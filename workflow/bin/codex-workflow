team_lock_file() {
  printf '%s/%s.lock\n' "$TEAM_LOCK_DIR" "$(title_checksum "$1")"
}

acquire_lock() {
  local lock_file="$1"
  local lock_dir="${lock_file}.dir"

  while ! mkdir "$lock_dir" 2>/dev/null; do
    sleep 0.05
  done

  LOCK_DIRS+=("$lock_dir")
}

release_lock() {
  local lock_file="$1"
  local lock_dir="${lock_file}.dir"
  local remaining=()
  local held_locks=()
  local held

  rmdir "$lock_dir" 2>/dev/null || true

  set +u
  held_locks=("${LOCK_DIRS[@]}")
  set -u

  if ((${#held_locks[@]})); then
    for held in "${held_locks[@]}"; do
      if [[ "$held" != "$lock_dir" ]]; then
        remaining+=("$held")
      fi
    done
  fi
  if ((${#remaining[@]})); then
    LOCK_DIRS=("${remaining[@]}")
  else
    LOCK_DIRS=()
  fi
}

path_relative_to_codex_home() {
  python3 - "$CODEX_HOME_ROOT" "$1" <<'PY'
from pathlib import Path
import sys

home = Path(sys.argv[1]).resolve()
target = Path(sys.argv[2]).resolve()
try:
    print(target.relative_to(home).as_posix())
except ValueError:
    print(str(target))
PY
}

