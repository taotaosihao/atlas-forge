}

cmd_learning_decision() {
  local task_id="$1"
  shift
  local decision reason recorded_at metadata decision_path candidate_count
  local candidates=()
  decision=""
  reason=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --decision) [[ $# -ge 2 ]] || { echo 'usage: codex-workflow learning-decision <task-id> --decision promote|skip --reason "<reason>" [--candidate <id>]...' >&2; exit 1; }; decision="$2"; shift 2 ;;
      --decision=*) decision="${1#--decision=}"; shift ;;
      --reason) [[ $# -ge 2 ]] || { echo 'usage: codex-workflow learning-decision <task-id> --decision promote|skip --reason "<reason>" [--candidate <id>]...' >&2; exit 1; }; reason="$2"; shift 2 ;;
      --reason=*) reason="${1#--reason=}"; shift ;;
      --candidate) [[ $# -ge 2 ]] || { echo 'usage: codex-workflow learning-decision <task-id> --decision promote|skip --reason "<reason>" [--candidate <id>]...' >&2; exit 1; }; candidates+=("$2"); shift 2 ;;
      --candidate=*) candidates+=("${1#--candidate=}"); shift ;;
      *) echo 'usage: codex-workflow learning-decision <task-id> --decision promote|skip --reason "<reason>" [--candidate <id>]...' >&2; exit 1 ;;
    esac
  done
  [[ -n "$decision" ]] || { echo "missing required argument: --decision" >&2; exit 1; }
  [[ -n "$reason" ]] || { echo "missing required argument: --reason" >&2; exit 1; }
  require_task "$task_id" >/dev/null
  sync_task_runtime "$task_id"
  recorded_at="$(timestamp_utc)"
  metadata="$(write_learning_decision "$task_id" "$decision" "$reason" "$recorded_at" "${#candidates[@]}" "${candidates[@]}")"
  IFS=$'\t' read -r decision_path decision candidate_count <<<"$metadata"
  upsert_task_fields "$(require_task "$task_id")" "learning_decision=$(path_relative_to_codex_home "$decision_path")" "learning_decision_value=$decision"
