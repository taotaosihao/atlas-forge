read_current_task_id() {
  python3 - "$CURRENT_TASK_FILE" <<'PY'
from pathlib import Path
import json
import sys

path = Path(sys.argv[1])
if not path.exists():
    raise SystemExit(0)
try:
    data = json.loads(path.read_text(encoding="utf-8"))
except json.JSONDecodeError:
    raise SystemExit(0)
task_id = data.get("task_id", "")
if task_id:
    print(task_id)
PY
}

list_task_ids() {
  find "$TASKS_DIR" -maxdepth 1 -name '*.md' -printf '%f\n' 2>/dev/null | sort | sed 's/\.md$//'
}

get_field() {
  local file="$1"
  local field="$2"
  awk -v want="$field" '
    BEGIN {
      in_header = 1
    }
    {
      line = $0
      sub(/\r$/, "", line)
      if (in_header) {
        if (line ~ "^" want ": ") {
          sub("^" want ": ", "", line)
          print line
          exit
        } else if (line ~ /^$/ || line ~ /^##[[:space:]]/ || line ~ /^#[[:space:]]/) {
          in_header = 0
        } else if (line ~ /^[A-Za-z0-9_.-]+: /) {
          # Keep unknown metadata lines in the header.
        } else {
          in_header = 0
        }
      }
    }
  ' "$file" | head -n 1
}

get_learning_field() {
  local file="$1"
  local field="$2"

  awk -v want="$field" '
    BEGIN {
      in_header = 1
    }
    {
      line = $0
      sub(/\r$/, "", line)
      if (in_header) {
        if (line ~ "^" want ": ") {
          sub("^" want ": ", "", line)
          print line
          exit
        } else if (line ~ /^##[[:space:]]/ || line ~ /^$/) {
          in_header = 0
        }
      }
    }
  ' "$file" | head -n 1
}

upsert_task_fields() {
  local file="$1"
  shift
  python3 - "$file" "$@" <<'PY'
from pathlib import Path
import re
import sys

path = Path(sys.argv[1])
updates = []
for raw in sys.argv[2:]:
    key, value = raw.split("=", 1)
    updates.append((key, value))

text = path.read_text(encoding="utf-8")
lines = text.splitlines(keepends=True)

header_end = len(lines)
for idx, line in enumerate(lines):
    stripped = line.rstrip("\r\n")
    if stripped == "" or stripped.startswith("## ") or stripped.startswith("# "):
        header_end = idx
        break
    if re.match(r"^[A-Za-z0-9_.-]+: ", stripped):
        continue
    header_end = idx
    break

header = [line.rstrip("\r\n") for line in lines[:header_end]]
body = "".join(lines[header_end:])
keys = [key for key, _ in updates]
done = set()

for idx, line in enumerate(header):
    for key, value in updates:
        if key in done:
            continue
        if re.match(rf"^{re.escape(key)}: ", line):
            header[idx] = f"{key}: {value}"
            done.add(key)
            break

for key, value in updates:
    if key not in done:
        header.append(f"{key}: {value}")

header_text = "\n".join(header)
if header_text:
    header_text += "\n"
if body:
    if not body.startswith("\n"):
      header_text += "\n"
    header_text += body.lstrip("\n")

path.write_text(header_text, encoding="utf-8")
PY
}

ensure_task_runtime_scaffold() {
  local task_id="$1"
  local title="$2"
  local artifact_dir verification_dir team_dir hook_failures_dir
  artifact_dir="$(task_artifact_dir "$task_id")"
  verification_dir="$(task_verification_dir "$task_id")"
  team_dir="$(task_team_dir "$task_id")"
  hook_failures_dir="$(task_hook_failures_dir "$task_id")"
  mkdir -p "$artifact_dir" "$verification_dir" "$team_dir" "$hook_failures_dir"
  if [[ ! -f "$artifact_dir/context.md" ]]; then
    printf '# Context\n\nTask: %s\nTitle: %s\n' "$task_id" "$title" > "$artifact_dir/context.md"
  fi
  if [[ ! -f "$artifact_dir/spec.md" ]]; then
    printf '# Spec\n\nTask: %s\n' "$task_id" > "$artifact_dir/spec.md"
  fi
  if [[ ! -f "$artifact_dir/analysis.md" ]]; then
    printf '# Analysis\n\nTask: %s\n' "$task_id" > "$artifact_dir/analysis.md"
  fi
  if [[ ! -f "$(task_team_decision_file "$task_id")" ]]; then
    printf '# Team Decision\n\nPending discussion.\n' > "$(task_team_decision_file "$task_id")"
  fi
  if [[ ! -f "$(task_team_staffing_file "$task_id")" ]]; then
    printf '# Staffing\n\nPending discussion.\n' > "$(task_team_staffing_file "$task_id")"
  fi
}

write_task_state_json() {
  local task_id="$1"
  local task_file artifact_dir_rel state_file
  task_file="$(require_task "$task_id")"
  artifact_dir_rel="$(task_artifact_dir_rel "$task_id")"
  state_file="$(task_state_file "$task_id")"
  python3 - "$task_file" "$state_file" "$artifact_dir_rel" "$(timestamp_utc)" <<'PY'
from pathlib import Path
import json
import re
import sys

task_file = Path(sys.argv[1])
state_file = Path(sys.argv[2])
artifact_dir = sys.argv[3]
now = sys.argv[4]
text = task_file.read_text(encoding="utf-8")

def get_field(name: str) -> str:
    match = re.search(rf"^{re.escape(name)}: ?(.*)$", text, re.MULTILINE)
    return match.group(1).strip() if match else ""

state = {}
if state_file.exists():
    try:
        state = json.loads(state_file.read_text(encoding="utf-8"))
    except json.JSONDecodeError:
        state = {}

active_team = state.get("active_team", {})
active_team["backend"] = get_field("active_team_backend") or active_team.get("backend", "")
active_team["mode"] = get_field("active_team_mode") or active_team.get("mode", "")
active_team["status"] = get_field("active_team_status") or active_team.get("status", "")
active_team["decision"] = get_field("active_team_decision") or active_team.get("decision", "")

state.update(
    {
        "task_id": get_field("id") or task_file.stem,
        "title": get_field("title"),
        "status": get_field("status"),
        "artifact_dir": artifact_dir,
        "last_verified_at": get_field("last_verified_at"),
        "updated_at": now,
    }
)
state["active_team"] = active_team
state_file.parent.mkdir(parents=True, exist_ok=True)
state_file.write_text(json.dumps(state, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
PY
}

set_task_state_fields() {
  local task_id="$1"
  shift
  local state_file
  state_file="$(task_state_file "$task_id")"
  python3 - "$state_file" "$(timestamp_utc)" "$@" <<'PY'
from pathlib import Path
import json
import sys

state_path = Path(sys.argv[1])
now = sys.argv[2]
pairs = sys.argv[3:]

state = {}
if state_path.exists():
    try:
        state = json.loads(state_path.read_text(encoding="utf-8"))
    except json.JSONDecodeError:
        state = {}

for pair in pairs:
    key, value = pair.split("=", 1)
    if value == "__TRUE__":
        cast = True
    elif value == "__FALSE__":
        cast = False
    elif value == "__NULL__":
        cast = None
    elif value.isdigit():
        cast = int(value)
    else:
        cast = value
    cursor = state
    parts = key.split(".")
    for part in parts[:-1]:
        cursor = cursor.setdefault(part, {})
    cursor[parts[-1]] = cast

state["updated_at"] = now
state_path.parent.mkdir(parents=True, exist_ok=True)
state_path.write_text(json.dumps(state, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
PY
}

append_task_runtime_event() {
  local task_id="$1"
  local kind="$2"
  local detail="$3"
  local runtime_file
  runtime_file="$(task_runtime_file "$task_id")"
  python3 - "$runtime_file" "$kind" "$detail" "$(timestamp_utc)" <<'PY'
from pathlib import Path
import json
import sys

path = Path(sys.argv[1])
kind = sys.argv[2]
detail = sys.argv[3]
created = sys.argv[4]
path.parent.mkdir(parents=True, exist_ok=True)
with path.open("a", encoding="utf-8") as fh:
    fh.write(json.dumps({"kind": kind, "detail": detail, "created_at": created}, ensure_ascii=False) + "\n")
PY
}

sync_task_runtime() {
  local task_id="$1"
  local task_file title artifact_dir_rel last_verified_at active_team_backend active_team_mode active_team_status active_team_decision
  task_file="$(require_task "$task_id")"
  title="$(get_field "$task_file" title)"
  artifact_dir_rel="$(task_artifact_dir_rel "$task_id")"
  last_verified_at="$(get_field "$task_file" last_verified_at)"
  active_team_backend="$(get_field "$task_file" active_team_backend)"
  active_team_mode="$(get_field "$task_file" active_team_mode)"
  active_team_status="$(get_field "$task_file" active_team_status)"
  active_team_decision="$(get_field "$task_file" active_team_decision)"
  ensure_state_dir
  ensure_artifacts_dir
  ensure_task_runtime_scaffold "$task_id" "$title"
  upsert_task_fields "$task_file" \
    "artifact_dir=$artifact_dir_rel" \
    "last_verified_at=$last_verified_at" \
    "active_team_backend=$active_team_backend" \
    "active_team_mode=$active_team_mode" \
    "active_team_status=$active_team_status" \
    "active_team_decision=$active_team_decision"
  write_task_state_json "$task_id"
}

write_current_task_pointer() {
  local task_id="$1"
  local task_file title artifact_dir_rel
  task_file="$(require_task "$task_id")"
  title="$(get_field "$task_file" title)"
  artifact_dir_rel="$(task_artifact_dir_rel "$task_id")"
  ensure_state_dir
  python3 - "$CURRENT_TASK_FILE" "$task_id" "$title" "$artifact_dir_rel" "$(timestamp_utc)" <<'PY'
from pathlib import Path
import json
import sys

path = Path(sys.argv[1])
data = {
    "task_id": sys.argv[2],
    "title": sys.argv[3],
    "artifact_dir": sys.argv[4],
    "updated_at": sys.argv[5],
}
path.parent.mkdir(parents=True, exist_ok=True)
path.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
PY
}

clear_current_task_pointer() {
  local task_id="${1:-}"
  python3 - "$CURRENT_TASK_FILE" "$task_id" <<'PY'
from pathlib import Path
import json
import sys

path = Path(sys.argv[1])
task_id = sys.argv[2]
if not path.exists():
    raise SystemExit(0)
if not task_id:
    path.unlink()
    raise SystemExit(0)
try:
    data = json.loads(path.read_text(encoding="utf-8"))
except json.JSONDecodeError:
    path.unlink()
    raise SystemExit(0)
if data.get("task_id") == task_id:
    path.unlink()
PY
}

header_field_count() {
  local file="$1"
  local field="$2"

  awk -v want="$field" '
    BEGIN {
      in_header = 1
      count = 0
    }
    {
      line = $0
      sub(/\r$/, "", line)
      if (in_header) {
        if (line ~ "^" want ": ") {
          count++
        } else if (line ~ /^$/ || line ~ /^##[[:space:]]/ || line ~ /^#[[:space:]]/) {
          in_header = 0
        } else if (line ~ /^[A-Za-z0-9_.-]+: /) {
          # Keep unknown metadata lines in the header.
        } else {
          in_header = 0
        }
      }
    }
    END {
      print count
    }
  ' "$file" | head -n 1
}

next_task_id() {
  local title="$1"
  local prefix max seq candidate file base

  prefix="$(date +%Y%m%d)"
  max=0

  shopt -s nullglob
  for file in "$TASKS_DIR"/"$prefix"-*.md; do
    base="$(basename "$file" .md)"
    if [[ "$base" =~ ^${prefix}-([0-9]+)- ]]; then
      seq="${BASH_REMATCH[1]}"
      if (( 10#$seq > max )); then
        max=$((10#$seq))
      fi
    fi
  done

  seq=$((max + 1))
  candidate="$prefix-$(printf '%03d' "$seq")-$(title_token "$title")"
  while [[ -e "$(task_file "$candidate")" ]]; do
    seq=$((seq + 1))
    candidate="$prefix-$(printf '%03d' "$seq")-$(title_token "$title")"
  done

  printf '%s\n' "$candidate"
}

render_task() {
  local file="$1"
  local id="$2"
  local title="$3"
  local criteria="$4"
  local now

  now="$(today)"
  local artifact_dir_rel=""
  artifact_dir_rel="$(task_artifact_dir_rel "$id")"
  ID="$id" \
  TITLE="$title" \
  STATUS="todo" \
  CREATED="$now" \
  UPDATED="$now" \
  ARTIFACT_DIR="$artifact_dir_rel" \
  LAST_VERIFIED_AT="" \
  ACTIVE_TEAM_BACKEND="" \
  ACTIVE_TEAM_MODE="" \
  ACTIVE_TEAM_STATUS="" \
  ACTIVE_TEAM_DECISION="" \
  SUCCESS_CRITERIA="$criteria" \
  perl -pe 's/\{\{(ID|TITLE|STATUS|CREATED|UPDATED|ARTIFACT_DIR|LAST_VERIFIED_AT|ACTIVE_TEAM_BACKEND|ACTIVE_TEAM_MODE|ACTIVE_TEAM_STATUS|ACTIVE_TEAM_DECISION|SUCCESS_CRITERIA)\}\}/$ENV{$1}/ge' \
    "$TASK_TEMPLATE" > "$file"
}

render_learning() {
  local file="$1"
  local task_id="$2"
  local title="$3"
  local lesson="$4"
  local now="${5:-}"

  if [[ -z "$now" ]]; then
    now="$(today)"
  fi
  TASK_ID="$task_id" \
  TITLE="$title" \
  CREATED="$now" \
  LESSON="$lesson" \
  perl -pe 's/\{\{(TASK_ID|TITLE|CREATED|LESSON)\}\}/$ENV{$1}/ge' \
    "$LEARNING_TEMPLATE" > "$file"
}

learning_basename() {
  local task_id="$1"
  local title="$2"
  local token checksum

  token="$(title_token "$title")"
  if [[ "$token" =~ ^u[0-9]+$ ]]; then
    printf '%s-%s\n' "$task_id" "$token"
    return
  fi

  checksum="$(title_checksum "$title")"
  printf '%s-%s-%s\n' "$task_id" "$token" "$checksum"
}

update_learning_index() {
  local basename="$1"
  local title="$2"
  local task_id="$3"
  local entry

  if [[ ! -s "$LEARNING_INDEX" ]]; then
    printf '# Learnings\n\n' > "$LEARNING_INDEX"
  fi

  entry="- [[${basename}]] title: ${title} | source task: ${task_id}"
  if ! grep -Fqx -- "$entry" "$LEARNING_INDEX" 2>/dev/null; then
    printf '%s\n' "$entry" >> "$LEARNING_INDEX"
  fi
}

update_learning_search_index() {
  local basename="$1"
  local title="$2"
  local task_id="$3"
  local created="$4"
  local lesson="$5"

  python3 - "$LEARNING_SEARCH_INDEX" "$basename" "$title" "$task_id" "$created" "$lesson" <<'PY'
import json
import os
import sys
import tempfile

path, learning_id, title, task_id, created, lesson = sys.argv[1:]
rows = []

if os.path.exists(path):
    with open(path, encoding="utf-8") as fh:
        for raw in fh:
            raw = raw.strip()
            if not raw:
                continue
            try:
                row = json.loads(raw)
            except json.JSONDecodeError:
                continue
            if row.get("id") != learning_id:
                rows.append(row)

rows.append({
    "id": learning_id,
    "title": title,
    "task_id": task_id,
    "created": created,
    "lesson": lesson,
})

directory = os.path.dirname(path) or "."
fd, tmp = tempfile.mkstemp(prefix="codex-memory-", suffix=".jsonl", dir=directory)
os.close(fd)
with open(tmp, "w", encoding="utf-8") as fh:
    for row in rows:
        fh.write(json.dumps(row, ensure_ascii=False) + "\n")
os.replace(tmp, path)
PY
}

sync_codex_memory() {
  validate_positive_integer "$MEMORY_RECENT_DAYS" "memory recent days"
  ensure_tasks_dir
  ensure_learnings_dir
  ensure_memory_dir

  python3 - "$TASKS_DIR" "$LEARNINGS_DIR" "$MEMORY_INDEX" "$TASK_MEMORY_INDEX" "$RECENT_LEARNINGS_INDEX" "$MEMORY_SEARCH_INDEX" "$MEMORY_RECENT_DAYS" <<'PY'
import json
import os
import re
import sys
import tempfile
from datetime import date, timedelta
from pathlib import Path

tasks_dir = Path(sys.argv[1])
learnings_dir = Path(sys.argv[2])
memory_index_path = Path(sys.argv[3])
task_memory_path = Path(sys.argv[4])
recent_learnings_path = Path(sys.argv[5])
memory_search_index_path = Path(sys.argv[6])
recent_days = int(sys.argv[7])
today = date.today()
cutoff = today - timedelta(days=recent_days - 1)


def read_text(path: Path) -> str:
    return path.read_text(encoding="utf-8")


def get_field(text: str, field: str) -> str:
    match = re.search(rf"^{re.escape(field)}: (.*)$", text, re.MULTILINE)
    return match.group(1).strip() if match else ""


def get_section(text: str, heading: str) -> str:
    marker = f"## {heading}\n"
    if marker not in text:
        return ""
    tail = text.split(marker, 1)[1]
    split = re.split(r"\n##[ ]|\n#[ ]", tail, maxsplit=1)
    return split[0].strip()


def normalize(value: str) -> str:
    return re.sub(r"\s+", " ", value.strip())


def excerpt(value: str, limit: int = 160) -> str:
    compact = normalize(value)
    if len(compact) <= limit:
        return compact
    return compact[: limit - 3].rstrip() + "..."


def parse_iso_day(value: str):
    try:
        return date.fromisoformat(value)
    except ValueError:
        return None


def parse_task(path: Path) -> dict:
    text = read_text(path)
    return {
        "kind": "task",
        "id": get_field(text, "id") or path.stem,
        "title": get_field(text, "title"),
        "status": get_field(text, "status"),
        "created": get_field(text, "created"),
        "updated": get_field(text, "updated"),
        "success_criteria": normalize(get_section(text, "Success Criteria")),
        "path": str(path),
    }


def parse_learning(path: Path) -> dict:
    text = read_text(path)
    return {
        "kind": "learning",
        "id": path.stem,
        "title": get_field(text, "title"),
        "task_id": get_field(text, "source-task-id"),
        "created": get_field(text, "created"),
        "lesson": normalize(get_section(text, "Lesson")),
        "path": str(path),
    }


def task_sort_key(row: dict):
    status_order = {"doing": 0, "todo": 1, "done": 2}
    return (status_order.get(row.get("status", ""), 9), row.get("id", ""))


def day_sort_key(row: dict, field: str):
    parsed = parse_iso_day(row.get(field, ""))
    return (parsed or date.min, row.get("id", ""))


def write_atomic(path: Path, content: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix="codex-memory-", suffix=".tmp", dir=str(path.parent))
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(content)
        os.replace(tmp, path)
    except Exception:
        try:
            os.unlink(tmp)
        except FileNotFoundError:
            pass
        raise


tasks = [parse_task(path) for path in sorted(tasks_dir.glob("*.md"))]
learnings = []
for path in sorted(learnings_dir.glob("*.md")):
    if path.name in {"index.md", "RECENT.md"}:
        continue
    learnings.append(parse_learning(path))

active_tasks = sorted(
    [row for row in tasks if row.get("status") in {"todo", "doing"}],
    key=task_sort_key,
)
recent_done_tasks = [
    row
    for row in tasks
    if row.get("status") == "done"
    and (parse_iso_day(row.get("updated", "")) or date.min) >= cutoff
]
recent_done_tasks.sort(key=lambda row: day_sort_key(row, "updated"), reverse=True)
recent_learnings = sorted(learnings, key=lambda row: day_sort_key(row, "created"), reverse=True)

memory_rows = []
for row in tasks:
    memory_rows.append(
        {
            "kind": "task",
            "id": row.get("id", ""),
            "title": row.get("title", ""),
            "status": row.get("status", ""),
            "created": row.get("created", ""),
            "updated": row.get("updated", ""),
            "success_criteria": row.get("success_criteria", ""),
            "path": row.get("path", ""),
        }
    )
for row in learnings:
    memory_rows.append(
        {
            "kind": "learning",
            "id": row.get("id", ""),
            "title": row.get("title", ""),
            "task_id": row.get("task_id", ""),
            "created": row.get("created", ""),
            "lesson": row.get("lesson", ""),
            "path": row.get("path", ""),
        }
    )
memory_rows.sort(
    key=lambda row: (
        row.get("updated", row.get("created", "")),
        row.get("kind", ""),
        row.get("id", ""),
    ),
    reverse=True,
)

memory_lines = [
    "# Codex Memory",
    "",
    f"Updated: {today.isoformat()}",
    "",
    "## Snapshot",
    f"- Open tasks: {len(active_tasks)}",
    f"- Recent completed tasks ({recent_days} days): {len(recent_done_tasks)}",
    f"- Saved learnings: {len(learnings)}",
    "",
    "## Active Tasks",
]
if active_tasks:
    for row in active_tasks[:10]:
        memory_lines.append(
            f"- [{row.get('status', '')}] {row.get('id', '')} | {row.get('title', '')} | updated {row.get('updated', '')}"
        )
        if row.get("success_criteria"):
            memory_lines.append(f"  Success: {excerpt(row['success_criteria'])}")
else:
    memory_lines.append("- No open tasks.")

memory_lines.extend(["", f"## Recent Completions ({recent_days} Days)"])
if recent_done_tasks:
    for row in recent_done_tasks[:10]:
        memory_lines.append(
            f"- {row.get('id', '')} | {row.get('title', '')} | updated {row.get('updated', '')}"
        )
else:
    memory_lines.append("- No recent completions.")

memory_lines.extend(["", "## Recent Learnings"])
if recent_learnings:
    for row in recent_learnings[:10]:
        memory_lines.append(
            f"- {row.get('title', '')} | source task {row.get('task_id', '')} | created {row.get('created', '')}"
        )
        if row.get("lesson"):
            memory_lines.append(f"  Lesson: {excerpt(row['lesson'])}")
else:
    memory_lines.append("- No saved learnings yet.")

memory_lines.extend(
    [
        "",
        "## Files",
        "- [Task Summary](tasks.md)",
        "- [Recent Learnings](learnings/RECENT.md)",
        "- [Full Learning Index](learnings/index.md)",
        "- Structured memory: `memory.jsonl`",
        "",
    ]
)

task_lines = [
    "# Task Memory",
    "",
    f"Updated: {today.isoformat()}",
    "",
    "## Open Tasks",
]
if active_tasks:
    for row in active_tasks:
        task_lines.append(f"- [{row.get('status', '')}] {row.get('id', '')} | {row.get('title', '')}")
        task_lines.append(
            f"  Created: {row.get('created', '')} | Updated: {row.get('updated', '')}"
        )
        if row.get("success_criteria"):
            task_lines.append(f"  Success: {excerpt(row['success_criteria'], 220)}")
else:
    task_lines.append("- No open tasks.")

task_lines.extend(["", f"## Recent Completions ({recent_days} Days)"])
if recent_done_tasks:
    for row in recent_done_tasks[:20]:
        task_lines.append(f"- {row.get('id', '')} | {row.get('title', '')}")
        task_lines.append(
            f"  Created: {row.get('created', '')} | Updated: {row.get('updated', '')}"
        )
        if row.get("success_criteria"):
            task_lines.append(f"  Success: {excerpt(row['success_criteria'], 220)}")
else:
    task_lines.append("- No recent completions.")
task_lines.append("")

learning_lines = [
    "# Recent Learnings",
    "",
    f"Updated: {today.isoformat()}",
    "",
    "## Latest Entries",
]
if recent_learnings:
    for row in recent_learnings[:20]:
        learning_lines.append(
            f"- {row.get('title', '')} | source task {row.get('task_id', '')} | created {row.get('created', '')}"
        )
        if row.get("lesson"):
            learning_lines.append(f"  Lesson: {excerpt(row['lesson'], 220)}")
else:
    learning_lines.append("- No saved learnings yet.")
learning_lines.extend(["", "## Full Index", "- See `index.md` for the complete learning list.", ""])

write_atomic(memory_index_path, "\n".join(memory_lines))
write_atomic(task_memory_path, "\n".join(task_lines))
write_atomic(recent_learnings_path, "\n".join(learning_lines))
write_atomic(
    memory_search_index_path,
    "".join(json.dumps(row, ensure_ascii=False) + "\n" for row in memory_rows),
)
PY
}

update_status() {
  local file="$1"
  local status="$2"
  local tmp
  tmp="$(mktemp)"
  STATUS="$status" UPDATED="$(today)" perl -ne '
    BEGIN {
      $in_header = 1;
      $status = $ENV{STATUS};
      $updated = $ENV{UPDATED};
      $id_seen = 0;
      $title_seen = 0;
      $status_seen = 0;
      $created_seen = 0;
      $updated_seen = 0;
    }
    my $eol = "\n";
    $eol = $1 if s/(\r?\n)\z//;
    if ($in_header) {
      if (/^id: /) {
        $id_seen = 1;
      } elsif (/^title: /) {
        $title_seen = 1;
      } elsif (/^status: /) {
        $_ = "status: $status";
        $status_seen = 1;
      } elsif (/^created: /) {
        $created_seen = 1;
      } elsif (/^updated: /) {
        $_ = "updated: $updated";
        $updated_seen = 1;
      } elsif (/^[A-Za-z0-9_.-]+: /) {
        # Keep extra metadata lines in the header.
      } elsif (/^$/ || /^##\s/ || /^#\s/) {
        $in_header = 0;
      } else {
        $in_header = 0;
      }
      if ($id_seen && $title_seen && $status_seen && $created_seen && $updated_seen) {
        $in_header = 0;
      }
    }
    print $_, $eol;
    END {
      if (!$status_seen || !$updated_seen) {
        my @missing;
        push @missing, "status" unless $status_seen;
        push @missing, "updated" unless $updated_seen;
        print STDERR "malformed task file: missing ", join(", ", @missing), "\n";
        exit 1;
      }
    }
  ' "$file" > "$tmp"
  mv "$tmp" "$file"
}

require_task() {
  local id="$1"
  local file
  file="$(task_file "$id")"
  if [[ ! -f "$file" ]]; then
    echo "unknown task: $id" >&2
    if ids="$(list_task_ids)" && [[ -n "$ids" ]]; then
      echo "known tasks:" >&2
      printf '%s\n' "$ids" >&2
    fi
    exit 1
  fi
  printf '%s\n' "$file"
}

validate_task_for_update() {
  local file="$1"
  local missing=()
  local duplicate=()
  local expected_id task_id title status created updated
  local id_count title_count status_count created_count updated_count

  expected_id="$(basename "$file" .md)"
  id_count="$(header_field_count "$file" id)"
  title_count="$(header_field_count "$file" title)"
  status_count="$(header_field_count "$file" status)"
  created_count="$(header_field_count "$file" created)"
  updated_count="$(header_field_count "$file" updated)"

  if [[ "$id_count" -eq 0 ]]; then missing+=("id"); elif [[ "$id_count" -gt 1 ]]; then duplicate+=("id"); fi
  if [[ "$title_count" -eq 0 ]]; then missing+=("title"); elif [[ "$title_count" -gt 1 ]]; then duplicate+=("title"); fi
  if [[ "$status_count" -eq 0 ]]; then missing+=("status"); elif [[ "$status_count" -gt 1 ]]; then duplicate+=("status"); fi
  if [[ "$created_count" -eq 0 ]]; then missing+=("created"); elif [[ "$created_count" -gt 1 ]]; then duplicate+=("created"); fi
  if [[ "$updated_count" -eq 0 ]]; then missing+=("updated"); elif [[ "$updated_count" -gt 1 ]]; then duplicate+=("updated"); fi

  if ((${#missing[@]} > 0)); then
    echo "malformed task file: $file missing ${missing[*]}" >&2
    exit 1
  fi

  if ((${#duplicate[@]} > 0)); then
    echo "malformed task file: $file duplicate ${duplicate[*]}" >&2
    exit 1
  fi

  task_id="$(get_field "$file" id)"
  title="$(get_field "$file" title)"
  status="$(get_field "$file" status)"
  created="$(get_field "$file" created)"
  updated="$(get_field "$file" updated)"

  if [[ "$task_id" != "$expected_id" ]]; then
    echo "malformed task file: $file filename/id mismatch ($expected_id != $task_id)" >&2
    exit 1
  fi

  case "$status" in
    todo|doing|done)
      ;;
    *)
      echo "malformed task file: $file invalid status $status" >&2
      exit 1
      ;;
  esac
}

set_config_feature() {
  local file="$1"
  local feature="$2"
  local value="$3"
  python3 - "$file" "$feature" "$value" <<'PY'
from pathlib import Path
import re
import sys

path = Path(sys.argv[1])
feature = sys.argv[2]
value = sys.argv[3].lower()
text = path.read_text(encoding="utf-8") if path.exists() else ""
lines = text.splitlines()

features_start = None
features_end = None
for idx, line in enumerate(lines):
    stripped = line.strip()
    if stripped == "[features]":
        features_start = idx
        features_end = len(lines)
        for follow in range(idx + 1, len(lines)):
            if lines[follow].startswith("[") and lines[follow].endswith("]"):
                features_end = follow
                break
        break

if features_start is None:
    if lines and lines[-1] != "":
        lines.append("")
    lines.extend(["[features]", f"{feature} = {value}"])
else:
    replaced = False
    for idx in range(features_start + 1, features_end):
        if re.match(rf"^{re.escape(feature)}\s*=", lines[idx].strip()):
            lines[idx] = f"{feature} = {value}"
            replaced = True
            break
    if not replaced:
        lines.insert(features_end, f"{feature} = {value}")

path.parent.mkdir(parents=True, exist_ok=True)
path.write_text("\n".join(lines).rstrip() + "\n", encoding="utf-8")
PY
}

merge_workflow_hooks_json() {
  local file="$1"
  local pre_hook="$2"
  local post_hook="$3"
  python3 - "$file" "$pre_hook" "$post_hook" <<'PY'
from pathlib import Path
import json
import sys

path = Path(sys.argv[1])
pre_hook = sys.argv[2]
post_hook = sys.argv[3]

try:
    data = json.loads(path.read_text(encoding="utf-8")) if path.exists() else {}
except json.JSONDecodeError:
    data = {}

hooks = data.setdefault("hooks", {})

def ensure_entry(name: str, command: str) -> None:
    entries = hooks.setdefault(name, [])
    for entry in entries:
        for hook in entry.get("hooks", []):
            if hook.get("type") == "command" and hook.get("command") == command:
                return
    entries.append(
        {
            "matcher": "Bash",
            "hooks": [
                {
                    "type": "command",
                    "command": command,
                }
            ],
        }
    )

ensure_entry("PreToolUse", pre_hook)
ensure_entry("PostToolUse", post_hook)

path.parent.mkdir(parents=True, exist_ok=True)
path.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
PY
}

install_workflow_hook_script() {
  local name="$1"
  local source="$SOURCE_HOOKS_DIR/$name"
  local target="$HOOKS_DIR/$name"
  if [[ ! -f "$source" ]]; then
    echo "missing workflow hook source: $source" >&2
    exit 1
  fi
  ensure_hooks_dir
  if [[ "$source" != "$target" ]]; then
    cp "$source" "$target"
  fi
  chmod +x "$target"
  printf '%s\n' "$target"
}

write_verification_record() {
  local record_file="$1"
  local record_type="$2"
  local task_id="$3"
  local command_text="$4"
  local cwd="$5"
  local exit_code="$6"
  local verdict="$7"
  local stdout_file="$8"
  local stderr_file="$9"
  local created_at="${10}"
  local outcome="${11:-}"
  local trajectory="${12:-}"
  local evaluator="${13:-}"
  local failure_attribution="${14:-}"
  local evidence_count="${15:-0}"
  shift $((15 < $# ? 15 : $#))
  local evidence_refs=()
  if (($#)); then
    evidence_refs=("$@")
  fi
  if ((evidence_count > 0)); then
    set -- "$record_file" "$record_type" "$task_id" "$command_text" "$cwd" "$exit_code" "$verdict" "$stdout_file" "$stderr_file" "$created_at" "$outcome" "$trajectory" "$evaluator" "$failure_attribution" "$evidence_count" "${evidence_refs[@]}"
  else
    set -- "$record_file" "$record_type" "$task_id" "$command_text" "$cwd" "$exit_code" "$verdict" "$stdout_file" "$stderr_file" "$created_at" "$outcome" "$trajectory" "$evaluator" "$failure_attribution" "$evidence_count"
  fi
  python3 - "$@" <<'PY'
from pathlib import Path
import sys

record_file = Path(sys.argv[1])
record_type = sys.argv[2]
task_id = sys.argv[3]
command_text = sys.argv[4]
cwd = sys.argv[5]
exit_code = sys.argv[6]
verdict = sys.argv[7]
stdout_file = Path(sys.argv[8])
stderr_file = Path(sys.argv[9])
created_at = sys.argv[10]
outcome = sys.argv[11]
trajectory = sys.argv[12]
evaluator = sys.argv[13]
failure_attribution = sys.argv[14]
evidence_count = int(sys.argv[15] or "0")
evidence_refs = sys.argv[16 : 16 + evidence_count]

def preview(path: Path) -> str:
    if not path.exists():
        return ""
    text = path.read_text(encoding="utf-8", errors="replace")
    lines = text.splitlines()
    if len(lines) > 80:
        lines = lines[:80] + [f"... ({len(text.splitlines()) - 80} more lines omitted)"]
    content = "\n".join(lines)
    if len(content) > 6000:
        content = content[:6000].rstrip() + "\n... (output truncated)"
    return content

stdout_preview = preview(stdout_file)
stderr_preview = preview(stderr_file)
metadata = []
if outcome:
    metadata.append(f"- outcome: {outcome}")
if trajectory:
    metadata.append(f"- trajectory: {trajectory}")
if evaluator:
    metadata.append(f"- evaluator: {evaluator}")
if failure_attribution:
    metadata.append(f"- failure_attribution: {failure_attribution}")
if evidence_refs:
    metadata.extend(["", "## Evidence Refs", ""])
    metadata.extend(f"- `{item}`" for item in evidence_refs)
body = [
    f"# {record_type.capitalize()} Record",
    "",
    f"- task_id: {task_id}",
    f"- created_at: {created_at}",
    f"- cwd: `{cwd}`",
    f"- exit_code: {exit_code}",
    f"- verdict: {verdict}",
    *metadata,
    "",
    "## Command",
    "",
    "```bash",
    command_text,
    "```",
    "",
    "## Stdout",
    "",
    "```text",
    stdout_preview,
    "```",
    "",
    "## Stderr",
    "",
    "```text",
    stderr_preview,
    "```",
    "",
]
record_file.parent.mkdir(parents=True, exist_ok=True)
record_file.write_text("\n".join(body), encoding="utf-8")
PY
}

config_feature_value() {
  python3 - "$CODEX_CONFIG_FILE" "$1" <<'PY'
from pathlib import Path
import sys

feature = sys.argv[2]
path = Path(sys.argv[1])
if not path.exists():
    raise SystemExit(0)

current_section = ""
for raw in path.read_text(encoding="utf-8").splitlines():
    line = raw.strip()
    if line.startswith("[") and line.endswith("]"):
        current_section = line
        continue
    if current_section == "[features]" and line.startswith(feature):
        _, value = line.split("=", 1)
        print(value.strip())
        break
PY
}

config_network_summary() {
  python3 - "$CODEX_CONFIG_FILE" <<'PY'
from pathlib import Path
import json
import os
import re
import sys

path = Path(sys.argv[1])
items = []
if path.exists():
    for raw in path.read_text(encoding="utf-8").splitlines():
        if re.search(r"base_url|baseURL|proxy", raw, re.IGNORECASE):
            items.append(raw.strip())
for key in ("HTTP_PROXY", "HTTPS_PROXY", "ALL_PROXY", "NO_PROXY"):
    value = os.environ.get(key)
    if value:
        items.append(f"{key}={value}")
print("; ".join(items[:8]))
PY
}

doctor_report() {
  local current_task_id="${1:-}"
  local output_format="${2:-text}"
  local codex_path login_output hooks_value legacy_hooks_value network_summary paseo_path paseo_summary
  codex_path="$(command -v "$CODEX_BIN" 2>/dev/null || true)"
  if [[ -n "$codex_path" ]]; then
    login_output="$("$CODEX_BIN" login status 2>&1 || true)"
  else
    login_output="missing codex executable"
  fi
  hooks_value="$(config_feature_value hooks)"
  legacy_hooks_value="$(config_feature_value codex_hooks)"
  network_summary="$(config_network_summary)"
  paseo_path="$(command -v "$PASEO_BIN" 2>/dev/null || true)"
  if [[ -n "$paseo_path" ]]; then
    paseo_summary="$("$PASEO_BIN" provider ls --json 2>/dev/null | tr '\n' ' ' || true)"
  else
    paseo_summary=""
  fi

  python3 - "$output_format" "$current_task_id" "$(timestamp_utc)" "$WORKFLOW_ROOT" "$CODEX_HOME_ROOT" "$TASKS_DIR" "$STATE_DIR" "$ARTIFACTS_DIR" "$HOOKS_DIR" "$SOURCE_HOOKS_DIR" "$CODEX_CONFIG_FILE" "$CODEX_HOOKS_FILE" "$ATLAS_SOURCE_SKILLS_DIR" "$ATLAS_CACHE_SKILLS_DIR" "$CURRENT_TASK_FILE" "${codex_path:-missing}" "${login_output:-unknown}" "${hooks_value:-unset}" "${legacy_hooks_value:-unset}" "${network_summary:-none}" "${paseo_path:-missing}" "$paseo_summary" <<'PY'
from pathlib import Path
import json
import sys

output_format = sys.argv[1]
current_task_id = sys.argv[2]
generated_at = sys.argv[3]
workflow_root = Path(sys.argv[4])
codex_home = Path(sys.argv[5])
tasks_dir = Path(sys.argv[6])
state_dir = Path(sys.argv[7])
artifacts_dir = Path(sys.argv[8])
hooks_dir = Path(sys.argv[9])
source_hooks_dir = Path(sys.argv[10])
config_file = Path(sys.argv[11])
hooks_file = Path(sys.argv[12])
source_skills_dir = Path(sys.argv[13])
cache_skills_dir = Path(sys.argv[14])
current_task_file = Path(sys.argv[15])
codex_path = sys.argv[16]
login_output = sys.argv[17]
hooks_value = sys.argv[18]
legacy_hooks_value = sys.argv[19]
network_summary = sys.argv[20]
paseo_path = sys.argv[21]
paseo_summary = sys.argv[22]


def path_info(path: Path) -> dict:
    return {
        "path": str(path),
        "exists": path.exists(),
        "is_file": path.is_file(),
        "is_dir": path.is_dir(),
    }


def read_json(path: Path):
    if not path.exists():
        return None
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return None


def read_runtime_events(task_id: str) -> list:
    if not task_id:
        return []
    runtime_file = artifacts_dir / task_id / "runtime.jsonl"
    rows = []
    if not runtime_file.exists():
        return rows
    for raw in runtime_file.read_text(encoding="utf-8", errors="replace").splitlines():
        if not raw.strip():
            continue
        try:
            rows.append(json.loads(raw))
        except json.JSONDecodeError:
            rows.append({"kind": "invalid-jsonl", "raw": raw[:200]})
    return rows


def build_install() -> dict:
    required_dirs = {
        "workflow_root": path_info(workflow_root),
        "tasks_dir": path_info(tasks_dir),
        "state_dir": path_info(state_dir),
        "artifacts_dir": path_info(artifacts_dir),
    }
    missing_dirs = [name for name, info in required_dirs.items() if not info["exists"]]
    status = "ok"
    if missing_dirs:
        status = "missing"
    elif codex_path == "missing":
        status = "warn"
    return {
        "status": status,
        "codex_executable": codex_path,
        "codex_login": login_output,
        "codex_home": str(codex_home),
        "config_toml": str(config_file),
        "network_summary": network_summary,
        "paseo": paseo_path,
        "paseo_providers": paseo_summary,
        "paths": required_dirs,
    }


def build_source_cache() -> dict:
    source_info = path_info(source_skills_dir)
    cache_info = path_info(cache_skills_dir)
    checked = []
    missing = []
    mismatches = []
    if source_skills_dir.is_dir() and cache_skills_dir.is_dir():
        for source_skill in sorted(source_skills_dir.glob("*/SKILL.md")):
            skill_name = source_skill.parent.name
            cache_skill = cache_skills_dir / skill_name / "SKILL.md"
            if not cache_skill.exists():
                missing.append(skill_name)
                continue
            checked.append(skill_name)
            if source_skill.read_bytes() != cache_skill.read_bytes():
                mismatches.append(skill_name)
    status = "unknown"
    if not source_info["exists"] or not cache_info["exists"]:
        status = "unknown"
    elif missing or mismatches:
        status = "mismatch"
    else:
        status = "ok"
    return {
        "status": status,
        "source_dir": str(source_skills_dir),
        "cache_dir": str(cache_skills_dir),
        "checked": checked,
        "missing": missing,
        "mismatches": mismatches,
    }


def hook_commands() -> list:
    data = read_json(hooks_file)
    commands = []
    if not isinstance(data, dict):
        return commands
    hooks = data.get("hooks", {})
    if not isinstance(hooks, dict):
        return commands
    for entries in hooks.values():
        if not isinstance(entries, list):
            continue
        for entry in entries:
            for hook in entry.get("hooks", []) if isinstance(entry, dict) else []:
                command = hook.get("command") if isinstance(hook, dict) else None
                if command:
                    commands.append(str(command))
    return commands


def build_hooks_config() -> dict:
    target_pre = hooks_dir / "pre-tool-use"
    target_post = hooks_dir / "post-tool-use"
    source_pre = source_hooks_dir / "pre-tool-use"
    source_post = source_hooks_dir / "post-tool-use"
    commands = hook_commands()
    target_hooks_exist = target_pre.exists() and target_post.exists()
    source_hooks_exist = source_pre.exists() and source_post.exists()
    commands_configured = any("pre-tool-use" in item for item in commands) and any("post-tool-use" in item for item in commands)
    enabled = hooks_value.lower() == "true" or legacy_hooks_value.lower() == "true"
    if enabled and hooks_file.exists() and target_hooks_exist and commands_configured:
        status = "ok"
    elif enabled or hooks_file.exists() or target_hooks_exist or commands_configured:
        status = "partial"
    else:
        status = "missing"
    return {
        "status": status,
        "features.hooks": hooks_value,
        "features.codex_hooks": legacy_hooks_value,
        "hooks_json": path_info(hooks_file),
        "target_pre_hook": path_info(target_pre),
        "target_post_hook": path_info(target_post),
        "source_hooks_exist": source_hooks_exist,
        "target_hooks_exist": target_hooks_exist,
        "commands_configured": commands_configured,
        "commands": commands,
    }


def build_hooks_runtime(hooks_config_status: str) -> dict:
    events = read_runtime_events(current_task_id)
    proof_events = [
        row for row in events
        if row.get("kind") in {"pre-tool-risk", "post-tool-failure"}
    ]
    failure_dir = artifacts_dir / current_task_id / "hook-failures" if current_task_id else None
    failure_files = sorted(failure_dir.glob("*.json")) if failure_dir and failure_dir.exists() else []
    if proof_events or failure_files:
        status = "proven"
    elif hooks_config_status in {"ok", "partial"}:
        status = "configured_unproven"
    else:
        status = "not_configured"
    latest_event = proof_events[-1] if proof_events else {}
    return {
        "status": status,
        "current_task_id": current_task_id,
        "runtime_file": str(artifacts_dir / current_task_id / "runtime.jsonl") if current_task_id else "",
        "proof_event_count": len(proof_events),
        "hook_failure_count": len(failure_files),
        "latest_proof_event": latest_event,
        "latest_failure": str(failure_files[-1]) if failure_files else "",
    }


def build_smoke() -> dict:
    state_path = artifacts_dir / current_task_id / "state.json" if current_task_id else None
    state = read_json(state_path) if state_path else {}
    if not isinstance(state, dict):
        state = {}
    verification = state.get("verification") if isinstance(state.get("verification"), dict) else {}
    last_record = verification.get("last_record", "")
    last_exit_code = verification.get("last_exit_code", "")
    last_verified_at = state.get("last_verified_at", "")
    verification_dir = artifacts_dir / current_task_id / "verification" if current_task_id else None
    records = sorted(verification_dir.glob("*.md")) if verification_dir and verification_dir.exists() else []
    if last_exit_code == 0 or str(last_exit_code) == "0":
        status = "passed"
    elif last_record or last_verified_at or records:
        status = "failed_or_unknown"
    else:
        status = "no_proof"
    events = read_runtime_events(current_task_id)
    smoke_events = [row for row in events if row.get("kind") == "smoke"]
    return {
        "status": status,
        "current_task_id": current_task_id,
        "last_verified_at": last_verified_at,
        "last_exit_code": last_exit_code,
        "last_record": last_record or (str(records[-1]) if records else ""),
        "smoke_event_count": len(smoke_events),
        "latest_smoke_event": smoke_events[-1] if smoke_events else {},
    }


install = build_install()
source_cache = build_source_cache()
hooks_config = build_hooks_config()
hooks_runtime = build_hooks_runtime(hooks_config["status"])
smoke = build_smoke()
report = {
    "generated_at": generated_at,
    "current_task_id": current_task_id,
    "install": install,
    "source_cache": source_cache,
    "hooks_config": hooks_config,
    "hooks_runtime": hooks_runtime,
    "smoke": smoke,
}

if output_format == "json":
    print(json.dumps(report, ensure_ascii=False, indent=2))
elif output_format == "text":
    sections = [
        ("install", install),
        ("source-cache", source_cache),
        ("hooks-config", hooks_config),
        ("hooks-runtime", hooks_runtime),
        ("smoke", smoke),
    ]
    print(f"generated_at\t{generated_at}")
    if current_task_id:
        print(f"current_task_id\t{current_task_id}")
    for name, section in sections:
        print(f"[{name}]")
        print(f"status\t{section.get('status', '')}")
        for key, value in section.items():
            if key == "status":
                continue
            if isinstance(value, (dict, list)):
                value = json.dumps(value, ensure_ascii=False, sort_keys=True)
            print(f"{key}\t{value}")
else:
    print(f"invalid doctor output format: {output_format}", file=sys.stderr)
    raise SystemExit(1)
PY
  if [[ -n "$current_task_id" ]]; then
    append_task_runtime_event "$current_task_id" "doctor" "ran doctor checks"
  fi
}

task_excerpt() {
  local file="$1"
  python3 - "$file" <<'PY'
from pathlib import Path
import sys

path = Path(sys.argv[1])
if not path.exists():
    raise SystemExit(0)
text = path.read_text(encoding="utf-8", errors="replace").strip()
if len(text) > 3000:
    text = text[:3000].rstrip() + "\n... (truncated)"
sys.stdout.write(text)
PY
}

team_role_names() {
  local mode="$1"
  local agents="$2"
  local -a base_roles=()
  local i
  case "$mode" in
    discuss)
      base_roles=(architect critic verifier)
      ;;
    execute)
      base_roles=(executor verifier reviewer)
      ;;
    *)
      echo "invalid team mode: $mode" >&2
      exit 1
      ;;
  esac
  for ((i = 0; i < agents; i++)); do
    if (( i < ${#base_roles[@]} )); then
      printf '%s\n' "${base_roles[$i]}"
    else
      printf 'lane-%d\n' "$((i + 1))"
    fi
  done
}

claude_provider_available() {
  local output
  if ! command -v "$PASEO_BIN" >/dev/null 2>&1; then
    return 1
  fi
  output="$("$PASEO_BIN" provider ls --json 2>/dev/null || true)"
  python3 - "$output" <<'PY'
import json
import sys

try:
    rows = json.loads(sys.argv[1] or "[]")
except json.JSONDecodeError:
    raise SystemExit(1)

for row in rows:
    provider = str(row.get("provider", "")).lower()
    status = str(row.get("status", "")).lower()
    if provider == "claude" and status == "available":
        raise SystemExit(0)
raise SystemExit(1)
PY
}

cmd_init_task() {
  local title="$1"
  local criteria="$2"
  local id file

  validate_title "$title"
  acquire_lock "$INIT_TASK_LOCK_FILE"
  id="$(next_task_id "$title")"
  if [[ -n "${CODEX_WORKFLOW_TEST_INIT_PAUSE_BEFORE_WRITE:-}" ]]; then
    sleep "$CODEX_WORKFLOW_TEST_INIT_PAUSE_BEFORE_WRITE"
  fi
  file="$(task_file "$id")"
  render_task "$file" "$id" "$title" "$criteria"
  release_lock "$INIT_TASK_LOCK_FILE"
  sync_codex_memory
  printf '%s\n' "$id"
}

cmd_list() {
  local mode="$1"
  local days="$2"
  local cutoff_day=""

  if [[ "$mode" == "recent" ]]; then
    cutoff_day="$(list_cutoff_day "$days")"
  fi

  python3 - "$TASKS_DIR" "$cutoff_day" <<'PY' | sort -t $'\t' -k2,2V
from pathlib import Path
import re
import sys

tasks_dir = Path(sys.argv[1])
cutoff_day = sys.argv[2]
required_fields = ("id", "title", "status", "created", "updated")
metadata_re = re.compile(r"^[A-Za-z0-9_.-]+: ")
task_day_re = re.compile(r"^([0-9]{8})-[0-9]+-")


def parse_header(path):
    fields = {}
    text = path.read_text(encoding="utf-8", errors="replace")
    for raw_line in text.splitlines():
        line = raw_line.rstrip("\r")
        if line == "" or line.startswith("## ") or line.startswith("# "):
            break
        if metadata_re.match(line):
            key, value = line.split(": ", 1)
            fields.setdefault(key, []).append(value)
            continue
        break
    return fields


def fail(message: str) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(1)


def should_list_task(status: str, task_id: str) -> bool:
    if not cutoff_day or status != "done":
        return True
    match = task_day_re.match(task_id)
    if not match:
        return True
    return match.group(1) >= cutoff_day


for path in sorted(tasks_dir.glob("*.md")):
    expected_id = path.stem
    fields = parse_header(path)
    missing = [field for field in required_fields if len(fields.get(field, [])) == 0]
    duplicate = [field for field in required_fields if len(fields.get(field, [])) > 1]

    if missing:
        fail(f"malformed task file: {path} missing {' '.join(missing)}")
    if duplicate:
        fail(f"malformed task file: {path} duplicate {' '.join(duplicate)}")

    task_id = fields["id"][0]
    title = fields["title"][0]
    status = fields["status"][0]

    if task_id != expected_id:
        fail(f"malformed task file: {path} filename/id mismatch ({expected_id} != {task_id})")
    if status not in {"todo", "doing", "done"}:
        fail(f"malformed task file: {path} invalid status {status}")
    if should_list_task(status, task_id):
        print(f"{status}\t{task_id}\t{title.replace(chr(9), ' ')}")
PY
}

cmd_start() {
  local file current lock_file
  file="$(require_task "$1")"
  ensure_task_lock_dir
  lock_file="$(task_lock_file "$file")"
  acquire_lock "$lock_file"
  validate_task_for_update "$file"
  current="$(get_field "$file" status)"
  if [[ "$current" == "done" ]]; then
    release_lock "$lock_file"
    echo "task already done: $1" >&2
    exit 1
  fi
  if [[ "$current" == "doing" ]]; then
    release_lock "$lock_file"
    echo "task already doing: $1" >&2
    exit 1
  fi
  if [[ -n "${CODEX_WORKFLOW_TEST_UPDATE_PAUSE_BEFORE_WRITE:-}" ]]; then
    sleep "$CODEX_WORKFLOW_TEST_UPDATE_PAUSE_BEFORE_WRITE"
  fi
  update_status "$file" "doing"
  release_lock "$lock_file"
  sync_task_runtime "$1"
  write_current_task_pointer "$1"
  append_task_runtime_event "$1" "task-status" "started"
  sync_codex_memory
}

cmd_done() {
  local task_id="$1"
  shift
  local file current lock_file no_verify_reason no_verify_requested no_verify_at
  no_verify_reason=""
  no_verify_requested="0"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --no-verify)
        [[ $# -ge 2 ]] || { echo 'usage: codex-workflow done <task-id> [--no-verify "<reason>"]' >&2; exit 1; }
        no_verify_reason="$2"
        no_verify_requested="1"
        shift 2
        ;;
      --no-verify=*)
        no_verify_reason="${1#--no-verify=}"
        no_verify_requested="1"
        shift
        ;;
      *)
        echo 'usage: codex-workflow done <task-id> [--no-verify "<reason>"]' >&2
        exit 1
        ;;
    esac
  done

  if [[ "$no_verify_requested" == "1" ]]; then
    validate_no_verify_reason "$no_verify_reason"
  fi

  file="$(require_task "$task_id")"
  ensure_task_lock_dir
  lock_file="$(task_lock_file "$file")"
  acquire_lock "$lock_file"
  validate_task_for_update "$file"
  current="$(get_field "$file" status)"
  if [[ "$current" == "done" ]]; then
    release_lock "$lock_file"
    echo "task already done: $task_id" >&2
    exit 1
  fi
  if [[ "$current" != "doing" ]]; then
    release_lock "$lock_file"
    echo "task must be doing before done: $task_id" >&2
    exit 1
  fi

  write_task_state_json "$task_id"
  if [[ "$no_verify_requested" != "1" ]] && ! task_has_successful_verification "$task_id"; then
    release_lock "$lock_file"
    echo "task lacks successful workflow verification: $task_id" >&2
    echo "run: codex-workflow verify $task_id -- <command...>" >&2
    echo 'or explicitly skip with: codex-workflow done <task-id> --no-verify "<reason>"' >&2
    exit 1
  fi

  if [[ -n "${CODEX_WORKFLOW_TEST_UPDATE_PAUSE_BEFORE_WRITE:-}" ]]; then
    sleep "$CODEX_WORKFLOW_TEST_UPDATE_PAUSE_BEFORE_WRITE"
  fi

  if [[ "$no_verify_requested" == "1" ]]; then
    no_verify_at="$(timestamp_utc)"
    upsert_task_fields "$file" "no_verify_reason=$no_verify_reason" "no_verify_at=$no_verify_at"
  fi

  update_status "$file" "done"
  release_lock "$lock_file"
  sync_task_runtime "$task_id"
  if [[ "$no_verify_requested" == "1" ]]; then
    set_task_state_fields "$task_id" \
      "verification.skipped=__TRUE__" \
      "verification.skip_reason=$no_verify_reason" \
      "verification.skipped_at=$no_verify_at"
    append_task_runtime_event "$task_id" "verify-skip" "$no_verify_reason"
  fi
  clear_current_task_pointer "$task_id"
  append_task_runtime_event "$task_id" "task-status" "done"
  sync_codex_memory
}

cmd_show() {
  local file
  file="$(require_task "$1")"
  validate_task_for_update "$file"
  cat "$file"
}

cmd_ready() {
  local task_id="$1"
  shift
  local file requirements skip_reason skip_requested checked_at result status issue_summary path_summary
  requirements="context,spec,analysis"
  skip_reason=""
  skip_requested="0"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --require)
        [[ $# -ge 2 ]] || { echo 'usage: codex-workflow ready <task-id> [--require context,spec,analysis[,decision]] [--skip "<reason>"]' >&2; exit 1; }
        requirements="$2"
        shift 2
        ;;
      --require=*)
        requirements="${1#--require=}"
        shift
        ;;
      --skip)
        [[ $# -ge 2 ]] || { echo 'usage: codex-workflow ready <task-id> [--require context,spec,analysis[,decision]] [--skip "<reason>"]' >&2; exit 1; }
        skip_reason="$2"
        skip_requested="1"
        shift 2
        ;;
      --skip=*)
        skip_reason="${1#--skip=}"
        skip_requested="1"
        shift
        ;;
      *)
        echo 'usage: codex-workflow ready <task-id> [--require context,spec,analysis[,decision]] [--skip "<reason>"]' >&2
        exit 1
        ;;
    esac
  done

  requirements="$(printf '%s' "$requirements" | tr -d '[:space:]')"
  if [[ -z "$requirements" ]]; then
    echo "invalid readiness requirements: empty" >&2
    exit 1
  fi
  if [[ "$skip_requested" == "1" ]]; then
    validate_readiness_skip_reason "$skip_reason"
  fi

  file="$(require_task "$task_id")"
  validate_task_for_update "$file"
  sync_task_runtime "$task_id"
  checked_at="$(timestamp_utc)"

  if [[ "$skip_requested" == "1" ]]; then
    upsert_task_fields "$file" \
      "readiness_status=skipped" \
      "readiness_checked_at=$checked_at" \
      "readiness_requirements=$requirements" \
      "readiness_issues=-" \
      "readiness_skip_reason=$skip_reason"
    write_task_state_json "$task_id"
    set_task_state_fields "$task_id" \
      "readiness.status=skipped" \
      "readiness.checked_at=$checked_at" \
      "readiness.requirements=$requirements" \
      "readiness.issues=-" \
      "readiness.skip_reason=$skip_reason"
    append_task_runtime_event "$task_id" "readiness-skip" "$requirements: $skip_reason"
    printf 'task_id: %s\n' "$task_id"
    printf 'status: skipped\n'
    printf 'requirements: %s\n' "$requirements"
    printf 'reason: %s\n' "$skip_reason"
    return 0
  fi

  result="$(evaluate_task_readiness "$task_id" "$requirements")"
  IFS=$'\t' read -r status issue_summary path_summary <<<"$result"
  upsert_task_fields "$file" \
    "readiness_status=$status" \
    "readiness_checked_at=$checked_at" \
    "readiness_requirements=$requirements" \
    "readiness_issues=$issue_summary" \
    "readiness_paths=$path_summary" \
    "readiness_skip_reason=-"
  write_task_state_json "$task_id"
  set_task_state_fields "$task_id" \
    "readiness.status=$status" \
    "readiness.checked_at=$checked_at" \
    "readiness.requirements=$requirements" \
    "readiness.issues=$issue_summary" \
    "readiness.paths=$path_summary" \
    "readiness.skip_reason=-"
  append_task_runtime_event "$task_id" "readiness" "$status $requirements $issue_summary"
  printf 'task_id: %s\n' "$task_id"
  printf 'status: %s\n' "$status"
  printf 'requirements: %s\n' "$requirements"
  printf 'issues: %s\n' "$issue_summary"
  printf 'paths: %s\n' "$path_summary"
  if [[ "$status" != "ready" ]]; then
    exit 1
  fi
}

cmd_handoff_envelope() {
  local task_id="$1"
  shift
  local prd_path repo_path base_branch title packet_path generated_at metadata
  local envelope_path prd_abs prd_sha repo_abs repo_sha packet_abs acceptance_count validation_count envelope_rel packet_value
  local acceptance_rows=()
  local validation_rows=()
  prd_path=""
  repo_path=""
  base_branch=""
  title=""
  packet_path=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --prd)
        [[ $# -ge 2 ]] || { echo 'usage: codex-workflow handoff-envelope <task-id> --prd <file> --repo <path> --base <branch> [--title "<title>"] [--packet <file>] --acceptance "<id>|<requirement>|<required|advisory>" --validation "<id>|<surface>|<required|advisory>|<evidence>"' >&2; exit 1; }
        prd_path="$2"
        shift 2
        ;;
      --prd=*)
        prd_path="${1#--prd=}"
        shift
        ;;
      --repo)
        [[ $# -ge 2 ]] || { echo 'usage: codex-workflow handoff-envelope <task-id> --prd <file> --repo <path> --base <branch> [--title "<title>"] [--packet <file>] --acceptance "<id>|<requirement>|<required|advisory>" --validation "<id>|<surface>|<required|advisory>|<evidence>"' >&2; exit 1; }
        repo_path="$2"
        shift 2
        ;;
      --repo=*)
        repo_path="${1#--repo=}"
        shift
        ;;
      --base)
        [[ $# -ge 2 ]] || { echo 'usage: codex-workflow handoff-envelope <task-id> --prd <file> --repo <path> --base <branch> [--title "<title>"] [--packet <file>] --acceptance "<id>|<requirement>|<required|advisory>" --validation "<id>|<surface>|<required|advisory>|<evidence>"' >&2; exit 1; }
        base_branch="$2"
        shift 2
        ;;
      --base=*)
        base_branch="${1#--base=}"
        shift
        ;;
      --title)
        [[ $# -ge 2 ]] || { echo 'usage: codex-workflow handoff-envelope <task-id> --prd <file> --repo <path> --base <branch> [--title "<title>"] [--packet <file>] --acceptance "<id>|<requirement>|<required|advisory>" --validation "<id>|<surface>|<required|advisory>|<evidence>"' >&2; exit 1; }
        title="$2"
        shift 2
        ;;
      --title=*)
        title="${1#--title=}"
        shift
        ;;
      --packet)
        [[ $# -ge 2 ]] || { echo 'usage: codex-workflow handoff-envelope <task-id> --prd <file> --repo <path> --base <branch> [--title "<title>"] [--packet <file>] --acceptance "<id>|<requirement>|<required|advisory>" --validation "<id>|<surface>|<required|advisory>|<evidence>"' >&2; exit 1; }
        packet_path="$2"
        shift 2
        ;;
      --packet=*)
        packet_path="${1#--packet=}"
        shift
        ;;
      --acceptance)
        [[ $# -ge 2 ]] || { echo 'usage: codex-workflow handoff-envelope <task-id> --prd <file> --repo <path> --base <branch> [--title "<title>"] [--packet <file>] --acceptance "<id>|<requirement>|<required|advisory>" --validation "<id>|<surface>|<required|advisory>|<evidence>"' >&2; exit 1; }
        acceptance_rows+=("$2")
        shift 2
        ;;
      --acceptance=*)
        acceptance_rows+=("${1#--acceptance=}")
        shift
        ;;
      --validation)
        [[ $# -ge 2 ]] || { echo 'usage: codex-workflow handoff-envelope <task-id> --prd <file> --repo <path> --base <branch> [--title "<title>"] [--packet <file>] --acceptance "<id>|<requirement>|<required|advisory>" --validation "<id>|<surface>|<required|advisory>|<evidence>"' >&2; exit 1; }
        validation_rows+=("$2")
        shift 2
        ;;
      --validation=*)
        validation_rows+=("${1#--validation=}")
        shift
        ;;
      *)
        echo 'usage: codex-workflow handoff-envelope <task-id> --prd <file> --repo <path> --base <branch> [--title "<title>"] [--packet <file>] --acceptance "<id>|<requirement>|<required|advisory>" --validation "<id>|<surface>|<required|advisory>|<evidence>"' >&2
        exit 1
        ;;
    esac
  done

  [[ -n "$prd_path" ]] || { echo "missing required argument: --prd" >&2; exit 1; }
  [[ -n "$repo_path" ]] || { echo "missing required argument: --repo" >&2; exit 1; }
  [[ -n "$base_branch" ]] || { echo "missing required argument: --base" >&2; exit 1; }

  require_task "$task_id" >/dev/null
  sync_task_runtime "$task_id"
  generated_at="$(timestamp_utc)"
  metadata="$(write_handoff_envelope "$task_id" "$prd_path" "$repo_path" "$base_branch" "$title" "$packet_path" "$generated_at" "${#acceptance_rows[@]}" "${acceptance_rows[@]}" "${#validation_rows[@]}" "${validation_rows[@]}")"
  IFS=$'\t' read -r envelope_path prd_abs prd_sha repo_abs base_branch repo_sha packet_abs acceptance_count validation_count title <<<"$metadata"
  envelope_rel="$(path_relative_to_codex_home "$envelope_path")"
  packet_value="$packet_abs"
  if [[ "$packet_abs" != "-" ]]; then
    packet_value="$(path_relative_to_codex_home "$packet_abs")"
  fi

  upsert_task_fields "$(require_task "$task_id")" \
    "handoff_envelope=$envelope_rel" \
    "handoff_generated_at=$generated_at" \
    "handoff_prd_path=$prd_abs" \
    "handoff_prd_sha256=$prd_sha" \
    "handoff_repo=$repo_abs" \
    "handoff_base=$base_branch" \
    "handoff_repo_sha=$repo_sha" \
    "handoff_packet=$packet_value" \
    "handoff_acceptance_rows=$acceptance_count" \
    "handoff_validation_rows=$validation_count"
  write_task_state_json "$task_id"
  set_task_state_fields "$task_id" \
    "handoff.envelope=$envelope_rel" \
    "handoff.generated_at=$generated_at" \
    "handoff.prd_path=$prd_abs" \
    "handoff.prd_sha256=$prd_sha" \
    "handoff.repo=$repo_abs" \
    "handoff.base=$base_branch" \
    "handoff.repo_sha=$repo_sha" \
    "handoff.packet=$packet_value" \
    "handoff.acceptance_rows=$acceptance_count" \
    "handoff.validation_rows=$validation_count"
  append_task_runtime_event "$task_id" "handoff-envelope" "$envelope_rel"
  printf 'task_id: %s\n' "$task_id"
  printf 'envelope: %s\n' "$envelope_path"
  printf 'prd_sha256: %s\n' "$prd_sha"
  printf 'repo: %s\n' "$repo_abs"
  printf 'base: %s\n' "$base_branch"
  printf 'acceptance_rows: %s\n' "$acceptance_count"
  printf 'validation_rows: %s\n' "$validation_count"
  printf 'packet: %s\n' "$packet_value"
}

cmd_result_ingest() {
  local task_id="$1"
  shift
  local issue outcome draft_pr blocker commit_sha worktree summary ingested_at metadata
  local result_path result_rel evidence_count lesson_count evidence_joined lessons_joined
  local evidence_items=()
  local lesson_items=()
  issue=""
  outcome=""
  draft_pr=""
  blocker=""
  commit_sha=""
  worktree=""
  summary=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --issue)
        [[ $# -ge 2 ]] || { echo 'usage: codex-workflow result-ingest <task-id> --issue <url-or-id> --outcome draft-pr|blocker --commit <sha-or-unknown> --worktree <path-or-none> --evidence <path-or-url> [--draft-pr <url>] [--blocker <path-or-url>] [--summary "<summary>"] [--lesson "<candidate>"]' >&2; exit 1; }
        issue="$2"
        shift 2
        ;;
      --issue=*)
        issue="${1#--issue=}"
        shift
        ;;
      --outcome)
        [[ $# -ge 2 ]] || { echo 'usage: codex-workflow result-ingest <task-id> --issue <url-or-id> --outcome draft-pr|blocker --commit <sha-or-unknown> --worktree <path-or-none> --evidence <path-or-url> [--draft-pr <url>] [--blocker <path-or-url>] [--summary "<summary>"] [--lesson "<candidate>"]' >&2; exit 1; }
        outcome="$2"
        shift 2
        ;;
      --outcome=*)
        outcome="${1#--outcome=}"
        shift
        ;;
      --draft-pr)
        [[ $# -ge 2 ]] || { echo 'usage: codex-workflow result-ingest <task-id> --issue <url-or-id> --outcome draft-pr|blocker --commit <sha-or-unknown> --worktree <path-or-none> --evidence <path-or-url> [--draft-pr <url>] [--blocker <path-or-url>] [--summary "<summary>"] [--lesson "<candidate>"]' >&2; exit 1; }
        draft_pr="$2"
        shift 2
        ;;
      --draft-pr=*)
        draft_pr="${1#--draft-pr=}"
        shift
        ;;
      --blocker)
        [[ $# -ge 2 ]] || { echo 'usage: codex-workflow result-ingest <task-id> --issue <url-or-id> --outcome draft-pr|blocker --commit <sha-or-unknown> --worktree <path-or-none> --evidence <path-or-url> [--draft-pr <url>] [--blocker <path-or-url>] [--summary "<summary>"] [--lesson "<candidate>"]' >&2; exit 1; }
        blocker="$2"
        shift 2
        ;;
      --blocker=*)
        blocker="${1#--blocker=}"
        shift
        ;;
      --commit)
        [[ $# -ge 2 ]] || { echo 'usage: codex-workflow result-ingest <task-id> --issue <url-or-id> --outcome draft-pr|blocker --commit <sha-or-unknown> --worktree <path-or-none> --evidence <path-or-url> [--draft-pr <url>] [--blocker <path-or-url>] [--summary "<summary>"] [--lesson "<candidate>"]' >&2; exit 1; }
        commit_sha="$2"
        shift 2
        ;;
      --commit=*)
        commit_sha="${1#--commit=}"
        shift
        ;;
      --worktree)
        [[ $# -ge 2 ]] || { echo 'usage: codex-workflow result-ingest <task-id> --issue <url-or-id> --outcome draft-pr|blocker --commit <sha-or-unknown> --worktree <path-or-none> --evidence <path-or-url> [--draft-pr <url>] [--blocker <path-or-url>] [--summary "<summary>"] [--lesson "<candidate>"]' >&2; exit 1; }
        worktree="$2"
        shift 2
        ;;
      --worktree=*)
        worktree="${1#--worktree=}"
        shift
        ;;
      --evidence)
        [[ $# -ge 2 ]] || { echo 'usage: codex-workflow result-ingest <task-id> --issue <url-or-id> --outcome draft-pr|blocker --commit <sha-or-unknown> --worktree <path-or-none> --evidence <path-or-url> [--draft-pr <url>] [--blocker <path-or-url>] [--summary "<summary>"] [--lesson "<candidate>"]' >&2; exit 1; }
        evidence_items+=("$2")
        shift 2
        ;;
      --evidence=*)
        evidence_items+=("${1#--evidence=}")
        shift
        ;;
      --summary)
        [[ $# -ge 2 ]] || { echo 'usage: codex-workflow result-ingest <task-id> --issue <url-or-id> --outcome draft-pr|blocker --commit <sha-or-unknown> --worktree <path-or-none> --evidence <path-or-url> [--draft-pr <url>] [--blocker <path-or-url>] [--summary "<summary>"] [--lesson "<candidate>"]' >&2; exit 1; }
        summary="$2"
        shift 2
        ;;
      --summary=*)
        summary="${1#--summary=}"
        shift
        ;;
      --lesson)
        [[ $# -ge 2 ]] || { echo 'usage: codex-workflow result-ingest <task-id> --issue <url-or-id> --outcome draft-pr|blocker --commit <sha-or-unknown> --worktree <path-or-none> --evidence <path-or-url> [--draft-pr <url>] [--blocker <path-or-url>] [--summary "<summary>"] [--lesson "<candidate>"]' >&2; exit 1; }
        lesson_items+=("$2")
        shift 2
        ;;
      --lesson=*)
        lesson_items+=("${1#--lesson=}")
        shift
        ;;
      *)
        echo 'usage: codex-workflow result-ingest <task-id> --issue <url-or-id> --outcome draft-pr|blocker --commit <sha-or-unknown> --worktree <path-or-none> --evidence <path-or-url> [--draft-pr <url>] [--blocker <path-or-url>] [--summary "<summary>"] [--lesson "<candidate>"]' >&2
        exit 1
        ;;
    esac
  done

  [[ -n "$issue" ]] || { echo "missing required argument: --issue" >&2; exit 1; }
  [[ -n "$outcome" ]] || { echo "missing required argument: --outcome" >&2; exit 1; }
  [[ -n "$commit_sha" ]] || { echo "missing required argument: --commit" >&2; exit 1; }
  [[ -n "$worktree" ]] || { echo "missing required argument: --worktree" >&2; exit 1; }

  require_task "$task_id" >/dev/null
  sync_task_runtime "$task_id"
  ingested_at="$(timestamp_utc)"
  metadata="$(write_result_ingest "$task_id" "$issue" "$outcome" "$draft_pr" "$blocker" "$commit_sha" "$worktree" "$summary" "$ingested_at" "${#evidence_items[@]}" "${evidence_items[@]}" "${#lesson_items[@]}" "${lesson_items[@]}")"
  IFS=$'\t' read -r result_path issue outcome draft_pr blocker commit_sha worktree evidence_count lesson_count summary evidence_joined lessons_joined <<<"$metadata"
  result_rel="$(path_relative_to_codex_home "$result_path")"

  upsert_task_fields "$(require_task "$task_id")" \
    "result_ingest=$result_rel" \
    "result_ingested_at=$ingested_at" \
    "result_issue=$issue" \
    "result_outcome=$outcome" \
    "result_draft_pr=$draft_pr" \
    "result_blocker=$blocker" \
    "result_commit=$commit_sha" \
    "result_worktree=$worktree" \
    "result_evidence_count=$evidence_count" \
    "result_lesson_candidates=$lesson_count"
  write_task_state_json "$task_id"
  set_task_state_fields "$task_id" \
    "result.artifact=$result_rel" \
    "result.ingested_at=$ingested_at" \
    "result.issue=$issue" \
    "result.outcome=$outcome" \
    "result.draft_pr=$draft_pr" \
    "result.blocker=$blocker" \
    "result.commit=$commit_sha" \
    "result.worktree=$worktree" \
    "result.evidence_count=$evidence_count" \
    "result.lesson_candidates=$lesson_count" \
    "result.summary=$summary" \
    "result.evidence=$evidence_joined" \
    "result.lessons=$lessons_joined"
  append_task_runtime_event "$task_id" "result-ingest" "$outcome $result_rel"
  printf 'task_id: %s\n' "$task_id"
  printf 'artifact: %s\n' "$result_path"
  printf 'issue: %s\n' "$issue"
  printf 'outcome: %s\n' "$outcome"
  printf 'draft_pr: %s\n' "$draft_pr"
  printf 'blocker: %s\n' "$blocker"
  printf 'commit: %s\n' "$commit_sha"
  printf 'worktree: %s\n' "$worktree"
  printf 'evidence_count: %s\n' "$evidence_count"
  printf 'lesson_candidates: %s\n' "$lesson_count"
}

route_decision_usage() {
  echo 'usage: codex-workflow route-decision <task-id> --intent <office-hours|brainstorm|intake|analyze|clarify|task|team|multica-handoff> --risk <low|medium|high> --decision <use|skip> --reason "<reason>" [--next <skill-or-command>] [--assumption "<assumption>"]... [--consensus] [--consensus-source <file>]' >&2
}

cmd_route_decision() {
  local task_id="$1"
  if [[ "$task_id" == "-h" || "$task_id" == "--help" || "$task_id" == "help" ]]; then
    route_decision_usage
    return 0
  fi
  shift
  local intent risk route_action reason next_step consensus_requested consensus_source recorded_at metadata
  local route_path consensus_path route_rel consensus_value assumption_count task_file
  local assumptions=()
  intent=""
  risk=""
  route_action=""
  reason=""
  next_step=""
  consensus_requested="0"
  consensus_source=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --intent)
        [[ $# -ge 2 ]] || { route_decision_usage; exit 1; }
        intent="$2"
        shift 2
        ;;
      --intent=*)
        intent="${1#--intent=}"
        shift
        ;;
      --layer)
        [[ $# -ge 2 ]] || { route_decision_usage; exit 1; }
        intent="$2"
        shift 2
        ;;
      --layer=*)
        intent="${1#--layer=}"
        shift
        ;;
      --risk)
        [[ $# -ge 2 ]] || { route_decision_usage; exit 1; }
        risk="$2"
        shift 2
        ;;
      --risk=*)
        risk="${1#--risk=}"
        shift
        ;;
      --decision)
        [[ $# -ge 2 ]] || { route_decision_usage; exit 1; }
        route_action="$2"
        shift 2
        ;;
      --decision=*)
        route_action="${1#--decision=}"
        shift
        ;;
      --reason)
        [[ $# -ge 2 ]] || { route_decision_usage; exit 1; }
        reason="$2"
        shift 2
        ;;
      --reason=*)
        reason="${1#--reason=}"
        shift
        ;;
      --next)
        [[ $# -ge 2 ]] || { route_decision_usage; exit 1; }
        next_step="$2"
        shift 2
        ;;
      --next=*)
        next_step="${1#--next=}"
        shift
        ;;
      --assumption)
        [[ $# -ge 2 ]] || { route_decision_usage; exit 1; }
        assumptions+=("$2")
        shift 2
        ;;
      --assumption=*)
        assumptions+=("${1#--assumption=}")
        shift
        ;;
      --consensus)
        consensus_requested="1"
        shift
        ;;
      --consensus-source)
        [[ $# -ge 2 ]] || { route_decision_usage; exit 1; }
        consensus_source="$2"
        shift 2
        ;;
      --consensus-source=*)
        consensus_source="${1#--consensus-source=}"
        shift
        ;;
      *)
        route_decision_usage
        exit 1
        ;;
    esac
  done

  [[ -n "$intent" ]] || { echo "missing required argument: --intent" >&2; exit 1; }
  [[ -n "$risk" ]] || { echo "missing required argument: --risk" >&2; exit 1; }
  [[ -n "$route_action" ]] || { echo "missing required argument: --decision" >&2; exit 1; }
  [[ -n "$reason" ]] || { echo "missing required argument: --reason" >&2; exit 1; }
  if [[ -n "$consensus_source" && "$consensus_requested" != "1" ]]; then
    echo "--consensus-source requires --consensus" >&2
    exit 1
  fi

  task_file="$(task_file "$task_id")"
  if [[ ! -f "$task_file" ]]; then
    echo "unknown route-decision task id: $task_id" >&2
    echo "route-decision records against an Atlas workflow task, not an external issue key or temporary handoff name." >&2
    echo "create one first with: codex-workflow init-task \"<title>\" \"<done condition>\" && codex-workflow start <task-id>" >&2
    exit 1
  fi
  sync_task_runtime "$task_id"
  recorded_at="$(timestamp_utc)"
  metadata="$(write_route_decision "$task_id" "$intent" "$risk" "$route_action" "$reason" "$next_step" "$consensus_requested" "$consensus_source" "$recorded_at" "${#assumptions[@]}" "${assumptions[@]}")"
  IFS=$'\t' read -r route_path consensus_path intent risk route_action next_step assumption_count reason <<<"$metadata"
  route_rel="$(path_relative_to_codex_home "$route_path")"
  consensus_value="$consensus_path"
  if [[ "$consensus_path" != "-" ]]; then
    consensus_value="$(path_relative_to_codex_home "$(task_consensus_plan_file "$task_id")")"
  fi

  upsert_task_fields "$(require_task "$task_id")" \
    "route_decision=$route_rel" \
    "route_recorded_at=$recorded_at" \
    "route_intent=$intent" \
    "route_risk=$risk" \
    "route_action=$route_action" \
    "route_reason=$reason" \
    "route_next=$next_step" \
    "route_consensus=$consensus_value" \
    "route_assumptions=$assumption_count"
  write_task_state_json "$task_id"
  set_task_state_fields "$task_id" \
    "route.decision=$route_rel" \
    "route.recorded_at=$recorded_at" \
    "route.intent=$intent" \
    "route.risk=$risk" \
    "route.action=$route_action" \
    "route.reason=$reason" \
    "route.next=$next_step" \
    "route.consensus=$consensus_value" \
    "route.assumptions_count=$assumption_count"
  append_task_runtime_event "$task_id" "route-decision" "$intent $risk $route_action: $reason"
  printf 'task_id: %s\n' "$task_id"
  printf 'artifact: %s\n' "$route_path"
  printf 'intent: %s\n' "$intent"
  printf 'risk: %s\n' "$risk"
  printf 'decision: %s\n' "$route_action"
  printf 'next: %s\n' "$next_step"
  printf 'assumptions: %s\n' "$assumption_count"
  printf 'consensus: %s\n' "$consensus_value"
}

cmd_curated_packet() {
  if [[ $# -ge 2 && ( "$1" == "--lint" || "$1" == "--lint="* ) ]]; then
    local lint_file lint_result lint_status lint_path lint_lines lint_task lint_prd_sha
    if [[ "$1" == "--lint" ]]; then
      [[ $# -eq 2 ]] || { echo 'usage: codex-workflow curated-packet --lint <file>' >&2; exit 1; }
      lint_file="$2"
    else
      [[ $# -eq 1 ]] || { echo 'usage: codex-workflow curated-packet --lint <file>' >&2; exit 1; }
      lint_file="${1#--lint=}"
    fi
    lint_result="$(lint_curated_packet_file "$lint_file")"
    IFS=$'\t' read -r lint_status lint_path lint_lines lint_task lint_prd_sha <<<"$lint_result"
    printf 'packet: %s\n' "$lint_path"
    printf 'status: %s\n' "$lint_status"
    printf 'lines: %s\n' "$lint_lines"
    printf 'atlas_task_id: %s\n' "$lint_task"
    printf 'prd_sha256: %s\n' "$lint_prd_sha"
    return 0
  fi

  local task_id="$1"
  shift
  local prd_path repo_path base_branch skip_reason skip_requested generated_at metadata lint_result
  local packet_path packet_rel prd_abs prd_sha repo_abs source_count packet_lines
  local source_paths=()
  prd_path=""
  repo_path=""
  base_branch=""
  skip_reason=""
  skip_requested="0"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --prd)
        [[ $# -ge 2 ]] || { echo 'usage: codex-workflow curated-packet <task-id> --prd <file> --repo <path> --base <branch> --source <file>... [--skip "<reason>"]' >&2; exit 1; }
        prd_path="$2"
        shift 2
        ;;
      --prd=*)
        prd_path="${1#--prd=}"
        shift
        ;;
      --repo)
        [[ $# -ge 2 ]] || { echo 'usage: codex-workflow curated-packet <task-id> --prd <file> --repo <path> --base <branch> --source <file>... [--skip "<reason>"]' >&2; exit 1; }
        repo_path="$2"
        shift 2
        ;;
      --repo=*)
        repo_path="${1#--repo=}"
        shift
        ;;
      --base)
        [[ $# -ge 2 ]] || { echo 'usage: codex-workflow curated-packet <task-id> --prd <file> --repo <path> --base <branch> --source <file>... [--skip "<reason>"]' >&2; exit 1; }
        base_branch="$2"
        shift 2
        ;;
      --base=*)
        base_branch="${1#--base=}"
        shift
        ;;
      --source)
        [[ $# -ge 2 ]] || { echo 'usage: codex-workflow curated-packet <task-id> --prd <file> --repo <path> --base <branch> --source <file>... [--skip "<reason>"]' >&2; exit 1; }
        source_paths+=("$2")
        shift 2
        ;;
      --source=*)
        source_paths+=("${1#--source=}")
        shift
        ;;
      --skip)
        [[ $# -ge 2 ]] || { echo 'usage: codex-workflow curated-packet <task-id> --prd <file> --repo <path> --base <branch> --source <file>... [--skip "<reason>"]' >&2; exit 1; }
        skip_reason="$2"
        skip_requested="1"
        shift 2
        ;;
      --skip=*)
        skip_reason="${1#--skip=}"
        skip_requested="1"
        shift
        ;;
      *)
        echo 'usage: codex-workflow curated-packet <task-id> --prd <file> --repo <path> --base <branch> --source <file>... [--skip "<reason>"]' >&2
        exit 1
        ;;
    esac
  done

  require_task "$task_id" >/dev/null
  sync_task_runtime "$task_id"

  if [[ "$skip_requested" == "1" ]]; then
    validate_single_line_reason "curated packet skip reason" "$skip_reason"
    generated_at="$(timestamp_utc)"
    upsert_task_fields "$(require_task "$task_id")" \
      "packet_status=skipped" \
      "packet_skipped_at=$generated_at" \
      "packet_skip_reason=$skip_reason"
    write_task_state_json "$task_id"
    set_task_state_fields "$task_id" \
      "packet.status=skipped" \
      "packet.skipped_at=$generated_at" \
      "packet.skip_reason=$skip_reason"
    append_task_runtime_event "$task_id" "curated-packet-skip" "$skip_reason"
    printf 'task_id: %s\n' "$task_id"
    printf 'status: skipped\n'
    printf 'reason: %s\n' "$skip_reason"
    return 0
  fi

  [[ -n "$prd_path" ]] || { echo "missing required argument: --prd" >&2; exit 1; }
  [[ -n "$repo_path" ]] || { echo "missing required argument: --repo" >&2; exit 1; }
  [[ -n "$base_branch" ]] || { echo "missing required argument: --base" >&2; exit 1; }
  [[ "${#source_paths[@]}" -gt 0 ]] || { echo "missing required argument: --source" >&2; exit 1; }

  generated_at="$(timestamp_utc)"
  metadata="$(write_curated_packet "$task_id" "$prd_path" "$repo_path" "$base_branch" "$generated_at" "${#source_paths[@]}" "${source_paths[@]}")"
  IFS=$'\t' read -r packet_path prd_abs prd_sha repo_abs base_branch source_count packet_lines <<<"$metadata"
  lint_result="$(lint_curated_packet_file "$packet_path")"
  packet_rel="$(path_relative_to_codex_home "$packet_path")"

  upsert_task_fields "$(require_task "$task_id")" \
    "packet_status=generated" \
    "packet_file=$packet_rel" \
    "packet_generated_at=$generated_at" \
    "packet_prd_path=$prd_abs" \
    "packet_prd_sha256=$prd_sha" \
    "packet_repo=$repo_abs" \
    "packet_base=$base_branch" \
    "packet_sources=$source_count" \
    "packet_lines=$packet_lines" \
    "packet_skip_reason=-"
  write_task_state_json "$task_id"
  set_task_state_fields "$task_id" \
    "packet.status=generated" \
    "packet.file=$packet_rel" \
    "packet.generated_at=$generated_at" \
    "packet.prd_path=$prd_abs" \
    "packet.prd_sha256=$prd_sha" \
    "packet.repo=$repo_abs" \
    "packet.base=$base_branch" \
    "packet.sources=$source_count" \
    "packet.lines=$packet_lines" \
    "packet.lint=passed"
  append_task_runtime_event "$task_id" "curated-packet" "$packet_rel"
  printf 'task_id: %s\n' "$task_id"
  printf 'packet: %s\n' "$packet_path"
  printf 'status: generated\n'
  printf 'lint: passed\n'
  printf 'prd_sha256: %s\n' "$prd_sha"
  printf 'sources: %s\n' "$source_count"
  printf 'lines: %s\n' "$packet_lines"
}

cmd_checkpoint() {
  local task_id="$1"
  shift
  local phase summary branch worktree compose_project runtime_target blocker recorded_at metadata
  local ledger_path lifecycle_path next_count
  local next_steps=()
  phase=""
  summary=""
  branch=""
  worktree=""
  compose_project=""
  runtime_target=""
  blocker=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --phase) [[ $# -ge 2 ]] || { echo 'usage: codex-workflow checkpoint <task-id> --phase <intake|plan|implement|verify|repair|handoff|blocked|done> --summary "<summary>" [--branch <name>] [--worktree <path>] [--compose-project <name>] [--runtime-target <target>] [--blocker <reason>] [--next <step>]...' >&2; exit 1; }; phase="$2"; shift 2 ;;
      --phase=*) phase="${1#--phase=}"; shift ;;
      --summary) [[ $# -ge 2 ]] || { echo 'usage: codex-workflow checkpoint <task-id> --phase <intake|plan|implement|verify|repair|handoff|blocked|done> --summary "<summary>" [--branch <name>] [--worktree <path>] [--compose-project <name>] [--runtime-target <target>] [--blocker <reason>] [--next <step>]...' >&2; exit 1; }; summary="$2"; shift 2 ;;
      --summary=*) summary="${1#--summary=}"; shift ;;
      --branch) [[ $# -ge 2 ]] || { echo 'usage: codex-workflow checkpoint <task-id> --phase <...> --summary "<summary>" [--branch <name>] [--worktree <path>] [--compose-project <name>] [--runtime-target <target>] [--blocker <reason>] [--next <step>]...' >&2; exit 1; }; branch="$2"; shift 2 ;;
      --branch=*) branch="${1#--branch=}"; shift ;;
      --worktree) [[ $# -ge 2 ]] || { echo 'usage: codex-workflow checkpoint <task-id> --phase <...> --summary "<summary>" [--branch <name>] [--worktree <path>] [--compose-project <name>] [--runtime-target <target>] [--blocker <reason>] [--next <step>]...' >&2; exit 1; }; worktree="$2"; shift 2 ;;
      --worktree=*) worktree="${1#--worktree=}"; shift ;;
      --compose-project) [[ $# -ge 2 ]] || { echo 'usage: codex-workflow checkpoint <task-id> --phase <...> --summary "<summary>" [--branch <name>] [--worktree <path>] [--compose-project <name>] [--runtime-target <target>] [--blocker <reason>] [--next <step>]...' >&2; exit 1; }; compose_project="$2"; shift 2 ;;
      --compose-project=*) compose_project="${1#--compose-project=}"; shift ;;
      --runtime-target) [[ $# -ge 2 ]] || { echo 'usage: codex-workflow checkpoint <task-id> --phase <...> --summary "<summary>" [--branch <name>] [--worktree <path>] [--compose-project <name>] [--runtime-target <target>] [--blocker <reason>] [--next <step>]...' >&2; exit 1; }; runtime_target="$2"; shift 2 ;;
      --runtime-target=*) runtime_target="${1#--runtime-target=}"; shift ;;
      --blocker) [[ $# -ge 2 ]] || { echo 'usage: codex-workflow checkpoint <task-id> --phase <...> --summary "<summary>" [--blocker <reason>]' >&2; exit 1; }; blocker="$2"; shift 2 ;;
      --blocker=*) blocker="${1#--blocker=}"; shift ;;
      --next) [[ $# -ge 2 ]] || { echo 'usage: codex-workflow checkpoint <task-id> --phase <...> --summary "<summary>" [--next <step>]...' >&2; exit 1; }; next_steps+=("$2"); shift 2 ;;
      --next=*) next_steps+=("${1#--next=}"); shift ;;
      *) echo 'usage: codex-workflow checkpoint <task-id> --phase <intake|plan|implement|verify|repair|handoff|blocked|done> --summary "<summary>" [--branch <name>] [--worktree <path>] [--compose-project <name>] [--runtime-target <target>] [--blocker <reason>] [--next <step>]...' >&2; exit 1 ;;
    esac
  done
  [[ -n "$phase" ]] || { echo "missing required argument: --phase" >&2; exit 1; }
  [[ -n "$summary" ]] || { echo "missing required argument: --summary" >&2; exit 1; }
  require_task "$task_id" >/dev/null
  sync_task_runtime "$task_id"
  recorded_at="$(timestamp_utc)"
  metadata="$(write_checkpoint_record "$task_id" "$phase" "$summary" "$branch" "$worktree" "$compose_project" "$runtime_target" "$blocker" "$recorded_at" "${#next_steps[@]}" "${next_steps[@]}")"
  IFS=$'\t' read -r ledger_path lifecycle_path phase summary branch worktree compose_project runtime_target blocker next_count <<<"$metadata"
  upsert_task_fields "$(require_task "$task_id")" "current_phase=$phase" "last_checkpoint=$recorded_at" "lifecycle=$(path_relative_to_codex_home "$lifecycle_path")"
  write_task_state_json "$task_id"
  set_task_state_fields "$task_id" \
    "current_phase=$phase" \
    "lifecycle_outcome=$phase" \
    "last_checkpoint=$recorded_at" \
    "branch=$branch" \
    "worktree=$worktree" \
    "compose_project=$compose_project" \
    "runtime_target=$runtime_target" \
    "checkpoint.summary=$summary" \
    "checkpoint.ledger=$(path_relative_to_codex_home "$ledger_path")" \
    "checkpoint.lifecycle=$(path_relative_to_codex_home "$lifecycle_path")"
  append_task_runtime_event "$task_id" "checkpoint" "$phase: $summary"
  printf 'task_id: %s\nledger: %s\nlifecycle: %s\nphase: %s\nnext_count: %s\n' "$task_id" "$ledger_path" "$lifecycle_path" "$phase" "$next_count"
}

cmd_source_snapshot() {
  local task_id="$1"
  shift
  local used_for authority freshness recorded_at metadata sources_path provenance_path count
  local sources=()
  used_for=""
  authority="advisory"
  freshness="unknown"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --source) [[ $# -ge 2 ]] || { echo 'usage: codex-workflow source-snapshot <task-id> --source <path-or-url> --used-for "<purpose>" [--authority canonical|advisory|background] [--freshness fresh|stale|unknown]' >&2; exit 1; }; sources+=("$2"); shift 2 ;;
      --source=*) sources+=("${1#--source=}"); shift ;;
      --used-for) [[ $# -ge 2 ]] || { echo 'usage: codex-workflow source-snapshot <task-id> --source <path-or-url> --used-for "<purpose>" [--authority canonical|advisory|background] [--freshness fresh|stale|unknown]' >&2; exit 1; }; used_for="$2"; shift 2 ;;
      --used-for=*) used_for="${1#--used-for=}"; shift ;;
      --authority) [[ $# -ge 2 ]] || { echo 'usage: codex-workflow source-snapshot <task-id> --source <path-or-url> --used-for "<purpose>" [--authority canonical|advisory|background] [--freshness fresh|stale|unknown]' >&2; exit 1; }; authority="$2"; shift 2 ;;
      --authority=*) authority="${1#--authority=}"; shift ;;
      --freshness) [[ $# -ge 2 ]] || { echo 'usage: codex-workflow source-snapshot <task-id> --source <path-or-url> --used-for "<purpose>" [--authority canonical|advisory|background] [--freshness fresh|stale|unknown]' >&2; exit 1; }; freshness="$2"; shift 2 ;;
      --freshness=*) freshness="${1#--freshness=}"; shift ;;
      *) echo 'usage: codex-workflow source-snapshot <task-id> --source <path-or-url> --used-for "<purpose>" [--authority canonical|advisory|background] [--freshness fresh|stale|unknown]' >&2; exit 1 ;;
    esac
  done
  [[ "${#sources[@]}" -gt 0 ]] || { echo "missing required argument: --source" >&2; exit 1; }
  [[ -n "$used_for" ]] || { echo "missing required argument: --used-for" >&2; exit 1; }
  require_task "$task_id" >/dev/null
  sync_task_runtime "$task_id"
  recorded_at="$(timestamp_utc)"
  metadata="$(write_source_snapshot "$task_id" "$used_for" "$authority" "$freshness" "$recorded_at" "${#sources[@]}" "${sources[@]}")"
  IFS=$'\t' read -r sources_path provenance_path count <<<"$metadata"
  upsert_task_fields "$(require_task "$task_id")" "sources=$(path_relative_to_codex_home "$sources_path")" "provenance=$(path_relative_to_codex_home "$provenance_path")" "source_snapshot_count=$count"
  write_task_state_json "$task_id"
  set_task_state_fields "$task_id" "provenance.sources=$(path_relative_to_codex_home "$sources_path")" "provenance.file=$(path_relative_to_codex_home "$provenance_path")" "provenance.last_source_count=$count"
  append_task_runtime_event "$task_id" "source-snapshot" "$count source(s): $used_for"
  printf 'task_id: %s\nsources: %s\nprovenance: %s\ncount: %s\n' "$task_id" "$sources_path" "$provenance_path" "$count"
}

cmd_prompt_bundle() {
  local task_id="$1"
  shift
  local bundle_id agent recorded_at metadata bundle_path provenance_path file_count skill_count
  local includes=()
  local skills=()
  bundle_id=""
  agent="atlas"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --include) [[ $# -ge 2 ]] || { echo 'usage: codex-workflow prompt-bundle <task-id> --include <path>... [--skill <name>]... [--agent atlas|multica|reviewer|e2e] [--bundle-id <id>]' >&2; exit 1; }; includes+=("$2"); shift 2 ;;
      --include=*) includes+=("${1#--include=}"); shift ;;
      --skill) [[ $# -ge 2 ]] || { echo 'usage: codex-workflow prompt-bundle <task-id> --include <path>... [--skill <name>]... [--agent atlas|multica|reviewer|e2e] [--bundle-id <id>]' >&2; exit 1; }; skills+=("$2"); shift 2 ;;
      --skill=*) skills+=("${1#--skill=}"); shift ;;
      --agent) [[ $# -ge 2 ]] || { echo 'usage: codex-workflow prompt-bundle <task-id> --include <path>... [--skill <name>]... [--agent atlas|multica|reviewer|e2e] [--bundle-id <id>]' >&2; exit 1; }; agent="$2"; shift 2 ;;
      --agent=*) agent="${1#--agent=}"; shift ;;
      --bundle-id) [[ $# -ge 2 ]] || { echo 'usage: codex-workflow prompt-bundle <task-id> --include <path>... [--skill <name>]... [--agent atlas|multica|reviewer|e2e] [--bundle-id <id>]' >&2; exit 1; }; bundle_id="$2"; shift 2 ;;
      --bundle-id=*) bundle_id="${1#--bundle-id=}"; shift ;;
      *) echo 'usage: codex-workflow prompt-bundle <task-id> --include <path>... [--skill <name>]... [--agent atlas|multica|reviewer|e2e] [--bundle-id <id>]' >&2; exit 1 ;;
    esac
  done
  [[ "${#includes[@]}" -gt 0 ]] || { echo "missing required argument: --include" >&2; exit 1; }
  require_task "$task_id" >/dev/null
  sync_task_runtime "$task_id"
  recorded_at="$(timestamp_utc)"
  metadata="$(write_prompt_bundle "$task_id" "$bundle_id" "$agent" "$recorded_at" "${#includes[@]}" "${includes[@]}" "${#skills[@]}" "${skills[@]}")"
  IFS=$'\t' read -r bundle_path provenance_path bundle_id agent file_count skill_count <<<"$metadata"
  upsert_task_fields "$(require_task "$task_id")" "prompt_bundle=$(path_relative_to_codex_home "$bundle_path")" "provenance=$(path_relative_to_codex_home "$provenance_path")" "prompt_bundle_id=$bundle_id"
  write_task_state_json "$task_id"
  set_task_state_fields "$task_id" "provenance.prompt_bundle=$(path_relative_to_codex_home "$bundle_path")" "provenance.file=$(path_relative_to_codex_home "$provenance_path")" "provenance.prompt_bundle_id=$bundle_id" "provenance.prompt_agent=$agent"
  append_task_runtime_event "$task_id" "prompt-bundle" "$bundle_id for $agent"
  printf 'task_id: %s\nbundle: %s\nprovenance: %s\nbundle_id: %s\nagent: %s\nfiles: %s\nskills: %s\n' "$task_id" "$bundle_path" "$provenance_path" "$bundle_id" "$agent" "$file_count" "$skill_count"
}

cmd_trace_promote() {
  local task_id="$1"
  shift
  local source_ref trace_type reason owner recorded_at metadata trace_path candidate_id source_path regression_path
  source_ref="latest"
  trace_type=""
  reason=""
  owner="atlas"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --from) [[ $# -ge 2 ]] || { echo 'usage: codex-workflow trace-promote <task-id> [--from latest|<verification-record>] --type regression|lesson|workflow-rule --reason "<reason>" [--owner atlas|multica|project]' >&2; exit 1; }; source_ref="$2"; shift 2 ;;
      --from=*) source_ref="${1#--from=}"; shift ;;
      --type) [[ $# -ge 2 ]] || { echo 'usage: codex-workflow trace-promote <task-id> [--from latest|<verification-record>] --type regression|lesson|workflow-rule --reason "<reason>" [--owner atlas|multica|project]' >&2; exit 1; }; trace_type="$2"; shift 2 ;;
      --type=*) trace_type="${1#--type=}"; shift ;;
      --reason) [[ $# -ge 2 ]] || { echo 'usage: codex-workflow trace-promote <task-id> [--from latest|<verification-record>] --type regression|lesson|workflow-rule --reason "<reason>" [--owner atlas|multica|project]' >&2; exit 1; }; reason="$2"; shift 2 ;;
      --reason=*) reason="${1#--reason=}"; shift ;;
      --owner) [[ $# -ge 2 ]] || { echo 'usage: codex-workflow trace-promote <task-id> [--from latest|<verification-record>] --type regression|lesson|workflow-rule --reason "<reason>" [--owner atlas|multica|project]' >&2; exit 1; }; owner="$2"; shift 2 ;;
      --owner=*) owner="${1#--owner=}"; shift ;;
      *) echo 'usage: codex-workflow trace-promote <task-id> [--from latest|<verification-record>] --type regression|lesson|workflow-rule --reason "<reason>" [--owner atlas|multica|project]' >&2; exit 1 ;;
    esac
  done
  [[ -n "$trace_type" ]] || { echo "missing required argument: --type" >&2; exit 1; }
  [[ -n "$reason" ]] || { echo "missing required argument: --reason" >&2; exit 1; }
  require_task "$task_id" >/dev/null
  sync_task_runtime "$task_id"
  recorded_at="$(timestamp_utc)"
  metadata="$(write_trace_promotion "$task_id" "$source_ref" "$trace_type" "$reason" "$owner" "$recorded_at")"
  IFS=$'\t' read -r trace_path candidate_id source_path trace_type owner regression_path <<<"$metadata"
  upsert_task_fields "$(require_task "$task_id")" "trace_candidates=$(path_relative_to_codex_home "$trace_path")" "latest_trace_candidate=$candidate_id"
  write_task_state_json "$task_id"
  set_task_state_fields "$task_id" "trace.candidates=$(path_relative_to_codex_home "$trace_path")" "trace.latest_candidate=$candidate_id" "trace.latest_source=$source_path" "trace.latest_type=$trace_type"
  append_task_runtime_event "$task_id" "trace-promote" "$candidate_id $trace_type"
  printf 'task_id: %s\nartifact: %s\ncandidate: %s\nsource: %s\ntype: %s\nowner: %s\nregression: %s\n' "$task_id" "$trace_path" "$candidate_id" "$source_path" "$trace_type" "$owner" "$regression_path"
}

cmd_multica_feedback() {
  local task_id="$1"
  shift
  local issue commit_sha round status evidence_manifest recorded_at metadata feedback_path feedback_json finding_count
  local reviews=()
  local e2es=()
  local scorecards=()
  local findings=()
  issue=""
  commit_sha=""
  round=""
  status=""
  evidence_manifest=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --issue) [[ $# -ge 2 ]] || { echo 'usage: codex-workflow multica-feedback <task-id> --issue <url-or-id> --commit <sha-or-unknown> --round <n> --status clean|repair-needed|blocked [--review <path-or-url>]... [--e2e <path-or-url>]... [--scorecard <path-or-url>]... [--evidence-manifest <path-or-url>] [--blocking-finding "<id|summary>"]...' >&2; exit 1; }; issue="$2"; shift 2 ;;
      --issue=*) issue="${1#--issue=}"; shift ;;
      --commit) [[ $# -ge 2 ]] || { echo 'usage: codex-workflow multica-feedback <task-id> --issue <url-or-id> --commit <sha-or-unknown> --round <n> --status clean|repair-needed|blocked ...' >&2; exit 1; }; commit_sha="$2"; shift 2 ;;
      --commit=*) commit_sha="${1#--commit=}"; shift ;;
      --round) [[ $# -ge 2 ]] || { echo 'usage: codex-workflow multica-feedback <task-id> --issue <url-or-id> --commit <sha-or-unknown> --round <n> --status clean|repair-needed|blocked ...' >&2; exit 1; }; round="$2"; shift 2 ;;
      --round=*) round="${1#--round=}"; shift ;;
      --status) [[ $# -ge 2 ]] || { echo 'usage: codex-workflow multica-feedback <task-id> --issue <url-or-id> --commit <sha-or-unknown> --round <n> --status clean|repair-needed|blocked ...' >&2; exit 1; }; status="$2"; shift 2 ;;
      --status=*) status="${1#--status=}"; shift ;;
      --review) [[ $# -ge 2 ]] || { echo 'usage: codex-workflow multica-feedback <task-id> ... [--review <path-or-url>]...' >&2; exit 1; }; reviews+=("$2"); shift 2 ;;
      --review=*) reviews+=("${1#--review=}"); shift ;;
      --e2e) [[ $# -ge 2 ]] || { echo 'usage: codex-workflow multica-feedback <task-id> ... [--e2e <path-or-url>]...' >&2; exit 1; }; e2es+=("$2"); shift 2 ;;
      --e2e=*) e2es+=("${1#--e2e=}"); shift ;;
      --scorecard) [[ $# -ge 2 ]] || { echo 'usage: codex-workflow multica-feedback <task-id> ... [--scorecard <path-or-url>]...' >&2; exit 1; }; scorecards+=("$2"); shift 2 ;;
      --scorecard=*) scorecards+=("${1#--scorecard=}"); shift ;;
      --evidence-manifest) [[ $# -ge 2 ]] || { echo 'usage: codex-workflow multica-feedback <task-id> ... [--evidence-manifest <path-or-url>]' >&2; exit 1; }; evidence_manifest="$2"; shift 2 ;;
      --evidence-manifest=*) evidence_manifest="${1#--evidence-manifest=}"; shift ;;
      --blocking-finding) [[ $# -ge 2 ]] || { echo 'usage: codex-workflow multica-feedback <task-id> ... [--blocking-finding "<id|summary>"]...' >&2; exit 1; }; findings+=("$2"); shift 2 ;;
      --blocking-finding=*) findings+=("${1#--blocking-finding=}"); shift ;;
      *) echo 'usage: codex-workflow multica-feedback <task-id> --issue <url-or-id> --commit <sha-or-unknown> --round <n> --status clean|repair-needed|blocked [--review <path-or-url>]... [--e2e <path-or-url>]... [--scorecard <path-or-url>]... [--evidence-manifest <path-or-url>] [--blocking-finding "<id|summary>"]...' >&2; exit 1 ;;
    esac
  done
  [[ -n "$issue" ]] || { echo "missing required argument: --issue" >&2; exit 1; }
  [[ -n "$commit_sha" ]] || { echo "missing required argument: --commit" >&2; exit 1; }
  [[ -n "$round" ]] || { echo "missing required argument: --round" >&2; exit 1; }
  [[ -n "$status" ]] || { echo "missing required argument: --status" >&2; exit 1; }
  require_task "$task_id" >/dev/null
  sync_task_runtime "$task_id"
  recorded_at="$(timestamp_utc)"
  metadata="$(write_multica_feedback "$task_id" "$issue" "$commit_sha" "$round" "$status" "$evidence_manifest" "$recorded_at" "${#reviews[@]}" "${reviews[@]}" "${#e2es[@]}" "${e2es[@]}" "${#scorecards[@]}" "${scorecards[@]}" "${#findings[@]}" "${findings[@]}")"
  IFS=$'\t' read -r feedback_path feedback_json issue commit_sha round status finding_count <<<"$metadata"
  upsert_task_fields "$(require_task "$task_id")" "multica_feedback=$(path_relative_to_codex_home "$feedback_path")" "multica_feedback_status=$status" "multica_feedback_round=$round" "multica_feedback_findings=$finding_count"
  write_task_state_json "$task_id"
  set_task_state_fields "$task_id" "multica_feedback.artifact=$(path_relative_to_codex_home "$feedback_path")" "multica_feedback.json=$(path_relative_to_codex_home "$feedback_json")" "multica_feedback.status=$status" "multica_feedback.round=$round" "multica_feedback.blocking_findings=$finding_count"
  if [[ "$status" == "repair-needed" ]]; then
    set_task_state_fields "$task_id" "current_phase=repair" "latest_feedback_route=repair"
  elif [[ "$status" == "blocked" ]]; then
    set_task_state_fields "$task_id" "current_phase=blocked" "latest_feedback_route=blocker"
  fi
  append_task_runtime_event "$task_id" "multica-feedback" "$status round $round"
  printf 'task_id: %s\nartifact: %s\njson: %s\nstatus: %s\nround: %s\nblocking_findings: %s\n' "$task_id" "$feedback_path" "$feedback_json" "$status" "$round" "$finding_count"
}

cmd_feedback_cycle() {
  local task_id="$1"
  shift
  local source finding severity classification route recorded_at metadata return_path cycle_file cycle cycle_status rows_joined
  local rows=()
  local evidence=()
  source=""
  finding=""
  severity=""
  classification=""
  route=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --source) [[ $# -ge 2 ]] || { echo 'usage: codex-workflow feedback-cycle <task-id> --source verify|design-review|multica-review|multica-e2e|user --finding "<summary>" --severity blocking|high|medium|low --classification implementation-bug|spec-gap|acceptance-gap|env-blocker|prd-conflict|scope-change --route repair|clarify|new-prd|blocker|acceptance-update [--affected-row <id>]... [--evidence <path-or-url>]...' >&2; exit 1; }; source="$2"; shift 2 ;;
      --source=*) source="${1#--source=}"; shift ;;
      --finding) [[ $# -ge 2 ]] || { echo 'usage: codex-workflow feedback-cycle <task-id> --source <source> --finding "<summary>" --severity <severity> --classification <classification> --route <route> [--affected-row <id>]... [--evidence <path-or-url>]...' >&2; exit 1; }; finding="$2"; shift 2 ;;
      --finding=*) finding="${1#--finding=}"; shift ;;
      --severity) [[ $# -ge 2 ]] || { echo 'usage: codex-workflow feedback-cycle <task-id> --source <source> --finding "<summary>" --severity <severity> --classification <classification> --route <route> ...' >&2; exit 1; }; severity="$2"; shift 2 ;;
      --severity=*) severity="${1#--severity=}"; shift ;;
      --classification) [[ $# -ge 2 ]] || { echo 'usage: codex-workflow feedback-cycle <task-id> --source <source> --finding "<summary>" --severity <severity> --classification <classification> --route <route> ...' >&2; exit 1; }; classification="$2"; shift 2 ;;
      --classification=*) classification="${1#--classification=}"; shift ;;
      --route) [[ $# -ge 2 ]] || { echo 'usage: codex-workflow feedback-cycle <task-id> --source <source> --finding "<summary>" --severity <severity> --classification <classification> --route <route> ...' >&2; exit 1; }; route="$2"; shift 2 ;;
      --route=*) route="${1#--route=}"; shift ;;
      --affected-row) [[ $# -ge 2 ]] || { echo 'usage: codex-workflow feedback-cycle <task-id> ... [--affected-row <id>]...' >&2; exit 1; }; rows+=("$2"); shift 2 ;;
      --affected-row=*) rows+=("${1#--affected-row=}"); shift ;;
      --evidence) [[ $# -ge 2 ]] || { echo 'usage: codex-workflow feedback-cycle <task-id> ... [--evidence <path-or-url>]...' >&2; exit 1; }; evidence+=("$2"); shift 2 ;;
      --evidence=*) evidence+=("${1#--evidence=}"); shift ;;
      *) echo 'usage: codex-workflow feedback-cycle <task-id> --source verify|design-review|multica-review|multica-e2e|user --finding "<summary>" --severity blocking|high|medium|low --classification implementation-bug|spec-gap|acceptance-gap|env-blocker|prd-conflict|scope-change --route repair|clarify|new-prd|blocker|acceptance-update [--affected-row <id>]... [--evidence <path-or-url>]...' >&2; exit 1 ;;
    esac
  done
  [[ -n "$source" ]] || { echo "missing required argument: --source" >&2; exit 1; }
  [[ -n "$finding" ]] || { echo "missing required argument: --finding" >&2; exit 1; }
  [[ -n "$severity" ]] || { echo "missing required argument: --severity" >&2; exit 1; }
  [[ -n "$classification" ]] || { echo "missing required argument: --classification" >&2; exit 1; }
  [[ -n "$route" ]] || { echo "missing required argument: --route" >&2; exit 1; }
  require_task "$task_id" >/dev/null
  sync_task_runtime "$task_id"
  recorded_at="$(timestamp_utc)"
  metadata="$(write_feedback_cycle "$task_id" "$source" "$finding" "$severity" "$classification" "$route" "$recorded_at" "${#rows[@]}" "${rows[@]}" "${#evidence[@]}" "${evidence[@]}")"
  IFS=$'\t' read -r return_path cycle_file cycle cycle_status route rows_joined <<<"$metadata"
  upsert_task_fields "$(require_task "$task_id")" "return_to_plan=$(path_relative_to_codex_home "$return_path")" "active_plan_cycle=$cycle" "latest_feedback_route=$route"
  write_task_state_json "$task_id"
  set_task_state_fields "$task_id" "return_to_plan.artifact=$(path_relative_to_codex_home "$return_path")" "active_plan_cycle=$cycle" "latest_feedback_route=$route" "previous_approval_status=stale-if-affected" "stale_acceptance_rows=$rows_joined"
  append_task_runtime_event "$task_id" "feedback-cycle" "$cycle_status cycle $cycle route $route"
  printf 'task_id: %s\nartifact: %s\ncycle_file: %s\ncycle: %s\nstatus: %s\nroute: %s\n' "$task_id" "$return_path" "$cycle_file" "$cycle" "$cycle_status" "$route"
}

