#!/usr/bin/env bash

if [[ "${BASH_VERSINFO[0]:-0}" -lt 4 ]]; then
  if [[ -z "${CODEX_WORKFLOW_BASH_REEXECED:-}" ]]; then
    for candidate in /opt/homebrew/bin/bash /usr/local/bin/bash; do
      if [[ -x "$candidate" ]]; then
        major="$("$candidate" -c 'printf "%s" "${BASH_VERSINFO[0]:-0}"' 2>/dev/null || true)"
        case "$major" in
          ''|*[!0-9]*)
            continue
            ;;
        esac
        if [[ "$major" -ge 4 ]]; then
          export CODEX_WORKFLOW_BASH_REEXECED=1
          exec "$candidate" "$0" "$@"
        fi
      fi
    done
  fi

  echo "codex-workflow requires Bash 4+; install a newer bash or put it earlier in PATH" >&2
  exit 1
fi

unset CODEX_WORKFLOW_BASH_REEXECED

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DEFAULT_CODEX_HOME_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
DEFAULT_WORKFLOW_ROOT="$DEFAULT_CODEX_HOME_ROOT/workflow"
DEFAULT_LEARNINGS_DIR="${HOME}/Documents/note/codex-memory/learnings"
WORKFLOW_ROOT="${CODEX_WORKFLOW_ROOT:-$DEFAULT_WORKFLOW_ROOT}"
if [[ -n "${CODEX_HOME_ROOT:-}" ]]; then
  CODEX_HOME_ROOT="$CODEX_HOME_ROOT"
elif [[ -n "${CODEX_HOME:-}" ]]; then
  CODEX_HOME_ROOT="$CODEX_HOME"
elif [[ -n "${CODEX_WORKFLOW_ROOT:-}" ]]; then
  CODEX_HOME_ROOT="$(dirname "$CODEX_WORKFLOW_ROOT")"
else
  CODEX_HOME_ROOT="$DEFAULT_CODEX_HOME_ROOT"
fi
TASKS_DIR="$WORKFLOW_ROOT/tasks"
STATE_DIR="$WORKFLOW_ROOT/state"
ARTIFACTS_DIR="$WORKFLOW_ROOT/artifacts"
HOOKS_DIR="$WORKFLOW_ROOT/hooks"
SOURCE_HOOKS_DIR="$SCRIPT_DIR/../hooks"
TEMPLATE_DIR="${CODEX_WORKFLOW_TEMPLATE_DIR:-$SCRIPT_DIR/../templates}"
TASK_TEMPLATE="$TEMPLATE_DIR/task.md"
LEARNING_TEMPLATE="$TEMPLATE_DIR/learning.md"
CURRENT_TASK_FILE="$STATE_DIR/current-task.json"
CODEX_CONFIG_FILE="${CODEX_CONFIG_FILE:-$CODEX_HOME_ROOT/config.toml}"
CODEX_HOOKS_FILE="${CODEX_HOOKS_FILE:-$CODEX_HOME_ROOT/hooks.json}"
PASEO_CONFIG_FILE="${PASEO_CONFIG_FILE:-$HOME/.paseo/config.json}"
ATLAS_SOURCE_SKILLS_DIR="${ATLAS_SOURCE_SKILLS_DIR:-$CODEX_HOME_ROOT/plugins/atlas-workflow/skills}"
if [[ -z "${ATLAS_CACHE_SKILLS_DIR:-}" ]]; then
  ATLAS_CACHE_SKILLS_DIR="$(find "$CODEX_HOME_ROOT/plugins/cache/atlas-forge/atlas-workflow" -mindepth 2 -maxdepth 2 -type d -name skills 2>/dev/null | sort -V | tail -1 || true)"
  ATLAS_CACHE_SKILLS_DIR="${ATLAS_CACHE_SKILLS_DIR:-$CODEX_HOME_ROOT/plugins/cache/local-atlas/atlas-workflow/local/skills}"
fi
CODEX_BIN="${CODEX_BIN:-codex}"
PASEO_BIN="${PASEO_BIN:-paseo}"
if [[ -n "${CODEX_LEARNINGS_DIR:-}" ]]; then
  LEARNINGS_DIR="$CODEX_LEARNINGS_DIR"
elif [[ "$WORKFLOW_ROOT" != "$DEFAULT_WORKFLOW_ROOT" ]]; then
  LEARNINGS_DIR="$(dirname "$WORKFLOW_ROOT")/learnings"
else
  LEARNINGS_DIR="$DEFAULT_LEARNINGS_DIR"
fi
LEARNING_INDEX="$LEARNINGS_DIR/index.md"
LEARNING_SEARCH_INDEX="$LEARNINGS_DIR/search.jsonl"
MEMORY_DIR="${CODEX_MEMORY_DIR:-$(dirname "$LEARNINGS_DIR")}"
MEMORY_INDEX="$MEMORY_DIR/MEMORY.md"
TASK_MEMORY_INDEX="$MEMORY_DIR/tasks.md"
RECENT_LEARNINGS_INDEX="$LEARNINGS_DIR/RECENT.md"
MEMORY_SEARCH_INDEX="$MEMORY_DIR/memory.jsonl"
MEMORY_RECENT_DAYS="${CODEX_MEMORY_RECENT_DAYS:-7}"
INIT_TASK_LOCK_FILE="$TASKS_DIR/.init-task.lock"
TASK_LOCK_DIR="${TMPDIR:-/tmp}/codex-workflow-task-locks"
LEARNING_LOCK_DIR="${TMPDIR:-/tmp}/codex-workflow-learning-locks"
TEAM_LOCK_DIR="${TMPDIR:-/tmp}/codex-workflow-team-locks"
LOCK_DIRS=()

release_all_locks() {
  local lock_dir
  local held_locks=()

  set +u
  held_locks=("${LOCK_DIRS[@]}")
  set -u

  if ((${#held_locks[@]})); then
    for lock_dir in "${held_locks[@]}"; do
      rmdir "$lock_dir" 2>/dev/null || true
    done
  fi
}

trap release_all_locks EXIT
trap 'release_all_locks; exit 130' INT
trap 'release_all_locks; exit 143' TERM

today() {
  date +%F
}

timestamp_utc() {
  date -u +%Y-%m-%dT%H:%M:%SZ
}

timestamp_token() {
  date -u +%Y%m%dT%H%M%S%N
}

trimmed_preview() {
  local file="$1"
  python3 - "$file" <<'PY'
from pathlib import Path
import sys

path = Path(sys.argv[1])
if not path.exists():
    raise SystemExit(0)

text = path.read_text(encoding="utf-8", errors="replace")
lines = text.splitlines()
if len(lines) > 80:
    lines = lines[:80] + [f"... ({len(text.splitlines()) - 80} more lines omitted)"]
preview = "\n".join(lines)
if len(preview) > 6000:
    preview = preview[:6000].rstrip() + "\n... (output truncated)"
sys.stdout.write(preview)
PY
}

list_usage() {
  echo 'usage: codex-workflow list [--all|--days <n>|--days=<n>]' >&2
}

slugify() {
  printf '%s' "$1" |
    tr '[:upper:]' '[:lower:]' |
    sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g'
}

validate_title() {
  local title="$1"
  if [[ -z "$title" || "$title" == *$'\n'* || "$title" == *$'\r'* || "$title" == *$'\t'* || "$title" =~ ^[[:space:]]*$ ]]; then
    echo "unsafe title: titles must be a single line" >&2
    exit 1
  fi
}

validate_query() {
  local query="$1"
  if [[ -z "$query" || "$query" == *$'\n'* || "$query" == *$'\r'* || "$query" =~ ^[[:space:]]*$ ]]; then
    echo "unsafe query: query must be a single non-empty line" >&2
    exit 1
  fi
}

validate_single_line_reason() {
  local label="$1"
  local reason="$2"
  if [[ -z "$reason" || "$reason" == *$'\n'* || "$reason" == *$'\r'* || "$reason" == *$'\t'* || "$reason" =~ ^[[:space:]]*$ ]]; then
    echo "unsafe $label: reason must be a single non-empty line" >&2
    exit 1
  fi
}

validate_no_verify_reason() {
  validate_single_line_reason "no-verify reason" "$1"
}

validate_readiness_skip_reason() {
  validate_single_line_reason "readiness skip reason" "$1"
}

validate_positive_integer() {
  local value="$1"
  local label="$2"

  if [[ ! "$value" =~ ^[1-9][0-9]*$ ]]; then
    echo "invalid $label: $value" >&2
    exit 1
  fi
}

validate_team_backend() {
  local backend="$1"
  case "$backend" in
    native) ;;
    *)
      echo "invalid team backend: $backend" >&2
      exit 1
      ;;
  esac
}

validate_team_mode() {
  local mode="$1"
  case "$mode" in
    discuss|execute) ;;
    *)
      echo "invalid team mode: $mode" >&2
      exit 1
      ;;
  esac
}

validate_team_final_status() {
  local status="$1"
  case "$status" in
    complete|failed|interrupted) ;;
    *)
      echo "invalid team final status: $status" >&2
      exit 1
      ;;
  esac
}

validate_team_loop_status() {
  local status="$1"
  case "$status" in
    loop-done|loop-incomplete|loop-failed|loop-timeout) ;;
    *)
      echo "invalid team loop status: $status" >&2
      exit 1
      ;;
  esac
}

validate_existing_nonempty_file() {
  local label="$1"
  local file="$2"

  if [[ -z "$file" || "$file" == *$'\n'* || "$file" == *$'\r'* || "$file" == *$'\t'* ]]; then
    echo "invalid $label path: $file" >&2
    exit 1
  fi
  if [[ ! -f "$file" ]]; then
    echo "missing $label file: $file" >&2
    exit 1
  fi
  if [[ ! -s "$file" ]]; then
    echo "empty $label file: $file" >&2
    exit 1
  fi
}

validate_team_native_artifact_file() {
  local task_id="$1"
  local label="$2"
  local file="$3"
  local team_dir

  validate_existing_nonempty_file "$label" "$file"
  team_dir="$(task_team_dir "$task_id")"
  python3 - "$team_dir" "$file" "$label" <<'PY'
from pathlib import Path
import re
import sys

team_dir = Path(sys.argv[1]).resolve()
path = Path(sys.argv[2]).resolve()
label = sys.argv[3]

try:
    path.relative_to(team_dir)
except ValueError:
    print(f"{label} file is outside current task team directory: {path}", file=sys.stderr)
    raise SystemExit(1)

text = path.read_text(encoding="utf-8", errors="replace")
if not re.search(r"(^|\b)backend\s*[:=]\s*native\b", text, flags=re.IGNORECASE | re.MULTILINE):
    print(f"{label} file is missing backend: native marker: {path}", file=sys.stderr)
    raise SystemExit(1)

ignored_prefixes = (
    "Task:",
    "Title:",
    "- task_id:",
    "- title:",
    "- backend:",
    "- mode:",
    "- objective:",
    "- agents:",
    "- roles:",
    "- status:",
    "- created_at:",
    "- completed_at:",
    "- decision_file:",
    "- round_file:",
    "- staffing:",
    "- loop:",
    "- iterations",
    "- max_",
)
content = []
for raw in text.splitlines():
    line = raw.strip()
    if not line:
        continue
    if line.startswith("#"):
        continue
    if line.startswith("```"):
        continue
    if line == "Pending discussion.":
        continue
    if any(line.startswith(prefix) for prefix in ignored_prefixes):
        continue
    content.append(line)

if len("\n".join(content).strip()) < 20:
    print(f"{label} file is not substantive: {path}", file=sys.stderr)
    raise SystemExit(1)
PY
}

duration_to_seconds() {
  local value="$1"
  python3 - "$value" <<'PY'
import re
import sys

value = sys.argv[1].strip()
match = re.fullmatch(r"([1-9][0-9]*)([smhd]?)", value)
if not match:
    print(f"invalid duration: {value}", file=sys.stderr)
    raise SystemExit(1)

amount = int(match.group(1))
unit = match.group(2) or "s"
multiplier = {"s": 1, "m": 60, "h": 3600, "d": 86400}[unit]
print(amount * multiplier)
PY
}

team_loop_remaining_seconds() {
  local deadline="$1"
  local now
  now="$(date +%s)"
  echo $((deadline - now))
}

team_loop_timeout_bin() {
  if command -v timeout >/dev/null 2>&1 && timeout --help 2>&1 | grep -q -- '--kill-after'; then
    printf '%s\n' timeout
    return 0
  fi

  if command -v gtimeout >/dev/null 2>&1 && gtimeout --help 2>&1 | grep -q -- '--kill-after'; then
    printf '%s\n' gtimeout
    return 0
  fi

  return 1
}

team_loop_run_with_deadline() {
  local deadline="$1"
  shift
  local remaining timeout_bin
  remaining="$(team_loop_remaining_seconds "$deadline")"
  if (( remaining <= 0 )); then
    return 124
  fi

  timeout_bin="$(team_loop_timeout_bin || true)"
  if [[ -n "$timeout_bin" ]]; then
    "$timeout_bin" --kill-after=5s "${remaining}s" "$@"
    return
  fi

  # Stock macOS does not include GNU timeout; keep bounded loops portable.
  python3 - "$remaining" "$@" <<'PY'
import os
import signal
import subprocess
import sys
import time

remaining = int(sys.argv[1])
argv = sys.argv[2:]
deadline = time.monotonic() + remaining

try:
    proc = subprocess.Popen(argv, start_new_session=True)
except FileNotFoundError:
    print(f"{argv[0]}: command not found", file=sys.stderr)
    raise SystemExit(127)
except OSError as exc:
    print(f"failed to start {argv[0]}: {exc}", file=sys.stderr)
    raise SystemExit(126)

while True:
    status = proc.poll()
    if status is not None:
        if status < 0:
            raise SystemExit(128 + abs(status))
        raise SystemExit(status)

    now = time.monotonic()
    if now >= deadline:
        break
    time.sleep(min(0.1, max(0.0, deadline - now)))

try:
    os.killpg(proc.pid, signal.SIGTERM)
except ProcessLookupError:
    pass

kill_deadline = time.monotonic() + 5
while time.monotonic() < kill_deadline:
    if proc.poll() is not None:
        raise SystemExit(124)
    time.sleep(0.1)

try:
    os.killpg(proc.pid, signal.SIGKILL)
except ProcessLookupError:
    pass

proc.wait()
raise SystemExit(124)
PY
}

team_loop_verifier_sentinel() {
  local file="$1"
  python3 - "$file" <<'PY'
from pathlib import Path
import re
import sys

path = Path(sys.argv[1])
if not path.exists():
    print("missing")
    raise SystemExit(0)

for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
    stripped = line.strip()
    if not stripped:
        continue
    match = re.fullmatch(r"done\s*[:=]\s*(true|false)", stripped, flags=re.IGNORECASE)
    print(match.group(1).lower() if match else "invalid")
    raise SystemExit(0)

print("missing")
PY
}

title_token() {
  local title="$1"
  local slug token

  slug="$(slugify "$title")"
  if [[ -n "$slug" ]]; then
    printf '%s\n' "$slug"
    return
  fi

  token="$(printf '%s' "$title" | cksum | awk '{print $1}')"
  printf 'u%s\n' "$token"
}

title_checksum() {
  printf '%s' "$1" | cksum | awk '{print $1}'
}

list_cutoff_day() {
  local days="$1"
  local offset

  validate_positive_integer "$days" "days"
  offset=$((days - 1))
  if date -d "$offset days ago" +%Y%m%d >/dev/null 2>&1; then
    date -d "$offset days ago" +%Y%m%d
  else
    date -v-"$offset"d +%Y%m%d
  fi
}

task_id_day() {
  local task_id="$1"

  if [[ "$task_id" =~ ^([0-9]{8})-[0-9]+- ]]; then
    printf '%s\n' "${BASH_REMATCH[1]}"
    return 0
  fi

  return 1
}

parse_list_args() {
  local mode="recent"
  local days="7"
  local mode_locked="0"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --all)
        if [[ "$mode_locked" == "1" ]]; then
          list_usage
          exit 1
        fi
        mode="all"
        mode_locked="1"
        shift
        ;;
      --days)
        if [[ "$mode_locked" == "1" || $# -lt 2 ]]; then
          list_usage
          exit 1
        fi
        mode="recent"
        mode_locked="1"
        days="$2"
        shift 2
        ;;
      --days=*)
        if [[ "$mode_locked" == "1" ]]; then
          list_usage
          exit 1
        fi
        mode="recent"
        mode_locked="1"
        days="${1#--days=}"
        shift
        ;;
      *)
        list_usage
        exit 1
        ;;
    esac
  done

  if [[ "$mode" == "recent" ]]; then
    validate_positive_integer "$days" "days"
  fi

  printf '%s\t%s\n' "$mode" "$days"
}

should_list_task() {
  local status="$1"
  local task_id="$2"
  local cutoff_day="$3"
  local task_day

  if [[ -z "$cutoff_day" || "$status" != "done" ]]; then
    return 0
  fi

  if ! task_day="$(task_id_day "$task_id")"; then
    return 0
  fi

  [[ "$task_day" < "$cutoff_day" ]] && return 1
  return 0
}

