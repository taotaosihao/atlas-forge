with lesson_file.open("a", encoding="utf-8") as fh:
    fh.write(
        "\n".join(
            [
                f"## {candidate_id}",
                "",
                f"- Recorded: {recorded_at}",
                f"- Trigger: {trigger}",
                f"- Lesson: {lesson}",
                "",
                "### Evidence",
                "",
                *evidence_lines,
                "",
            ]
        )
    )
event = {
    "kind": "lesson-candidate",
    "candidate_id": candidate_id,
    "created_at": recorded_at,
    "trigger": trigger,
    "lesson": lesson,
    "evidence": evidence,
}
with (artifact_dir / "ledger.jsonl").open("a", encoding="utf-8") as fh:
    fh.write(json.dumps(event, ensure_ascii=False) + "\n")

print("\t".join([str(lesson_file), candidate_id, trigger, str(len(evidence))]))
PY
}

