task_has_successful_verification() {
  local task_id="$1"
  local state_file
  state_file="$(task_state_file "$task_id")"
  python3 - "$state_file" <<'PY'
from pathlib import Path
import json
import sys

path = Path(sys.argv[1])
if not path.exists():
    raise SystemExit(1)

try:
    state = json.loads(path.read_text(encoding="utf-8"))
except json.JSONDecodeError:
    raise SystemExit(1)

last_verified_at = str(state.get("last_verified_at") or "").strip()
verification = state.get("verification") or {}
last_exit_code = verification.get("last_exit_code")

if last_verified_at and (last_exit_code == 0 or str(last_exit_code) == "0"):
    raise SystemExit(0)
raise SystemExit(1)
PY
}

evaluate_task_readiness() {
  local task_id="$1"
  local requirements="$2"
  local artifact_dir
  artifact_dir="$(task_artifact_dir "$task_id")"
  python3 - "$artifact_dir" "$requirements" <<'PY'
from pathlib import Path
import sys

artifact_dir = Path(sys.argv[1])
requirements = [item.strip() for item in sys.argv[2].split(",") if item.strip()]
valid = {"context", "spec", "analysis", "decision"}
unknown = [item for item in requirements if item not in valid]

if not requirements:
    print("invalid readiness requirements: empty", file=sys.stderr)
    raise SystemExit(2)
if unknown:
    print(f"invalid readiness requirement(s): {','.join(unknown)}", file=sys.stderr)
    raise SystemExit(2)

def path_for(requirement: str) -> Path:
    if requirement == "decision":
        root_decision = artifact_dir / "decision.md"
        if root_decision.exists():
            return root_decision
        return artifact_dir / "team" / "decision.md"
    return artifact_dir / f"{requirement}.md"

def has_substantive_content(path: Path) -> bool:
    if not path.exists():
        return False
    text = path.read_text(encoding="utf-8", errors="replace")
    content = []
    for raw in text.splitlines():
        line = raw.strip()
        if not line:
            continue
        if line.startswith("#"):
            continue
        if line.startswith("Task:") or line.startswith("Title:"):
            continue
        if line == "Pending discussion.":
            continue
        content.append(line)
    return bool("\n".join(content).strip())

issues = []
paths = []
for requirement in requirements:
    path = path_for(requirement)
    try:
        rel_path = path.relative_to(artifact_dir).as_posix()
    except ValueError:
        rel_path = str(path)
    paths.append(f"{requirement}:{rel_path}")
    if not path.exists():
        issues.append(f"{requirement}:missing")
    elif not has_substantive_content(path):
        issues.append(f"{requirement}:template")

status = "ready" if not issues else "not-ready"
print("\t".join([status, ",".join(issues) if issues else "-", ",".join(paths)]))
PY
}

write_handoff_envelope() {
  local task_id="$1"
  local prd_path="$2"
  local repo_path="$3"
  local base_branch="$4"
  local title="$5"
  local packet_path="$6"
  local generated_at="$7"
  local acceptance_count="$8"
  shift 8
  local acceptance_rows=("${@:1:$acceptance_count}")
  shift "$acceptance_count"
  local validation_count="$1"
  shift
  local validation_rows=("${@:1:$validation_count}")
  local artifact_dir envelope_file
  artifact_dir="$(task_artifact_dir "$task_id")"
  envelope_file="$(task_handoff_envelope_file "$task_id")"
  python3 - "$task_id" "$artifact_dir" "$envelope_file" "$prd_path" "$repo_path" "$base_branch" "$title" "$packet_path" "$generated_at" "$acceptance_count" "${acceptance_rows[@]}" "$validation_count" "${validation_rows[@]}" <<'PY'
from pathlib import Path
import hashlib
import subprocess
import sys

task_id = sys.argv[1]
artifact_dir = Path(sys.argv[2])
envelope_file = Path(sys.argv[3])
prd_raw = sys.argv[4]
repo_raw = sys.argv[5]
base_branch = sys.argv[6]
title = sys.argv[7]
packet_raw = sys.argv[8]
generated_at = sys.argv[9]
acceptance_count = int(sys.argv[10])
idx = 11
acceptance_raw = sys.argv[idx : idx + acceptance_count]
idx += acceptance_count
validation_count = int(sys.argv[idx])
idx += 1
validation_raw = sys.argv[idx : idx + validation_count]

def fail(message: str) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(1)

def require_single_line(value: str, label: str) -> str:
    if not value or any(ch in value for ch in "\n\r\t") or not value.strip():
        fail(f"invalid {label}: must be a single non-empty line")
    return value.strip()

def parse_row(raw: str, field_count: int, label: str):
    require_single_line(raw, f"{label} row")
    parts = [part.strip() for part in raw.split("|")]
    if len(parts) != field_count or any(not part for part in parts):
        fail(f"invalid {label} row: {raw}")
    priority = parts[-1] if label == "acceptance" else parts[2]
    if priority not in {"required", "advisory"}:
        fail(f"invalid {label} priority: {priority}")
    return parts

base_branch = require_single_line(base_branch, "base branch")
title = title.strip() if title.strip() else ""
if title:
    title = require_single_line(title, "title")

prd_path = Path(prd_raw).expanduser()
if not prd_path.exists() or not prd_path.is_file():
    fail(f"missing PRD file: {prd_raw}")
prd_path = prd_path.resolve()
suffix = prd_path.suffix.lower()
if suffix not in {".md", ".markdown", ".html", ".htm"}:
    fail(f"unsupported PRD extension: {prd_path.suffix}")
prd_format = "HTML" if suffix in {".html", ".htm"} else "Markdown"
prd_sha = hashlib.sha256(prd_path.read_bytes()).hexdigest()

repo_path = Path(repo_raw).expanduser()
if not repo_path.exists() or not repo_path.is_dir():
    fail(f"missing repo directory: {repo_raw}")
repo_path = repo_path.resolve()

packet_path = None
if packet_raw:
    packet_path = Path(packet_raw).expanduser()
    if not packet_path.exists() or not packet_path.is_file():
        fail(f"missing curated packet file: {packet_raw}")
    packet_path = packet_path.resolve()

if acceptance_count < 1:
    fail("at least one acceptance row is required")
if validation_count < 1:
    fail("at least one validation row is required")

acceptance_rows = [parse_row(row, 3, "acceptance") for row in acceptance_raw]
validation_rows = [parse_row(row, 4, "validation") for row in validation_raw]

def git_value(*args: str) -> str:
    try:
        result = subprocess.run(
            ["git", "-C", str(repo_path), *args],
            check=True,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
        )
    except Exception:
        return "unknown"
    value = result.stdout.strip()
    return value or "unknown"

repo_name = git_value("rev-parse", "--show-toplevel")
repo_name = Path(repo_name).name if repo_name != "unknown" else repo_path.name
repo_sha = git_value("rev-parse", "HEAD")

try:
    prd_rel = prd_path.relative_to(repo_path).as_posix()
except ValueError:
    prd_rel = str(prd_path)

if packet_path is not None:
    try:
        packet_display = packet_path.relative_to(repo_path).as_posix()
    except ValueError:
        packet_display = str(packet_path)
else:
    packet_display = "-"

if not title:
    title = f"Multica handoff: {prd_path.stem}"

def table(rows, headers):
    out = [
        "| " + " | ".join(headers) + " |",
        "| " + " | ".join(["---"] * len(headers)) + " |",
    ]
    for row in rows:
        out.append("| " + " | ".join(cell.replace("|", "\\|") for cell in row) + " |")
    return "\n".join(out)

artifact_dir.mkdir(parents=True, exist_ok=True)
envelope = f"""# Multica Handoff Envelope

Generated: {generated_at}
Atlas task: {task_id}
Title: {title}

## Canonical PRD

- Format: {prd_format}
- PRD path: `{prd_rel}`
- PRD absolute path: `{prd_path}`
- PRD SHA256: `{prd_sha}`

The PRD file is the source of truth. If this envelope, a curated memory packet, or an issue summary conflicts with the PRD, Multica must stop and report a PRD fidelity blocker before implementation.

## Target Repository

- Repository: {repo_name}
- Repo path: `{repo_path}`
- Base branch: `{base_branch}`
- Submitter commit SHA: `{repo_sha}`

Prefer the local repository path above when it exists and is a git work tree. Use a dedicated worktree and branch for `>100 lines` or `unknown` code delta estimates.

## Acceptance Matrix

{table(acceptance_rows, ["ID", "Requirement", "Priority"])}

Required rows cannot be skipped. Advisory rows should inform implementation and review but do not override the canonical PRD.

## Validation Lanes

{table(validation_rows, ["ID", "Surface", "Priority", "Evidence"])}

Required validation must produce real evidence appropriate to the changed surface. UI work needs screenshots and interaction/responsive evidence when relevant. Backend/API/worker/data/library work needs runtime command output, request/response, logs, migrations, integration tests, or data assertions.

## Curated Memory Packet

- Packet: `{packet_display}`
- Precedence: advisory_prd_wins

The curated packet is advisory context only. It must not contain raw transcripts, raw logs, secrets, or global memory dumps, and it never overrides the PRD.

## Multica Execution Contract

1. PREFLIGHT: repo, base branch, runtimes, permissions, readable PRD, PRD fidelity, and approved staffing plan when one is required.
2. PLAN: implementation plan from PRD acceptance criteria, including code delta estimate and worktree decision.
3. IMPLEMENT: scoped changes only; use a dedicated worktree for `>100 lines` or `unknown` estimates.
4. VALIDATE: review and E2E against the current commit SHA.
5. REPAIR: high-priority findings, failed required validation, and missing required evidence must be repaired until cleared.
6. PR-READY-GATE: every required acceptance and validation row has evidence.
7. OUTPUT: draft PR or blocker report only.

Forbidden actions: do not merge, deploy, perform production changes, or clean up an unmerged Multica worktree.

## Suggested Submit Command

If an approved Multica agent/staffing plan exists, attach it with `--staffing-plan`. If staffing is still unclear, use `multica-agent-plan` before submitting.

```bash
~/.agents/bin/multica-prd-submit --repo {str(repo_path)!r} --title {title!r} {str(prd_path)!r}
```
"""
envelope_file.write_text(envelope, encoding="utf-8")

print(
    "\t".join(
        [
            str(envelope_file),
            str(prd_path),
            prd_sha,
            str(repo_path),
            base_branch,
            repo_sha,
            str(packet_path) if packet_path is not None else "-",
            str(acceptance_count),
            str(validation_count),
            title,
        ]
    )
)
PY
}

write_result_ingest() {
  local task_id="$1"
  local issue="$2"
  local outcome="$3"
  local draft_pr="$4"
  local blocker="$5"
  local commit_sha="$6"
  local worktree="$7"
  local summary="$8"
  local ingested_at="$9"
  local evidence_count="${10}"
  shift 10
  local evidence_items=("${@:1:$evidence_count}")
  shift "$evidence_count"
  local lesson_count="$1"
  shift
  local lesson_items=("${@:1:$lesson_count}")
  local artifact_dir result_file
  artifact_dir="$(task_artifact_dir "$task_id")"
  result_file="$(task_result_ingest_file "$task_id")"
  python3 - "$task_id" "$artifact_dir" "$result_file" "$issue" "$outcome" "$draft_pr" "$blocker" "$commit_sha" "$worktree" "$summary" "$ingested_at" "$evidence_count" "${evidence_items[@]}" "$lesson_count" "${lesson_items[@]}" <<'PY'
from pathlib import Path
import re
import sys

task_id = sys.argv[1]
artifact_dir = Path(sys.argv[2])
result_file = Path(sys.argv[3])
issue = sys.argv[4]
outcome = sys.argv[5]
draft_pr = sys.argv[6]
blocker = sys.argv[7]
commit_sha = sys.argv[8]
worktree = sys.argv[9]
summary = sys.argv[10]
ingested_at = sys.argv[11]
evidence_count = int(sys.argv[12])
idx = 13
evidence_items = sys.argv[idx : idx + evidence_count]
idx += evidence_count
lesson_count = int(sys.argv[idx])
idx += 1
lesson_items = sys.argv[idx : idx + lesson_count]

def fail(message: str) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(1)

def require_single_line(value: str, label: str, allow_empty: bool = False) -> str:
    if any(ch in value for ch in "\n\r\t"):
        fail(f"invalid {label}: must be a single line")
    stripped = value.strip()
    if not allow_empty and not stripped:
        fail(f"invalid {label}: must be non-empty")
    return stripped

issue = require_single_line(issue, "issue")
outcome = require_single_line(outcome, "outcome")
draft_pr = require_single_line(draft_pr, "draft PR", allow_empty=True)
blocker = require_single_line(blocker, "blocker", allow_empty=True)
commit_sha = require_single_line(commit_sha, "commit")
worktree = require_single_line(worktree, "worktree")
summary = require_single_line(summary, "summary", allow_empty=True)

if outcome not in {"draft-pr", "blocker"}:
    fail(f"invalid outcome: {outcome}")
if commit_sha != "unknown" and not re.fullmatch(r"[0-9a-fA-F]{7,64}", commit_sha):
    fail("invalid commit: expected 7-64 hex characters or unknown")
if outcome == "draft-pr":
    if not draft_pr:
        fail("draft-pr outcome requires --draft-pr")
    if blocker:
        fail("draft-pr outcome cannot include --blocker")
if outcome == "blocker":
    if not blocker:
        fail("blocker outcome requires --blocker")
    if draft_pr:
        fail("blocker outcome cannot include --draft-pr")
if evidence_count < 1:
    fail("at least one evidence item is required")

evidence_items = [require_single_line(item, "evidence") for item in evidence_items]
lesson_items = [require_single_line(item, "lesson") for item in lesson_items]

if not summary:
    summary = "Multica returned a draft PR." if outcome == "draft-pr" else "Multica returned a blocker report."

artifact_dir.mkdir(parents=True, exist_ok=True)
evidence_md = "\n".join(f"- `{item}`" for item in evidence_items)
lesson_md = "\n".join(f"- {item}" for item in lesson_items) if lesson_items else "- None recorded."

result_md = f"""# Multica Result Ingest

Ingested: {ingested_at}
Atlas task: {task_id}
Outcome: {outcome}
Summary: {summary}

## Multica Pointers

- Issue: `{issue}`
- Draft PR: `{draft_pr or '-'}`
- Blocker: `{blocker or '-'}`
- Commit SHA: `{commit_sha}`
- Worktree: `{worktree}`

## Evidence

{evidence_md}

## Lesson Candidates

{lesson_md}

## Atlas Boundary

Atlas records this result for recovery and follow-up planning. Atlas does not merge, deploy, clean a Multica worktree before merge, or silently promote lesson candidates into permanent memory.
"""
result_file.write_text(result_md, encoding="utf-8")

print(
    "\t".join(
        [
            str(result_file),
            issue,
            outcome,
            draft_pr or "-",
            blocker or "-",
            commit_sha,
            worktree,
            str(evidence_count),
            str(lesson_count),
            summary,
            " ;; ".join(evidence_items),
            " ;; ".join(lesson_items) if lesson_items else "-",
        ]
    )
)
PY
}

write_route_decision() {
  local task_id="$1"
  local intent="$2"
  local risk="$3"
  local route_action="$4"
  local reason="$5"
  local next_step="$6"
  local consensus_requested="$7"
  local consensus_source="$8"
  local recorded_at="$9"
  local assumption_count="${10}"
  shift 10
  local assumptions=("$@")
  local artifact_dir route_file consensus_file
  artifact_dir="$(task_artifact_dir "$task_id")"
  route_file="$(task_routing_decision_file "$task_id")"
  consensus_file="$(task_consensus_plan_file "$task_id")"
  python3 - "$task_id" "$artifact_dir" "$route_file" "$consensus_file" "$intent" "$risk" "$route_action" "$reason" "$next_step" "$consensus_requested" "$consensus_source" "$recorded_at" "$assumption_count" "${assumptions[@]}" <<'PY'
from pathlib import Path
import sys

task_id = sys.argv[1]
artifact_dir = Path(sys.argv[2])
route_file = Path(sys.argv[3])
consensus_file = Path(sys.argv[4])
intent = sys.argv[5]
risk = sys.argv[6]
route_action = sys.argv[7]
reason = sys.argv[8]
next_step = sys.argv[9]
consensus_requested = sys.argv[10]
consensus_source = sys.argv[11]
recorded_at = sys.argv[12]
assumption_count = int(sys.argv[13])
assumptions = sys.argv[14 : 14 + assumption_count]

VALID_INTENTS = {
    "office-hours",
    "brainstorm",
    "intake",
    "analyze",
    "clarify",
    "task",
    "team",
    "multica-handoff",
}
VALID_RISKS = {"low", "medium", "high"}
VALID_ACTIONS = {"use", "skip"}


def fail(message: str) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(1)


def require_single_line(value: str, label: str, allow_empty: bool = False) -> str:
    if any(ch in value for ch in "\n\r\t"):
        fail(f"invalid {label}: must be a single line")
    stripped = value.strip()
    if not allow_empty and not stripped:
        fail(f"invalid {label}: must be non-empty")
    return stripped


def display_path(path: Path) -> str:
    try:
        return path.resolve().relative_to(artifact_dir.resolve()).as_posix()
    except ValueError:
        return str(path.resolve())


intent = require_single_line(intent, "intent")
risk = require_single_line(risk, "risk")
route_action = require_single_line(route_action, "decision")
reason = require_single_line(reason, "reason")
next_step = require_single_line(next_step, "next", allow_empty=True)
assumptions = [require_single_line(item, "assumption") for item in assumptions]

if intent not in VALID_INTENTS:
    fail(f"invalid intent: {intent}")
if risk not in VALID_RISKS:
    fail(f"invalid risk: {risk}")
if route_action not in VALID_ACTIONS:
    fail(f"invalid decision: {route_action}")
if consensus_requested not in {"0", "1"}:
    fail(f"invalid consensus flag: {consensus_requested}")

artifact_dir.mkdir(parents=True, exist_ok=True)
next_display = next_step or "-"
consensus_display = "-"
consensus_source_display = "-"

if consensus_requested == "1":
    if consensus_source.strip():
        source_path = Path(consensus_source).expanduser()
        if not source_path.is_absolute():
            source_path = (Path.cwd() / source_path).resolve()
    else:
        source_path = artifact_dir / "team" / "decision.md"

    if not source_path.exists() or not source_path.is_file():
        fail(f"missing consensus source: {source_path}")

    source_text = source_path.read_text(encoding="utf-8", errors="replace")
    substantive = []
    for raw in source_text.splitlines():
        line = raw.strip()
        if not line:
            continue
        if line.startswith("#"):
            continue
        if line.startswith("Task:") or line.startswith("Title:"):
            continue
        if line == "Pending discussion.":
            continue
        substantive.append(line)
    if len("\n".join(substantive).strip()) < 20:
        fail(f"consensus source is not substantive: {source_path}")

    lowered = source_text.casefold()
    role_rows = []
    for role in ("Planner", "Architect", "Critic"):
        role_rows.append(f"- {role}: {'explicit' if role.casefold() in lowered else 'not explicitly labeled'}")

    excerpt_lines = []
    for raw in source_text.splitlines():
        if raw.strip() == "Pending discussion.":
            continue
        excerpt_lines.append(raw.rstrip())
        if len(excerpt_lines) >= 120:
            excerpt_lines.append("... (truncated)")
            break
    excerpt = "\n".join(excerpt_lines).strip()

    consensus_file.write_text(
        "\n".join(
            [
                "# Consensus Plan",
                "",
                f"Generated: {recorded_at}",
                f"Atlas task: {task_id}",
                "",
                "## Source",
                "",
                f"- Source: `{display_path(source_path)}`",
                "- Status: substantive",
                "",
                "## Role Coverage",
                "",
                *role_rows,
                "",
                "## Consensus Evidence",
                "",
                "```markdown",
                excerpt,
                "```",
                "",
                "## Use",
                "",
                "This artifact records routing consensus evidence only. It does not override the task spec, PRD, or later verification evidence.",
                "",
            ]
        ),
        encoding="utf-8",
    )
    consensus_display = display_path(consensus_file)
    consensus_source_display = display_path(source_path)

assumption_lines = [f"- {item}" for item in assumptions] if assumptions else ["- None."]
route_file.write_text(
    "\n".join(
        [
            "# Routing Decision",
            "",
            f"Recorded: {recorded_at}",
            f"Atlas task: {task_id}",
            "",
            "## Decision",
            "",
            f"- Intent: {intent}",
            f"- Risk: {risk}",
            f"- Action: {route_action}",
            f"- Next: {next_display}",
            f"- Reason: {reason}",
            "",
            "## Assumptions",
            "",
            *assumption_lines,
            "",
            "## Consensus",
            "",
            f"- Requested: {'yes' if consensus_requested == '1' else 'no'}",
            f"- Source: `{consensus_source_display}`",
            f"- Plan: `{consensus_display}`",
            "",
        ]
    ),
    encoding="utf-8",
)

print(
    "\t".join(
        [
            str(route_file),
            consensus_display,
            intent,
            risk,
            route_action,
            next_display,
            str(len(assumptions)),
            reason,
        ]
    )
)
PY
}

lint_curated_packet_file() {
  local packet_file="$1"
  python3 - "$packet_file" <<'PY'
from pathlib import Path
import re
import sys

packet_path = Path(sys.argv[1]).expanduser()

REQUIRED_METADATA = {
    "packet_version",
    "atlas_task_id",
    "generated_at",
    "prd_path",
    "prd_sha256",
    "target_repo",
    "base_branch",
    "precedence",
}
RISK_PATTERNS = [
    r"AKIA[0-9A-Z]{16}",
    r"-----BEGIN [A-Z ]*PRIVATE KEY-----",
    r"BEGIN OPENSSH PRIVATE KEY",
    r"(?i)\b(password|passwd|pwd)\s*[:=]",
    r"(?i)\b(token|api[_-]?key|secret|cookie)\s*[:=]",
    r"(?im)^#+\s*raw transcript",
    r"(?im)^#+\s*raw logs?",
    r"(?i)raw transcript dump",
    r"(?i)raw log dump",
    r"(?i)raw session dump",
    r"(?i)global memory dump",
    r"\.codex/sessions",
    r"logs_2\.sqlite",
]


def fail(message: str) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(1)


if not packet_path.exists() or not packet_path.is_file():
    fail(f"missing packet file: {packet_path}")

text = packet_path.read_text(encoding="utf-8", errors="replace")
lines = text.splitlines()
if len(lines) > 250:
    fail(f"packet too large: {len(lines)} lines > 250")

metadata = {}
for raw in lines:
    if not raw.strip():
        continue
    if raw.startswith("#"):
        continue
    match = re.match(r"^([A-Za-z0-9_.-]+):\s*(.*)$", raw)
    if match:
        metadata.setdefault(match.group(1), match.group(2).strip())

missing = sorted(REQUIRED_METADATA - set(metadata))
if missing:
    fail(f"packet missing metadata: {', '.join(missing)}")
if metadata.get("precedence") != "advisory_prd_wins":
    fail("packet precedence must be advisory_prd_wins")
if "## Sources" not in text:
    fail("packet missing Sources section")
if "## Curated Context" not in text:
    fail("packet missing Curated Context section")

for pattern in RISK_PATTERNS:
    if re.search(pattern, text):
        fail(f"packet contains risky marker: {pattern}")

print("\t".join(["ok", str(packet_path), str(len(lines)), metadata.get("atlas_task_id", ""), metadata.get("prd_sha256", "")]))
PY
}

write_curated_packet() {
  local task_id="$1"
  local prd_path="$2"
  local repo_path="$3"
  local base_branch="$4"
  local generated_at="$5"
  local source_count="$6"
  shift 6
  local source_paths=("$@")
  local artifact_dir packet_file
  artifact_dir="$(task_artifact_dir "$task_id")"
  packet_file="$(task_curated_packet_file "$task_id")"
  python3 - "$task_id" "$artifact_dir" "$packet_file" "$prd_path" "$repo_path" "$base_branch" "$generated_at" "$source_count" "${source_paths[@]}" <<'PY'
from pathlib import Path
import hashlib
import re
import sys

task_id = sys.argv[1]
artifact_dir = Path(sys.argv[2])
packet_file = Path(sys.argv[3])
prd_raw = sys.argv[4]
repo_raw = sys.argv[5]
base_branch = sys.argv[6]
generated_at = sys.argv[7]
source_count = int(sys.argv[8])
source_raw = sys.argv[9 : 9 + source_count]

RISK_PATTERNS = [
    r"AKIA[0-9A-Z]{16}",
    r"-----BEGIN [A-Z ]*PRIVATE KEY-----",
    r"BEGIN OPENSSH PRIVATE KEY",
    r"(?i)\b(password|passwd|pwd)\s*[:=]",
    r"(?i)\b(token|api[_-]?key|secret|cookie)\s*[:=]",
    r"(?im)^#+\s*raw transcript",
    r"(?im)^#+\s*raw logs?",
    r"(?i)raw transcript dump",
    r"(?i)raw log dump",
    r"(?i)raw session dump",
    r"(?i)global memory dump",
    r"\.codex/sessions",
    r"logs_2\.sqlite",
]


def fail(message: str) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(1)


def require_single_line(value: str, label: str) -> str:
    if not value or any(ch in value for ch in "\n\r\t") or not value.strip():
        fail(f"invalid {label}: must be a single non-empty line")
    return value.strip()


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def display(path: Path, repo=None) -> str:
    if repo is not None:
        try:
            return path.relative_to(repo).as_posix()
        except ValueError:
            pass
    return str(path)


def reject_risky_text(text: str, label: str) -> None:
    for pattern in RISK_PATTERNS:
        if re.search(pattern, text):
            fail(f"{label} contains risky marker: {pattern}")


base_branch = require_single_line(base_branch, "base branch")
prd_path = Path(prd_raw).expanduser()
if not prd_path.exists() or not prd_path.is_file():
    fail(f"missing PRD file: {prd_raw}")
prd_path = prd_path.resolve()
if prd_path.suffix.lower() not in {".md", ".markdown", ".html", ".htm"}:
    fail(f"unsupported PRD extension: {prd_path.suffix}")
prd_sha = sha256(prd_path)

repo_path = Path(repo_raw).expanduser()
if not repo_path.exists() or not repo_path.is_dir():
    fail(f"missing repo directory: {repo_raw}")
repo_path = repo_path.resolve()

if source_count < 1:
    fail("at least one curated source is required")

sources = []
for raw in source_raw:
    require_single_line(raw, "source")
    path = Path(raw).expanduser()
    if not path.exists() or not path.is_file():
        fail(f"missing source file: {raw}")
    path = path.resolve()
    text = path.read_text(encoding="utf-8", errors="replace")
    reject_risky_text(text, f"source {path}")
    excerpt_lines = []
    for line in text.splitlines():
        stripped = line.rstrip()
        if len(stripped) > 220:
            stripped = stripped[:217].rstrip() + "..."
        excerpt_lines.append(stripped)
        if len(excerpt_lines) >= 36:
            excerpt_lines.append("... (source excerpt truncated)")
            break
    excerpt = "\n".join(excerpt_lines).strip() or "(empty source)"
    sources.append(
        {
            "path": path,
            "display": display(path, repo_path),
            "sha": sha256(path),
            "lines": len(excerpt.splitlines()),
            "excerpt": excerpt,
        }
    )

artifact_dir.mkdir(parents=True, exist_ok=True)
source_rows = [
    "| ID | Path | SHA256 | Lines Included |",
    "| --- | --- | --- | --- |",
]
for idx, source in enumerate(sources, 1):
    source_rows.append(
        f"| S{idx} | `{source['display']}` | `{source['sha']}` | {source['lines']} |"
    )

context_sections = []
for idx, source in enumerate(sources, 1):
    context_sections.extend(
        [
            f"### S{idx}: {source['display']}",
            "",
            "```text",
            source["excerpt"],
            "```",
            "",
        ]
    )

packet_lines = [
    "# Multica Memory Packet",
    "",
    "packet_version: 1",
    f"atlas_task_id: {task_id}",
    f"generated_at: {generated_at}",
    f"prd_path: {display(prd_path, repo_path)}",
    f"prd_sha256: {prd_sha}",
    f"target_repo: {repo_path}",
    f"base_branch: {base_branch}",
    "precedence: advisory_prd_wins",
    "",
    "## Precedence",
    "",
    "This packet is advisory context only. The PRD is canonical. If this packet conflicts with the PRD, Multica must stop with a PRD fidelity blocker.",
    "",
    "## Scope",
    "",
    "- Task-scoped facts, decisions, constraints, risks, and validation hints only.",
    "- No broad memory exports or sensitive raw materials.",
    "",
    "## Sources",
    "",
    *source_rows,
    "",
    "## Curated Context",
    "",
    *context_sections,
    "## Multica Instructions",
    "",
    "- Treat this packet as low-priority advisory context.",
    "- Do not override the canonical PRD.",
    "- If packet context appears stale or conflicting, report a PRD fidelity blocker.",
    "",
]

packet_text = "\n".join(packet_lines)
actual_line_count = len(packet_text.splitlines())
if actual_line_count > 250:
    fail(f"generated packet too large: {actual_line_count} lines > 250")
reject_risky_text(packet_text, "generated packet")
packet_file.write_text(packet_text, encoding="utf-8")
print(
    "\t".join(
        [
            str(packet_file),
            str(prd_path),
            prd_sha,
            str(repo_path),
            base_branch,
            str(source_count),
            str(actual_line_count),
        ]
    )
)
PY
}

write_checkpoint_record() {
  local task_id="$1"
  local phase="$2"
  local summary="$3"
  local branch="$4"
  local worktree="$5"
  local compose_project="$6"
  local runtime_target="$7"
  local blocker="$8"
  local recorded_at="$9"
  local next_count="${10}"
  shift 10
  local next_steps=("$@")
  local artifact_dir ledger_file lifecycle_file
  artifact_dir="$(task_artifact_dir "$task_id")"
  ledger_file="$(task_ledger_file "$task_id")"
  lifecycle_file="$(task_lifecycle_file "$task_id")"
  python3 - "$task_id" "$artifact_dir" "$ledger_file" "$lifecycle_file" "$phase" "$summary" "$branch" "$worktree" "$compose_project" "$runtime_target" "$blocker" "$recorded_at" "$next_count" "${next_steps[@]}" <<'PY'
from pathlib import Path
import json
import sys

task_id = sys.argv[1]
artifact_dir = Path(sys.argv[2])
ledger_file = Path(sys.argv[3])
lifecycle_file = Path(sys.argv[4])
phase = sys.argv[5]
summary = sys.argv[6]
branch = sys.argv[7]
worktree = sys.argv[8]
compose_project = sys.argv[9]
runtime_target = sys.argv[10]
blocker = sys.argv[11]
recorded_at = sys.argv[12]
next_count = int(sys.argv[13])
next_steps = sys.argv[14 : 14 + next_count]

VALID_PHASES = {"intake", "plan", "implement", "verify", "repair", "handoff", "blocked", "done"}

def fail(message: str) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(1)

def one_line(value: str, label: str, allow_empty: bool = True) -> str:
    if any(ch in value for ch in "\n\r\t"):
        fail(f"invalid {label}: must be a single line")
    value = value.strip()
    if not allow_empty and not value:
        fail(f"invalid {label}: must be non-empty")
    return value

phase = one_line(phase, "phase", allow_empty=False)
summary = one_line(summary, "summary", allow_empty=False)
branch = one_line(branch, "branch")
worktree = one_line(worktree, "worktree")
compose_project = one_line(compose_project, "compose project")
runtime_target = one_line(runtime_target, "runtime target")
blocker = one_line(blocker, "blocker")
next_steps = [one_line(item, "next step", allow_empty=False) for item in next_steps]
if phase not in VALID_PHASES:
    fail(f"invalid phase: {phase}")
if phase == "blocked" and not blocker:
    fail("blocked phase requires --blocker")

artifact_dir.mkdir(parents=True, exist_ok=True)
event = {
    "kind": "checkpoint",
    "task_id": task_id,
    "created_at": recorded_at,
    "phase": phase,
    "summary": summary,
    "branch": branch or "-",
    "worktree": worktree or "-",
    "compose_project": compose_project or "-",
    "runtime_target": runtime_target or "-",
    "blocker": blocker or "-",
    "next": next_steps,
}
with ledger_file.open("a", encoding="utf-8") as fh:
    fh.write(json.dumps(event, ensure_ascii=False) + "\n")

events = []
if ledger_file.exists():
    for raw in ledger_file.read_text(encoding="utf-8", errors="replace").splitlines():
        if not raw.strip():
            continue
        try:
            events.append(json.loads(raw))
        except json.JSONDecodeError:
            continue

rows = [
    "| Created | Phase | Summary | Next |",
    "| --- | --- | --- | --- |",
]
for item in events[-20:]:
    next_display = "; ".join(item.get("next") or []) or "-"
    summary_display = str(item.get("summary", "-")).replace("|", "\\|")
    next_display = next_display.replace("|", "\\|")
    rows.append(
        f"| {item.get('created_at', '-')} | {item.get('phase', '-')} | {summary_display} | {next_display} |"
    )

next_lines = [f"- {item}" for item in next_steps] if next_steps else ["- None recorded."]
lifecycle_file.write_text(
    "\n".join(
        [
            "# Lifecycle",
            "",
            f"Updated: {recorded_at}",
            f"Atlas task: {task_id}",
            "",
            "## Current",
            "",
            f"- Phase: {phase}",
            f"- Summary: {summary}",
            f"- Branch: `{branch or '-'}`",
            f"- Worktree: `{worktree or '-'}`",
            f"- Compose project: `{compose_project or '-'}`",
            f"- Runtime target: `{runtime_target or '-'}`",
            f"- Blocker: {blocker or '-'}",
            "",
            "## Next",
            "",
            *next_lines,
            "",
            "## Recent Ledger",
            "",
            *rows,
            "",
        ]
    ),
    encoding="utf-8",
)

print(
    "\t".join(
        [
            str(ledger_file),
            str(lifecycle_file),
            phase,
            summary,
            branch or "-",
            worktree or "-",
            compose_project or "-",
            runtime_target or "-",
            blocker or "-",
            str(len(next_steps)),
        ]
    )
)
PY
}

write_source_snapshot() {
  local task_id="$1"
  local used_for="$2"
  local authority="$3"
  local freshness="$4"
  local recorded_at="$5"
  local source_count="$6"
  shift 6
  local sources=("$@")
  local artifact_dir sources_file provenance_file
  artifact_dir="$(task_artifact_dir "$task_id")"
  sources_file="$(task_sources_file "$task_id")"
  provenance_file="$(task_provenance_file "$task_id")"
  python3 - "$task_id" "$artifact_dir" "$sources_file" "$provenance_file" "$used_for" "$authority" "$freshness" "$recorded_at" "$source_count" "${sources[@]}" <<'PY'
from pathlib import Path
import hashlib
import json
import sys
from urllib.parse import urlparse

task_id = sys.argv[1]
artifact_dir = Path(sys.argv[2])
sources_file = Path(sys.argv[3])
provenance_file = Path(sys.argv[4])
used_for = sys.argv[5]
authority = sys.argv[6]
freshness = sys.argv[7]
recorded_at = sys.argv[8]
source_count = int(sys.argv[9])
sources = sys.argv[10 : 10 + source_count]

VALID_AUTHORITY = {"canonical", "advisory", "background"}
VALID_FRESHNESS = {"fresh", "stale", "unknown"}

def fail(message: str) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(1)

def one_line(value: str, label: str, allow_empty: bool = False) -> str:
    if any(ch in value for ch in "\n\r\t"):
        fail(f"invalid {label}: must be a single line")
    value = value.strip()
    if not allow_empty and not value:
        fail(f"invalid {label}: must be non-empty")
    return value

used_for = one_line(used_for, "used-for")
authority = one_line(authority or "advisory", "authority")
freshness = one_line(freshness or "unknown", "freshness")
if authority not in VALID_AUTHORITY:
    fail(f"invalid authority: {authority}")
if freshness not in VALID_FRESHNESS:
    fail(f"invalid freshness: {freshness}")
if source_count < 1:
    fail("at least one --source is required")

artifact_dir.mkdir(parents=True, exist_ok=True)
new_rows = []
for source in sources:
    source = one_line(source, "source")
    parsed = urlparse(source)
    row = {
        "task_id": task_id,
        "recorded_at": recorded_at,
        "source": source,
        "used_for": used_for,
        "authority": authority,
        "freshness": freshness,
    }
    if parsed.scheme in {"http", "https"}:
        row.update({"type": "url", "sha256": "-", "mtime": "-"})
    else:
        path = Path(source).expanduser()
        if not path.exists() or not path.is_file():
            fail(f"missing source file: {source}")
        path = path.resolve()
        row.update(
            {
                "type": "file",
                "source": str(path),
                "sha256": hashlib.sha256(path.read_bytes()).hexdigest(),
                "mtime": str(path.stat().st_mtime_ns),
            }
        )
    new_rows.append(row)

with sources_file.open("a", encoding="utf-8") as fh:
    for row in new_rows:
        fh.write(json.dumps(row, ensure_ascii=False) + "\n")

all_rows = []
if sources_file.exists():
    for raw in sources_file.read_text(encoding="utf-8", errors="replace").splitlines():
        if raw.strip():
            try:
                all_rows.append(json.loads(raw))
            except json.JSONDecodeError:
                pass

table_rows = [
    "| Source | Type | Authority | Freshness | Used For | SHA256 |",
    "| --- | --- | --- | --- | --- | --- |",
]
for row in all_rows[-50:]:
    table_rows.append(
        "| {source} | {type} | {authority} | {freshness} | {used_for} | `{sha}` |".format(
            source=f"`{row.get('source', '-')}`".replace("|", "\\|"),
            type=row.get("type", "-"),
            authority=row.get("authority", "-"),
            freshness=row.get("freshness", "-"),
            used_for=str(row.get("used_for", "-")).replace("|", "\\|"),
            sha=row.get("sha256", "-"),
        )
    )

bundle_file = artifact_dir / "prompt-bundle.json"
bundle_note = "No prompt bundle recorded yet."
if bundle_file.exists():
    bundle_note = f"Prompt bundle recorded at `{bundle_file.name}`."

provenance_file.write_text(
    "\n".join(
        [
            "# Provenance",
            "",
            f"Updated: {recorded_at}",
            f"Atlas task: {task_id}",
            "",
            "## Source Snapshots",
            "",
            *table_rows,
            "",
            "## Prompt Bundle",
            "",
            bundle_note,
            "",
        ]
    ),
    encoding="utf-8",
)

print("\t".join([str(sources_file), str(provenance_file), str(len(new_rows))]))
PY
}

write_prompt_bundle() {
  local task_id="$1"
  local bundle_id="$2"
  local agent="$3"
  local recorded_at="$4"
  local include_count="$5"
  shift 5
  local includes=("${@:1:$include_count}")
  shift "$include_count"
  local skill_count="$1"
  shift
  local skills=("${@:1:$skill_count}")
  local artifact_dir bundle_file provenance_file
  artifact_dir="$(task_artifact_dir "$task_id")"
  bundle_file="$(task_prompt_bundle_file "$task_id")"
  provenance_file="$(task_provenance_file "$task_id")"
  python3 - "$task_id" "$artifact_dir" "$bundle_file" "$provenance_file" "$bundle_id" "$agent" "$recorded_at" "$include_count" "${includes[@]}" "$skill_count" "${skills[@]}" <<'PY'
from pathlib import Path
import hashlib
import json
import sys

task_id = sys.argv[1]
artifact_dir = Path(sys.argv[2])
bundle_file = Path(sys.argv[3])
provenance_file = Path(sys.argv[4])
bundle_id = sys.argv[5]
agent = sys.argv[6]
recorded_at = sys.argv[7]
include_count = int(sys.argv[8])
idx = 9
includes = sys.argv[idx : idx + include_count]
idx += include_count
skill_count = int(sys.argv[idx])
idx += 1
skills = sys.argv[idx : idx + skill_count]

VALID_AGENTS = {"atlas", "multica", "reviewer", "e2e"}

def fail(message: str) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(1)

def one_line(value: str, label: str, allow_empty: bool = True) -> str:
    if any(ch in value for ch in "\n\r\t"):
        fail(f"invalid {label}: must be a single line")
    value = value.strip()
    if not allow_empty and not value:
        fail(f"invalid {label}: must be non-empty")
    return value

bundle_id = one_line(bundle_id or f"{task_id}-prompt-bundle", "bundle id", allow_empty=False)
agent = one_line(agent or "atlas", "agent", allow_empty=False)
if agent not in VALID_AGENTS:
    fail(f"invalid agent: {agent}")
if include_count < 1:
    fail("at least one --include is required")
skills = [one_line(item, "skill", allow_empty=False) for item in skills]

files = []
for raw in includes:
    one_line(raw, "include", allow_empty=False)
    path = Path(raw).expanduser()
    if not path.exists() or not path.is_file():
        fail(f"missing include file: {raw}")
    path = path.resolve()
    files.append(
        {
            "path": str(path),
            "sha256": hashlib.sha256(path.read_bytes()).hexdigest(),
            "bytes": path.stat().st_size,
        }
    )

artifact_dir.mkdir(parents=True, exist_ok=True)
bundle = {
    "bundle_id": bundle_id,
    "task_id": task_id,
    "recorded_at": recorded_at,
    "agent": agent,
    "files": files,
    "skills": skills,
}
bundle_file.write_text(json.dumps(bundle, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")

source_note = "No source snapshots recorded yet."
sources_file = artifact_dir / "sources.jsonl"
if sources_file.exists():
    source_note = f"Source snapshots recorded at `{sources_file.name}`."
file_rows = [
    "| Path | SHA256 | Bytes |",
    "| --- | --- | --- |",
]
for row in files:
    file_rows.append(f"| `{row['path']}` | `{row['sha256']}` | {row['bytes']} |")
skill_rows = [f"- {item}" for item in skills] if skills else ["- None recorded."]
provenance_file.write_text(
    "\n".join(
        [
            "# Provenance",
            "",
            f"Updated: {recorded_at}",
            f"Atlas task: {task_id}",
            "",
            "## Source Snapshots",
            "",
            source_note,
            "",
            "## Prompt Bundle",
            "",
            f"- Bundle ID: `{bundle_id}`",
            f"- Agent: {agent}",
            f"- Manifest: `{bundle_file.name}`",
            "",
            "### Included Files",
            "",
            *file_rows,
            "",
            "### Skills",
            "",
            *skill_rows,
            "",
        ]
    ),
    encoding="utf-8",
)

print("\t".join([str(bundle_file), str(provenance_file), bundle_id, agent, str(len(files)), str(len(skills))]))
PY
}

write_trace_promotion() {
  local task_id="$1"
  local source_ref="$2"
  local trace_type="$3"
  local reason="$4"
  local owner="$5"
  local recorded_at="$6"
  local artifact_dir trace_file
  artifact_dir="$(task_artifact_dir "$task_id")"
  trace_file="$(task_trace_candidates_file "$task_id")"
  python3 - "$task_id" "$artifact_dir" "$trace_file" "$source_ref" "$trace_type" "$reason" "$owner" "$recorded_at" <<'PY'
from pathlib import Path
import json
import re
import sys

task_id = sys.argv[1]
artifact_dir = Path(sys.argv[2])
trace_file = Path(sys.argv[3])
source_ref = sys.argv[4]
trace_type = sys.argv[5]
reason = sys.argv[6]
owner = sys.argv[7]
recorded_at = sys.argv[8]

VALID_TYPES = {"regression", "lesson", "workflow-rule"}
VALID_OWNERS = {"atlas", "multica", "project"}

def fail(message: str) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(1)

def one_line(value: str, label: str, allow_empty: bool = False) -> str:
    if any(ch in value for ch in "\n\r\t"):
        fail(f"invalid {label}: must be a single line")
    value = value.strip()
    if not allow_empty and not value:
        fail(f"invalid {label}: must be non-empty")
    return value

trace_type = one_line(trace_type, "type")
reason = one_line(reason, "reason")
owner = one_line(owner or "atlas", "owner")
if trace_type not in VALID_TYPES:
    fail(f"invalid type: {trace_type}")
if owner not in VALID_OWNERS:
    fail(f"invalid owner: {owner}")

artifact_dir.mkdir(parents=True, exist_ok=True)
if source_ref == "latest":
    candidates = sorted((artifact_dir / "verification").glob("*.md"))
    failed = []
    for path in candidates:
        text = path.read_text(encoding="utf-8", errors="replace")
        if re.search(r"^- verdict: failed$", text, re.MULTILINE) or re.search(r"^- exit_code: (?!0$).+", text, re.MULTILINE):
            failed.append(path)
    if not failed:
        fail("no failed verification record found for --from latest")
    source_path = failed[-1]
elif source_ref:
    source_path = Path(source_ref).expanduser()
    if not source_path.is_absolute():
        source_path = (Path.cwd() / source_path).resolve()
    if not source_path.exists() or not source_path.is_file():
        fail(f"missing trace source: {source_ref}")
else:
    fail("missing --from")

source_text = source_path.read_text(encoding="utf-8", errors="replace")
preview = "\n".join(source_text.splitlines()[:120])
if len(preview) > 6000:
    preview = preview[:6000].rstrip() + "\n... (truncated)"
candidate_id = f"T{recorded_at.replace('-', '').replace(':', '').replace('T', '').replace('Z', '')}"

if not trace_file.exists():
    trace_file.write_text("# Trace Candidates\n\n", encoding="utf-8")
with trace_file.open("a", encoding="utf-8") as fh:
    fh.write(
        "\n".join(
            [
                f"## {candidate_id}",
                "",
                f"- Recorded: {recorded_at}",
                f"- Type: {trace_type}",
                f"- Owner: {owner}",
                f"- Source: `{source_path}`",
                f"- Reason: {reason}",
                "",
                "### Trace Preview",
                "",
                "```text",
                preview,
                "```",
                "",
            ]
        )
    )

regression_path = "-"
if trace_type == "regression":
    regression_dir = artifact_dir / "regressions"
    regression_dir.mkdir(parents=True, exist_ok=True)
    regression_path = regression_dir / f"{candidate_id}.md"
    regression_path.write_text(
        "\n".join(
            [
                f"# Regression Candidate {candidate_id}",
                "",
                f"Source: `{source_path}`",
                f"Reason: {reason}",
                "",
                "## Reproduction",
                "",
                "Use the source trace above to build a project-specific regression test or checklist.",
                "",
            ]
        ),
        encoding="utf-8",
    )

event = {
    "kind": "trace-promote",
    "created_at": recorded_at,
    "candidate_id": candidate_id,
    "type": trace_type,
    "owner": owner,
    "source": str(source_path),
    "reason": reason,
    "regression": str(regression_path),
}
with (artifact_dir / "ledger.jsonl").open("a", encoding="utf-8") as fh:
    fh.write(json.dumps(event, ensure_ascii=False) + "\n")

print("\t".join([str(trace_file), candidate_id, str(source_path), trace_type, owner, str(regression_path)]))
PY
}

write_multica_feedback() {
  local task_id="$1"
  local issue="$2"
  local commit_sha="$3"
  local round="$4"
  local status="$5"
  local evidence_manifest="$6"
  local recorded_at="$7"
  local review_count="$8"
  shift 8
  local reviews=("${@:1:$review_count}")
  shift "$review_count"
  local e2e_count="$1"
  shift
  local e2es=("${@:1:$e2e_count}")
  shift "$e2e_count"
  local scorecard_count="$1"
  shift
  local scorecards=("${@:1:$scorecard_count}")
  shift "$scorecard_count"
  local finding_count="$1"
  shift
  local findings=("${@:1:$finding_count}")
  local artifact_dir feedback_file feedback_json
  artifact_dir="$(task_artifact_dir "$task_id")"
  feedback_file="$(task_multica_feedback_file "$task_id")"
  feedback_json="$(task_multica_feedback_json_file "$task_id")"
  python3 - "$task_id" "$artifact_dir" "$feedback_file" "$feedback_json" "$issue" "$commit_sha" "$round" "$status" "$evidence_manifest" "$recorded_at" "$review_count" "${reviews[@]}" "$e2e_count" "${e2es[@]}" "$scorecard_count" "${scorecards[@]}" "$finding_count" "${findings[@]}" <<'PY'
from pathlib import Path
import json
import re
import sys

task_id = sys.argv[1]
artifact_dir = Path(sys.argv[2])
feedback_file = Path(sys.argv[3])
feedback_json = Path(sys.argv[4])
issue = sys.argv[5]
commit_sha = sys.argv[6]
round_no = sys.argv[7]
status = sys.argv[8]
evidence_manifest = sys.argv[9]
recorded_at = sys.argv[10]
idx = 11
review_count = int(sys.argv[idx]); idx += 1
reviews = sys.argv[idx : idx + review_count]; idx += review_count
e2e_count = int(sys.argv[idx]); idx += 1
e2es = sys.argv[idx : idx + e2e_count]; idx += e2e_count
scorecard_count = int(sys.argv[idx]); idx += 1
scorecards = sys.argv[idx : idx + scorecard_count]; idx += scorecard_count
finding_count = int(sys.argv[idx]); idx += 1
findings = sys.argv[idx : idx + finding_count]

VALID_STATUS = {"clean", "repair-needed", "blocked"}

def fail(message: str) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(1)

def one_line(value: str, label: str, allow_empty: bool = True) -> str:
    if any(ch in value for ch in "\n\r\t"):
        fail(f"invalid {label}: must be a single line")
    value = value.strip()
    if not allow_empty and not value:
        fail(f"invalid {label}: must be non-empty")
    return value

issue = one_line(issue, "issue", allow_empty=False)
commit_sha = one_line(commit_sha, "commit", allow_empty=False)
round_no = one_line(round_no, "round", allow_empty=False)
status = one_line(status, "status", allow_empty=False)
evidence_manifest = one_line(evidence_manifest, "evidence manifest")
if status not in VALID_STATUS:
    fail(f"invalid status: {status}")
if not round_no.isdigit() or int(round_no) < 1:
    fail(f"invalid round: {round_no}")
if commit_sha != "unknown" and not re.fullmatch(r"[0-9a-fA-F]{7,64}", commit_sha):
    fail("invalid commit: expected 7-64 hex characters or unknown")
reviews = [one_line(item, "review", allow_empty=False) for item in reviews]
e2es = [one_line(item, "e2e", allow_empty=False) for item in e2es]
scorecards = [one_line(item, "scorecard", allow_empty=False) for item in scorecards]
findings = [one_line(item, "blocking finding", allow_empty=False) for item in findings]
if status in {"repair-needed", "blocked"} and not findings:
    fail(f"{status} status requires at least one --blocking-finding")

artifact_dir.mkdir(parents=True, exist_ok=True)
payload = {
    "task_id": task_id,
    "recorded_at": recorded_at,
    "issue": issue,
    "commit": commit_sha,
    "round": int(round_no),
    "status": status,
    "reviews": reviews,
    "e2e": e2es,
    "scorecards": scorecards,
    "evidence_manifest": evidence_manifest or "-",
    "blocking_findings": findings,
}
feedback_json.write_text(json.dumps(payload, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")

def bullets(items):
    return "\n".join(f"- `{item}`" for item in items) if items else "- None recorded."

feedback_file.write_text(
    "\n".join(
        [
            "# Multica Feedback",
            "",
            f"Recorded: {recorded_at}",
            f"Atlas task: {task_id}",
            "",
            "## Status",
            "",
            f"- Issue: `{issue}`",
            f"- Commit: `{commit_sha}`",
            f"- Round: {round_no}",
            f"- Status: {status}",
            f"- Evidence manifest: `{evidence_manifest or '-'}`",
            "",
            "## Review Evidence",
            "",
            bullets(reviews),
            "",
            "## E2E Evidence",
            "",
            bullets(e2es),
            "",
            "## Scorecards",
            "",
            bullets(scorecards),
            "",
            "## Blocking Findings",
            "",
            bullets(findings),
            "",
            "## Atlas Boundary",
            "",
            "Atlas records Multica feedback and next planning state. Atlas does not execute Multica repair loops.",
            "",
        ]
    ),
    encoding="utf-8",
)

event = {
    "kind": "multica-feedback",
    "created_at": recorded_at,
    "status": status,
    "issue": issue,
    "commit": commit_sha,
    "round": int(round_no),
    "blocking_findings": findings,
}
if status in {"repair-needed", "blocked"}:
    event["phase"] = "repair" if status == "repair-needed" else "blocked"
with (artifact_dir / "ledger.jsonl").open("a", encoding="utf-8") as fh:
    fh.write(json.dumps(event, ensure_ascii=False) + "\n")

print("\t".join([str(feedback_file), str(feedback_json), issue, commit_sha, round_no, status, str(len(findings))]))
PY
}

write_feedback_cycle() {
  local task_id="$1"
  local source="$2"
  local finding="$3"
  local severity="$4"
  local classification="$5"
  local route="$6"
  local recorded_at="$7"
  local row_count="$8"
  shift 8
  local rows=("${@:1:$row_count}")
  shift "$row_count"
  local evidence_count="$1"
  shift
  local evidence=("${@:1:$evidence_count}")
  local artifact_dir return_file
  artifact_dir="$(task_artifact_dir "$task_id")"
  return_file="$(task_return_to_plan_file "$task_id")"
  python3 - "$task_id" "$artifact_dir" "$return_file" "$source" "$finding" "$severity" "$classification" "$route" "$recorded_at" "$row_count" "${rows[@]}" "$evidence_count" "${evidence[@]}" <<'PY'
from pathlib import Path
import json
import sys

task_id = sys.argv[1]
artifact_dir = Path(sys.argv[2])
return_file = Path(sys.argv[3])
source = sys.argv[4]
finding = sys.argv[5]
severity = sys.argv[6]
classification = sys.argv[7]
route = sys.argv[8]
recorded_at = sys.argv[9]
idx = 10
row_count = int(sys.argv[idx]); idx += 1
rows = sys.argv[idx : idx + row_count]; idx += row_count
evidence_count = int(sys.argv[idx]); idx += 1
evidence = sys.argv[idx : idx + evidence_count]

VALID_SOURCES = {"verify", "design-review", "multica-review", "multica-e2e", "user"}
VALID_SEVERITY = {"blocking", "high", "medium", "low"}
VALID_CLASS = {"implementation-bug", "spec-gap", "acceptance-gap", "env-blocker", "prd-conflict", "scope-change"}
VALID_ROUTE = {"repair", "clarify", "new-prd", "blocker", "acceptance-update"}

def fail(message: str) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(1)

def one_line(value: str, label: str, allow_empty: bool = False) -> str:
    if any(ch in value for ch in "\n\r\t"):
        fail(f"invalid {label}: must be a single line")
    value = value.strip()
    if not allow_empty and not value:
        fail(f"invalid {label}: must be non-empty")
    return value

source = one_line(source, "source")
finding = one_line(finding, "finding")
severity = one_line(severity, "severity")
classification = one_line(classification, "classification")
route = one_line(route, "route")
rows = [one_line(item, "affected row", allow_empty=False) for item in rows]
evidence = [one_line(item, "evidence", allow_empty=False) for item in evidence]
if source not in VALID_SOURCES:
    fail(f"invalid source: {source}")
if severity not in VALID_SEVERITY:
    fail(f"invalid severity: {severity}")
if classification not in VALID_CLASS:
    fail(f"invalid classification: {classification}")
if route not in VALID_ROUTE:
    fail(f"invalid route: {route}")

artifact_dir.mkdir(parents=True, exist_ok=True)
ledger_file = artifact_dir / "ledger.jsonl"
previous_cycle = 0
if ledger_file.exists():
    for raw in ledger_file.read_text(encoding="utf-8", errors="replace").splitlines():
        try:
            event = json.loads(raw)
        except json.JSONDecodeError:
            continue
        previous_cycle = max(previous_cycle, int(event.get("plan_cycle") or 0))

creates_cycle = severity in {"blocking", "high"} or bool(rows)
cycle = previous_cycle + 1 if creates_cycle else previous_cycle
cycle_status = "new-cycle" if creates_cycle else "current-cycle-note"
cycle_file = "-"
if creates_cycle:
    cycle_dir = artifact_dir / "plan-cycles"
    cycle_dir.mkdir(parents=True, exist_ok=True)
    cycle_file_path = cycle_dir / f"cycle-{cycle}.md"
    cycle_file = str(cycle_file_path)
    cycle_row_lines = [f"- {item}" for item in rows] if rows else ["- None specified."]
    cycle_evidence_lines = [f"- `{item}`" for item in evidence] if evidence else ["- None recorded."]
    cycle_file_path.write_text(
        "\n".join(
            [
                f"# Plan Cycle {cycle}",
                "",
                f"Created: {recorded_at}",
                f"Source: {source}",
                f"Severity: {severity}",
                f"Classification: {classification}",
                f"Route: {route}",
                f"Finding: {finding}",
                "",
                "## Affected Acceptance Rows",
                "",
                *cycle_row_lines,
                "",
                "## Evidence",
                "",
                *cycle_evidence_lines,
                "",
            ]
        ),
        encoding="utf-8",
    )

event = {
    "kind": "feedback-cycle",
    "created_at": recorded_at,
    "plan_cycle": cycle,
    "cycle_status": cycle_status,
    "source": source,
    "finding": finding,
    "severity": severity,
    "classification": classification,
    "route": route,
    "affected_rows": rows,
    "evidence": evidence,
}
with ledger_file.open("a", encoding="utf-8") as fh:
    fh.write(json.dumps(event, ensure_ascii=False) + "\n")

row_lines = [f"- {item}" for item in rows] if rows else ["- None specified."]
evidence_lines = [f"- `{item}`" for item in evidence] if evidence else ["- None recorded."]
return_file.write_text(
    "\n".join(
        [
            "# Return-To-Plan Feedback",
            "",
            f"Updated: {recorded_at}",
            f"Atlas task: {task_id}",
            "",
            "## Latest Feedback",
            "",
            f"- Cycle status: {cycle_status}",
            f"- Active plan cycle: {cycle}",
            f"- Source: {source}",
            f"- Severity: {severity}",
            f"- Classification: {classification}",
            f"- Route: {route}",
            f"- Finding: {finding}",
            "",
            "## Stale / Affected Acceptance Rows",
            "",
            *row_lines,
            "",
            "## Evidence",
            "",
            *evidence_lines,
            "",
            "## Rule",
            "",
            "Non-clean required validation must either create a new plan/spec cycle or record why the current plan still applies.",
            "",
        ]
    ),
    encoding="utf-8",
)

print("\t".join([str(return_file), cycle_file, str(cycle), cycle_status, route, ";".join(rows) if rows else "-"]))
PY
}

write_lesson_candidate() {
  local task_id="$1"
  local trigger="$2"
  local lesson="$3"
  local recorded_at="$4"
  local evidence_count="$5"
  shift 5
  local evidence=("$@")
  local artifact_dir lesson_file
  artifact_dir="$(task_artifact_dir "$task_id")"
  lesson_file="$(task_lesson_candidates_file "$task_id")"
  python3 - "$task_id" "$artifact_dir" "$lesson_file" "$trigger" "$lesson" "$recorded_at" "$evidence_count" "${evidence[@]}" <<'PY'
from pathlib import Path
import json
import sys

task_id = sys.argv[1]
artifact_dir = Path(sys.argv[2])
lesson_file = Path(sys.argv[3])
trigger = sys.argv[4]
lesson = sys.argv[5]
recorded_at = sys.argv[6]
evidence_count = int(sys.argv[7])
evidence = sys.argv[8 : 8 + evidence_count]

VALID_TRIGGERS = {"repeated-failure", "remote", "ui", "data-contract", "multica-feedback", "manual"}

def fail(message: str) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(1)

def one_line(value: str, label: str, allow_empty: bool = False) -> str:
    if any(ch in value for ch in "\n\r\t"):
        fail(f"invalid {label}: must be a single line")
    value = value.strip()
    if not allow_empty and not value:
        fail(f"invalid {label}: must be non-empty")
    return value

trigger = one_line(trigger, "trigger")
lesson = one_line(lesson, "lesson")
evidence = [one_line(item, "evidence", allow_empty=False) for item in evidence]
if trigger not in VALID_TRIGGERS:
    fail(f"invalid trigger: {trigger}")

artifact_dir.mkdir(parents=True, exist_ok=True)
candidate_id = f"L{recorded_at.replace('-', '').replace(':', '').replace('T', '').replace('Z', '')}"
if not lesson_file.exists():
    lesson_file.write_text("# Lesson Candidates\n\n", encoding="utf-8")
