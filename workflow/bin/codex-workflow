      *) echo 'usage: codex-workflow lesson-candidate <task-id> --trigger repeated-failure|remote|ui|data-contract|multica-feedback|manual --lesson "<candidate>" [--evidence <path-or-url>]...' >&2; exit 1 ;;
    esac
  done
  [[ -n "$trigger" ]] || { echo "missing required argument: --trigger" >&2; exit 1; }
