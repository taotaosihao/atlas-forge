from pathlib import Path
import json
import sys

path = Path(sys.argv[1])
kind = sys.argv[2]
detail = sys.argv[3]
created = sys.argv[4]
path.parent.mkdir(parents=True, exist_ok=True)
with path.open("a", encoding="utf-8") as fh:
    fh.write(json.dumps({"kind": kind, "detail": detail, "created_at": created}, ensure_ascii=False) + "\n")
PY
}

sync_task_runtime() {
  local task_id="$1"
  local task_file title artifact_dir_rel last_verified_at active_team_backend active_team_mode active_team_status active_team_decision
  task_file="$(require_task "$task_id")"
  title="$(get_field "$task_file" title)"
  artifact_dir_rel="$(task_artifact_dir_rel "$task_id")"
  last_verified_at="$(get_field "$task_file" last_verified_at)"
  active_team_backend="$(get_field "$task_file" active_team_backend)"
  active_team_mode="$(get_field "$task_file" active_team_mode)"
  active_team_status="$(get_field "$task_file" active_team_status)"
  active_team_decision="$(get_field "$task_file" active_team_decision)"
  ensure_state_dir
  ensure_artifacts_dir
  ensure_task_runtime_scaffold "$task_id" "$title"
  upsert_task_fields "$task_file" \
    "artifact_dir=$artifact_dir_rel" \
    "last_verified_at=$last_verified_at" \
    "active_team_backend=$active_team_backend" \
    "active_team_mode=$active_team_mode" \
    "active_team_status=$active_team_status" \
    "active_team_decision=$active_team_decision"
  write_task_state_json "$task_id"
}

header_field_count() {
  local file="$1"
  local field="$2"

  awk -v want="$field" '
    BEGIN {
      in_header = 1
      count = 0
    }
    {
      line = $0
      sub(/\r$/, "", line)
      if (in_header) {
        if (line ~ "^" want ": ") {
          count++
        } else if (line ~ /^$/ || line ~ /^##[[:space:]]/ || line ~ /^#[[:space:]]/) {
          in_header = 0
        } else if (line ~ /^[A-Za-z0-9_.-]+: /) {
          # Keep unknown metadata lines in the header.
        } else {
          in_header = 0
        }
      }
    }
    END {
      print count
    }
  ' "$file" | head -n 1
}

render_learning() {
  local file="$1"
  local task_id="$2"
  local title="$3"
  local lesson="$4"
  local now="${5:-}"

  if [[ -z "$now" ]]; then
    now="$(today)"
  fi
  TASK_ID="$task_id" \
  TITLE="$title" \
  CREATED="$now" \
  LESSON="$lesson" \
  perl -pe 's/\{\{(TASK_ID|TITLE|CREATED|LESSON)\}\}/$ENV{$1}/ge' \
    "$LEARNING_TEMPLATE" > "$file"
}

learning_basename() {
  local task_id="$1"
  local title="$2"
  local token checksum

  token="$(title_token "$title")"
  if [[ "$token" =~ ^u[0-9]+$ ]]; then
    printf '%s-%s\n' "$task_id" "$token"
    return
  fi

  checksum="$(title_checksum "$title")"
  printf '%s-%s-%s\n' "$task_id" "$token" "$checksum"
}

update_learning_index() {
  local basename="$1"
  local title="$2"
  local task_id="$3"
  local entry

  if [[ ! -s "$LEARNING_INDEX" ]]; then
    printf '# Learnings\n\n' > "$LEARNING_INDEX"
  fi

  entry="- [[${basename}]] title: ${title} | source task: ${task_id}"
  if ! grep -Fqx -- "$entry" "$LEARNING_INDEX" 2>/dev/null; then
    printf '%s\n' "$entry" >> "$LEARNING_INDEX"
  fi
}

update_learning_search_index() {
  local basename="$1"
  local title="$2"
  local task_id="$3"
  local created="$4"
  local lesson="$5"

  python3 - "$LEARNING_SEARCH_INDEX" "$basename" "$title" "$task_id" "$created" "$lesson" <<'PY'
import json
import os
import sys
import tempfile

path, learning_id, title, task_id, created, lesson = sys.argv[1:]
rows = []

if os.path.exists(path):
    with open(path, encoding="utf-8") as fh:
        for raw in fh:
            raw = raw.strip()
            if not raw:
                continue
            try:
                row = json.loads(raw)
            except json.JSONDecodeError:
                continue
            if row.get("id") != learning_id:
                rows.append(row)

rows.append({
    "id": learning_id,
    "title": title,
    "task_id": task_id,
    "created": created,
    "lesson": lesson,
})

directory = os.path.dirname(path) or "."
fd, tmp = tempfile.mkstemp(prefix="codex-memory-", suffix=".jsonl", dir=directory)
os.close(fd)
with open(tmp, "w", encoding="utf-8") as fh:
    for row in rows:
        fh.write(json.dumps(row, ensure_ascii=False) + "\n")
os.replace(tmp, path)
PY
}

sync_codex_memory() {
  validate_positive_integer "$MEMORY_RECENT_DAYS" "memory recent days"
  ensure_tasks_dir
  ensure_learnings_dir
  ensure_memory_dir

  python3 - "$TASKS_DIR" "$LEARNINGS_DIR" "$MEMORY_INDEX" "$TASK_MEMORY_INDEX" "$RECENT_LEARNINGS_INDEX" "$MEMORY_SEARCH_INDEX" "$MEMORY_RECENT_DAYS" <<'PY'
import json
import os
import re
import sys
import tempfile
from datetime import date, timedelta
from pathlib import Path

tasks_dir = Path(sys.argv[1])
learnings_dir = Path(sys.argv[2])
memory_index_path = Path(sys.argv[3])
task_memory_path = Path(sys.argv[4])
recent_learnings_path = Path(sys.argv[5])
memory_search_index_path = Path(sys.argv[6])
recent_days = int(sys.argv[7])
today = date.today()
cutoff = today - timedelta(days=recent_days - 1)


def read_text(path: Path) -> str:
    return path.read_text(encoding="utf-8")


def get_field(text: str, field: str) -> str:
    match = re.search(rf"^{re.escape(field)}: (.*)$", text, re.MULTILINE)
    return match.group(1).strip() if match else ""


def get_section(text: str, heading: str) -> str:
    marker = f"## {heading}\n"
    if marker not in text:
        return ""
    tail = text.split(marker, 1)[1]
    split = re.split(r"\n##[ ]|\n#[ ]", tail, maxsplit=1)
    return split[0].strip()


def normalize(value: str) -> str:
    return re.sub(r"\s+", " ", value.strip())


def excerpt(value: str, limit: int = 160) -> str:
    compact = normalize(value)
    if len(compact) <= limit:
        return compact
    return compact[: limit - 3].rstrip() + "..."


def parse_iso_day(value: str):
    try:
        return date.fromisoformat(value)
    except ValueError:
        return None


def parse_task(path: Path) -> dict:
    text = read_text(path)
    return {
        "kind": "task",
        "id": get_field(text, "id") or path.stem,
        "title": get_field(text, "title"),
        "status": get_field(text, "status"),
        "created": get_field(text, "created"),
        "updated": get_field(text, "updated"),
        "success_criteria": normalize(get_section(text, "Success Criteria")),
        "path": str(path),
    }


def parse_learning(path: Path) -> dict:
    text = read_text(path)
    return {
        "kind": "learning",
        "id": path.stem,
        "title": get_field(text, "title"),
        "task_id": get_field(text, "source-task-id"),
        "created": get_field(text, "created"),
        "lesson": normalize(get_section(text, "Lesson")),
        "path": str(path),
    }


def task_sort_key(row: dict):
    status_order = {"doing": 0, "todo": 1, "done": 2}
    return (status_order.get(row.get("status", ""), 9), row.get("id", ""))


def day_sort_key(row: dict, field: str):
    parsed = parse_iso_day(row.get(field, ""))
    return (parsed or date.min, row.get("id", ""))


def write_atomic(path: Path, content: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix="codex-memory-", suffix=".tmp", dir=str(path.parent))
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(content)
        os.replace(tmp, path)
    except Exception:
        try:
            os.unlink(tmp)
        except FileNotFoundError:
            pass
        raise


tasks = [parse_task(path) for path in sorted(tasks_dir.glob("*.md"))]
learnings = []
for path in sorted(learnings_dir.glob("*.md")):
    if path.name in {"index.md", "RECENT.md"}:
        continue
    learnings.append(parse_learning(path))

active_tasks = sorted(
    [row for row in tasks if row.get("status") in {"todo", "doing"}],
    key=task_sort_key,
)
recent_done_tasks = [
    row
    for row in tasks
    if row.get("status") == "done"
    and (parse_iso_day(row.get("updated", "")) or date.min) >= cutoff
]
recent_done_tasks.sort(key=lambda row: day_sort_key(row, "updated"), reverse=True)
recent_learnings = sorted(learnings, key=lambda row: day_sort_key(row, "created"), reverse=True)

memory_rows = []
for row in tasks:
    memory_rows.append(
        {
            "kind": "task",
            "id": row.get("id", ""),
            "title": row.get("title", ""),
            "status": row.get("status", ""),
            "created": row.get("created", ""),
            "updated": row.get("updated", ""),
            "success_criteria": row.get("success_criteria", ""),
            "path": row.get("path", ""),
        }
    )
for row in learnings:
    memory_rows.append(
        {
            "kind": "learning",
            "id": row.get("id", ""),
            "title": row.get("title", ""),
            "task_id": row.get("task_id", ""),
            "created": row.get("created", ""),
            "lesson": row.get("lesson", ""),
            "path": row.get("path", ""),
        }
    )
memory_rows.sort(
    key=lambda row: (
        row.get("updated", row.get("created", "")),
        row.get("kind", ""),
        row.get("id", ""),
    ),
    reverse=True,
)

memory_lines = [
    "# Codex Memory",
    "",
    f"Updated: {today.isoformat()}",
    "",
    "## Snapshot",
    f"- Open tasks: {len(active_tasks)}",
    f"- Recent completed tasks ({recent_days} days): {len(recent_done_tasks)}",
    f"- Saved learnings: {len(learnings)}",
    "",
    "## Active Tasks",
]
if active_tasks:
    for row in active_tasks[:10]:
        memory_lines.append(
            f"- [{row.get('status', '')}] {row.get('id', '')} | {row.get('title', '')} | updated {row.get('updated', '')}"
        )
        if row.get("success_criteria"):
            memory_lines.append(f"  Success: {excerpt(row['success_criteria'])}")
else:
    memory_lines.append("- No open tasks.")

memory_lines.extend(["", f"## Recent Completions ({recent_days} Days)"])
if recent_done_tasks:
    for row in recent_done_tasks[:10]:
        memory_lines.append(
            f"- {row.get('id', '')} | {row.get('title', '')} | updated {row.get('updated', '')}"
        )
else:
    memory_lines.append("- No recent completions.")

memory_lines.extend(["", "## Recent Learnings"])
if recent_learnings:
    for row in recent_learnings[:10]:
        memory_lines.append(
            f"- {row.get('title', '')} | source task {row.get('task_id', '')} | created {row.get('created', '')}"
        )
        if row.get("lesson"):
            memory_lines.append(f"  Lesson: {excerpt(row['lesson'])}")
else:
    memory_lines.append("- No saved learnings yet.")

memory_lines.extend(
    [
        "",
        "## Files",
        "- [Task Summary](tasks.md)",
        "- [Recent Learnings](learnings/RECENT.md)",
        "- [Full Learning Index](learnings/index.md)",
        "- Structured memory: `memory.jsonl`",
        "",
    ]
)

task_lines = [
    "# Task Memory",
    "",
    f"Updated: {today.isoformat()}",
    "",
    "## Open Tasks",
]
if active_tasks:
    for row in active_tasks:
        task_lines.append(f"- [{row.get('status', '')}] {row.get('id', '')} | {row.get('title', '')}")
        task_lines.append(
            f"  Created: {row.get('created', '')} | Updated: {row.get('updated', '')}"
        )
        if row.get("success_criteria"):
            task_lines.append(f"  Success: {excerpt(row['success_criteria'], 220)}")
else:
    task_lines.append("- No open tasks.")

task_lines.extend(["", f"## Recent Completions ({recent_days} Days)"])
if recent_done_tasks:
    for row in recent_done_tasks[:20]:
        task_lines.append(f"- {row.get('id', '')} | {row.get('title', '')}")
        task_lines.append(
            f"  Created: {row.get('created', '')} | Updated: {row.get('updated', '')}"
        )
        if row.get("success_criteria"):
            task_lines.append(f"  Success: {excerpt(row['success_criteria'], 220)}")
else:
    task_lines.append("- No recent completions.")
task_lines.append("")

learning_lines = [
    "# Recent Learnings",
    "",
    f"Updated: {today.isoformat()}",
    "",
    "## Latest Entries",
]
if recent_learnings:
    for row in recent_learnings[:20]:
        learning_lines.append(
            f"- {row.get('title', '')} | source task {row.get('task_id', '')} | created {row.get('created', '')}"
        )
        if row.get("lesson"):
            learning_lines.append(f"  Lesson: {excerpt(row['lesson'], 220)}")
else:
    learning_lines.append("- No saved learnings yet.")
learning_lines.extend(["", "## Full Index", "- See `index.md` for the complete learning list.", ""])

write_atomic(memory_index_path, "\n".join(memory_lines))
write_atomic(task_memory_path, "\n".join(task_lines))
write_atomic(recent_learnings_path, "\n".join(learning_lines))
write_atomic(
    memory_search_index_path,
    "".join(json.dumps(row, ensure_ascii=False) + "\n" for row in memory_rows),
)
PY
}

require_task() {
  local id="$1"
  local file
  file="$(task_file "$id")"
  if [[ ! -f "$file" ]]; then
    echo "unknown task: $id" >&2
    if ids="$(list_task_ids)" && [[ -n "$ids" ]]; then
      echo "known tasks:" >&2
      printf '%s\n' "$ids" >&2
    fi
    exit 1
  fi
  printf '%s\n' "$file"
}

validate_task_for_update() {
  local file="$1"
  local missing=()
  local duplicate=()
  local expected_id task_id title status created updated
  local id_count title_count status_count created_count updated_count

  expected_id="$(basename "$file" .md)"
  id_count="$(header_field_count "$file" id)"
  title_count="$(header_field_count "$file" title)"
  status_count="$(header_field_count "$file" status)"
  created_count="$(header_field_count "$file" created)"
  updated_count="$(header_field_count "$file" updated)"

  if [[ "$id_count" -eq 0 ]]; then missing+=("id"); elif [[ "$id_count" -gt 1 ]]; then duplicate+=("id"); fi
  if [[ "$title_count" -eq 0 ]]; then missing+=("title"); elif [[ "$title_count" -gt 1 ]]; then duplicate+=("title"); fi
  if [[ "$status_count" -eq 0 ]]; then missing+=("status"); elif [[ "$status_count" -gt 1 ]]; then duplicate+=("status"); fi
  if [[ "$created_count" -eq 0 ]]; then missing+=("created"); elif [[ "$created_count" -gt 1 ]]; then duplicate+=("created"); fi
  if [[ "$updated_count" -eq 0 ]]; then missing+=("updated"); elif [[ "$updated_count" -gt 1 ]]; then duplicate+=("updated"); fi

  if ((${#missing[@]} > 0)); then
    echo "malformed task file: $file missing ${missing[*]}" >&2
    exit 1
  fi

  if ((${#duplicate[@]} > 0)); then
    echo "malformed task file: $file duplicate ${duplicate[*]}" >&2
    exit 1
  fi

  task_id="$(get_field "$file" id)"
  title="$(get_field "$file" title)"
  status="$(get_field "$file" status)"
  created="$(get_field "$file" created)"
  # shellcheck disable=SC2034  # read for header symmetry; validation uses updated_count only
  updated="$(get_field "$file" updated)"

  if [[ "$task_id" != "$expected_id" ]]; then
    echo "malformed task file: $file filename/id mismatch ($expected_id != $task_id)" >&2
    exit 1
  fi

  case "$status" in
    todo|doing|blocked|done|archived)
      ;;
    *)
      echo "malformed task file: $file invalid status $status" >&2
      exit 1
      ;;
  esac
}

set_config_feature() {
  local file="$1"
  local feature="$2"
  local value="$3"
  python3 - "$file" "$feature" "$value" <<'PY'
from pathlib import Path
import re
import sys

path = Path(sys.argv[1])
feature = sys.argv[2]
value = sys.argv[3].lower()
text = path.read_text(encoding="utf-8") if path.exists() else ""
lines = text.splitlines()

features_start = None
features_end = None
for idx, line in enumerate(lines):
    stripped = line.strip()
    if stripped == "[features]":
        features_start = idx
        features_end = len(lines)
        for follow in range(idx + 1, len(lines)):
            if lines[follow].startswith("[") and lines[follow].endswith("]"):
                features_end = follow
                break
        break

if features_start is None:
    if lines and lines[-1] != "":
        lines.append("")
    lines.extend(["[features]", f"{feature} = {value}"])
else:
    replaced = False
    for idx in range(features_start + 1, features_end):
        if re.match(rf"^{re.escape(feature)}\s*=", lines[idx].strip()):
            lines[idx] = f"{feature} = {value}"
            replaced = True
            break
    if not replaced:
        lines.insert(features_end, f"{feature} = {value}")

path.parent.mkdir(parents=True, exist_ok=True)
path.write_text("\n".join(lines).rstrip() + "\n", encoding="utf-8")
PY
}

merge_workflow_hooks_json() {
  local file="$1"
  local pre_hook="$2"
  local post_hook="$3"
  python3 - "$file" "$pre_hook" "$post_hook" <<'PY'
from pathlib import Path
import json
import sys

path = Path(sys.argv[1])
pre_hook = sys.argv[2]
post_hook = sys.argv[3]

try:
    data = json.loads(path.read_text(encoding="utf-8")) if path.exists() else {}
except json.JSONDecodeError:
    data = {}

hooks = data.setdefault("hooks", {})

def ensure_entry(name: str, command: str) -> None:
    entries = hooks.setdefault(name, [])
    for entry in entries:
        for hook in entry.get("hooks", []):
            if hook.get("type") == "command" and hook.get("command") == command:
                return
    entries.append(
        {
            "matcher": "Bash",
            "hooks": [
                {
                    "type": "command",
                    "command": command,
                }
            ],
        }
    )

ensure_entry("PreToolUse", pre_hook)
ensure_entry("PostToolUse", post_hook)

path.parent.mkdir(parents=True, exist_ok=True)
path.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
PY
}

install_workflow_hook_script() {
  local name="$1"
  local source="$SOURCE_HOOKS_DIR/$name"
  local target="$HOOKS_DIR/$name"
  if [[ ! -f "$source" ]]; then
    echo "missing workflow hook source: $source" >&2
    exit 1
  fi
  ensure_hooks_dir
  if [[ "$source" != "$target" ]]; then
    cp "$source" "$target"
  fi
  chmod +x "$target"
  printf '%s\n' "$target"
}

write_verification_record() {
  node "$SCRIPT_DIR/lib/codex-workflow/verification/record-cli.js" "$@"
}

config_feature_value() {
  python3 - "$CODEX_CONFIG_FILE" "$1" <<'PY'
from pathlib import Path
import sys

feature = sys.argv[2]
path = Path(sys.argv[1])
if not path.exists():
    raise SystemExit(0)

current_section = ""
for raw in path.read_text(encoding="utf-8").splitlines():
    line = raw.strip()
    if line.startswith("[") and line.endswith("]"):
        current_section = line
        continue
    if current_section == "[features]" and line.startswith(feature):
        _, value = line.split("=", 1)
        print(value.strip())
        break
PY
}

config_network_summary() {
  python3 - "$CODEX_CONFIG_FILE" <<'PY'
from pathlib import Path
import json
import os
import re
import sys

path = Path(sys.argv[1])
items = []
if path.exists():
    for raw in path.read_text(encoding="utf-8").splitlines():
        if re.search(r"base_url|baseURL|proxy", raw, re.IGNORECASE):
            items.append(raw.strip())
for key in ("HTTP_PROXY", "HTTPS_PROXY", "ALL_PROXY", "NO_PROXY"):
    value = os.environ.get(key)
    if value:
        items.append(f"{key}={value}")
print("; ".join(items[:8]))
PY
}

doctor_report() {
  local current_task_id="${1:-}"
  local output_format="${2:-text}"
  local codex_path login_output hooks_value legacy_hooks_value network_summary paseo_path paseo_summary
  codex_path="$(command -v "$CODEX_BIN" 2>/dev/null || true)"
  if [[ -n "$codex_path" ]]; then
    login_output="$("$CODEX_BIN" login status 2>&1 || true)"
  else
    login_output="missing codex executable"
  fi
  hooks_value="$(config_feature_value hooks)"
  legacy_hooks_value="$(config_feature_value codex_hooks)"
  network_summary="$(config_network_summary)"
  paseo_path="$(command -v "$PASEO_BIN" 2>/dev/null || true)"
  if [[ -n "$paseo_path" ]]; then
    paseo_summary="$("$PASEO_BIN" provider ls --json 2>/dev/null | tr '\n' ' ' || true)"
  else
    paseo_summary=""
  fi

  python3 - "$output_format" "$current_task_id" "$(timestamp_utc)" "$WORKFLOW_ROOT" "$CODEX_HOME_ROOT" "$TASKS_DIR" "$STATE_DIR" "$ARTIFACTS_DIR" "$HOOKS_DIR" "$SOURCE_HOOKS_DIR" "$CODEX_CONFIG_FILE" "$CODEX_HOOKS_FILE" "$ATLAS_SOURCE_SKILLS_DIR" "$ATLAS_CACHE_SKILLS_DIR" "$CURRENT_TASK_FILE" "${codex_path:-missing}" "${login_output:-unknown}" "${hooks_value:-unset}" "${legacy_hooks_value:-unset}" "${network_summary:-none}" "${paseo_path:-missing}" "$paseo_summary" <<'PY'
from pathlib import Path
import json
import sys

output_format = sys.argv[1]
current_task_id = sys.argv[2]
generated_at = sys.argv[3]
workflow_root = Path(sys.argv[4])
codex_home = Path(sys.argv[5])
tasks_dir = Path(sys.argv[6])
state_dir = Path(sys.argv[7])
artifacts_dir = Path(sys.argv[8])
hooks_dir = Path(sys.argv[9])
source_hooks_dir = Path(sys.argv[10])
config_file = Path(sys.argv[11])
hooks_file = Path(sys.argv[12])
source_skills_dir = Path(sys.argv[13])
cache_skills_dir = Path(sys.argv[14])
current_task_file = Path(sys.argv[15])
codex_path = sys.argv[16]
login_output = sys.argv[17]
hooks_value = sys.argv[18]
legacy_hooks_value = sys.argv[19]
network_summary = sys.argv[20]
paseo_path = sys.argv[21]
paseo_summary = sys.argv[22]


def path_info(path: Path) -> dict:
    return {
        "path": str(path),
        "exists": path.exists(),
        "is_file": path.is_file(),
        "is_dir": path.is_dir(),
    }


def read_json(path: Path):
    if not path.exists():
        return None
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return None


def read_runtime_events(task_id: str) -> list:
    if not task_id:
        return []
    runtime_file = artifacts_dir / task_id / "runtime.jsonl"
    rows = []
    if not runtime_file.exists():
        return rows
    for raw in runtime_file.read_text(encoding="utf-8", errors="replace").splitlines():
        if not raw.strip():
            continue
        try:
            rows.append(json.loads(raw))
        except json.JSONDecodeError:
            rows.append({"kind": "invalid-jsonl", "raw": raw[:200]})
    return rows


def build_install() -> dict:
    required_dirs = {
        "workflow_root": path_info(workflow_root),
        "tasks_dir": path_info(tasks_dir),
        "state_dir": path_info(state_dir),
        "artifacts_dir": path_info(artifacts_dir),
    }
    missing_dirs = [name for name, info in required_dirs.items() if not info["exists"]]
    status = "ok"
    if missing_dirs:
        status = "missing"
    elif codex_path == "missing":
        status = "warn"
    return {
        "status": status,
        "codex_executable": codex_path,
        "codex_login": login_output,
        "codex_home": str(codex_home),
        "config_toml": str(config_file),
        "network_summary": network_summary,
        "paseo": paseo_path,
        "paseo_providers": paseo_summary,
        "paths": required_dirs,
    }


def build_source_cache() -> dict:
    source_info = path_info(source_skills_dir)
    cache_info = path_info(cache_skills_dir)
    checked = []
    missing = []
    mismatches = []
    if source_skills_dir.is_dir() and cache_skills_dir.is_dir():
        for source_skill in sorted(source_skills_dir.glob("*/SKILL.md")):
            skill_name = source_skill.parent.name
            cache_skill = cache_skills_dir / skill_name / "SKILL.md"
            if not cache_skill.exists():
                missing.append(skill_name)
                continue
            checked.append(skill_name)
            if source_skill.read_bytes() != cache_skill.read_bytes():
                mismatches.append(skill_name)
    status = "unknown"
    if not source_info["exists"] or not cache_info["exists"]:
        status = "unknown"
    elif missing or mismatches:
        status = "mismatch"
    else:
        status = "ok"
    return {
        "status": status,
        "source_dir": str(source_skills_dir),
        "cache_dir": str(cache_skills_dir),
        "checked": checked,
        "missing": missing,
        "mismatches": mismatches,
    }


def hook_commands() -> list:
    data = read_json(hooks_file)
    commands = []
    if not isinstance(data, dict):
        return commands
    hooks = data.get("hooks", {})
    if not isinstance(hooks, dict):
        return commands
    for entries in hooks.values():
        if not isinstance(entries, list):
            continue
        for entry in entries:
            for hook in entry.get("hooks", []) if isinstance(entry, dict) else []:
                command = hook.get("command") if isinstance(hook, dict) else None
                if command:
                    commands.append(str(command))
    return commands


def build_hooks_config() -> dict:
    target_pre = hooks_dir / "pre-tool-use"
    target_post = hooks_dir / "post-tool-use"
    source_pre = source_hooks_dir / "pre-tool-use"
    source_post = source_hooks_dir / "post-tool-use"
    commands = hook_commands()
    target_hooks_exist = target_pre.exists() and target_post.exists()
    source_hooks_exist = source_pre.exists() and source_post.exists()
    commands_configured = any("pre-tool-use" in item for item in commands) and any("post-tool-use" in item for item in commands)
    enabled = hooks_value.lower() == "true" or legacy_hooks_value.lower() == "true"
    if enabled and hooks_file.exists() and target_hooks_exist and commands_configured:
        status = "ok"
    elif enabled or hooks_file.exists() or target_hooks_exist or commands_configured:
        status = "partial"
    else:
        status = "missing"
    return {
        "status": status,
        "features.hooks": hooks_value,
        "features.codex_hooks": legacy_hooks_value,
        "hooks_json": path_info(hooks_file),
        "target_pre_hook": path_info(target_pre),
        "target_post_hook": path_info(target_post),
        "source_hooks_exist": source_hooks_exist,
        "target_hooks_exist": target_hooks_exist,
        "commands_configured": commands_configured,
        "commands": commands,
    }


def build_hooks_runtime(hooks_config_status: str) -> dict:
    events = read_runtime_events(current_task_id)
    proof_events = [
        row for row in events
        if row.get("kind") in {"pre-tool-risk", "post-tool-failure"}
    ]
    failure_dir = artifacts_dir / current_task_id / "hook-failures" if current_task_id else None
    failure_files = sorted(failure_dir.glob("*.json")) if failure_dir and failure_dir.exists() else []
    if proof_events or failure_files:
        status = "proven"
    elif hooks_config_status in {"ok", "partial"}:
        status = "configured_unproven"
    else:
        status = "not_configured"
    latest_event = proof_events[-1] if proof_events else {}
    return {
        "status": status,
        "current_task_id": current_task_id,
        "runtime_file": str(artifacts_dir / current_task_id / "runtime.jsonl") if current_task_id else "",
        "proof_event_count": len(proof_events),
        "hook_failure_count": len(failure_files),
        "latest_proof_event": latest_event,
        "latest_failure": str(failure_files[-1]) if failure_files else "",
    }


def build_smoke() -> dict:
    state_path = artifacts_dir / current_task_id / "state.json" if current_task_id else None
    state = read_json(state_path) if state_path else {}
    if not isinstance(state, dict):
        state = {}
    verification = state.get("verification") if isinstance(state.get("verification"), dict) else {}
    last_record = verification.get("last_record", "")
    last_exit_code = verification.get("last_exit_code", "")
    last_verified_at = state.get("last_verified_at", "")
    verification_dir = artifacts_dir / current_task_id / "verification" if current_task_id else None
    records = sorted(verification_dir.glob("*.md")) if verification_dir and verification_dir.exists() else []
    if last_exit_code == 0 or str(last_exit_code) == "0":
        status = "passed"
    elif last_record or last_verified_at or records:
        status = "failed_or_unknown"
    else:
        status = "no_proof"
    events = read_runtime_events(current_task_id)
    smoke_events = [row for row in events if row.get("kind") == "smoke"]
    return {
        "status": status,
        "current_task_id": current_task_id,
        "last_verified_at": last_verified_at,
        "last_exit_code": last_exit_code,
        "last_record": last_record or (str(records[-1]) if records else ""),
        "smoke_event_count": len(smoke_events),
        "latest_smoke_event": smoke_events[-1] if smoke_events else {},
    }


install = build_install()
source_cache = build_source_cache()
hooks_config = build_hooks_config()
hooks_runtime = build_hooks_runtime(hooks_config["status"])
smoke = build_smoke()
report = {
    "generated_at": generated_at,
    "current_task_id": current_task_id,
    "install": install,
    "source_cache": source_cache,
    "hooks_config": hooks_config,
    "hooks_runtime": hooks_runtime,
    "smoke": smoke,
}

if output_format == "json":
    print(json.dumps(report, ensure_ascii=False, indent=2))
elif output_format == "text":
    sections = [
        ("install", install),
        ("source-cache", source_cache),
        ("hooks-config", hooks_config),
        ("hooks-runtime", hooks_runtime),
        ("smoke", smoke),
    ]
    print(f"generated_at\t{generated_at}")
    if current_task_id:
        print(f"current_task_id\t{current_task_id}")
    for name, section in sections:
        print(f"[{name}]")
        print(f"status\t{section.get('status', '')}")
        for key, value in section.items():
            if key == "status":
                continue
            if isinstance(value, (dict, list)):
                value = json.dumps(value, ensure_ascii=False, sort_keys=True)
            print(f"{key}\t{value}")
else:
    print(f"invalid doctor output format: {output_format}", file=sys.stderr)
    raise SystemExit(1)
PY
  if [[ -n "$current_task_id" ]]; then
    append_task_runtime_event "$current_task_id" "doctor" "ran doctor checks"
  fi
}

strict_doctor_report() {
  local output_format="${1:-text}"
  local usage_error="${2:-}"
  local marketplace="atlas-forge"
  local source_plugin_root="$CODEX_HOME_ROOT/plugins/atlas-workflow"
  local local_cache_plugin_root="$CODEX_HOME_ROOT/plugins/cache/local-atlas/atlas-workflow/local"
  local snapshot_root="$CODEX_HOME_ROOT/.tmp/marketplaces/$marketplace"
  local release_cache_root="$CODEX_HOME_ROOT/plugins/cache/$marketplace/atlas-workflow"
  local config_file="$CODEX_HOME_ROOT/config.toml"
  local hooks_file="$CODEX_HOME_ROOT/hooks.json"
  local integrity_bin="$SCRIPT_DIR/atlas-plugin-integrity"

  PYTHONDONTWRITEBYTECODE=1 python3 - "$output_format" "$(timestamp_utc)" "$WORKFLOW_ROOT" "$CODEX_HOME_ROOT" "$TASKS_DIR" "$STATE_DIR" "$ARTIFACTS_DIR" "$HOOKS_DIR" "$SOURCE_HOOKS_DIR" "$config_file" "$hooks_file" "$source_plugin_root" "$local_cache_plugin_root" "$snapshot_root" "$release_cache_root" "$marketplace" "$integrity_bin" "$usage_error" <<'PY'
from pathlib import Path
import json
import os
import re
import stat
import subprocess
import sys
import tomllib

output_format = sys.argv[1]
generated_at = sys.argv[2]
workflow_root = Path(sys.argv[3])
codex_home = Path(sys.argv[4])
tasks_dir = Path(sys.argv[5])
state_dir = Path(sys.argv[6])
artifacts_dir = Path(sys.argv[7])
hooks_dir = Path(sys.argv[8])
source_hooks_dir = Path(sys.argv[9])
config_file = Path(sys.argv[10])
hooks_file = Path(sys.argv[11])
source_plugin_root = Path(sys.argv[12])
local_cache_plugin_root = Path(sys.argv[13])
snapshot_root = Path(sys.argv[14])
release_cache_root = Path(sys.argv[15])
marketplace = sys.argv[16]
integrity_bin = Path(sys.argv[17])
usage_error = sys.argv[18]

STRICT_SECTIONS = (
    "manifest_compatibility",
    "source_local_cache",
    "marketplace_snapshot",
    "exact_release_cache",
    "version_collision",
    "release_downgrade",
)
FULL_SHA = re.compile(r"^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$")


def path_info(path: Path) -> dict:
    try:
        mode = os.lstat(path).st_mode
    except FileNotFoundError:
        mode = None
    except OSError:
        mode = None
    return {
        "path": str(path),
        "exists": mode is not None,
        "is_file": mode is not None and stat.S_ISREG(mode),
        "is_dir": mode is not None and stat.S_ISDIR(mode),
        "is_symlink": mode is not None and stat.S_ISLNK(mode),
    }


def structured_error(code: str, message: str, **details) -> dict:
    return {"code": code, "message": message, **details}


def not_run_sections(error: dict) -> dict:
    return {
        name: {
            "status": "not_run",
            "critical": True,
            "reason": error["message"],
            "errors": [error],
        }
        for name in STRICT_SECTIONS
    }


if usage_error:
    error = structured_error("CLI_USAGE", usage_error)
    sections = not_run_sections(error)
    report = {
        "schema_version": 1,
        "tool": "codex-workflow-doctor",
        "mode": "strict",
        "strict": True,
        "ok": False,
        "strict_ok": False,
        "strict_failures": list(STRICT_SECTIONS),
        "generated_at": generated_at,
        "current_task_id": "",
        "install": {"status": "not_checked", "strict_relevant": False},
        "source_cache": {"status": "not_checked", "strict_relevant": False},
        "hooks_config": {"status": "not_checked", "strict_relevant": False},
        "hooks_runtime": {"status": "not_checked", "strict_relevant": False},
        "smoke": {"status": "not_checked", "strict_relevant": False},
        **sections,
        "errors": [error],
    }
    print(json.dumps(report, ensure_ascii=False, indent=2, sort_keys=True))
    raise SystemExit(2)


def safe_config() -> tuple[dict, list[dict]]:
    errors = []
    if config_file.is_symlink() or not config_file.is_file():
        return {}, [structured_error(
            "CONFIG_MISSING",
            "strict doctor requires a real CODEX_HOME_ROOT/config.toml",
            path=str(config_file),
        )]
    try:
        data = tomllib.loads(config_file.read_text(encoding="utf-8"))
    except Exception as error:
        return {}, [structured_error(
            "CONFIG_INVALID",
            "config.toml is not valid UTF-8 TOML",
            path=str(config_file),
            detail=str(error),
        )]
    marketplaces = data.get("marketplaces")
    entry = marketplaces.get(marketplace) if isinstance(marketplaces, dict) else None
    if not isinstance(entry, dict):
        errors.append(structured_error(
            "MARKETPLACE_CONFIG_MISSING",
            "atlas-forge marketplace config is missing",
        ))
        entry = {}
    source_type = entry.get("source_type")
    source = entry.get("source")
    ref = entry.get("ref")
    revision = entry.get("last_revision")
    if source_type != "git" or not isinstance(source, str) or not source:
        errors.append(structured_error(
            "MARKETPLACE_SOURCE_INVALID",
            "atlas-forge marketplace must use a non-empty Git source",
            source_type=source_type,
        ))
    if not isinstance(ref, str) or not FULL_SHA.fullmatch(ref):
        errors.append(structured_error(
            "MARKETPLACE_REF_INVALID",
            "marketplace ref must be a full immutable SHA string",
            ref_type=type(ref).__name__,
        ))
    if not isinstance(revision, str) or not FULL_SHA.fullmatch(revision):
        errors.append(structured_error(
            "MARKETPLACE_REVISION_INVALID",
            "marketplace last_revision must be a full immutable SHA string",
            revision_type=type(revision).__name__,
        ))
    if isinstance(ref, str) and isinstance(revision, str) and ref.lower() != revision.lower():
        errors.append(structured_error(
            "MARKETPLACE_IDENTITY_MISMATCH",
            "marketplace ref and last_revision must be identical",
        ))
    plugins = data.get("plugins")
    selector = f"atlas-workflow@{marketplace}"
    atlas_settings = plugins.get(selector) if isinstance(plugins, dict) else None
    if not isinstance(atlas_settings, dict) or atlas_settings.get("enabled") is not True:
        errors.append(structured_error(
            "ATLAS_PLUGIN_NOT_ENABLED",
            "strict doctor requires atlas-workflow@atlas-forge enabled=true",
            selector=selector,
        ))
    other_enabled = []
    if isinstance(plugins, dict):
        suffix = f"@{marketplace}"
        for candidate, settings in plugins.items():
            if (
                candidate.endswith(suffix)
                and candidate != selector
                and isinstance(settings, dict)
                and settings.get("enabled") is True
            ):
                other_enabled.append(candidate)
    features = data.get("features") if isinstance(data.get("features"), dict) else {}
    return {
        "source_type": source_type,
        "source": source if isinstance(source, str) else "",
        "ref": ref if isinstance(ref, str) else "",
        "last_revision": revision if isinstance(revision, str) else "",
        "atlas_enabled": isinstance(atlas_settings, dict) and atlas_settings.get("enabled") is True,
        "other_enabled_plugins": sorted(other_enabled),
        "features_hooks": features.get("hooks", "unset"),
        "features_codex_hooks": features.get("codex_hooks", "unset"),
    }, errors


def build_source_cache(source_local_section: dict) -> dict:
    section_status = source_local_section.get("status", "unknown")
    if section_status == "ok":
        status = "ok"
    elif section_status in {"missing", "not_run"}:
        status = "unknown"
    else:
        status = "mismatch"
    return {
        "status": status,
        "source_dir": str(source_plugin_root / "skills"),
        "cache_dir": str(local_cache_plugin_root / "skills"),
        "derived_from": "source_local_cache",
        "critical_status": section_status,
        "critical_error_count": len(source_local_section.get("errors", [])),
        "strict_relevant": False,
    }


def build_hooks_config(config: dict, config_errors: list[dict]) -> dict:
    commands = []
    hook_error = None
    hooks_exists = False
    try:
        hooks_mode = os.lstat(hooks_file).st_mode
        hooks_exists = True
    except FileNotFoundError:
        hooks_mode = None
    except OSError as error:
        hooks_mode = None
        hook_error = f"hooks.json metadata is unavailable: {error}"
    if hooks_mode is not None and (stat.S_ISLNK(hooks_mode) or not stat.S_ISREG(hooks_mode)):
        hook_error = "hooks.json must be a regular file without symbolic links"
    elif hooks_mode is not None:
        try:
            data = json.loads(hooks_file.read_text(encoding="utf-8"))
            hooks = data.get("hooks", {}) if isinstance(data, dict) else {}
            if isinstance(hooks, dict):
                for entries in hooks.values():
                    if not isinstance(entries, list):
                        continue
                    for entry in entries:
                        for hook in entry.get("hooks", []) if isinstance(entry, dict) else []:
                            command = hook.get("command") if isinstance(hook, dict) else None
                            if command:
                                commands.append(str(command))
        except Exception as error:
            hook_error = str(error)
    enabled = config.get("features_hooks") is True or config.get("features_codex_hooks") is True
    target_hooks = path_info(hooks_dir / "pre-tool-use")["is_file"] and path_info(
        hooks_dir / "post-tool-use"
    )["is_file"]
    configured = any("pre-tool-use" in command for command in commands) and any(
        "post-tool-use" in command for command in commands
    )
    if hook_error or config_errors:
        status = "error"
    elif enabled and hooks_exists and target_hooks and configured:
        status = "ok"
    elif enabled or hooks_exists or target_hooks or configured:
        status = "partial"
    else:
        status = "missing"
    return {
        "status": status,
        "strict_relevant": False,
        "features.hooks": config.get("features_hooks", "unknown"),
        "features.codex_hooks": config.get("features_codex_hooks", "unknown"),
        "hooks_json": path_info(hooks_file),
        "target_hooks_exist": target_hooks,
        "source_hooks_exist": path_info(source_hooks_dir / "pre-tool-use")["is_file"]
        and path_info(source_hooks_dir / "post-tool-use")["is_file"],
        "commands_configured": configured,
        "command_count": len(commands),
        "error": hook_error,
    }


codex_home_text = str(codex_home)
boundary_errors = []
try:
    if not codex_home.is_absolute() or os.path.normpath(codex_home_text) != codex_home_text:
        raise ValueError("CODEX_HOME_ROOT must be absolute and lexically canonical")
    if codex_home.is_symlink() or not codex_home.is_dir() or str(codex_home.resolve(strict=True)) != codex_home_text:
        raise ValueError("CODEX_HOME_ROOT must be a real canonical directory")
    protected_roots = [
        Path(os.environ.get("AGENTS_HOME", str(Path(os.environ.get("HOME", "")) / ".agents"))),
        Path(os.environ.get("LOCAL_BIN_ROOT", str(Path(os.environ.get("HOME", "")) / ".local" / "bin"))),
    ]
    for protected in protected_roots:
        protected_text = str(protected)
        if not protected.is_absolute():
            raise ValueError(f"protected ownership root is not absolute: {protected_text}")
        codex_to_protected = os.path.relpath(protected_text, codex_home_text)
        protected_to_codex = os.path.relpath(codex_home_text, protected_text)
        if codex_to_protected == "." or not codex_to_protected.startswith(".." + os.sep) \
                or not protected_to_codex.startswith(".." + os.sep):
            raise ValueError(f"CODEX_HOME_ROOT overlaps protected ownership root: {protected_text}")
except Exception as error:
    boundary_errors.append(structured_error(
        "CODEX_HOME_INVALID",
        "strict doctor rejected CODEX_HOME_ROOT before reading installation state",
        path=codex_home_text,
        detail=str(error),
    ))

if boundary_errors:
    config, config_errors = {}, boundary_errors
else:
    config, config_errors = safe_config()
expected_commit = config.get("last_revision")
expected_source = config.get("source")
if not isinstance(expected_commit, str) or not FULL_SHA.fullmatch(expected_commit):
    expected_commit = "0" * 40
if not isinstance(expected_source, str) or not expected_source:
    expected_source = "invalid://missing-marketplace-source"

command = [
    str(integrity_bin),
    "doctor",
    "--codex-home", str(codex_home),
    "--source", str(source_plugin_root),
    "--local-cache", str(local_cache_plugin_root),
    "--snapshot-root", str(snapshot_root),
    "--release-cache-root", str(release_cache_root),
    "--expected-commit", expected_commit,
    "--expected-source", expected_source,
    "--marketplace", marketplace,
]
helper_envelope_errors = []
helper_report_errors = []
helper_exit = 2
sections = {}
try:
    if boundary_errors:
        raise RuntimeError("CODEX_HOME_ROOT failed strict ownership validation")
    if integrity_bin.is_symlink() or not integrity_bin.is_file() or not os.access(integrity_bin, os.X_OK):
        raise RuntimeError("fixed sibling atlas-plugin-integrity is missing or not executable")
    environment = dict(os.environ)
    for key in list(environment):
        if key.startswith("GIT_") or key in {"SSH_AUTH_SOCK", "SSH_ASKPASS"}:
            environment.pop(key, None)
    environment["HOME"] = str(codex_home)
    environment["GIT_OPTIONAL_LOCKS"] = "0"
    environment["GIT_CONFIG_GLOBAL"] = "/dev/null"
    environment["GIT_CONFIG_SYSTEM"] = "/dev/null"
    environment["GIT_CONFIG_NOSYSTEM"] = "1"
    environment["GIT_ATTR_NOSYSTEM"] = "1"
    environment["GIT_TERMINAL_PROMPT"] = "0"
    environment["GIT_NO_LAZY_FETCH"] = "1"
    environment["GIT_CEILING_DIRECTORIES"] = str(codex_home)
    environment["GIT_ASKPASS"] = "/bin/false"
    environment["SSH_ASKPASS"] = "/bin/false"
    environment["GIT_SSH_COMMAND"] = "/bin/false"
    result = subprocess.run(
        command,
        text=True,
        capture_output=True,
        check=False,
        timeout=30,
        env=environment,
    )
    helper_exit = result.returncode
    helper = json.loads(result.stdout)
    if (
        not isinstance(helper, dict)
        or helper.get("schema_version") != 1
        or helper.get("tool") != "atlas-plugin-integrity"
        or helper.get("mode") != "doctor"
        or not isinstance(helper.get("checks"), dict)
        or not isinstance(helper.get("ok"), bool)
        or not isinstance(helper.get("errors"), list)
    ):
        raise RuntimeError("atlas-plugin-integrity returned an invalid doctor envelope")
    for name in STRICT_SECTIONS:
        section = helper["checks"].get(name)
        if not isinstance(section, dict) or not isinstance(section.get("status"), str) or not isinstance(section.get("errors"), list):
            raise RuntimeError(f"atlas-plugin-integrity omitted required section: {name}")
        sections[name] = {**section, "critical": True}
    helper_section_failures = [name for name in STRICT_SECTIONS if sections[name].get("status") != "ok"]
    helper_consistent_ok = not helper_section_failures
    if (
        result.returncode not in {0, 1}
        or helper.get("ok") is not helper_consistent_ok
        or (result.returncode == 0) is not helper_consistent_ok
        or (helper_consistent_ok and helper["errors"])
        or (not helper_consistent_ok and not helper["errors"])
    ):
        raise RuntimeError("atlas-plugin-integrity exit code, ok flag, sections, and errors are inconsistent")
    helper_report_errors = helper["errors"]
except Exception as error:
    helper_error = structured_error(
        "INTEGRITY_HELPER_FAILED",
        "strict doctor could not obtain a complete integrity report",
        detail=str(error),
    )
    helper_envelope_errors.append(helper_error)
    sections = not_run_sections(helper_error)
    helper_exit = 2

if config_errors:
    marketplace_section = sections["marketplace_snapshot"]
    marketplace_section["status"] = "invalid"
    marketplace_section.setdefault("errors", []).extend(config_errors)
    marketplace_section["config"] = {
        "path": str(config_file),
        "source_type": config.get("source_type"),
        "ref_is_full_sha": isinstance(config.get("ref"), str) and bool(FULL_SHA.fullmatch(config.get("ref", ""))),
        "revision_is_full_sha": isinstance(config.get("last_revision"), str)
        and bool(FULL_SHA.fullmatch(config.get("last_revision", ""))),
        "atlas_enabled": config.get("atlas_enabled", False),
        "other_enabled_plugins": config.get("other_enabled_plugins", []),
    }

strict_failures = [name for name in STRICT_SECTIONS if sections[name].get("status") != "ok"]
strict_ok = not strict_failures
if helper_exit == 2 or helper_envelope_errors or any(
    error["code"] in {"CONFIG_MISSING", "CONFIG_INVALID"} for error in config_errors
):
    exit_code = 2
elif strict_ok:
    exit_code = 0
else:
    exit_code = 1

install = {
    "status": "ok" if codex_home.is_dir() else "missing",
    "strict_relevant": False,
    "codex_home": str(codex_home),
    "workflow_root": path_info(workflow_root),
    "tasks_dir": path_info(tasks_dir),
    "state_dir": path_info(state_dir),
    "artifacts_dir": path_info(artifacts_dir),
    "codex_login": "not_checked_in_strict_mode",
    "paseo": "not_checked_in_strict_mode",
}
source_cache = build_source_cache(sections["source_local_cache"])
hooks_config = build_hooks_config(config, config_errors)
hooks_runtime = {
    "status": "configured_unproven" if hooks_config["status"] in {"ok", "partial"} else "not_configured",
    "strict_relevant": False,
    "proof_event_count": 0,
    "reason": "strict doctor does not read or mutate active task runtime",
}
smoke = {
    "status": "no_proof",
    "strict_relevant": False,
    "reason": "strict doctor does not require or inspect smoke proof",
}
report = {
    "schema_version": 1,
    "tool": "codex-workflow-doctor",
    "mode": "strict",
    "strict": True,
    "ok": strict_ok,
    "strict_ok": strict_ok,
    "strict_failures": strict_failures,
    "generated_at": generated_at,
    "current_task_id": "",
    "install": install,
    "source_cache": source_cache,
    "hooks_config": hooks_config,
    "hooks_runtime": hooks_runtime,
    "smoke": smoke,
    **sections,
    "errors": [*helper_envelope_errors, *helper_report_errors, *config_errors],
}

if output_format == "json":
    print(json.dumps(report, ensure_ascii=False, indent=2, sort_keys=True))
elif output_format == "text":
    print(f"generated_at\t{generated_at}")
    print("strict\ttrue")
    print(f"strict_ok\t{str(strict_ok).lower()}")
    print(f"strict_failures\t{json.dumps(strict_failures, ensure_ascii=False)}")
    for name in ("install", "source_cache", "hooks_config", "hooks_runtime", "smoke", *STRICT_SECTIONS):
        print(f"[{name}]")
        print(f"status\t{report[name].get('status', '')}")
        print(f"details\t{json.dumps(report[name], ensure_ascii=False, sort_keys=True)}")
else:
    print(json.dumps({
        "schema_version": 1,
        "tool": "codex-workflow-doctor",
        "mode": "strict",
        "strict": True,
        "ok": False,
        "errors": [structured_error("OUTPUT_FORMAT_INVALID", "invalid doctor output format")],
        **not_run_sections(structured_error("OUTPUT_FORMAT_INVALID", "invalid doctor output format")),
    }, ensure_ascii=False, sort_keys=True))
    exit_code = 2

raise SystemExit(exit_code)
PY
}

task_excerpt() {
  local file="$1"
  python3 - "$file" <<'PY'
from pathlib import Path
import sys

path = Path(sys.argv[1])
if not path.exists():
    raise SystemExit(0)
text = path.read_text(encoding="utf-8", errors="replace").strip()
if len(text) > 3000:
    text = text[:3000].rstrip() + "\n... (truncated)"
sys.stdout.write(text)
PY
}

team_role_names() {
  local mode="$1"
  local agents="$2"
  local -a base_roles=()
  local i
  case "$mode" in
    discuss)
      base_roles=(architect critic verifier)
      ;;
    execute)
      base_roles=(executor verifier reviewer)
      ;;
    *)
      echo "invalid team mode: $mode" >&2
      exit 1
      ;;
  esac
  for ((i = 0; i < agents; i++)); do
    if (( i < ${#base_roles[@]} )); then
      printf '%s\n' "${base_roles[$i]}"
    else
      printf 'lane-%d\n' "$((i + 1))"
    fi
  done
}

claude_provider_available() {
  local output
  if ! command -v "$PASEO_BIN" >/dev/null 2>&1; then
    return 1
  fi
  output="$("$PASEO_BIN" provider ls --json 2>/dev/null || true)"
  python3 - "$output" <<'PY'
import json
import sys

try:
    rows = json.loads(sys.argv[1] or "[]")
except json.JSONDecodeError:
    raise SystemExit(1)

for row in rows:
    provider = str(row.get("provider", "")).lower()
    status = str(row.get("status", "")).lower()
    if provider == "claude" and status == "available":
        raise SystemExit(0)
raise SystemExit(1)
PY
}

cmd_init_task() {
  local id
  id="$(node "$SCRIPT_DIR/lib/codex-workflow/task/cli.js" init-task "$@")" || return $?
  sync_codex_memory
  printf '%s\n' "$id"
}

cmd_task_mutation() {
  node "$SCRIPT_DIR/lib/codex-workflow/task/cli.js" "$@" || return $?
  sync_codex_memory
}

cmd_handoff_envelope() {
  local task_id="$1"
  shift
  local prd_path repo_path base_branch title packet_path generated_at metadata
  local envelope_path prd_abs prd_sha repo_abs repo_sha packet_abs acceptance_count validation_count envelope_rel packet_value
  local acceptance_rows=()
  local validation_rows=()
  prd_path=""
  repo_path=""
  base_branch=""
  title=""
  packet_path=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --prd)
        [[ $# -ge 2 ]] || { echo 'usage: codex-workflow handoff-envelope <task-id> --prd <file> --repo <path> --base <branch> [--title "<title>"] [--packet <file>] --acceptance "<id>|<requirement>|<required|advisory>" --validation "<id>|<surface>|<required|advisory>|<evidence>"' >&2; exit 1; }
        prd_path="$2"
        shift 2
        ;;
      --prd=*)
        prd_path="${1#--prd=}"
        shift
        ;;
      --repo)
        [[ $# -ge 2 ]] || { echo 'usage: codex-workflow handoff-envelope <task-id> --prd <file> --repo <path> --base <branch> [--title "<title>"] [--packet <file>] --acceptance "<id>|<requirement>|<required|advisory>" --validation "<id>|<surface>|<required|advisory>|<evidence>"' >&2; exit 1; }
        repo_path="$2"
        shift 2
        ;;
      --repo=*)
        repo_path="${1#--repo=}"
        shift
        ;;
      --base)
        [[ $# -ge 2 ]] || { echo 'usage: codex-workflow handoff-envelope <task-id> --prd <file> --repo <path> --base <branch> [--title "<title>"] [--packet <file>] --acceptance "<id>|<requirement>|<required|advisory>" --validation "<id>|<surface>|<required|advisory>|<evidence>"' >&2; exit 1; }
        base_branch="$2"
        shift 2
        ;;
      --base=*)
        base_branch="${1#--base=}"
        shift
        ;;
      --title)
        [[ $# -ge 2 ]] || { echo 'usage: codex-workflow handoff-envelope <task-id> --prd <file> --repo <path> --base <branch> [--title "<title>"] [--packet <file>] --acceptance "<id>|<requirement>|<required|advisory>" --validation "<id>|<surface>|<required|advisory>|<evidence>"' >&2; exit 1; }
        title="$2"
        shift 2
        ;;
      --title=*)
        title="${1#--title=}"
        shift
        ;;
      --packet)
        [[ $# -ge 2 ]] || { echo 'usage: codex-workflow handoff-envelope <task-id> --prd <file> --repo <path> --base <branch> [--title "<title>"] [--packet <file>] --acceptance "<id>|<requirement>|<required|advisory>" --validation "<id>|<surface>|<required|advisory>|<evidence>"' >&2; exit 1; }
        packet_path="$2"
        shift 2
        ;;
      --packet=*)
        packet_path="${1#--packet=}"
        shift
        ;;
      --acceptance)
        [[ $# -ge 2 ]] || { echo 'usage: codex-workflow handoff-envelope <task-id> --prd <file> --repo <path> --base <branch> [--title "<title>"] [--packet <file>] --acceptance "<id>|<requirement>|<required|advisory>" --validation "<id>|<surface>|<required|advisory>|<evidence>"' >&2; exit 1; }
        acceptance_rows+=("$2")
        shift 2
        ;;
      --acceptance=*)
        acceptance_rows+=("${1#--acceptance=}")
        shift
        ;;
      --validation)
        [[ $# -ge 2 ]] || { echo 'usage: codex-workflow handoff-envelope <task-id> --prd <file> --repo <path> --base <branch> [--title "<title>"] [--packet <file>] --acceptance "<id>|<requirement>|<required|advisory>" --validation "<id>|<surface>|<required|advisory>|<evidence>"' >&2; exit 1; }
        validation_rows+=("$2")
        shift 2
        ;;
      --validation=*)
        validation_rows+=("${1#--validation=}")
        shift
        ;;
      *)
        echo 'usage: codex-workflow handoff-envelope <task-id> --prd <file> --repo <path> --base <branch> [--title "<title>"] [--packet <file>] --acceptance "<id>|<requirement>|<required|advisory>" --validation "<id>|<surface>|<required|advisory>|<evidence>"' >&2
        exit 1
        ;;
    esac
  done

  [[ -n "$prd_path" ]] || { echo "missing required argument: --prd" >&2; exit 1; }
  [[ -n "$repo_path" ]] || { echo "missing required argument: --repo" >&2; exit 1; }
  [[ -n "$base_branch" ]] || { echo "missing required argument: --base" >&2; exit 1; }

  require_task "$task_id" >/dev/null
  sync_task_runtime "$task_id"
  generated_at="$(timestamp_utc)"
  metadata="$(write_handoff_envelope "$task_id" "$prd_path" "$repo_path" "$base_branch" "$title" "$packet_path" "$generated_at" "${#acceptance_rows[@]}" "${acceptance_rows[@]}" "${#validation_rows[@]}" "${validation_rows[@]}")"
  IFS=$'\t' read -r envelope_path prd_abs prd_sha repo_abs base_branch repo_sha packet_abs acceptance_count validation_count title <<<"$metadata"
  envelope_rel="$(path_relative_to_codex_home "$envelope_path")"
  packet_value="$packet_abs"
  if [[ "$packet_abs" != "-" ]]; then
    packet_value="$(path_relative_to_codex_home "$packet_abs")"
  fi

  upsert_task_fields "$(require_task "$task_id")" \
    "handoff_envelope=$envelope_rel" \
    "handoff_generated_at=$generated_at" \
    "handoff_prd_path=$prd_abs" \
    "handoff_prd_sha256=$prd_sha" \
    "handoff_repo=$repo_abs" \
    "handoff_base=$base_branch" \
    "handoff_repo_sha=$repo_sha" \
    "handoff_packet=$packet_value" \
    "handoff_acceptance_rows=$acceptance_count" \
    "handoff_validation_rows=$validation_count"
  write_task_state_json "$task_id"
  set_task_state_fields "$task_id" \
    "handoff.envelope=$envelope_rel" \
    "handoff.generated_at=$generated_at" \
    "handoff.prd_path=$prd_abs" \
    "handoff.prd_sha256=$prd_sha" \
    "handoff.repo=$repo_abs" \
    "handoff.base=$base_branch" \
    "handoff.repo_sha=$repo_sha" \
    "handoff.packet=$packet_value" \
    "handoff.acceptance_rows=$acceptance_count" \
    "handoff.validation_rows=$validation_count"
  append_task_runtime_event "$task_id" "handoff-envelope" "$envelope_rel"
  printf 'task_id: %s\n' "$task_id"
  printf 'envelope: %s\n' "$envelope_path"
  printf 'prd_sha256: %s\n' "$prd_sha"
  printf 'repo: %s\n' "$repo_abs"
  printf 'base: %s\n' "$base_branch"
  printf 'acceptance_rows: %s\n' "$acceptance_count"
  printf 'validation_rows: %s\n' "$validation_count"
  printf 'packet: %s\n' "$packet_value"
}

cmd_result_ingest() {
  local task_id="$1"
  shift
  local issue outcome draft_pr blocker commit_sha worktree summary ingested_at metadata
  local result_path result_rel evidence_count lesson_count evidence_joined lessons_joined
  local evidence_items=()
  local lesson_items=()
  issue=""
  outcome=""
  draft_pr=""
  blocker=""
  commit_sha=""
  worktree=""
  summary=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --issue)
        [[ $# -ge 2 ]] || { echo 'usage: codex-workflow result-ingest <task-id> --issue <url-or-id> --outcome draft-pr|blocker --commit <sha-or-unknown> --worktree <path-or-none> --evidence <path-or-url> [--draft-pr <url>] [--blocker <path-or-url>] [--summary "<summary>"] [--lesson "<candidate>"]' >&2; exit 1; }
        issue="$2"
        shift 2
        ;;
      --issue=*)
        issue="${1#--issue=}"
        shift
        ;;
      --outcome)
        [[ $# -ge 2 ]] || { echo 'usage: codex-workflow result-ingest <task-id> --issue <url-or-id> --outcome draft-pr|blocker --commit <sha-or-unknown> --worktree <path-or-none> --evidence <path-or-url> [--draft-pr <url>] [--blocker <path-or-url>] [--summary "<summary>"] [--lesson "<candidate>"]' >&2; exit 1; }
        outcome="$2"
        shift 2
        ;;
      --outcome=*)
        outcome="${1#--outcome=}"
        shift
        ;;
      --draft-pr)
        [[ $# -ge 2 ]] || { echo 'usage: codex-workflow result-ingest <task-id> --issue <url-or-id> --outcome draft-pr|blocker --commit <sha-or-unknown> --worktree <path-or-none> --evidence <path-or-url> [--draft-pr <url>] [--blocker <path-or-url>] [--summary "<summary>"] [--lesson "<candidate>"]' >&2; exit 1; }
        draft_pr="$2"
        shift 2
        ;;
      --draft-pr=*)
        draft_pr="${1#--draft-pr=}"
        shift
        ;;
      --blocker)
        [[ $# -ge 2 ]] || { echo 'usage: codex-workflow result-ingest <task-id> --issue <url-or-id> --outcome draft-pr|blocker --commit <sha-or-unknown> --worktree <path-or-none> --evidence <path-or-url> [--draft-pr <url>] [--blocker <path-or-url>] [--summary "<summary>"] [--lesson "<candidate>"]' >&2; exit 1; }
        blocker="$2"
        shift 2
        ;;
      --blocker=*)
        blocker="${1#--blocker=}"
        shift
        ;;
      --commit)
        [[ $# -ge 2 ]] || { echo 'usage: codex-workflow result-ingest <task-id> --issue <url-or-id> --outcome draft-pr|blocker --commit <sha-or-unknown> --worktree <path-or-none> --evidence <path-or-url> [--draft-pr <url>] [--blocker <path-or-url>] [--summary "<summary>"] [--lesson "<candidate>"]' >&2; exit 1; }
        commit_sha="$2"
        shift 2
        ;;
      --commit=*)
        commit_sha="${1#--commit=}"
        shift
        ;;
      --worktree)
        [[ $# -ge 2 ]] || { echo 'usage: codex-workflow result-ingest <task-id> --issue <url-or-id> --outcome draft-pr|blocker --commit <sha-or-unknown> --worktree <path-or-none> --evidence <path-or-url> [--draft-pr <url>] [--blocker <path-or-url>] [--summary "<summary>"] [--lesson "<candidate>"]' >&2; exit 1; }
        worktree="$2"
        shift 2
        ;;
      --worktree=*)
        worktree="${1#--worktree=}"
        shift
        ;;
      --evidence)
        [[ $# -ge 2 ]] || { echo 'usage: codex-workflow result-ingest <task-id> --issue <url-or-id> --outcome draft-pr|blocker --commit <sha-or-unknown> --worktree <path-or-none> --evidence <path-or-url> [--draft-pr <url>] [--blocker <path-or-url>] [--summary "<summary>"] [--lesson "<candidate>"]' >&2; exit 1; }
        evidence_items+=("$2")
        shift 2
        ;;
      --evidence=*)
        evidence_items+=("${1#--evidence=}")
        shift
        ;;
      --summary)
        [[ $# -ge 2 ]] || { echo 'usage: codex-workflow result-ingest <task-id> --issue <url-or-id> --outcome draft-pr|blocker --commit <sha-or-unknown> --worktree <path-or-none> --evidence <path-or-url> [--draft-pr <url>] [--blocker <path-or-url>] [--summary "<summary>"] [--lesson "<candidate>"]' >&2; exit 1; }
        summary="$2"
        shift 2
        ;;
      --summary=*)
        summary="${1#--summary=}"
        shift
        ;;
      --lesson)
        [[ $# -ge 2 ]] || { echo 'usage: codex-workflow result-ingest <task-id> --issue <url-or-id> --outcome draft-pr|blocker --commit <sha-or-unknown> --worktree <path-or-none> --evidence <path-or-url> [--draft-pr <url>] [--blocker <path-or-url>] [--summary "<summary>"] [--lesson "<candidate>"]' >&2; exit 1; }
        lesson_items+=("$2")
        shift 2
        ;;
      --lesson=*)
        lesson_items+=("${1#--lesson=}")
        shift
        ;;
      *)
        echo 'usage: codex-workflow result-ingest <task-id> --issue <url-or-id> --outcome draft-pr|blocker --commit <sha-or-unknown> --worktree <path-or-none> --evidence <path-or-url> [--draft-pr <url>] [--blocker <path-or-url>] [--summary "<summary>"] [--lesson "<candidate>"]' >&2
        exit 1
        ;;
    esac
  done

  [[ -n "$issue" ]] || { echo "missing required argument: --issue" >&2; exit 1; }
  [[ -n "$outcome" ]] || { echo "missing required argument: --outcome" >&2; exit 1; }
  [[ -n "$commit_sha" ]] || { echo "missing required argument: --commit" >&2; exit 1; }
  [[ -n "$worktree" ]] || { echo "missing required argument: --worktree" >&2; exit 1; }

  require_task "$task_id" >/dev/null
  sync_task_runtime "$task_id"
  ingested_at="$(timestamp_utc)"
  metadata="$(write_result_ingest "$task_id" "$issue" "$outcome" "$draft_pr" "$blocker" "$commit_sha" "$worktree" "$summary" "$ingested_at" "${#evidence_items[@]}" "${evidence_items[@]}" "${#lesson_items[@]}" "${lesson_items[@]}")"
  IFS=$'\t' read -r result_path issue outcome draft_pr blocker commit_sha worktree evidence_count lesson_count summary evidence_joined lessons_joined <<<"$metadata"
  result_rel="$(path_relative_to_codex_home "$result_path")"

  upsert_task_fields "$(require_task "$task_id")" \
    "result_ingest=$result_rel" \
    "result_ingested_at=$ingested_at" \
    "result_issue=$issue" \
    "result_outcome=$outcome" \
    "result_draft_pr=$draft_pr" \
    "result_blocker=$blocker" \
    "result_commit=$commit_sha" \
    "result_worktree=$worktree" \
    "result_evidence_count=$evidence_count" \
    "result_lesson_candidates=$lesson_count"
  write_task_state_json "$task_id"
  set_task_state_fields "$task_id" \
    "result.artifact=$result_rel" \
    "result.ingested_at=$ingested_at" \
    "result.issue=$issue" \
    "result.outcome=$outcome" \
    "result.draft_pr=$draft_pr" \
    "result.blocker=$blocker" \
    "result.commit=$commit_sha" \
    "result.worktree=$worktree" \
    "result.evidence_count=$evidence_count" \
    "result.lesson_candidates=$lesson_count" \
    "result.summary=$summary" \
    "result.evidence=$evidence_joined" \
    "result.lessons=$lessons_joined"
  append_task_runtime_event "$task_id" "result-ingest" "$outcome $result_rel"
  printf 'task_id: %s\n' "$task_id"
  printf 'artifact: %s\n' "$result_path"
  printf 'issue: %s\n' "$issue"
  printf 'outcome: %s\n' "$outcome"
  printf 'draft_pr: %s\n' "$draft_pr"
  printf 'blocker: %s\n' "$blocker"
  printf 'commit: %s\n' "$commit_sha"
  printf 'worktree: %s\n' "$worktree"
  printf 'evidence_count: %s\n' "$evidence_count"
  printf 'lesson_candidates: %s\n' "$lesson_count"
}

cmd_curated_packet() {
  if [[ $# -ge 2 && ( "$1" == "--lint" || "$1" == "--lint="* ) ]]; then
    local lint_file lint_result lint_status lint_path lint_lines lint_task lint_prd_sha
    if [[ "$1" == "--lint" ]]; then
      [[ $# -eq 2 ]] || { echo 'usage: codex-workflow curated-packet --lint <file>' >&2; exit 1; }
      lint_file="$2"
    else
      [[ $# -eq 1 ]] || { echo 'usage: codex-workflow curated-packet --lint <file>' >&2; exit 1; }
      lint_file="${1#--lint=}"
    fi
    lint_result="$(lint_curated_packet_file "$lint_file")"
    IFS=$'\t' read -r lint_status lint_path lint_lines lint_task lint_prd_sha <<<"$lint_result"
    printf 'packet: %s\n' "$lint_path"
    printf 'status: %s\n' "$lint_status"
    printf 'lines: %s\n' "$lint_lines"
    printf 'atlas_task_id: %s\n' "$lint_task"
    printf 'prd_sha256: %s\n' "$lint_prd_sha"
    return 0
  fi

  local task_id="$1"
  shift
  local prd_path repo_path base_branch skip_reason skip_requested generated_at metadata lint_result
  local packet_path packet_rel prd_abs prd_sha repo_abs source_count packet_lines
  local source_paths=()
  prd_path=""
  repo_path=""
  base_branch=""
  skip_reason=""
  skip_requested="0"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --prd)
        [[ $# -ge 2 ]] || { echo 'usage: codex-workflow curated-packet <task-id> --prd <file> --repo <path> --base <branch> --source <file>... [--skip "<reason>"]' >&2; exit 1; }
        prd_path="$2"
        shift 2
        ;;
      --prd=*)
        prd_path="${1#--prd=}"
        shift
        ;;
      --repo)
        [[ $# -ge 2 ]] || { echo 'usage: codex-workflow curated-packet <task-id> --prd <file> --repo <path> --base <branch> --source <file>... [--skip "<reason>"]' >&2; exit 1; }
        repo_path="$2"
        shift 2
        ;;
      --repo=*)
        repo_path="${1#--repo=}"
        shift
        ;;
      --base)
        [[ $# -ge 2 ]] || { echo 'usage: codex-workflow curated-packet <task-id> --prd <file> --repo <path> --base <branch> --source <file>... [--skip "<reason>"]' >&2; exit 1; }
        base_branch="$2"
        shift 2
        ;;
      --base=*)
        base_branch="${1#--base=}"
        shift
        ;;
      --source)
        [[ $# -ge 2 ]] || { echo 'usage: codex-workflow curated-packet <task-id> --prd <file> --repo <path> --base <branch> --source <file>... [--skip "<reason>"]' >&2; exit 1; }
        source_paths+=("$2")
        shift 2
        ;;
      --source=*)
        source_paths+=("${1#--source=}")
        shift
        ;;
      --skip)
        [[ $# -ge 2 ]] || { echo 'usage: codex-workflow curated-packet <task-id> --prd <file> --repo <path> --base <branch> --source <file>... [--skip "<reason>"]' >&2; exit 1; }
        skip_reason="$2"
        skip_requested="1"
        shift 2
        ;;
      --skip=*)
        skip_reason="${1#--skip=}"
        skip_requested="1"
        shift
        ;;
      *)
        echo 'usage: codex-workflow curated-packet <task-id> --prd <file> --repo <path> --base <branch> --source <file>... [--skip "<reason>"]' >&2
        exit 1
        ;;
    esac
  done

  require_task "$task_id" >/dev/null
  sync_task_runtime "$task_id"

  if [[ "$skip_requested" == "1" ]]; then
    validate_single_line_reason "curated packet skip reason" "$skip_reason"
    generated_at="$(timestamp_utc)"
    upsert_task_fields "$(require_task "$task_id")" \
      "packet_status=skipped" \
      "packet_skipped_at=$generated_at" \
      "packet_skip_reason=$skip_reason"
    write_task_state_json "$task_id"
    set_task_state_fields "$task_id" \
      "packet.status=skipped" \
      "packet.skipped_at=$generated_at" \
      "packet.skip_reason=$skip_reason"
    append_task_runtime_event "$task_id" "curated-packet-skip" "$skip_reason"
    printf 'task_id: %s\n' "$task_id"
    printf 'status: skipped\n'
    printf 'reason: %s\n' "$skip_reason"
    return 0
  fi

  [[ -n "$prd_path" ]] || { echo "missing required argument: --prd" >&2; exit 1; }
  [[ -n "$repo_path" ]] || { echo "missing required argument: --repo" >&2; exit 1; }
  [[ -n "$base_branch" ]] || { echo "missing required argument: --base" >&2; exit 1; }
  [[ "${#source_paths[@]}" -gt 0 ]] || { echo "missing required argument: --source" >&2; exit 1; }

  generated_at="$(timestamp_utc)"
  metadata="$(write_curated_packet "$task_id" "$prd_path" "$repo_path" "$base_branch" "$generated_at" "${#source_paths[@]}" "${source_paths[@]}")"
  IFS=$'\t' read -r packet_path prd_abs prd_sha repo_abs base_branch source_count packet_lines <<<"$metadata"
  lint_result="$(lint_curated_packet_file "$packet_path")"
  packet_rel="$(path_relative_to_codex_home "$packet_path")"

  upsert_task_fields "$(require_task "$task_id")" \
    "packet_status=generated" \
    "packet_file=$packet_rel" \
    "packet_generated_at=$generated_at" \
    "packet_prd_path=$prd_abs" \
    "packet_prd_sha256=$prd_sha" \
    "packet_repo=$repo_abs" \
    "packet_base=$base_branch" \
    "packet_sources=$source_count" \
    "packet_lines=$packet_lines" \
    "packet_skip_reason=-"
  write_task_state_json "$task_id"
  set_task_state_fields "$task_id" \
    "packet.status=generated" \
    "packet.file=$packet_rel" \
    "packet.generated_at=$generated_at" \
    "packet.prd_path=$prd_abs" \
    "packet.prd_sha256=$prd_sha" \
    "packet.repo=$repo_abs" \
    "packet.base=$base_branch" \
    "packet.sources=$source_count" \
    "packet.lines=$packet_lines" \
    "packet.lint=passed"
  append_task_runtime_event "$task_id" "curated-packet" "$packet_rel"
  printf 'task_id: %s\n' "$task_id"
  printf 'packet: %s\n' "$packet_path"
  printf 'status: generated\n'
  printf 'lint: passed\n'
  printf 'prd_sha256: %s\n' "$prd_sha"
  printf 'sources: %s\n' "$source_count"
  printf 'lines: %s\n' "$packet_lines"
}


cmd_multica_feedback() {
  local task_id="$1"
  shift
  local issue commit_sha round status evidence_manifest recorded_at metadata feedback_path feedback_json finding_count
  local reviews=()
  local e2es=()
  local scorecards=()
  local findings=()
  issue=""
  commit_sha=""
  round=""
  status=""
  evidence_manifest=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --issue) [[ $# -ge 2 ]] || { echo 'usage: codex-workflow multica-feedback <task-id> --issue <url-or-id> --commit <sha-or-unknown> --round <n> --status clean|repair-needed|blocked [--review <path-or-url>]... [--e2e <path-or-url>]... [--scorecard <path-or-url>]... [--evidence-manifest <path-or-url>] [--blocking-finding "<id|summary>"]...' >&2; exit 1; }; issue="$2"; shift 2 ;;
      --issue=*) issue="${1#--issue=}"; shift ;;
      --commit) [[ $# -ge 2 ]] || { echo 'usage: codex-workflow multica-feedback <task-id> --issue <url-or-id> --commit <sha-or-unknown> --round <n> --status clean|repair-needed|blocked ...' >&2; exit 1; }; commit_sha="$2"; shift 2 ;;
      --commit=*) commit_sha="${1#--commit=}"; shift ;;
      --round) [[ $# -ge 2 ]] || { echo 'usage: codex-workflow multica-feedback <task-id> --issue <url-or-id> --commit <sha-or-unknown> --round <n> --status clean|repair-needed|blocked ...' >&2; exit 1; }; round="$2"; shift 2 ;;
      --round=*) round="${1#--round=}"; shift ;;
      --status) [[ $# -ge 2 ]] || { echo 'usage: codex-workflow multica-feedback <task-id> --issue <url-or-id> --commit <sha-or-unknown> --round <n> --status clean|repair-needed|blocked ...' >&2; exit 1; }; status="$2"; shift 2 ;;
      --status=*) status="${1#--status=}"; shift ;;
      --review) [[ $# -ge 2 ]] || { echo 'usage: codex-workflow multica-feedback <task-id> ... [--review <path-or-url>]...' >&2; exit 1; }; reviews+=("$2"); shift 2 ;;
      --review=*) reviews+=("${1#--review=}"); shift ;;
      --e2e) [[ $# -ge 2 ]] || { echo 'usage: codex-workflow multica-feedback <task-id> ... [--e2e <path-or-url>]...' >&2; exit 1; }; e2es+=("$2"); shift 2 ;;
      --e2e=*) e2es+=("${1#--e2e=}"); shift ;;
      --scorecard) [[ $# -ge 2 ]] || { echo 'usage: codex-workflow multica-feedback <task-id> ... [--scorecard <path-or-url>]...' >&2; exit 1; }; scorecards+=("$2"); shift 2 ;;
      --scorecard=*) scorecards+=("${1#--scorecard=}"); shift ;;
      --evidence-manifest) [[ $# -ge 2 ]] || { echo 'usage: codex-workflow multica-feedback <task-id> ... [--evidence-manifest <path-or-url>]' >&2; exit 1; }; evidence_manifest="$2"; shift 2 ;;
      --evidence-manifest=*) evidence_manifest="${1#--evidence-manifest=}"; shift ;;
      --blocking-finding) [[ $# -ge 2 ]] || { echo 'usage: codex-workflow multica-feedback <task-id> ... [--blocking-finding "<id|summary>"]...' >&2; exit 1; }; findings+=("$2"); shift 2 ;;
      --blocking-finding=*) findings+=("${1#--blocking-finding=}"); shift ;;
      *) echo 'usage: codex-workflow multica-feedback <task-id> --issue <url-or-id> --commit <sha-or-unknown> --round <n> --status clean|repair-needed|blocked [--review <path-or-url>]... [--e2e <path-or-url>]... [--scorecard <path-or-url>]... [--evidence-manifest <path-or-url>] [--blocking-finding "<id|summary>"]...' >&2; exit 1 ;;
    esac
  done
  [[ -n "$issue" ]] || { echo "missing required argument: --issue" >&2; exit 1; }
  [[ -n "$commit_sha" ]] || { echo "missing required argument: --commit" >&2; exit 1; }
  [[ -n "$round" ]] || { echo "missing required argument: --round" >&2; exit 1; }
  [[ -n "$status" ]] || { echo "missing required argument: --status" >&2; exit 1; }
  require_task "$task_id" >/dev/null
  sync_task_runtime "$task_id"
  recorded_at="$(timestamp_utc)"
  metadata="$(write_multica_feedback "$task_id" "$issue" "$commit_sha" "$round" "$status" "$evidence_manifest" "$recorded_at" "${#reviews[@]}" "${reviews[@]}" "${#e2es[@]}" "${e2es[@]}" "${#scorecards[@]}" "${scorecards[@]}" "${#findings[@]}" "${findings[@]}")"
  IFS=$'\t' read -r feedback_path feedback_json issue commit_sha round status finding_count <<<"$metadata"
  upsert_task_fields "$(require_task "$task_id")" "multica_feedback=$(path_relative_to_codex_home "$feedback_path")" "multica_feedback_status=$status" "multica_feedback_round=$round" "multica_feedback_findings=$finding_count"
  write_task_state_json "$task_id"
  set_task_state_fields "$task_id" "multica_feedback.artifact=$(path_relative_to_codex_home "$feedback_path")" "multica_feedback.json=$(path_relative_to_codex_home "$feedback_json")" "multica_feedback.status=$status" "multica_feedback.round=$round" "multica_feedback.blocking_findings=$finding_count"
  if [[ "$status" == "repair-needed" ]]; then
    set_task_state_fields "$task_id" "current_phase=repair" "latest_feedback_route=repair"
  elif [[ "$status" == "blocked" ]]; then
    set_task_state_fields "$task_id" "current_phase=blocked" "latest_feedback_route=blocker"
  fi
  append_task_runtime_event "$task_id" "multica-feedback" "$status round $round"
  printf 'task_id: %s\nartifact: %s\njson: %s\nstatus: %s\nround: %s\nblocking_findings: %s\n' "$task_id" "$feedback_path" "$feedback_json" "$status" "$round" "$finding_count"
}

cmd_learn() {
  local task_id title lesson task_file basename file tmp existing_created created current lock_file

  task_id="$1"
  title="$2"
  lesson="$3"

  validate_title "$title"
  task_file="$(require_task "$task_id")"
  validate_task_for_update "$task_file"
  current="$(get_field "$task_file" status)"
  if [[ "$current" != "done" ]]; then
    echo "task must be done before learn: $task_id" >&2
    exit 1
  fi
  ensure_learning_template
  ensure_learnings_dir
  ensure_learning_lock_dir

  basename="$(learning_basename "$task_id" "$title")"
  file="$LEARNINGS_DIR/$basename.md"
  lock_file="$(learning_lock_file)"
  acquire_lock "$lock_file"
  if [[ -n "${CODEX_WORKFLOW_TEST_LEARN_PAUSE_BEFORE_WRITE:-}" ]]; then
    sleep "$CODEX_WORKFLOW_TEST_LEARN_PAUSE_BEFORE_WRITE"
  fi
  tmp="$(mktemp)"
  if [[ -f "$file" ]]; then
    existing_created="$(get_learning_field "$file" created)"
    render_learning "$tmp" "$task_id" "$title" "$lesson" "$existing_created"
    if ! cmp -s "$file" "$tmp"; then
      rm -f "$tmp"
      release_lock "$lock_file"
      echo "learning already exists with different content: $file" >&2
      exit 1
    fi
  else
    render_learning "$tmp" "$task_id" "$title" "$lesson"
    mv "$tmp" "$file"
    tmp=""
  fi
  rm -f "$tmp"
  update_learning_index "$basename" "$title" "$task_id"
  created="$(get_learning_field "$file" created)"
  update_learning_search_index "$basename" "$title" "$task_id" "$created" "$lesson"
  release_lock "$lock_file"
  sync_codex_memory
  printf '%s\n' "$basename"
}

cmd_dream() {
  sync_codex_memory
  printf '%s\n' "$MEMORY_INDEX"
}

cmd_recall() {
  local query="$1"

  validate_query "$query"
  ensure_learnings_dir

  python3 - "$LEARNING_SEARCH_INDEX" "$LEARNINGS_DIR" "$query" <<'PY'
import json
import sys
from pathlib import Path

index_path = Path(sys.argv[1])
learnings_dir = Path(sys.argv[2])
query = sys.argv[3].casefold()
terms = [part for part in query.split() if part]

def score_text(text: str) -> int:
    lowered = text.casefold()
    return sum(lowered.count(term) for term in terms)

rows = []
if index_path.exists():
    with index_path.open(encoding="utf-8") as fh:
        for raw in fh:
            raw = raw.strip()
            if not raw:
                continue
            try:
                row = json.loads(raw)
            except json.JSONDecodeError:
                continue
            score = score_text(row.get("title", "")) * 3 + score_text(row.get("lesson", ""))
            if score > 0:
                row["_score"] = score
                rows.append(row)
else:
    for path in sorted(learnings_dir.glob("*.md")):
        if path.name == "index.md":
            continue
        text = path.read_text(encoding="utf-8")
        lines = text.splitlines()
        title = next((line[7:] for line in lines if line.startswith("title: ")), "")
        task_id = next((line[16:] for line in lines if line.startswith("source-task-id: ")), "")
        marker = "## Lesson\n"
        lesson = text.split(marker, 1)[1].strip() if marker in text else ""
        score = score_text(title) * 3 + score_text(lesson)
        if score > 0:
            rows.append({
                "id": path.stem,
                "title": title,
                "task_id": task_id,
                "lesson": lesson,
                "_score": score,
            })

rows.sort(key=lambda row: (-row["_score"], row.get("id", "")))
for row in rows[:5]:
    excerpt = row.get("lesson", "").replace("\n", " ").strip()
    excerpt = excerpt[:120]
    print(f'{row.get("id", "")}\t{row.get("title", "")}\t{row.get("task_id", "")}\t{excerpt}')
PY
}

cmd_doctor() {
  local current_task_id output_format strict_mode
  output_format="text"
  strict_mode=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --strict)
        strict_mode=true
        shift
        ;;
      --json)
        output_format="json"
        shift
        ;;
      --text)
        output_format="text"
        shift
        ;;
      *)
        if [[ "$ATLAS_DOCTOR_STRICT_REQUESTED" == true ]]; then
          strict_doctor_report json "unknown strict doctor argument: $1"
          return
        fi
        echo 'usage: codex-workflow doctor [--strict] [--json|--text]' >&2
        exit 1
        ;;
    esac
  done
  if [[ "$strict_mode" == true ]]; then
    strict_doctor_report "$output_format"
    return
  fi
  current_task_id="$(read_current_task_id || true)"
  if [[ -n "$current_task_id" ]]; then
    sync_task_runtime "$current_task_id"
  fi
  doctor_report "$current_task_id" "$output_format"
}

cmd_smoke() {
  local task_id last_message_file stdout_file stderr_file message exit_code verdict record_file verified_at
  task_id="$(read_current_task_id || true)"
  if [[ -z "$task_id" ]]; then
    echo "no active task: run codex-workflow start <task-id> first" >&2
    exit 1
  fi
  sync_task_runtime "$task_id"
  last_message_file="$(mktemp)"
  stdout_file="$(mktemp)"
  stderr_file="$(mktemp)"
  set +e
  "$CODEX_BIN" exec --skip-git-repo-check -C "$PWD" --output-last-message "$last_message_file" "Reply with exactly CODEX-SMOKE-OK" >"$stdout_file" 2>"$stderr_file"
  exit_code=$?
  set -e
  message="$(tr -d '\r' < "$last_message_file" 2>/dev/null | sed 's/[[:space:]]*$//')"
  if [[ -n "$message" ]]; then
    printf '%s\n' "$message" >>"$stdout_file"
  fi
  verdict="failed"
  if [[ "$exit_code" -eq 0 && "$message" == "CODEX-SMOKE-OK" ]]; then
    verdict="passed"
  fi
  record_file="$(task_verification_dir "$task_id")/$(timestamp_token)-smoke.md"
  write_verification_record "$record_file" "smoke" "$task_id" "$CODEX_BIN exec --skip-git-repo-check -C $PWD --output-last-message <tmp> \"Reply with exactly CODEX-SMOKE-OK\"" "$PWD" "$exit_code" "$verdict" "$stdout_file" "$stderr_file" "$(timestamp_utc)" "$verdict" "smoke-only" "local-command" "" 0
  verified_at="$(timestamp_utc)"
  upsert_task_fields "$(require_task "$task_id")" "last_verified_at=$verified_at"
  write_task_state_json "$task_id"
  set_task_state_fields "$task_id" \
    "last_verified_at=$verified_at" \
    "verification.last_record=$(path_relative_to_codex_home "$record_file")" \
    "verification.last_exit_code=$exit_code"
  append_task_runtime_event "$task_id" "smoke" "$verdict"
  printf 'task_id: %s\n' "$task_id"
  printf 'record: %s\n' "$record_file"
  printf 'message: %s\n' "$message"
  rm -f "$last_message_file" "$stdout_file" "$stderr_file"
  if [[ "$verdict" != "passed" ]]; then
    exit 1
  fi
}


cmd_self_test() {
  local contract_script="$SCRIPT_DIR/../tests/contract.sh"
  local source_root_file="$SCRIPT_DIR/../source-root"
  local atlas_forge_root="${ATLAS_FORGE_ROOT:-}"

  if [[ ! -x "$contract_script" ]]; then
    echo "missing executable contract test script: $contract_script" >&2
    exit 1
  fi
  if [[ -z "$atlas_forge_root" && -f "$source_root_file" ]]; then
    read -r atlas_forge_root < "$source_root_file" || atlas_forge_root=""
    if [[ ! -d "$atlas_forge_root" ]]; then
      atlas_forge_root=""
    fi
  fi
  if [[ -n "$atlas_forge_root" ]]; then
    (
      cd "$atlas_forge_root"
      ATLAS_FORGE_ROOT="$atlas_forge_root" CODEX_WORKFLOW_BIN="$SCRIPT_DIR/codex-workflow" "$contract_script"
    )
  else
    CODEX_WORKFLOW_BIN="$SCRIPT_DIR/codex-workflow" "$contract_script"
  fi
}

cmd_install_hooks() {
  local pre_hook post_hook current_task_id
  pre_hook="$(install_workflow_hook_script pre-tool-use)"
  post_hook="$(install_workflow_hook_script post-tool-use)"
  set_config_feature "$CODEX_CONFIG_FILE" hooks true
  merge_workflow_hooks_json "$CODEX_HOOKS_FILE" "$pre_hook" "$post_hook"
  current_task_id="$(read_current_task_id || true)"
  if [[ -n "$current_task_id" ]]; then
    sync_task_runtime "$current_task_id"
    append_task_runtime_event "$current_task_id" "hooks" "installed workflow hooks"
  fi
  printf 'config: %s\n' "$CODEX_CONFIG_FILE"
  printf 'hooks_json: %s\n' "$CODEX_HOOKS_FILE"
  printf 'pre_hook: %s\n' "$pre_hook"
  printf 'post_hook: %s\n' "$post_hook"
}

cmd_team_start() {
  local task_id="$1"
  local objective="$2"
  shift 2
  local mode="discuss"
  local agents="3"
  local claude_review="0"
  local arg

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --mode)
        [[ $# -ge 2 ]] || { echo 'usage: codex-workflow team-start <task-id> "<objective>" [--mode discuss|execute] [--agents N] [--claude-review]' >&2; exit 1; }
        mode="$2"
        shift 2
        ;;
      --mode=*)
        mode="${1#--mode=}"
        shift
        ;;
      --agents)
        [[ $# -ge 2 ]] || { echo 'usage: codex-workflow team-start <task-id> "<objective>" [--mode discuss|execute] [--agents N] [--claude-review]' >&2; exit 1; }
        agents="$2"
        shift 2
        ;;
      --agents=*)
        agents="${1#--agents=}"
        shift
        ;;
      --claude-review)
        claude_review="1"
        shift
        ;;
      *)
        echo "unknown team-start option: $1" >&2
        exit 1
        ;;
    esac
  done

  validate_positive_integer "$agents" "agents"
  case "$mode" in
    discuss|execute) ;;
    *)
      echo "invalid team mode: $mode" >&2
      exit 1
      ;;
  esac

  if [[ "$claude_review" == "1" ]] && ! claude_provider_available; then
    sync_task_runtime "$task_id"
    upsert_task_fields "$(require_task "$task_id")" "active_team_backend=legacy" "active_team_mode=$mode" "active_team_status=error" "active_team_decision=$(path_relative_to_codex_home "$(task_team_decision_file "$task_id")")"
    write_task_state_json "$task_id"
    set_task_state_fields "$task_id" "active_team.backend=legacy" "active_team.status=error" "active_team.error=claude provider unavailable"
    echo "claude review requested but paseo claude provider is unavailable" >&2
    exit 1
  fi

  local task_file title artifact_dir team_dir decision_file staffing_file round_file decision_rel staffing_rel round_rel
  local context_text spec_text analysis_text tmpdir role prompt status_any_fail="0"
  local roles_display team_interrupted="0" wait_status
  local -a roles=()
  local -a pids=()
  declare -A lane_message_files lane_stdout_files lane_stderr_files lane_statuses

  sync_task_runtime "$task_id"
  task_file="$(require_task "$task_id")"
  title="$(get_field "$task_file" title)"
  artifact_dir="$(task_artifact_dir "$task_id")"
  team_dir="$(task_team_dir "$task_id")"
  decision_file="$(task_team_decision_file "$task_id")"
  staffing_file="$(task_team_staffing_file "$task_id")"
  round_file="$team_dir/round-$(timestamp_token).md"
  decision_rel="$(path_relative_to_codex_home "$decision_file")"
  staffing_rel="$(path_relative_to_codex_home "$staffing_file")"
  round_rel="$(path_relative_to_codex_home "$round_file")"
  context_text="$(task_excerpt "$artifact_dir/context.md")"
  spec_text="$(task_excerpt "$artifact_dir/spec.md")"
  analysis_text="$(task_excerpt "$artifact_dir/analysis.md")"

  ensure_team_lock_dir
  local team_lock
  team_lock="$(team_lock_file "$task_id")"
  acquire_lock "$team_lock"
  upsert_task_fields "$task_file" "active_team_backend=legacy" "active_team_mode=$mode" "active_team_status=running" "active_team_decision=$decision_rel"
  write_task_state_json "$task_id"
  set_task_state_fields "$task_id" \
    "active_team.backend=legacy" \
    "active_team.mode=$mode" \
    "active_team.status=running" \
    "active_team.decision=$decision_rel" \
    "active_team.objective=$objective" \
    "active_team.agents=$agents" \
    "active_team.claude_review=$( [[ "$claude_review" == "1" ]] && printf '__TRUE__' || printf '__FALSE__' )"
  release_lock "$team_lock"

  append_task_runtime_event "$task_id" "team-start" "$mode / $objective"
  mapfile -t roles < <(team_role_names "$mode" "$agents")
  tmpdir="$(mktemp -d)"
  roles_display="$(IFS=,; printf '%s' "${roles[*]}")"
  {
    printf '# Team Round\n\n'
    printf 'Pending lane completion.\n\n'
    printf -- '- task_id: %s\n' "$task_id"
    printf -- '- mode: %s\n' "$mode"
    printf -- '- objective: %s\n' "$objective"
    printf -- '- agents: %s\n' "$agents"
    printf -- '- roles: %s\n' "$roles_display"
    printf -- '- temp_dir: %s\n' "$tmpdir"
  } > "$round_file"
  set_task_state_fields "$task_id" \
    "active_team.round_file=$round_rel" \
    "active_team.staffing=$staffing_rel" \
    "active_team.temp_dir=$tmpdir" \
    "active_team.roles=$roles_display"
  append_task_runtime_event "$task_id" "team-lanes-started" "roles=$roles_display temp_dir=$tmpdir round=$round_rel"

  team_start_interrupt() {
    team_interrupted="1"
    status_any_fail="1"
    local pid
    for pid in "${pids[@]}"; do
      kill -INT "$pid" 2>/dev/null || true
    done
  }
  trap team_start_interrupt INT TERM

  for role in "${roles[@]}"; do
    lane_message_files["$role"]="$tmpdir/$role.message"
    lane_stdout_files["$role"]="$tmpdir/$role.stdout"
    lane_stderr_files["$role"]="$tmpdir/$role.stderr"
    prompt="$(cat <<EOF
You are the $role lane in an Atlas workflow team round.

Task: $task_id
Title: $title
Mode: $mode
Objective: $objective

Current task file:
$(sed -n '1,80p' "$task_file")

Context:
$context_text

Spec:
$spec_text

Analysis:
$analysis_text

Respond in markdown with exactly these sections:
## Evidence
## Inference
## Unknown
## Recommendation
EOF
)"
    "$CODEX_BIN" exec --skip-git-repo-check -C "$PWD" --output-last-message "${lane_message_files[$role]}" "$prompt" >"${lane_stdout_files[$role]}" 2>"${lane_stderr_files[$role]}" &
    pids+=("$!")
  done

  local idx=0
  for role in "${roles[@]}"; do
    set +e
    wait "${pids[$idx]}"
    wait_status="$?"
    lane_statuses["$role"]="$wait_status"
    set -e
    if [[ "${lane_statuses[$role]}" -ne 0 ]]; then
      status_any_fail="1"
    fi
    idx=$((idx + 1))
  done
  trap 'release_all_locks; exit 130' INT
  trap 'release_all_locks; exit 143' TERM

  {
    printf '# Team Round\n\n'
    printf -- '- task_id: %s\n' "$task_id"
    printf -- '- mode: %s\n' "$mode"
    printf -- '- objective: %s\n' "$objective"
    printf -- '- agents: %s\n' "$agents"
    printf -- '- roles: %s\n' "$roles_display"
    printf -- '- temp_dir: %s\n' "$tmpdir"
    printf -- '- interrupted: %s\n' "$team_interrupted"
    printf -- '- created_at: %s\n\n' "$(timestamp_utc)"
    for role in "${roles[@]}"; do
      printf '## %s\n\n' "$role"
      printf -- '- exit_code: %s\n\n' "${lane_statuses[$role]:-not-collected}"
      printf '### Message\n\n```markdown\n'
      trimmed_preview "${lane_message_files[$role]}"
      printf '\n```\n\n'
      printf '### Stdout\n\n```text\n'
      trimmed_preview "${lane_stdout_files[$role]}"
      printf '\n```\n\n'
      printf '### Stderr\n\n```text\n'
      trimmed_preview "${lane_stderr_files[$role]}"
      printf '\n```\n\n'
    done
  } > "$round_file"

  local claude_review_status="0"
  local claude_stdout_file="$tmpdir/claude-review.stdout"
  local claude_stderr_file="$tmpdir/claude-review.stderr"
  if [[ "$claude_review" == "1" ]]; then
    set +e
    "$PASEO_BIN" run --provider claude --cwd "$PWD" "Review the following Atlas team round and highlight the strongest plan, major risks, and decision recommendation.\n\n$(cat "$round_file")" >"$claude_stdout_file" 2>"$claude_stderr_file"
    claude_review_status="$?"
    set -e
    {
      printf '# Claude Review\n\n'
      printf -- '- task_id: %s\n' "$task_id"
      printf -- '- created_at: %s\n' "$(timestamp_utc)"
      printf -- '- exit_code: %s\n\n' "$claude_review_status"
      printf '## Stdout\n\n```text\n'
      trimmed_preview "$claude_stdout_file"
      printf '\n```\n\n'
      printf '## Stderr\n\n```text\n'
      trimmed_preview "$claude_stderr_file"
      printf '\n```\n'
    } > "$(task_team_claude_review_file "$task_id")"
    if [[ "$claude_review_status" -ne 0 ]]; then
      status_any_fail="1"
    fi
  fi

  {
    printf '# Team Decision\n\n'
    printf -- '- task_id: %s\n' "$task_id"
    printf -- '- title: %s\n' "$title"
    printf -- '- mode: %s\n' "$mode"
    printf -- '- objective: %s\n' "$objective"
    printf -- '- agents: %s\n' "$agents"
    printf -- '- round_file: %s\n' "$round_rel"
    if [[ "$team_interrupted" == "1" ]]; then
      printf -- '- status: interrupted\n'
    fi
    if [[ "$claude_review" == "1" ]]; then
      printf -- '- claude_review: %s\n' "$(path_relative_to_codex_home "$(task_team_claude_review_file "$task_id")")"
    fi
    printf '\n## Primary Decision\n\n'
    if [[ "$team_interrupted" == "1" ]]; then
      printf 'Team round was interrupted before every lane completed. Inspect the partial round file and rerun `codex-workflow team-start %s "<objective>"` if a complete decision is required.\n\n' "$task_id"
    elif [[ "$status_any_fail" == "1" ]]; then
      printf 'Team round failed. Inspect the round file before using this decision for promotion.\n\n'
    elif [[ "$mode" == "discuss" ]]; then
      printf 'Use `codex-workflow team-promote %s --to execute` when the discussion outcome is ready for implementation.\n\n' "$task_id"
    else
      printf 'Use `codex-workflow team-promote %s --to worktree` for higher-risk execution, or `--to finish` when the implementation is ready for final acceptance.\n\n' "$task_id"
    fi
    printf '## Lane Summaries\n\n'
    for role in "${roles[@]}"; do
      printf '### %s\n\n' "$role"
      trimmed_preview "${lane_message_files[$role]}"
      printf '\n\n'
    done
    if [[ "$claude_review" == "1" ]]; then
      printf '## Claude Review Summary\n\n'
      trimmed_preview "$claude_stdout_file"
      printf '\n'
    fi
  } > "$decision_file"

  {
    printf '# Staffing\n\n'
    printf -- '- task_id: %s\n' "$task_id"
    printf -- '- mode: %s\n' "$mode"
    printf -- '- decision_file: %s\n\n' "$decision_rel"
    printf '## Suggested Ownership\n\n'
    for role in "${roles[@]}"; do
      case "$role" in
        architect) printf -- '- architect: refine implementation path and decision boundaries.\n' ;;
        critic) printf -- '- critic: keep regression, risk, and boundary checks active through execution.\n' ;;
        verifier) printf -- '- verifier: own repo evidence checks and final verification commands.\n' ;;
        executor) printf -- '- executor: own primary implementation changes and command execution.\n' ;;
        reviewer) printf -- '- reviewer: challenge regressions and confirm acceptance coverage.\n' ;;
        *) printf -- '- %s: take a bounded slice defined by the decision file.\n' "$role" ;;
      esac
    done
  } > "$staffing_file"

  if [[ "$team_interrupted" == "1" ]]; then
    upsert_task_fields "$task_file" "active_team_backend=legacy" "active_team_mode=$mode" "active_team_status=interrupted" "active_team_decision=$decision_rel"
    write_task_state_json "$task_id"
    set_task_state_fields "$task_id" \
      "active_team.backend=legacy" \
      "active_team.status=interrupted" \
      "active_team.round_file=$round_rel" \
      "active_team.staffing=$staffing_rel" \
      "active_team.temp_dir=$tmpdir"
    append_task_runtime_event "$task_id" "team-complete" "interrupted"
    echo "team round interrupted: partial output in $round_file" >&2
    printf 'task_id: %s\n' "$task_id"
    printf 'mode: %s\n' "$mode"
    printf 'status: interrupted\n'
    printf 'decision: %s\n' "$decision_file"
    printf 'staffing: %s\n' "$staffing_file"
    printf 'round: %s\n' "$round_file"
    printf 'temp_dir: %s\n' "$tmpdir"
    exit 130
  fi

  if [[ "$status_any_fail" == "1" ]]; then
    upsert_task_fields "$task_file" "active_team_backend=legacy" "active_team_mode=$mode" "active_team_status=failed" "active_team_decision=$decision_rel"
    write_task_state_json "$task_id"
    set_task_state_fields "$task_id" \
      "active_team.backend=legacy" \
      "active_team.status=failed" \
      "active_team.round_file=$round_rel" \
      "active_team.staffing=$staffing_rel" \
      "active_team.temp_dir=$tmpdir"
    append_task_runtime_event "$task_id" "team-complete" "failed"
    echo "team round failed: inspect $round_file" >&2
    exit 1
  fi

  upsert_task_fields "$task_file" "active_team_backend=legacy" "active_team_mode=$mode" "active_team_status=complete" "active_team_decision=$decision_rel"
  write_task_state_json "$task_id"
  set_task_state_fields "$task_id" \
    "active_team.backend=legacy" \
    "active_team.status=complete" \
    "active_team.round_file=$round_rel" \
    "active_team.staffing=$staffing_rel"
  append_task_runtime_event "$task_id" "team-complete" "$mode"
  printf 'task_id: %s\n' "$task_id"
  printf 'mode: %s\n' "$mode"
  printf 'decision: %s\n' "$decision_file"
  printf 'staffing: %s\n' "$staffing_file"
  printf 'round: %s\n' "$round_file"
}

cmd_team_loop() {
  local task_id="$1"
  local objective="$2"
  shift 2
  local agents="3"
  local max_iterations="5"
  local max_time="1h"
  local archive="0"
  local name=""
  local verify_prompt_extra=""
  local arg
  local -a verify_checks=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --agents)
        [[ $# -ge 2 ]] || { echo 'usage: codex-workflow team-loop <task-id> "<objective>" [--agents N] [--max-iterations N] [--max-time <duration>] [--verify-check <command>]... [--verify "<prompt>"] [--archive] [--name <name>]' >&2; exit 1; }
        agents="$2"
        shift 2
        ;;
      --agents=*)
        agents="${1#--agents=}"
        shift
        ;;
      --max-iterations)
        [[ $# -ge 2 ]] || { echo 'usage: codex-workflow team-loop <task-id> "<objective>" [--max-iterations N]' >&2; exit 1; }
        max_iterations="$2"
        shift 2
        ;;
      --max-iterations=*)
        max_iterations="${1#--max-iterations=}"
        shift
        ;;
      --max-time)
        [[ $# -ge 2 ]] || { echo 'usage: codex-workflow team-loop <task-id> "<objective>" [--max-time <duration>]' >&2; exit 1; }
        max_time="$2"
        shift 2
        ;;
      --max-time=*)
        max_time="${1#--max-time=}"
        shift
        ;;
      --verify-check)
        [[ $# -ge 2 ]] || { echo 'usage: codex-workflow team-loop <task-id> "<objective>" [--verify-check <command>]...' >&2; exit 1; }
        verify_checks+=("$2")
        shift 2
        ;;
      --verify-check=*)
        verify_checks+=("${1#--verify-check=}")
        shift
        ;;
      --archive)
        archive="1"
        shift
        ;;
      --verify)
        [[ $# -ge 2 ]] || { echo 'usage: codex-workflow team-loop <task-id> "<objective>" [--verify "<prompt>"]' >&2; exit 1; }
        verify_prompt_extra="$2"
        shift 2
        ;;
      --verify=*)
        verify_prompt_extra="${1#--verify=}"
        shift
        ;;
      --name)
        [[ $# -ge 2 ]] || { echo 'usage: codex-workflow team-loop <task-id> "<objective>" [--name <name>]' >&2; exit 1; }
        name="$2"
        shift 2
        ;;
      --name=*)
        name="${1#--name=}"
        shift
        ;;
      *)
        echo "unknown team-loop option: $1" >&2
        exit 1
        ;;
    esac
  done

  validate_positive_integer "$agents" "agents"
  validate_positive_integer "$max_iterations" "max iterations"
  validate_query "$objective"
  validate_single_line_reason "max time" "$max_time"
  if [[ -n "$name" ]]; then
    validate_single_line_reason "loop name" "$name"
  fi
  for arg in "${verify_checks[@]}"; do
    validate_single_line_reason "verify check" "$arg"
  done

  if [[ -n "$verify_prompt_extra" ]]; then
    validate_single_line_reason "verify prompt" "$verify_prompt_extra"
  fi

  if ! command -v "$CODEX_BIN" >/dev/null 2>&1; then
    echo "codex CLI is required for team-loop verifier but was not found: $CODEX_BIN" >&2
    exit 1
  fi
  command -v python3 >/dev/null 2>&1 || { echo "python3 is required for bounded team-loop execution" >&2; exit 1; }

  local task_file title artifact_dir team_dir decision_file staffing_file decision_rel staffing_rel
  local max_time_seconds start_epoch deadline loop_token loop_file loop_rel loop_status iteration iterations_completed workflow_cmd
  local workflow_cmd_q task_id_q objective_q agents_q workflow_root_q codex_home_q team_command
  local iter_dir team_stdout team_stderr team_status checks_pass check_index check_stdout check_stderr check_status
  local verifier_prompt verifier_message verifier_stdout verifier_stderr verifier_status verifier_done verifier_sentinel now

  max_time_seconds="$(duration_to_seconds "$max_time")"

  sync_task_runtime "$task_id"
  task_file="$(require_task "$task_id")"
  title="$(get_field "$task_file" title)"
  artifact_dir="$(task_artifact_dir "$task_id")"
  team_dir="$(task_team_dir "$task_id")"
  decision_file="$(task_team_decision_file "$task_id")"
  staffing_file="$(task_team_staffing_file "$task_id")"
  decision_rel="$(path_relative_to_codex_home "$decision_file")"
  staffing_rel="$(path_relative_to_codex_home "$staffing_file")"
  name="${name:-atlas-team-loop-$task_id}"
  loop_token="$(timestamp_token)"
  loop_file="$team_dir/loop-$loop_token.md"
  loop_rel="$(path_relative_to_codex_home "$loop_file")"
  start_epoch="$(date +%s)"
  deadline=$((start_epoch + max_time_seconds))
  workflow_cmd="$SCRIPT_DIR/codex-workflow"
  printf -v workflow_cmd_q '%q' "$workflow_cmd"
  printf -v task_id_q '%q' "$task_id"
  printf -v objective_q '%q' "$objective"
  printf -v agents_q '%q' "$agents"
  printf -v workflow_root_q '%q' "$WORKFLOW_ROOT"
  printf -v codex_home_q '%q' "$CODEX_HOME_ROOT"
  team_command="CODEX_WORKFLOW_ROOT=$workflow_root_q CODEX_HOME_ROOT=$codex_home_q $workflow_cmd_q team-start $task_id_q $objective_q --mode execute --agents $agents_q"

  {
    printf '# Team Loop\n\n'
    printf -- '- task_id: %s\n' "$task_id"
    printf -- '- title: %s\n' "$title"
    printf -- '- objective: %s\n' "$objective"
    printf -- '- name: %s\n' "$name"
    printf -- '- agents: %s\n' "$agents"
    printf -- '- max_iterations: %s\n' "$max_iterations"
    printf -- '- max_time: %s\n' "$max_time"
    printf -- '- archive_requested: %s\n' "$archive"
    printf -- '- team_command: `%s`\n' "$team_command"
    printf -- '- created_at: %s\n\n' "$(timestamp_utc)"
  } > "$loop_file"

  upsert_task_fields "$task_file" "active_team_backend=legacy" "active_team_mode=execute" "active_team_status=loop-running" "active_team_decision=$decision_rel"
  write_task_state_json "$task_id"
  set_task_state_fields "$task_id" \
    "active_team.backend=legacy" \
    "active_team.mode=execute" \
    "active_team.status=loop-running" \
    "active_team.objective=$objective" \
    "active_team.agents=$agents" \
    "active_team.decision=$decision_rel" \
    "active_team.staffing=$staffing_rel" \
    "active_team.loop.status=loop-running" \
    "active_team.loop.name=$name" \
    "active_team.loop.file=$loop_rel" \
    "active_team.loop.iteration=0" \
    "active_team.loop.max_iterations=$max_iterations" \
    "active_team.loop.max_time=$max_time"
  append_task_runtime_event "$task_id" "team-loop-start" "name=$name max_iterations=$max_iterations max_time=$max_time loop=$loop_rel"

  iteration=1
  while (( iteration <= max_iterations )); do
    now="$(date +%s)"
    if (( now >= deadline )); then
      loop_status="loop-timeout"
      {
        printf '\n## Timeout\n\n'
        printf -- '- iteration_before_start: %s\n' "$iteration"
        printf -- '- max_time: %s\n' "$max_time"
        printf -- '- created_at: %s\n' "$(timestamp_utc)"
      } >> "$loop_file"
      break
    fi

    iter_dir="$team_dir/loop-$loop_token-iteration-$iteration"
    mkdir -p "$iter_dir"
    team_stdout="$iter_dir/team-start.stdout"
    team_stderr="$iter_dir/team-start.stderr"
    checks_pass="1"

    set_task_state_fields "$task_id" \
      "active_team.status=loop-running" \
      "active_team.loop.status=loop-running" \
      "active_team.loop.iteration=$iteration" \
      "active_team.loop.file=$loop_rel"
    append_task_runtime_event "$task_id" "team-loop-iteration-start" "$iteration"

    set +e
    team_loop_run_with_deadline "$deadline" env \
      CODEX_WORKFLOW_ROOT="$WORKFLOW_ROOT" \
      CODEX_HOME_ROOT="$CODEX_HOME_ROOT" \
      CODEX_BIN="$CODEX_BIN" \
      PASEO_BIN="$PASEO_BIN" \
      PASEO_CONFIG_FILE="$PASEO_CONFIG_FILE" \
      CODEX_CONFIG_FILE="$CODEX_CONFIG_FILE" \
      CODEX_HOOKS_FILE="$CODEX_HOOKS_FILE" \
      "$workflow_cmd" team-start "$task_id" "$objective" --mode execute --agents "$agents" >"$team_stdout" 2>"$team_stderr"
    team_status="$?"
    set -e

    {
      printf '\n## Iteration %s\n\n' "$iteration"
      printf -- '- team_start_exit_code: %s\n' "$team_status"
      if [[ "$team_status" -eq 124 ]]; then
        printf -- '- team_start_timed_out: true\n'
      fi
      printf -- '- output_dir: %s\n\n' "$iter_dir"
      printf '### Team Start Stdout\n\n```text\n'
      trimmed_preview "$team_stdout"
      printf '\n```\n\n'
      printf '### Team Start Stderr\n\n```text\n'
      trimmed_preview "$team_stderr"
      printf '\n```\n\n'
    } >> "$loop_file"

    if [[ "$team_status" -eq 124 ]]; then
      loop_status="loop-timeout"
      break
    fi
    if [[ "$team_status" -ne 0 ]]; then
      loop_status="loop-failed"
      break
    fi

    check_index=1
    for arg in "${verify_checks[@]}"; do
      check_stdout="$iter_dir/verify-check-$check_index.stdout"
      check_stderr="$iter_dir/verify-check-$check_index.stderr"
      set +e
      team_loop_run_with_deadline "$deadline" bash -lc "$arg" >"$check_stdout" 2>"$check_stderr"
      check_status="$?"
      set -e
      if [[ "$check_status" -ne 0 ]]; then
        checks_pass="0"
      fi
      if [[ "$check_status" -eq 124 ]]; then
        loop_status="loop-timeout"
      fi
      {
        printf '### Verify Check %s\n\n' "$check_index"
        printf -- '- command: `%s`\n' "$arg"
        printf -- '- exit_code: %s\n' "$check_status"
        if [[ "$check_status" -eq 124 ]]; then
          printf -- '- timed_out: true\n'
        fi
        printf '\n#### Stdout\n\n```text\n'
        trimmed_preview "$check_stdout"
        printf '\n```\n\n'
        printf '#### Stderr\n\n```text\n'
        trimmed_preview "$check_stderr"
        printf '\n```\n\n'
      } >> "$loop_file"
      if [[ "${loop_status:-}" == "loop-timeout" ]]; then
        break
      fi
      check_index=$((check_index + 1))
    done
    if [[ "${loop_status:-}" == "loop-timeout" ]]; then
      break
    fi

    verifier_message="$iter_dir/verifier.message"
    verifier_stdout="$iter_dir/verifier.stdout"
    verifier_stderr="$iter_dir/verifier.stderr"
    verifier_prompt="$(cat <<EOF
You are the verifier for an Atlas-managed team loop.

First non-empty line must be exactly one of:
done=true
done=false

Return done=true only when all required evidence proves the objective is satisfied. Return done=false when the latest team round only gives advice, when required implementation is missing, when verification was not run, when any verify-check failed, or when blockers remain unresolved.

Task: $task_id
Objective: $objective
Additional verification instruction: ${verify_prompt_extra:-Use the objective, team artifacts, and verify-check results as the acceptance contract.}
Iteration: $iteration
Verify checks passed: $checks_pass
Artifact directory: $artifact_dir
Team decision: $decision_file
Team staffing: $staffing_file
Team loop ledger: $loop_file

Check the latest artifacts and repository state. Cite the specific command output, file path, or artifact path that proves the result. Do not suggest fixes; only judge whether the loop should stop.
EOF
)"
    set +e
    team_loop_run_with_deadline "$deadline" "$CODEX_BIN" exec --skip-git-repo-check -C "$PWD" --output-last-message "$verifier_message" "$verifier_prompt" >"$verifier_stdout" 2>"$verifier_stderr"
    verifier_status="$?"
    set -e
    verifier_sentinel="$(team_loop_verifier_sentinel "$verifier_message")"
    verifier_done="0"
    if [[ "$checks_pass" == "1" ]] && [[ "$verifier_status" -eq 0 ]] && [[ "$verifier_sentinel" == "true" ]]; then
      verifier_done="1"
    fi
    {
      printf '### Verifier\n\n'
      printf -- '- exit_code: %s\n' "$verifier_status"
      if [[ "$verifier_status" -eq 124 ]]; then
        printf -- '- timed_out: true\n'
      fi
      printf -- '- sentinel: %s\n' "$verifier_sentinel"
      printf -- '- done: %s\n\n' "$verifier_done"
      printf '#### Message\n\n```markdown\n'
      trimmed_preview "$verifier_message"
      printf '\n```\n\n'
      printf '#### Stdout\n\n```text\n'
      trimmed_preview "$verifier_stdout"
      printf '\n```\n\n'
      printf '#### Stderr\n\n```text\n'
      trimmed_preview "$verifier_stderr"
      printf '\n```\n\n'
    } >> "$loop_file"

    if [[ "$verifier_status" -eq 124 ]]; then
      loop_status="loop-timeout"
      break
    fi
    if [[ "$verifier_status" -ne 0 ]]; then
      loop_status="loop-failed"
      break
    fi
    if [[ "$verifier_done" == "1" ]]; then
      loop_status="loop-done"
      break
    fi

    loop_status="loop-incomplete"
    iteration=$((iteration + 1))
  done

  if [[ -z "${loop_status:-}" ]]; then
    loop_status="loop-incomplete"
  fi
  if (( iteration > max_iterations )); then
    iterations_completed="$max_iterations"
  else
    iterations_completed="$iteration"
  fi
  {
    printf '\n## Final Status\n\n'
    printf -- '- status: %s\n' "$loop_status"
    printf -- '- iterations_completed: %s\n' "$iterations_completed"
    printf -- '- completed_at: %s\n' "$(timestamp_utc)"
  } >> "$loop_file"

  upsert_task_fields "$task_file" "active_team_backend=legacy" "active_team_status=$loop_status" "active_team_decision=$decision_rel"
  write_task_state_json "$task_id"
  set_task_state_fields "$task_id" \
    "active_team.backend=legacy" \
    "active_team.status=$loop_status" \
    "active_team.decision=$decision_rel" \
    "active_team.staffing=$staffing_rel" \
    "active_team.loop.status=$loop_status" \
    "active_team.loop.file=$loop_rel" \
    "active_team.loop.iteration=$iterations_completed" \
    "active_team.loop.max_iterations=$max_iterations" \
    "active_team.loop.max_time=$max_time"
  append_task_runtime_event "$task_id" "team-loop-complete" "$loop_status"

  printf 'task_id: %s\n' "$task_id"
  printf 'status: %s\n' "$loop_status"
  printf 'loop: %s\n' "$loop_file"
  printf 'iterations: %s\n' "$iterations_completed"
  if [[ "$loop_status" == "loop-done" ]]; then
    return 0
  fi
  return 1
}

main() {
  if [[ "$ATLAS_DOCTOR_STRICT_REQUESTED" != true ]]; then
    ensure_tasks_dir
  fi

  case "${1:-}" in
    init-task)
      shift
      cmd_init_task "$@"
      ;;
    list)
      shift
      node "$SCRIPT_DIR/lib/codex-workflow/task/cli.js" list "$@"
      ;;
    start)
      shift
      cmd_task_mutation start "$@"
      ;;
    block)
      shift
      cmd_task_mutation block "$@"
      ;;
    resume)
      shift
      cmd_task_mutation resume "$@"
      ;;
    done)
      shift
      cmd_task_mutation 'done' "$@"
      ;;
    archive)
      shift
      cmd_task_mutation archive "$@"
      ;;
    stale)
      shift
      node "$SCRIPT_DIR/lib/codex-workflow/task/cli.js" stale "$@"
      ;;
    show)
      shift
      node "$SCRIPT_DIR/lib/codex-workflow/task/cli.js" show "$@"
      ;;
    ready)
      shift
      node "$SCRIPT_DIR/lib/codex-workflow/verification/cli.js" ready "$@"
      ;;
    scaffold-intake)
      shift
      node "$SCRIPT_DIR/lib/codex-workflow/artifact/cli.js" scaffold-intake "$@"
      ;;
    scaffold-brainstorm)
      shift
      node "$SCRIPT_DIR/lib/codex-workflow/artifact/cli.js" scaffold-brainstorm "$@"
      ;;
    scaffold-clarify)
      shift
      node "$SCRIPT_DIR/lib/codex-workflow/artifact/cli.js" scaffold-clarify "$@"
      ;;
    scaffold-team)
      shift
      node "$SCRIPT_DIR/lib/codex-workflow/artifact/cli.js" scaffold-team "$@"
      ;;
    scaffold-phase)
      shift
      node "$SCRIPT_DIR/lib/codex-workflow/artifact/cli.js" scaffold-phase "$@"
      ;;
    handoff-envelope)
      [[ $# -ge 2 ]] || { echo 'usage: codex-workflow handoff-envelope <task-id> --prd <file> --repo <path> --base <branch> [--title "<title>"] [--packet <file>] --acceptance "<id>|<requirement>|<required|advisory>" --validation "<id>|<surface>|<required|advisory>|<evidence>"' >&2; exit 1; }
      shift
      cmd_handoff_envelope "$@"
      ;;
    result-ingest)
      [[ $# -ge 2 ]] || { echo 'usage: codex-workflow result-ingest <task-id> --issue <url-or-id> --outcome draft-pr|blocker --commit <sha-or-unknown> --worktree <path-or-none> --evidence <path-or-url> [--draft-pr <url>] [--blocker <path-or-url>] [--summary "<summary>"] [--lesson "<candidate>"]' >&2; exit 1; }
      shift
      cmd_result_ingest "$@"
      ;;
    route-decision)
      shift
      node "$SCRIPT_DIR/lib/codex-workflow/artifact/cli.js" route-decision "$@"
      ;;
    curated-packet)
      [[ $# -ge 2 ]] || { echo 'usage: codex-workflow curated-packet <task-id> --prd <file> --repo <path> --base <branch> --source <file>... [--skip "<reason>"] | codex-workflow curated-packet --lint <file>' >&2; exit 1; }
      shift
      cmd_curated_packet "$@"
      ;;
    checkpoint)
      shift
      node "$SCRIPT_DIR/lib/codex-workflow/artifact/cli.js" checkpoint "$@"
      ;;
    source-snapshot)
      shift
      node "$SCRIPT_DIR/lib/codex-workflow/artifact/cli.js" source-snapshot "$@"
      ;;
    prompt-bundle)
      shift
      node "$SCRIPT_DIR/lib/codex-workflow/artifact/cli.js" prompt-bundle "$@"
      ;;
    trace-promote)
      shift
      node "$SCRIPT_DIR/lib/codex-workflow/feedback/cli.js" trace-promote "$@"
      ;;
    multica-feedback)
      [[ $# -ge 2 ]] || { echo 'usage: codex-workflow multica-feedback <task-id> --issue <url-or-id> --commit <sha-or-unknown> --round <n> --status clean|repair-needed|blocked [--review <path-or-url>]... [--e2e <path-or-url>]... [--scorecard <path-or-url>]... [--evidence-manifest <path-or-url>] [--blocking-finding "<id|summary>"]...' >&2; exit 1; }
      shift
      cmd_multica_feedback "$@"
      ;;
    feedback-cycle)
      shift
      node "$SCRIPT_DIR/lib/codex-workflow/feedback/cli.js" feedback-cycle "$@"
      ;;
    lesson-candidate)
      shift
      node "$SCRIPT_DIR/lib/codex-workflow/feedback/cli.js" lesson-candidate "$@"
      ;;
    learning-decision)
      shift
      node "$SCRIPT_DIR/lib/codex-workflow/feedback/cli.js" learning-decision "$@"
      ;;
    gate-metric)
      shift
      node "$SCRIPT_DIR/lib/codex-workflow/verification/cli.js" gate-metric "$@"
      ;;
    gate-report)
      shift
      node "$SCRIPT_DIR/lib/codex-workflow/verification/cli.js" gate-report "$@"
      ;;
    outcome-mark)
      shift
      node "$SCRIPT_DIR/lib/codex-workflow/outcome/cli.js" outcome-mark "$@"
      ;;
    outcome-report)
      shift
      node "$SCRIPT_DIR/lib/codex-workflow/outcome/cli.js" outcome-report "$@"
      ;;
    learn)
      [[ $# -eq 4 ]] || { echo 'usage: codex-workflow learn <task-id> "<learning title>" "<lesson>"' >&2; exit 1; }
      cmd_learn "$2" "$3" "$4"
      ;;
    dream)
      [[ $# -eq 1 ]] || { echo 'usage: codex-workflow dream' >&2; exit 1; }
      cmd_dream
      ;;
    recall)
      [[ $# -eq 2 ]] || { echo 'usage: codex-workflow recall "<query>"' >&2; exit 1; }
      cmd_recall "$2"
      ;;
    doctor)
      shift
      cmd_doctor "$@"
      ;;
    smoke)
      [[ $# -eq 1 ]] || { echo 'usage: codex-workflow smoke' >&2; exit 1; }
      cmd_smoke
      ;;
    verify)
      shift
      node "$SCRIPT_DIR/lib/codex-workflow/verification/cli.js" verify "$@"
      ;;
    self-test)
      [[ $# -eq 1 ]] || { echo 'usage: codex-workflow self-test' >&2; exit 1; }
      cmd_self_test
      ;;
    install-hooks)
      [[ $# -eq 1 ]] || { echo 'usage: codex-workflow install-hooks' >&2; exit 1; }
      cmd_install_hooks
      ;;
    team-start)
      [[ $# -ge 3 ]] || { echo 'usage: codex-workflow team-start <task-id> "<objective>" [--mode discuss|execute] [--agents N] [--claude-review]' >&2; exit 1; }
      shift
      cmd_team_start "$@"
      ;;
    team-record-start|team-record-finalize|team-loop-record|team-status|team-stop|team-promote|team-slice-accept|team-slice-supersede)
      command="$1"
      shift
      node "$SCRIPT_DIR/lib/codex-workflow/team/cli.js" "$command" "$@"
      ;;
    team-loop)
      [[ $# -ge 3 ]] || { echo 'usage: codex-workflow team-loop <task-id> "<objective>" [--agents N] [--max-iterations N] [--max-time <duration>] [--verify-check <command>]... [--verify "<prompt>"] [--archive] [--name <name>]' >&2; exit 1; }
      shift
      cmd_team_loop "$@"
      ;;
    *)
      echo 'usage: codex-workflow {init-task|list|start|block|resume|done|archive|stale|show|ready|scaffold-intake|scaffold-brainstorm|scaffold-clarify|scaffold-team|scaffold-phase|handoff-envelope|result-ingest|route-decision|curated-packet|checkpoint|source-snapshot|prompt-bundle|trace-promote|multica-feedback|feedback-cycle|lesson-candidate|learning-decision|gate-metric|gate-report|outcome-mark|outcome-report|learn|dream|recall|doctor|doctor --json|smoke|verify|self-test|install-hooks|team-start|team-record-start|team-record-finalize|team-loop-record|team-status|team-stop|team-promote|team-selection-record|team-lane-record|team-dispatch-record|team-attempt-record|team-fallback-record|team-slice-accept|team-slice-supersede|team-loop}' >&2
      exit 1
      ;;
  esac
}

main "$@"
