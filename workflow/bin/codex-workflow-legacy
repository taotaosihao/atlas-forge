read_current_task_id() {
  python3 - "$CURRENT_TASK_FILE" <<'PY'
from pathlib import Path
import json
import sys

path = Path(sys.argv[1])
if not path.exists():
    raise SystemExit(0)
try:
    data = json.loads(path.read_text(encoding="utf-8"))
except json.JSONDecodeError:
    raise SystemExit(0)
task_id = data.get("task_id", "")
if task_id:
    print(task_id)
PY
}

list_task_ids() {
  find "$TASKS_DIR" -maxdepth 1 -name '*.md' -printf '%f\n' 2>/dev/null | sort | sed 's/\.md$//'
}

get_field() {
  local file="$1"
  local field="$2"
  awk -v want="$field" '
    BEGIN {
      in_header = 1
    }
    {
      line = $0
      sub(/\r$/, "", line)
      if (in_header) {
        if (line ~ "^" want ": ") {
          sub("^" want ": ", "", line)
          print line
          exit
        } else if (line ~ /^$/ || line ~ /^##[[:space:]]/ || line ~ /^#[[:space:]]/) {
          in_header = 0
        } else if (line ~ /^[A-Za-z0-9_.-]+: /) {
          # Keep unknown metadata lines in the header.
        } else {
          in_header = 0
        }
      }
    }
  ' "$file" | head -n 1
}

get_learning_field() {
  local file="$1"
  local field="$2"

  awk -v want="$field" '
    BEGIN {
      in_header = 1
    }
    {
      line = $0
      sub(/\r$/, "", line)
      if (in_header) {
        if (line ~ "^" want ": ") {
          sub("^" want ": ", "", line)
          print line
          exit
        } else if (line ~ /^##[[:space:]]/ || line ~ /^$/) {
          in_header = 0
        }
      }
    }
  ' "$file" | head -n 1
}

upsert_task_fields() {
  local file="$1"
  shift
  python3 - "$file" "$@" <<'PY'
from pathlib import Path
import re
import sys

path = Path(sys.argv[1])
updates = []
for raw in sys.argv[2:]:
    key, value = raw.split("=", 1)
    updates.append((key, value))

text = path.read_text(encoding="utf-8")
lines = text.splitlines(keepends=True)

header_end = len(lines)
for idx, line in enumerate(lines):
    stripped = line.rstrip("\r\n")
    if stripped == "" or stripped.startswith("## ") or stripped.startswith("# "):
        header_end = idx
        break
    if re.match(r"^[A-Za-z0-9_.-]+: ", stripped):
        continue
    header_end = idx
    break

header = [line.rstrip("\r\n") for line in lines[:header_end]]
body = "".join(lines[header_end:])
keys = [key for key, _ in updates]
done = set()

for idx, line in enumerate(header):
    for key, value in updates:
        if key in done:
            continue
        if re.match(rf"^{re.escape(key)}: ", line):
            header[idx] = f"{key}: {value}"
            done.add(key)
            break

for key, value in updates:
    if key not in done:
        header.append(f"{key}: {value}")

header_text = "\n".join(header)
if header_text:
    header_text += "\n"
if body:
    if not body.startswith("\n"):
      header_text += "\n"
    header_text += body.lstrip("\n")

path.write_text(header_text, encoding="utf-8")
PY
}

ensure_task_runtime_scaffold() {
  local task_id="$1"
  local title="$2"
  local artifact_dir verification_dir team_dir hook_failures_dir
  artifact_dir="$(task_artifact_dir "$task_id")"
  verification_dir="$(task_verification_dir "$task_id")"
  team_dir="$(task_team_dir "$task_id")"
  hook_failures_dir="$(task_hook_failures_dir "$task_id")"
  mkdir -p "$artifact_dir" "$verification_dir" "$team_dir" "$hook_failures_dir"
  if [[ ! -f "$artifact_dir/context.md" ]]; then
    printf '# Context\n\nTask: %s\nTitle: %s\n' "$task_id" "$title" > "$artifact_dir/context.md"
  fi
  if [[ ! -f "$artifact_dir/spec.md" ]]; then
    printf '# Spec\n\nTask: %s\n' "$task_id" > "$artifact_dir/spec.md"
  fi
  if [[ ! -f "$artifact_dir/analysis.md" ]]; then
    printf '# Analysis\n\nTask: %s\n' "$task_id" > "$artifact_dir/analysis.md"
  fi
  if [[ ! -f "$(task_team_decision_file "$task_id")" ]]; then
    printf '# Team Decision\n\nPending discussion.\n' > "$(task_team_decision_file "$task_id")"
  fi
  if [[ ! -f "$(task_team_staffing_file "$task_id")" ]]; then
    printf '# Staffing\n\nPending discussion.\n' > "$(task_team_staffing_file "$task_id")"
  fi
}

write_task_state_json() {
  local task_id="$1"
  local task_file artifact_dir_rel state_file
  task_file="$(require_task "$task_id")"
  artifact_dir_rel="$(task_artifact_dir_rel "$task_id")"
  state_file="$(task_state_file "$task_id")"
  python3 - "$task_file" "$state_file" "$artifact_dir_rel" "$(timestamp_utc)" <<'PY'
from pathlib import Path
import json
import re
import sys

task_file = Path(sys.argv[1])
state_file = Path(sys.argv[2])
artifact_dir = sys.argv[3]
now = sys.argv[4]
text = task_file.read_text(encoding="utf-8")

def get_field(name: str) -> str:
    match = re.search(rf"^{re.escape(name)}: ?(.*)$", text, re.MULTILINE)
    return match.group(1).strip() if match else ""

state = {}
if state_file.exists():
    try:
        state = json.loads(state_file.read_text(encoding="utf-8"))
    except json.JSONDecodeError:
        state = {}

active_team = state.get("active_team", {})
active_team["backend"] = get_field("active_team_backend") or active_team.get("backend", "")
active_team["mode"] = get_field("active_team_mode") or active_team.get("mode", "")
active_team["status"] = get_field("active_team_status") or active_team.get("status", "")
active_team["decision"] = get_field("active_team_decision") or active_team.get("decision", "")

state.update(
    {
        "task_id": get_field("id") or task_file.stem,
        "title": get_field("title"),
        "status": get_field("status"),
        "artifact_dir": artifact_dir,
        "last_verified_at": get_field("last_verified_at"),
        "updated_at": now,
    }
)
state["active_team"] = active_team
state_file.parent.mkdir(parents=True, exist_ok=True)
state_file.write_text(json.dumps(state, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
PY
}

set_task_state_fields() {
  local task_id="$1"
  shift
  local state_file
  state_file="$(task_state_file "$task_id")"
  python3 - "$state_file" "$(timestamp_utc)" "$@" <<'PY'
from pathlib import Path
import json
import sys

state_path = Path(sys.argv[1])
now = sys.argv[2]
pairs = sys.argv[3:]

state = {}
if state_path.exists():
    try:
        state = json.loads(state_path.read_text(encoding="utf-8"))
    except json.JSONDecodeError:
        state = {}

for pair in pairs:
    key, value = pair.split("=", 1)
    if value == "__TRUE__":
        cast = True
    elif value == "__FALSE__":
        cast = False
    elif value == "__NULL__":
        cast = None
    elif value.isdigit():
        cast = int(value)
    else:
        cast = value
    cursor = state
    parts = key.split(".")
    for part in parts[:-1]:
        cursor = cursor.setdefault(part, {})
    cursor[parts[-1]] = cast

state["updated_at"] = now
state_path.parent.mkdir(parents=True, exist_ok=True)
state_path.write_text(json.dumps(state, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
PY
}

