#!/usr/bin/env node

const fs = require('fs');
const os = require('os');
const path = require('path');

function fail(message) {
  process.stderr.write(`atlas-agent-model-policy: ${message}\n`);
  process.exit(1);
}

function readJson(file, label) {
  try {
    return JSON.parse(fs.readFileSync(file, 'utf8'));
  } catch (error) {
    fail(`cannot read ${label} ${file}: ${error.message}`);
  }
}

function parseArgs(argv) {
  const args = { command: 'check' };
  if (argv[0] && !argv[0].startsWith('--')) args.command = argv.shift();
  while (argv.length) {
    const flag = argv.shift();
    if (!['--catalog', '--policy', '--agents-dir'].includes(flag) || !argv.length) {
      fail(`invalid argument ${flag}`);
    }
    args[flag.slice(2).replace('-', '_')] = argv.shift();
  }
  if (!['check', 'resolve'].includes(args.command)) fail(`unknown command ${args.command}`);
  return args;
}

function compareFamily(a, b) {
  return a.major - b.major || a.minor - b.minor;
}

function resolvePolicy(catalog, policy) {
  const familyPattern = new RegExp(policy.family.slug_pattern);
  const models = (catalog.models || []).flatMap((model) => {
    const match = familyPattern.exec(model.slug || '');
    if (!match) return [];
    return [{ ...model, family: { major: Number(match[1]), minor: Number(match[2]) } }];
  });
  if (!models.length) fail('catalog contains no matching GPT model family');

  const latestFamily = models.map((model) => model.family).sort(compareFamily).at(-1);
  const latest = models.filter((model) => compareFamily(model.family, latestFamily) === 0);
  const capabilityModels = {};

  for (const [capability, rule] of Object.entries(policy.capabilities)) {
    const pattern = new RegExp(rule.description_pattern, 'i');
    const matches = latest.filter((model) => pattern.test(model.description || ''));
    if (matches.length !== 1) {
      fail(`latest family ${latestFamily.major}.${latestFamily.minor} resolves ${matches.length} models for capability ${capability}`);
    }
    capabilityModels[capability] = matches[0];
  }

  const roles = {};
  for (const [role, profile] of Object.entries(policy.roles)) {
    const model = capabilityModels[profile.capability];
    if (!model) fail(`role ${role} references unknown capability ${profile.capability}`);
    const efforts = (model.supported_reasoning_levels || []).map((entry) => entry.effort);
    if (!efforts.includes(profile.reasoning_effort)) {
      fail(`model ${model.slug} does not support reasoning effort ${profile.reasoning_effort} for ${role}`);
    }
    roles[role] = { model: model.slug, model_reasoning_effort: profile.reasoning_effort };
  }
  return { family: `${latestFamily.major}.${latestFamily.minor}`, roles };
}

function readAgent(file) {
  const source = fs.readFileSync(file, 'utf8');
  const model = source.match(/^model\s*=\s*"([^"]+)"/m)?.[1];
  const effort = source.match(/^model_reasoning_effort\s*=\s*"([^"]+)"/m)?.[1];
  return { model, model_reasoning_effort: effort };
}

const args = parseArgs(process.argv.slice(2));
const repoRoot = path.resolve(__dirname, '..', '..');
const managedAgentsDir = fs.existsSync(path.join(repoRoot, '.codex', 'agents'))
  ? path.join(repoRoot, '.codex', 'agents')
  : path.join(repoRoot, 'agents');
const catalogFile = path.resolve(args.catalog || path.join(os.homedir(), '.codex', 'models_cache.json'));
const policyFile = path.resolve(args.policy || path.join(managedAgentsDir, 'model-policy.json'));
const agentsDir = path.resolve(args.agents_dir || managedAgentsDir);
const resolved = resolvePolicy(readJson(catalogFile, 'catalog'), readJson(policyFile, 'policy'));

if (args.command === 'resolve') {
  process.stdout.write(`${JSON.stringify(resolved, null, 2)}\n`);
  process.exit(0);
}

for (const [role, expected] of Object.entries(resolved.roles)) {
  const file = path.join(agentsDir, `${role}.toml`);
  let actual;
  try {
    actual = readAgent(file);
  } catch (error) {
    fail(`cannot read agent ${file}: ${error.message}`);
  }
  if (actual.model !== expected.model || actual.model_reasoning_effort !== expected.model_reasoning_effort) {
    fail(`${role} is stale: expected ${expected.model}/${expected.model_reasoning_effort}, found ${actual.model || 'missing'}/${actual.model_reasoning_effort || 'missing'}`);
  }
}

process.stdout.write(`atlas-agent-model-policy: ok family=${resolved.family} roles=${Object.keys(resolved.roles).length}\n`);
