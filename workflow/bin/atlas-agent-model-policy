#!/usr/bin/env node

const fs = require('fs');
const os = require('os');
const path = require('path');

function fail(message) {
  process.stderr.write(`atlas-agent-model-policy: ${message}\n`);
  process.exit(1);
}

function readJson(file, label) {
  try {
    return JSON.parse(fs.readFileSync(file, 'utf8'));
  } catch (error) {
    fail(`cannot read ${label} ${file}: ${error.message}`);
  }
}

function parseArgs(argv) {
  const args = { command: 'check' };
  if (argv[0] && !argv[0].startsWith('--')) args.command = argv.shift();
  while (argv.length) {
    const flag = argv.shift();
    if (!['--catalog', '--policy', '--agents-dir', '--mode'].includes(flag) || !argv.length) {
      fail(`invalid argument ${flag}`);
    }
    args[flag.slice(2).replace('-', '_')] = argv.shift();
  }
  if (!['check', 'resolve'].includes(args.command)) fail(`unknown command ${args.command}`);
  if (args.mode && !['planning-review', 'saving', 'quality'].includes(args.mode)) {
    fail(`unknown mode ${args.mode}`);
  }
  return args;
}

function compareFamily(a, b) {
  return a.major - b.major || a.minor - b.minor;
}

function resolvePolicy(catalog, policy, mode) {
  const familyPattern = new RegExp(policy.family.slug_pattern);
  const models = (catalog.models || []).flatMap((model) => {
    const match = familyPattern.exec(model.slug || '');
    if (!match) return [];
    return [{ ...model, family: { major: Number(match[1]), minor: Number(match[2]) } }];
  });
  if (!models.length) fail('catalog contains no matching GPT model family');

  const latestFamily = models.map((model) => model.family).sort(compareFamily).at(-1);
  const latest = models.filter((model) => compareFamily(model.family, latestFamily) === 0);
  const rolePolicy = mode === 'planning-review'
    ? policy.planning_review_roles
    : mode === 'quality'
      ? policy.quality_roles
      : policy.roles;
  if (!rolePolicy || typeof rolePolicy !== 'object') fail(`policy lacks ${mode} roles`);
  if (mode === 'planning-review') {
    const lowTierRole = Object.entries(rolePolicy)
      .find(([, profile]) => profile.capability !== 'frontier');
    if (lowTierRole) {
      fail(`planning-review role ${lowTierRole[0]} must use frontier capability`);
    }
  }
  const requiredCapabilities = new Set(Object.values(rolePolicy).map((profile) => profile.capability));
  const capabilityModels = {};

  for (const [capability, rule] of Object.entries(policy.capabilities)) {
    if (!requiredCapabilities.has(capability)) continue;
    const pattern = new RegExp(rule.description_pattern, 'i');
    const matches = latest.filter((model) => pattern.test(model.description || ''));
    if (matches.length !== 1) {
      fail(`latest family ${latestFamily.major}.${latestFamily.minor} resolves ${matches.length} models for capability ${capability}`);
    }
    capabilityModels[capability] = matches[0];
  }

  const roles = {};
  for (const [role, profile] of Object.entries(rolePolicy)) {
    const model = capabilityModels[profile.capability];
    if (!model) fail(`role ${role} references unknown capability ${profile.capability}`);
    const efforts = (model.supported_reasoning_levels || []).map((entry) => entry.effort);
    if (!efforts.includes(profile.reasoning_effort)) {
      fail(`model ${model.slug} does not support reasoning effort ${profile.reasoning_effort} for ${role}`);
    }
    roles[role] = { model: model.slug, model_reasoning_effort: profile.reasoning_effort };
  }
  return {
    family: `${latestFamily.major}.${latestFamily.minor}`,
    mode,
    capabilities: Object.fromEntries(
      Object.entries(capabilityModels).map(([capability, model]) => [capability, model.slug]),
    ),
    roles,
  };
}

function readAgent(file) {
  const source = fs.readFileSync(file, 'utf8');
  const model = source.match(/^model\s*=\s*"([^"]+)"/m)?.[1];
  const effort = source.match(/^model_reasoning_effort\s*=\s*"([^"]+)"/m)?.[1];
  const modelProvider = source.match(/^model_provider\s*=\s*"([^"]+)"/m)?.[1];
  const sandboxMode = source.match(/^sandbox_mode\s*=\s*"([^"]+)"/m)?.[1];
  const instructions = source.match(/^developer_instructions\s*=\s*"""([\s\S]*?)"""/m)?.[1];
  return {
    model,
    model_reasoning_effort: effort,
    model_provider: modelProvider,
    sandbox_mode: sandboxMode,
    developer_instructions: instructions,
    source,
  };
}

const args = parseArgs(process.argv.slice(2));
const repoRoot = path.resolve(__dirname, '..', '..');
const managedAgentsDir = fs.existsSync(path.join(repoRoot, '.codex', 'agents'))
  ? path.join(repoRoot, '.codex', 'agents')
  : path.join(repoRoot, 'agents');
const catalogFile = path.resolve(args.catalog || path.join(os.homedir(), '.codex', 'models_cache.json'));
const policyFile = path.resolve(args.policy || path.join(managedAgentsDir, 'model-policy.json'));
const agentsDir = path.resolve(args.agents_dir || managedAgentsDir);
const policy = readJson(policyFile, 'policy');
if (![1, 2].includes(policy.schema_version)) fail(`unsupported policy schema ${policy.schema_version}`);
if (policy.schema_version === 2 && policy.default_mode !== 'planning-review') {
  fail('policy schema v2 must default to planning-review');
}
const mode = args.mode || policy.default_mode || 'saving';
if (!['planning-review', 'saving', 'quality'].includes(mode)) fail(`unknown default mode ${mode}`);
const resolved = resolvePolicy(readJson(catalogFile, 'catalog'), policy, mode);

if (args.command === 'resolve') {
  const { capabilities: _capabilities, ...publicResolved } = resolved;
  process.stdout.write(`${JSON.stringify(publicResolved, null, 2)}\n`);
  process.exit(0);
}

for (const role of Object.keys(resolved.roles)) {
  const file = path.join(agentsDir, `${role}.toml`);
  let actual;
  try {
    actual = readAgent(file);
  } catch (error) {
    fail(`cannot read agent ${file}: ${error.message}`);
  }
  const pinned = [
    ['model', actual.model],
    ['model_reasoning_effort', actual.model_reasoning_effort],
    ['model_provider', actual.model_provider],
  ].filter(([, value]) => value !== undefined);
  if (pinned.length > 0) {
    fail(`${role} must leave native routing to explicit dispatch values; remove ${pinned.map(([key]) => key).join(', ')}`);
  }
}

const equivalentRoles = policy.equivalent_roles || {};
for (const [role, expected] of Object.entries(equivalentRoles)) {
  const baselineExpected = resolved.roles[expected.equivalent_to];
  if (!baselineExpected) continue;

  let actual;
  let baseline;
  try {
    actual = readAgent(path.join(agentsDir, `${role}.toml`));
    baseline = readAgent(path.join(agentsDir, `${expected.equivalent_to}.toml`));
  } catch (error) {
    fail(`cannot read equivalent agent ${role}: ${error.message}`);
  }

  const mismatches = [
    ['model', actual.model, expected.model],
    ['model_reasoning_effort', actual.model_reasoning_effort, expected.reasoning_effort],
    ['model_provider', actual.model_provider, expected.model_provider],
    ['sandbox_mode', actual.sandbox_mode, expected.sandbox_mode],
  ].filter(([, found, wanted]) => found !== wanted);
  if (mismatches.length > 0) {
    fail(`${role} equivalent profile mismatch: ${mismatches.map(([key, found, wanted]) => `${key} expected ${wanted}, found ${found || 'missing'}`).join('; ')}`);
  }
  if (baseline.sandbox_mode !== expected.sandbox_mode) {
    fail(`${expected.equivalent_to} sandbox mismatch: expected ${expected.sandbox_mode}, found ${baseline.sandbox_mode || 'missing'}`);
  }
  if (!actual.developer_instructions || actual.developer_instructions !== baseline.developer_instructions) {
    fail(`${role} must preserve the exact developer_instructions of ${expected.equivalent_to}`);
  }
}

const equivalentRoleCount = Object.values(equivalentRoles)
  .filter((expected) => resolved.roles[expected.equivalent_to])
  .length;
const roleCount = Object.keys(resolved.roles).length + equivalentRoleCount;
process.stdout.write(`atlas-agent-model-policy: ok family=${resolved.family} mode=${resolved.mode} roles=${roleCount}\n`);
