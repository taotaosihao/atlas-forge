{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas-web-acceptance-project-config-v1",
  "type": "object",
  "required": ["schema_version", "protocol_version", "task_id", "scenario_id", "project_root", "adapter", "phases", "validators", "required_evidence"],
  "properties": {
    "schema_version": {"const": 1},
    "protocol_version": {"const": "1"},
    "task_id": {"type": "string", "minLength": 1},
    "scenario_id": {"type": "string", "minLength": 1},
    "project_root": {"type": "string", "minLength": 1},
    "entrypoint": {"type": "string", "minLength": 1},
    "browser": {"type": "string", "minLength": 1},
    "viewport": {"type": "object", "required": ["width", "height"], "properties": {"width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
    "role": {"type": "string", "minLength": 1},
    "consecutive_successes": {"type": "integer", "minimum": 1},
    "adapter": {"type": "object", "required": ["argv"], "properties": {"argv": {"$ref": "#/$defs/argv"}}, "additionalProperties": false},
    "phases": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "validators": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "claim_id", "argv"], "properties": {"id": {"type": "string", "minLength": 1}, "claim_id": {"type": "string", "minLength": 1}, "argv": {"$ref": "#/$defs/argv"}}, "additionalProperties": false}},
    "required_evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "claim_id"], "properties": {"id": {"type": "string", "minLength": 1}, "claim_id": {"type": "string", "minLength": 1}}, "additionalProperties": false}}
  },
  "$defs": {"argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}},
  "additionalProperties": false
}
