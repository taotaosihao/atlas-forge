{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "atlas-web-acceptance-run-result-v1", "type": "object",
  "required": ["schema_version", "tool", "run_id", "task_id", "scenario_id", "technical_status", "failure_class", "attempts", "contract_digest", "config_digest", "evidence_index_digest"],
  "properties": {"schema_version": {"const": 1}, "tool": {"const": "codex-web-acceptance"}, "run_id": {"type": "string", "minLength": 1}, "task_id": {"type": "string", "minLength": 1}, "scenario_id": {"type": "string", "minLength": 1}, "technical_status": {"enum": ["passed", "unstable", "failed"]}, "failure_class": {"oneOf": [{"enum": ["project", "environment", "safety", "protocol", "internal"]}, {"type": "null"}]}, "attempts": {"type": "array", "minItems": 1, "items": {"oneOf": [{"type": "object", "required": ["attempt", "status", "failure_class"], "properties": {"attempt": {"type": "integer", "minimum": 1}, "status": {"const": "passed"}, "failure_class": {"type": "null"}}, "additionalProperties": false}, {"type": "object", "required": ["attempt", "status", "failure_class", "reason"], "properties": {"attempt": {"type": "integer", "minimum": 1}, "status": {"const": "failed"}, "failure_class": {"enum": ["project", "environment", "safety", "protocol", "internal"]}, "reason": {"type": "string", "minLength": 1}}, "additionalProperties": false}]}}, "contract_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "config_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "evidence_index_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "additionalProperties": false
}
