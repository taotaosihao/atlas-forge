{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "atlas-web-acceptance-validator-input-v1", "type": "object",
  "required": ["protocol_version", "validator_id", "claim_id", "input_digest", "evidence_digest", "facts", "evidence_refs"],
