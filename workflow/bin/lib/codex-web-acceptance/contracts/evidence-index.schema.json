{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "atlas-web-acceptance-evidence-index-v1", "type": "object",
  "required": ["schema_version", "run_id", "attempts", "evidence_refs", "validators"],
  "properties": {
    "schema_version": {"const": 1}, "run_id": {"type": "string", "minLength": 1},
    "attempts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/attempt"}},
    "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "validators": {"type": "array", "items": {"$ref": "#/$defs/validator"}}
  },
  "$defs": {
    "attempt": {"oneOf": [{"type": "object", "required": ["attempt", "status", "failure_class"], "properties": {"attempt": {"type": "integer", "minimum": 1}, "status": {"const": "passed"}, "failure_class": {"type": "null"}}, "additionalProperties": false}, {"type": "object", "required": ["attempt", "status", "failure_class", "reason"], "properties": {"attempt": {"type": "integer", "minimum": 1}, "status": {"const": "failed"}, "failure_class": {"enum": ["project", "environment", "safety", "protocol", "internal"]}, "reason": {"type": "string", "minLength": 1}}, "additionalProperties": false}]},
    "evidence": {"type": "object", "required": ["id", "claim_id", "status", "path", "sha256", "attempt"], "properties": {"id": {"type": "string", "minLength": 1}, "claim_id": {"type": ["string", "null"]}, "status": {"enum": ["passed", "failed", "blocked", "skipped", "missing"]}, "path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "attempt": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
    "validator": {"type": "object", "required": ["protocol_version", "validator_id", "claim_id", "input_digest", "evidence_digest", "status", "reason", "attempt"], "properties": {"protocol_version": {"const": "1"}, "validator_id": {"type": "string", "minLength": 1}, "claim_id": {"type": "string", "minLength": 1}, "input_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "evidence_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "status": {"enum": ["passed", "failed"]}, "reason": {"type": "string", "minLength": 1}, "attempt": {"type": "integer", "minimum": 1}}, "additionalProperties": false}
  }, "additionalProperties": false
}
