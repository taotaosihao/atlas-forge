{
  "schema_version": 2,
  "default_mode": "planning-review",
  "planning_review_model": "gpt-6-astra",
  "family": {
    "slug_pattern": "^gpt-(\\d+)\\.(\\d+)-",
    "selection": "latest"
  },
  "capabilities": {
    "frontier": { "description_pattern": "\\bfrontier\\b" },
    "balanced": { "description_pattern": "\\bbalanced\\b" },
    "fast": { "description_pattern": "\\bfast\\b" }
  },
  "roles": {
    "atlas-sdd-reviewer": { "capability": "balanced", "reasoning_effort": "max" },
    "atlas-sdd-phase-reviewer": { "capability": "frontier", "reasoning_effort": "medium" },
    "atlas-sdd-planner": { "capability": "frontier", "reasoning_effort": "high" },
    "atlas-sdd-implementer": { "capability": "fast", "reasoning_effort": "max" },
    "atlas-sdd-verifier": { "capability": "balanced", "reasoning_effort": "high" },
    "atlas-sdd-browser-verifier": { "capability": "fast", "reasoning_effort": "xhigh" },
    "atlas-sdd-explorer": { "capability": "fast", "reasoning_effort": "max" }
  },
  "planning_review_roles": {
    "atlas-sdd-reviewer": { "capability": "frontier", "reasoning_effort": "medium" },
    "atlas-sdd-phase-reviewer": { "capability": "frontier", "reasoning_effort": "medium" },
    "atlas-sdd-planner": { "capability": "frontier", "reasoning_effort": "high" }
  },
  "quality_roles": {
    "atlas-sdd-reviewer": { "capability": "frontier", "reasoning_effort": "xhigh" },
    "atlas-sdd-phase-reviewer": { "capability": "frontier", "reasoning_effort": "xhigh" },
    "atlas-sdd-planner": { "capability": "frontier", "reasoning_effort": "max" },
    "atlas-sdd-implementer": { "capability": "frontier", "reasoning_effort": "medium" },
    "atlas-sdd-verifier": { "capability": "frontier", "reasoning_effort": "medium" },
    "atlas-sdd-browser-verifier": { "capability": "frontier", "reasoning_effort": "medium" },
    "atlas-sdd-explorer": { "capability": "frontier", "reasoning_effort": "high" }
  },
  "equivalent_roles": {
    "atlas-sdd-implementer-deepseek": {
      "equivalent_to": "atlas-sdd-implementer",
      "model": "deepseek-v4-pro:deepseek",
      "reasoning_effort": "max",
      "model_provider": "zenmux"
    },
    "atlas-sdd-explorer-deepseek": {
      "equivalent_to": "atlas-sdd-explorer",
      "model": "deepseek-v4-pro:deepseek",
      "reasoning_effort": "max",
      "model_provider": "zenmux",
      "sandbox_mode": "read-only"
    },
    "atlas-sdd-planner-deepseek": {
      "equivalent_to": "atlas-sdd-planner",
      "model": "deepseek-v4-pro:deepseek",
      "reasoning_effort": "max",
      "model_provider": "zenmux",
      "sandbox_mode": "read-only"
    },
    "atlas-sdd-reviewer-deepseek": {
      "equivalent_to": "atlas-sdd-reviewer",
      "model": "deepseek-v4-pro:deepseek",
      "reasoning_effort": "max",
      "model_provider": "zenmux",
      "sandbox_mode": "read-only"
    }
  }
}
