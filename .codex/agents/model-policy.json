{
  "schema_version": 1,
  "family": {
    "slug_pattern": "^gpt-(\\d+)\\.(\\d+)-",
    "selection": "latest"
  },
  "capabilities": {
    "frontier": { "description_pattern": "\\bfrontier\\b" },
    "balanced": { "description_pattern": "\\bbalanced\\b" },
    "fast": { "description_pattern": "\\bfast\\b" }
  },
  "roles": {
    "atlas-sdd-reviewer": { "capability": "balanced", "reasoning_effort": "high" },
    "atlas-sdd-phase-reviewer": { "capability": "frontier", "reasoning_effort": "medium" },
    "atlas-sdd-planner": { "capability": "frontier", "reasoning_effort": "medium" },
    "atlas-sdd-implementer": { "capability": "fast", "reasoning_effort": "max" },
    "atlas-sdd-verifier": { "capability": "balanced", "reasoning_effort": "high" },
    "atlas-sdd-browser-verifier": { "capability": "fast", "reasoning_effort": "high" },
    "atlas-sdd-explorer": { "capability": "fast", "reasoning_effort": "medium" }
  },
  "equivalent_roles": {
    "atlas-sdd-implementer-deepseek": {
      "equivalent_to": "atlas-sdd-implementer",
      "model": "deepseek-v4-flash:deepseek",
      "reasoning_effort": "high",
      "model_provider": "zenmux"
    },
    "atlas-sdd-explorer-deepseek": {
      "equivalent_to": "atlas-sdd-explorer",
      "model": "deepseek-v4-flash:deepseek",
      "reasoning_effort": "medium",
      "model_provider": "zenmux",
      "sandbox_mode": "read-only"
    }
  }
}
