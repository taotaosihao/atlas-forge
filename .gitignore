# Runtime/editor noise
.DS_Store
*.swp
*.tmp

# Do not store live Codex state in this source repo.
workflow/artifacts/
workflow/state/
workflow/tasks/
workflow/hook-failures/
workflow/runtime/

# Plugin/runtime caches belong under ~/.codex/plugins/cache, not source.
plugins/cache/
cache/

# Local scratch
.tmp/
tmp/

# Daily agent benchmark local/private data
tools/daily-agent-benchmark/runs/*
!tools/daily-agent-benchmark/runs/.gitkeep
tools/daily-agent-benchmark/cases/private-*/
tools/daily-agent-benchmark/local-cases/

# Multica local runtime/secrets are copied into ~/.agents locally, not stored.
.agents/multica-sdlc/*-env.json
.agents/multica-sdlc/*-settings.json
.agents/multica-sdlc/agent-scorecards.jsonl
.agents/multica-sdlc/agent-scorecards.lock
.agents/multica-sdlc/tasks/
