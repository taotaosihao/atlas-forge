#!/usr/bin/env node
"use strict";

const fs = require("fs");
const os = require("os");
const path = require("path");
const { validateLedgerEvent } = require("../contracts/team-sdd/validators/ledger-event");
const { validateBrief } = require("../contracts/team-sdd/validators/brief");
const { validateReviewVerdict } = require("../contracts/team-sdd/validators/review-verdict");
const {
  computeGoalRef,
  digestFile,
  validateControllerResolutionAgainst,
} = require("../contracts/team-sdd/validators/controller-resolution");
const { validatePathLeaseDocument } = require("../contracts/team-sdd/validators/path-lease");
const { validateBusinessIntent } = require("../contracts/team-sdd/validators/business-intent");
const { validateBusinessScenarioCard } = require("../contracts/team-sdd/validators/business-scenario-card");
const { validateBusinessEvidenceMap } = require("../contracts/team-sdd/validators/business-evidence-map");
const { validateBusinessAcceptanceReport } = require("../contracts/team-sdd/validators/business-acceptance-report");
const { validateBusinessDeviationLog } = require("../contracts/team-sdd/validators/business-deviation-log");
const { validateBusinessVerdict } = require("../contracts/team-sdd/validators/business-verdict");

const ID_PATTERN = /^[A-Za-z0-9][A-Za-z0-9._-]*$/;

function usage() {
  console.log("usage: codex-team-artifact-lint --task <task-id> [--strict] [--business-acceptance]");
}

function parseArgs(argv) {
  const options = { task: null, strict: false, businessAcceptance: false, help: false };
  for (let i = 0; i < argv.length; i += 1) {
    const arg = argv[i];
    if (arg === "--help" || arg === "-h") {
      options.help = true;
    } else if (arg === "--task") {
      options.task = argv[++i];
    } else if (arg.startsWith("--task=")) {
      options.task = arg.slice("--task=".length);
    } else if (arg === "--strict") {
      options.strict = true;
    } else if (arg === "--business-acceptance") {
      options.businessAcceptance = true;
    } else {
      throw new Error(`unknown option: ${arg}`);
    }
  }
  return options;
}

function workflowRoot() {
  return path.resolve(process.env.CODEX_WORKFLOW_ROOT || process.env.ATLAS_WORKFLOW_ROOT || path.join(os.homedir(), ".codex", "workflow"));
}

function safeId(label, value) {
  if (typeof value !== "string" || !ID_PATTERN.test(value)) {
    throw new Error(`${label} must be a safe identifier`);
  }
}

function readJson(file, errors) {
  try {
    return JSON.parse(fs.readFileSync(file, "utf8"));
  } catch (error) {
    errors.push(`${file}: invalid JSON: ${error.message}`);
    return undefined;
  }
}

function canonicalRegularFile(file) {
  try {
    const stat = fs.lstatSync(file);
    return stat.isFile()
      && !stat.isSymbolicLink()
      && fs.realpathSync(file) === path.resolve(file);
  } catch (_error) {
    return false;
  }
}

function walkFiles(root) {
  if (!fs.existsSync(root)) {
    return [];
  }
  const results = [];
  const stack = [root];
  while (stack.length > 0) {
    const current = stack.pop();
    const stat = fs.statSync(current);
    if (stat.isDirectory()) {
      for (const entry of fs.readdirSync(current)) {
        stack.push(path.join(current, entry));
      }
    } else if (stat.isFile()) {
      results.push(current);
    }
  }
  return results.sort();
}

function substantiveMarkdown(text) {
  const lines = text.split(/\n/).map((line) => line.trim()).filter(Boolean);
  const substantive = lines.filter((line) => {
    if (line.startsWith("#")) return false;
    if (/^[-_*]{3,}$/.test(line)) return false;
    if (/^[A-Za-z0-9_-]+:\s*$/.test(line)) return false;
    if (/^(todo|tbd|placeholder|template|fill me|lorem ipsum)$/i.test(line)) return false;
    return true;
  });
  return substantive.join(" ").replace(/[`*_>-]/g, "").trim().length >= 12;
}

function lintLedger(sddDir, errors) {
  const ledger = path.join(sddDir, "progress.jsonl");
  if (!fs.existsSync(ledger)) {
    errors.push("missing SDD progress.jsonl");
    return [];
  }
  const lines = fs.readFileSync(ledger, "utf8").split(/\n/).filter(Boolean);
  const events = [];
  lines.forEach((line, index) => {
    let event;
    try {
      event = JSON.parse(line);
    } catch (error) {
      errors.push(`progress.jsonl:${index + 1}: invalid JSON: ${error.message}`);
      return;
    }
    const validation = validateLedgerEvent(event);
    if (validation.length > 0) {
      errors.push(`progress.jsonl:${index + 1}: ${validation.join("; ")}`);
      return;
    }
    events.push(event);
  });
  return events;
}

function lintBriefs(sliceDirs, errors) {
  for (const sliceDir of sliceDirs) {
    const file = path.join(sliceDir, "brief.json");
    if (!fs.existsSync(file)) {
      errors.push(`${sliceDir}: missing brief.json`);
      continue;
    }
    const brief = readJson(file, errors);
    if (brief) {
      const validation = validateBrief(brief);
      if (validation.length > 0) {
        errors.push(`${file}: ${validation.join("; ")}`);
      }
    }
  }
}

function legacyControllerResolutionExists(sliceDir) {
  const file = path.join(sliceDir, "controller-resolution.json");
  if (!fs.existsSync(file)) {
    return false;
  }
  try {
    const value = JSON.parse(fs.readFileSync(file, "utf8"));
    return value && value.status && value.reason;
  } catch (_error) {
    return false;
  }
}

function lintReviewVerdicts(sliceDirs, errors, strict, taskId) {
  for (const sliceDir of sliceDirs) {
    const file = path.join(sliceDir, "review-verdict.json");
    if (!fs.existsSync(file)) {
      continue;
    }
    const verdict = readJson(file, errors);
    if (!fs.existsSync(path.join(sliceDir, "review-package.diff"))) {
      errors.push(`${sliceDir}: review-verdict.json exists before review-package.diff`);
    }
    if (!verdict) {
      continue;
    }
    const validation = validateReviewVerdict(verdict);
    if (validation.length > 0) {
      errors.push(`${file}: ${validation.join("; ")}`);
      continue;
    }
    if (verdict.schema_version === 1) {
      const hasBlockingIssue = verdict.issues.some((issue) => ["Critical", "Important"].includes(issue.severity));
      const hasCannotVerify = verdict.cannot_verify_from_diff.length > 0;
      if (strict && (hasBlockingIssue || hasCannotVerify) && !legacyControllerResolutionExists(sliceDir)) {
        errors.push(`${sliceDir}: unresolved review verdict requires controller-resolution.json`);
      }
      continue;
    }
    if (!canonicalRegularFile(file)) {
      errors.push(`${file}: review verdict must be a canonical regular non-symlink file`);
      continue;
    }

    const expectedSliceId = path.basename(sliceDir);
    if (verdict.task_id !== taskId) {
      errors.push(`${file}: TASK_ID_MISMATCH expected ${taskId}, got ${verdict.task_id}`);
    }
    if (verdict.slice_id !== expectedSliceId) {
      errors.push(`${file}: SLICE_ID_MISMATCH expected ${expectedSliceId}, got ${verdict.slice_id}`);
    }
    const resolutionFile = path.join(sliceDir, "controller-resolution.json");
    const needsResolution = verdict.issues.length > 0 || verdict.cannot_verify_from_diff.length > 0;
    if (!fs.existsSync(resolutionFile)) {
      if (needsResolution) {
        errors.push(`${sliceDir}: v2 review verdict requires controller-resolution.json`);
      }
      continue;
    }
    if (!canonicalRegularFile(resolutionFile)) {
      errors.push(`${resolutionFile}: controller resolution must be a canonical regular non-symlink file`);
      continue;
    }
    const resolution = readJson(resolutionFile, errors);
    const briefFile = path.join(sliceDir, "brief.json");
    if (!canonicalRegularFile(briefFile)) {
      errors.push(`${briefFile}: brief must be a canonical regular non-symlink file`);
      continue;
    }
    const brief = readJson(briefFile, errors);
    if (!resolution || !brief) continue;
    let goalRef;
    try {
      goalRef = computeGoalRef(brief, sliceDir);
    } catch (error) {
      errors.push(`${briefFile}: cannot compute goal_ref: ${error.message}`);
      continue;
    }
    const resolutionErrors = validateControllerResolutionAgainst(resolution, {
      verdict,
      brief,
      verdictDigest: digestFile(file),
      goalRef,
      sliceDir,
    });
    if (resolutionErrors.length > 0) {
      errors.push(`${resolutionFile}: ${resolutionErrors.join("; ")}`);
      continue;
    }
    if (!strict) continue;
    for (const record of resolution.records) {
      if (record.disposition === "current-required" && record.repair_status === "open") {
        errors.push(`${sliceDir}: unresolved current-required finding: ${record.finding_id}`);
      }
    }
    for (const gap of resolution.evidence_gaps) {
      if (gap.status !== "resolved") {
        errors.push(`${sliceDir}: unresolved evidence gap: ${gap.gap_id} (${gap.status})`);
      }
    }
  }
}

function lintPathLeases(sddDir, errors) {
  const file = path.join(sddDir, "path-leases.json");
  if (!fs.existsSync(file)) {
    return;
  }
  const value = readJson(file, errors);
  if (value) {
    const validation = validatePathLeaseDocument(value);
    if (validation.length > 0) {
      errors.push(`${file}: ${validation.join("; ")}`);
    }
  }
}

function lintSliceReferences(events, slicesDir, errors) {
  for (const event of events) {
    if (event.slice_id && !fs.existsSync(path.join(slicesDir, event.slice_id))) {
      errors.push(`ledger references missing slice dir: ${event.slice_id}`);
    }
  }
}

function artifactRelativeRegularFile(artifactRoot, value) {
  if (typeof value !== "string" || value.length === 0 || path.isAbsolute(value)) {
    return null;
  }
  const normalized = path.posix.normalize(value.replaceAll("\\", "/"));
  if (normalized === ".." || normalized.startsWith("../") || normalized.includes("/../")) {
    return null;
  }
  const absolute = path.resolve(artifactRoot, normalized);
  const relative = path.relative(artifactRoot, absolute);
  if (relative === ".." || relative.startsWith(`..${path.sep}`) || path.isAbsolute(relative)) {
    return null;
  }
  if (!canonicalRegularFile(absolute)) {
    return null;
  }
  return absolute;
}

function markdownBackend(file, errors) {
  if (!canonicalRegularFile(file)) {
    errors.push(`${file}: team artifact must be a canonical regular non-symlink file`);
    return null;
  }
  const text = fs.readFileSync(file, "utf8");
  const matches = [...text.matchAll(/^\s*-?\s*backend:\s*(native|paseo|mixed|none)\s*$/gim)]
    .map((match) => match[1].toLowerCase());
  if (matches.length !== 1) {
    errors.push(`${file}: expected exactly one backend: native|paseo|mixed|none marker`);
    return null;
  }
  return matches[0];
}

function stableValue(value) {
  if (Array.isArray(value)) return value.map(stableValue);
  if (!value || typeof value !== "object") return value;
  return Object.fromEntries(Object.keys(value).sort().map((key) => [key, stableValue(value[key])]));
}

function deriveBackendV2(team) {
  const attempts = Array.isArray(team.attempts) ? team.attempts : [];
  const admissions = Array.isArray(team.admissions) ? team.admissions : [];
  const dispatches = Array.isArray(team.dispatches) ? team.dispatches : [];
  const attemptedBackends = [...new Set(attempts
    .filter((attempt) => attempt.launch_invoked || attempt.bound_at
      || attempt.running_at || attempt.runtime_agent_id)
    .map((attempt) => attempt.backend))].sort();
  const admittedIds = new Set(admissions
    .filter((admission) => admission.disposition === "admitted")
    .flatMap((admission) => admission.admitted_attempt_ids || []));
  const effectiveBackends = new Set(attempts
    .filter((attempt) => admittedIds.has(attempt.attempt_id))
    .map((attempt) => attempt.backend));
  const effectiveBackend = effectiveBackends.size === 0 ? "none"
    : effectiveBackends.size === 1 ? [...effectiveBackends][0] : "mixed";
  const requestedBackends = new Set(dispatches.map((dispatch) => dispatch.resolved_requested_backend));
  const resolvedRequestedBackend = requestedBackends.size === 0
    ? (team.configured_backend || team.default_backend || "native")
    : requestedBackends.size === 1 ? [...requestedBackends][0] : "mixed";
  const admissionByDispatch = new Map(admissions.map((admission) => [admission.dispatch_id, admission]));
  const lanes = (Array.isArray(team.lanes) ? team.lanes : []).map((lane) => {
    const laneDispatches = dispatches.filter((dispatch) => dispatch.lane_id === lane.lane_id);
    const laneAdmissions = laneDispatches.map((dispatch) => admissionByDispatch.get(dispatch.dispatch_id))
      .filter((admission) => admission && admission.disposition === "admitted");
    const admittedAttemptIds = [...new Set(laneAdmissions
      .flatMap((admission) => admission.admitted_attempt_ids || []))];
    const laneBackends = new Set(attempts
      .filter((attempt) => admittedAttemptIds.includes(attempt.attempt_id))
      .map((attempt) => attempt.backend));
    return {
      lane_id: lane.lane_id,
      effective_backend: laneBackends.size === 0 ? "none"
        : laneBackends.size === 1 ? [...laneBackends][0] : "mixed",
      admitted_attempt_ids: admittedAttemptIds,
      evidence_refs: [...new Set(laneAdmissions.flatMap((admission) => admission.evidence_refs || []))],
    };
  }).filter((lane) => lane.admitted_attempt_ids.length > 0);
  return {
    schema_version: 2,
    team_run_id: team.team_run_id,
    generation: team.generation,
    configured_backend: team.configured_backend ?? null,
    resolved_requested_backend: resolvedRequestedBackend,
    attempted_backends: attemptedBackends,
    effective_backend: effectiveBackend,
    legacy_projection: effectiveBackend === "mixed" || effectiveBackend === "none",
    lanes,
  };
}

function validateCurrentTeamArtifacts(artifactRoot, teamDir, team, effectiveBackend, errors) {
  const references = [
    ["decision", team.decision],
    ["round", team.round_file],
    ["staffing", team.staffing],
  ];
  for (const [label, reference] of references) {
    if (typeof reference !== "string" || !reference.trim()) {
      errors.push(`${teamDir}: v2 state is missing current ${label} artifact reference`);
      continue;
    }
    const normalized = path.posix.normalize(reference.replaceAll("\\", "/"));
    const expectedSuffix = `/artifacts/${path.basename(artifactRoot)}/team/${path.posix.basename(normalized)}`;
    if (path.isAbsolute(reference) || normalized.includes("../")
      || !`/${normalized}`.endsWith(expectedSuffix)) {
      errors.push(`${teamDir}: current ${label} artifact reference is outside this task team: ${reference}`);
      continue;
    }
    const file = path.join(teamDir, path.posix.basename(normalized));
    const marker = markdownBackend(file, errors);
    if (marker && marker !== effectiveBackend) {
      errors.push(`${file}: backend ${marker} does not match sidecar effective_backend ${effectiveBackend}`);
    }
  }
}

function validateBackendV2Sidecar(artifactRoot, teamDir, errors) {
  const file = path.join(teamDir, "backend-v2.json");
  if (!fs.existsSync(file)) {
    return null;
  }
  if (!canonicalRegularFile(file)) {
    errors.push(`${file}: backend v2 sidecar must be a canonical regular non-symlink file`);
    return null;
  }
  const sidecar = readJson(file, errors);
  if (!sidecar || typeof sidecar !== "object" || Array.isArray(sidecar)) {
    return null;
  }
  if (sidecar.schema_version !== 2) {
    errors.push(`${file}: schema_version must be 2`);
  }
  try {
    safeId("team_run_id", sidecar.team_run_id);
  } catch (error) {
    errors.push(`${file}: ${error.message}`);
  }
  if (!Number.isInteger(sidecar.generation) || sidecar.generation < 1) {
    errors.push(`${file}: generation must be a positive integer`);
  }
  const configured = new Set([null, "native", "paseo"]);
  if (!configured.has(sidecar.configured_backend)) {
    errors.push(`${file}: configured_backend must be null|native|paseo`);
  }
  if (!new Set(["native", "paseo", "mixed"]).has(sidecar.resolved_requested_backend)) {
    errors.push(`${file}: resolved_requested_backend must be native|paseo|mixed`);
  }
  if (!Array.isArray(sidecar.attempted_backends)
    || sidecar.attempted_backends.some((backend) => !new Set(["native", "paseo"]).has(backend))
    || new Set(sidecar.attempted_backends).size !== sidecar.attempted_backends.length) {
    errors.push(`${file}: attempted_backends must be a unique native|paseo array`);
  }
  if (!new Set(["native", "paseo", "mixed", "none"]).has(sidecar.effective_backend)) {
    errors.push(`${file}: effective_backend must be native|paseo|mixed|none`);
  }
  if (typeof sidecar.legacy_projection !== "boolean") {
    errors.push(`${file}: legacy_projection must be boolean`);
  }
  if (!Array.isArray(sidecar.lanes)) {
    errors.push(`${file}: lanes must be an array`);
    return sidecar;
  }

  const laneIds = new Set();
  const admittedLaneBackends = new Set();
  let mixedLaneProvenance = false;
  for (const [index, lane] of sidecar.lanes.entries()) {
    const label = `${file}: lanes[${index}]`;
    if (!lane || typeof lane !== "object" || Array.isArray(lane)) {
      errors.push(`${label} must be an object`);
      continue;
    }
    try {
      safeId("lane_id", lane.lane_id);
    } catch (error) {
      errors.push(`${label}: ${error.message}`);
      continue;
    }
    if (laneIds.has(lane.lane_id)) {
      errors.push(`${label}: duplicate lane_id ${lane.lane_id}`);
    }
    laneIds.add(lane.lane_id);
    if (!new Set(["native", "paseo", "mixed"]).has(lane.effective_backend)) {
      errors.push(`${label}: effective_backend must be native|paseo|mixed`);
    } else {
      admittedLaneBackends.add(lane.effective_backend);
    }
    if (!Array.isArray(lane.admitted_attempt_ids) || lane.admitted_attempt_ids.length === 0) {
      errors.push(`${label}: admitted_attempt_ids must be a non-empty array`);
    } else {
      const attemptIds = new Set();
      for (const attemptId of lane.admitted_attempt_ids) {
        try {
          safeId("admitted attempt id", attemptId);
        } catch (error) {
          errors.push(`${label}: ${error.message}`);
          continue;
        }
        if (attemptIds.has(attemptId)) {
          errors.push(`${label}: duplicate admitted attempt id ${attemptId}`);
        }
        attemptIds.add(attemptId);
      }
      if (lane.effective_backend === "mixed" && attemptIds.size >= 2) {
        mixedLaneProvenance = true;
      }
    }
    if (!Array.isArray(lane.evidence_refs)) {
      errors.push(`${label}: evidence_refs must be an array`);
    } else {
      for (const evidenceRef of lane.evidence_refs) {
        if (!artifactRelativeRegularFile(artifactRoot, evidenceRef)) {
          errors.push(`${label}: invalid or missing artifact-relative evidence_ref ${String(evidenceRef)}`);
        }
      }
    }
  }

  if (sidecar.effective_backend === "mixed"
    && !(admittedLaneBackends.has("native") && admittedLaneBackends.has("paseo"))
    && !mixedLaneProvenance) {
    errors.push(`${file}: mixed effective_backend requires admitted native+paseo lane provenance or a mixed lane with at least two admitted attempts`);
  }
  if (sidecar.effective_backend === "native"
    && [...admittedLaneBackends].some((backend) => backend !== "native")) {
    errors.push(`${file}: native effective_backend conflicts with admitted lane backend provenance`);
  }
  if (sidecar.effective_backend === "paseo"
    && [...admittedLaneBackends].some((backend) => backend !== "paseo")) {
    errors.push(`${file}: paseo effective_backend conflicts with admitted lane backend provenance`);
  }
  if (sidecar.effective_backend === "none" && sidecar.lanes.length > 0) {
    errors.push(`${file}: none effective_backend cannot contain admitted lanes`);
  }

  const stateFile = path.join(artifactRoot, "state.json");
  if (!canonicalRegularFile(stateFile)) {
    errors.push(`${file}: backend v2 sidecar requires canonical task state.json`);
    return sidecar;
  }
  const state = readJson(stateFile, errors);
  const team = state && state.active_team;
  if (!team || team.schema_version !== 2) {
    errors.push(`${stateFile}: active_team schema_version must be 2 for backend v2 sidecar`);
    return sidecar;
  }
  const derived = deriveBackendV2(team);
  if (JSON.stringify(stableValue(sidecar)) !== JSON.stringify(stableValue(derived))) {
    errors.push(`${file}: sidecar does not match backend provenance derived from state.json`);
  }
  validateCurrentTeamArtifacts(artifactRoot, teamDir, team, sidecar.effective_backend, errors);
  return sidecar;
}

function lintTeamMetadata(artifactRoot, teamDir, errors, strict) {
  if (!strict) {
    return;
  }
  const sidecar = validateBackendV2Sidecar(artifactRoot, teamDir, errors);
  for (const file of walkFiles(teamDir).filter((item) => /round-.*\.md$/.test(path.basename(item)))) {
    const text = fs.readFileSync(file, "utf8");
    if (!sidecar && !/(^|\n)-?\s*backend:\s*native(\n|$)/.test(text)) {
      errors.push(`${file}: missing backend: native metadata for legacy/native v1 artifact`);
    }
  }
}

function lintPlaceholderArtifacts(teamDir, errors, strict) {
  if (!strict) {
    return;
  }
  for (const file of walkFiles(teamDir).filter((item) => item.endsWith(".md"))) {
    const text = fs.readFileSync(file, "utf8");
    if (!substantiveMarkdown(text)) {
      errors.push(`${file}: placeholder-only artifact`);
    }
  }
}

function lintForbiddenTerms(sddDir, errors) {
  for (const file of walkFiles(sddDir)) {
    const text = fs.readFileSync(file, "utf8");
    if (/max_fix_iterations|exhausted-by-iteration/.test(text)) {
      errors.push(`${file}: contains bounded SDD fix-loop stop term`);
    }
  }
}

function validateJsonFile(file, validate, errors) {
  const value = readJson(file, errors);
  if (value === undefined) {
    return null;
  }
  const validation = validate(value);
  if (validation.length > 0) {
    errors.push(`${file}: ${validation.join("; ")}`);
    return null;
  }
  return value;
}

function ensureArtifactRelativePath(artifactRoot, rawPath, label, errors, v2) {
  if (typeof rawPath !== "string" || rawPath.length === 0) {
    errors.push(`${label}: EVIDENCE_PATH_INVALID path must be a non-empty string`);
    return null;
  }
  if (path.isAbsolute(rawPath)) {
    errors.push(`${label}: EVIDENCE_PATH_INVALID local evidence path must be artifact-root-relative`);
    return null;
  }
  const resolved = path.resolve(artifactRoot, rawPath);
  const relative = path.relative(artifactRoot, resolved);
  if (relative.startsWith("..") || path.isAbsolute(relative)) {
    errors.push(`${label}: EVIDENCE_PATH_INVALID local evidence path must not escape artifact root`);
    return null;
  }
  if (!fs.existsSync(resolved)) {
    errors.push(`${label}: EVIDENCE_PATH_INVALID local evidence path does not exist: ${rawPath}`);
    return null;
  }
  if (!v2) {
    return resolved;
  }
  const stat = fs.lstatSync(resolved);
  if (stat.isSymbolicLink() || !stat.isFile()) {
    errors.push(`${label}: EVIDENCE_PATH_INVALID local evidence path must be a regular non-symlink file: ${rawPath}`);
    return null;
  }
  const canonicalRoot = fs.realpathSync(artifactRoot);
  const canonical = fs.realpathSync(resolved);
  const canonicalRelative = path.relative(canonicalRoot, canonical);
  if (canonicalRelative.startsWith("..") || path.isAbsolute(canonicalRelative)) {
    errors.push(`${label}: EVIDENCE_PATH_INVALID local evidence path must not escape artifact root: ${rawPath}`);
    return null;
  }
  return canonical;
}

function lintEvidenceMap(artifactRoot, evidenceMap, errors, v2) {
  const evidenceIndex = new Map();
  if (!evidenceMap || !Array.isArray(evidenceMap.evidence_refs)) {
    return evidenceIndex;
  }
  evidenceMap.evidence_refs.forEach((ref, itemIndex) => {
    if (!ref || typeof ref !== "object") {
      return;
    }
    const label = `business-evidence-map.evidence_refs[${itemIndex}]`;
    let identity = null;
    if (ref.source_type === "local") {
      const canonical = ensureArtifactRelativePath(artifactRoot, ref.evidence_path, label, errors, v2);
      if (v2 && canonical) {
        const stat = fs.statSync(canonical);
        identity = `local:${stat.dev}:${stat.ino}`;
      }
    } else if (["external", "manual"].includes(ref.source_type)) {
      const description = typeof ref.description === "string" ? ref.description.trim() : "";
      const evidencePath = typeof ref.evidence_path === "string" ? ref.evidence_path.trim() : "";
      if ((!v2 && typeof ref.description === "string" && ref.description.length === 0)
        || (v2 && description.length === 0)) {
        errors.push(`${label}: external/manual evidence requires description`);
      }
      if (v2) {
        try {
          const canonical = new URL(evidencePath);
          const validExternal = ref.source_type === "external"
            && ["http:", "https:"].includes(canonical.protocol)
            && canonical.hostname.length > 0
            && !canonical.username
            && !canonical.password;
          const validManual = ref.source_type === "manual"
            && canonical.protocol === "manual:"
            && canonical.href.length > "manual:".length;
          if (!validExternal && !validManual) {
            errors.push(`${label}: EVIDENCE_PATH_INVALID external evidence requires credential-free HTTP(S), and manual evidence requires manual:`);
          } else {
            canonical.hash = "";
            identity = `nonlocal:${canonical.href}`;
          }
        } catch (_error) {
          errors.push(`${label}: EVIDENCE_PATH_INVALID external/manual evidence URI is invalid`);
        }
      }
    }
    if (v2 && evidenceIndex.has(ref.evidence_id)) {
      errors.push(`${label}: EVIDENCE_ID_DUPLICATE duplicate evidence_id: ${ref.evidence_id}`);
    } else {
      evidenceIndex.set(ref.evidence_id, { ref, identity });
    }
  });
  return evidenceIndex;
}

function lintDeviationLog(file, errors, taskId) {
  if (!fs.existsSync(file)) {
    return;
  }
  const lines = fs.readFileSync(file, "utf8").split(/\n/);
  lines.forEach((line, index) => {
    if (!line.trim()) {
      return;
    }
    let value;
    try {
      value = JSON.parse(line);
    } catch (error) {
      errors.push(`${file}:${index + 1}: invalid JSON: ${error.message}`);
      return;
    }
    const validation = validateBusinessDeviationLog(value);
    if (validation.length > 0) {
      errors.push(`${file}:${index + 1}: ${validation.join("; ")}`);
    } else if (taskId && value.task_id !== taskId) {
      errors.push(`${file}:${index + 1}: TASK_ID_MISMATCH expected ${taskId}, got ${value.task_id}`);
    }
  });
}

function lintBusinessTaskId(value, label, taskId, errors) {
  if (value && value.task_id !== taskId) {
    errors.push(`${label}: TASK_ID_MISMATCH expected ${taskId}, got ${value.task_id}`);
  }
}

function lintGoalEvidence(goalLabel, goal, evidenceIndex, scenarioIds, errors) {
  const identities = new Set();
  if (!goal || !Array.isArray(goal.evidence_refs)) {
    return identities;
  }
  for (const evidenceId of goal.evidence_refs) {
    const indexed = evidenceIndex.get(evidenceId);
    if (!indexed) {
      errors.push(`${goalLabel}: EVIDENCE_REF_NOT_FOUND ${evidenceId}`);
      continue;
    }
    if (goal.status === "passed" && indexed.ref.result !== "passed") {
      errors.push(`${goalLabel}: EVIDENCE_REF_NOT_PASSED ${evidenceId}`);
    }
    if (!scenarioIds.has(indexed.ref.scenario_id)) {
      errors.push(`${goalLabel}: EVIDENCE_SCENARIO_NOT_FOUND ${indexed.ref.scenario_id}`);
    }
    if (indexed.identity) {
      identities.add(indexed.identity);
    }
  }
  return identities;
}

function lintBusinessAcceptanceV2(context, errors) {
  const {
    intent,
    verdict,
    evidenceMap,
    evidenceIndex,
    acceptanceReport,
    scenarioIds,
  } = context;
  if (!verdict) {
    return;
  }

  const hasGoalA = Object.prototype.hasOwnProperty.call(verdict, "goal_a");
  const hasGoalB = Object.prototype.hasOwnProperty.call(verdict, "goal_b");
  if (intent.closure_mode === "standard") {
    if (hasGoalA || hasGoalB) {
      errors.push("DUAL_GOAL_FORBIDDEN standard closure_mode must not contain goal_a or goal_b");
    }
  } else if (!hasGoalA || !hasGoalB) {
    errors.push("DUAL_GOAL_REQUIRED dual_goal closure_mode requires goal_a and goal_b");
    return;
  }

  const accepted = ["accepted", "conditionally_accepted"].includes(verdict.verdict);
  if (accepted) {
    if (verdict.technical_gate_status !== "passed") {
      errors.push("TECHNICAL_GATE_NOT_PASSED accepted/conditionally_accepted requires technical_gate_status passed");
    }
    if (verdict.business_acceptance_status !== "passed") {
      errors.push("BUSINESS_ACCEPTANCE_NOT_PASSED accepted/conditionally_accepted requires business_acceptance_status passed");
    }
    if (!evidenceMap) {
      errors.push("accepted/conditionally_accepted requires a valid business-evidence-map.json");
    }
    if (!acceptanceReport) {
      errors.push("accepted/conditionally_accepted requires a valid business-acceptance-report.json");
    } else {
      if (acceptanceReport.rating.blocking_technical_gate_failed === true
        || acceptanceReport.technical_gate_summary.blocking_failure_count !== 0
        || acceptanceReport.technical_gate_summary.failed_gates.length !== 0) {
        errors.push("TECHNICAL_GATE_NOT_PASSED acceptance report contains a blocking technical gate failure");
      }
      if (acceptanceReport.technical_gate_summary.blocking_failure_count
        !== acceptanceReport.technical_gate_summary.failed_gates.length) {
        errors.push("TECHNICAL_GATE_SUMMARY_MISMATCH blocking_failure_count must match failed_gates length");
      }
      if (acceptanceReport.scenario_results.some((result) => result.technical_gate_result !== "passed")) {
        errors.push("TECHNICAL_GATE_NOT_PASSED accepted/conditionally_accepted requires every scenario technical gate passed");
      }
      if (acceptanceReport.scenario_results.some((result) => result.business_result !== "passed")) {
        errors.push("BUSINESS_ACCEPTANCE_NOT_PASSED accepted/conditionally_accepted requires every scenario business result passed");
      }
      if (acceptanceReport.scenario_results.length === 0) {
        errors.push("BUSINESS_ACCEPTANCE_NOT_PASSED accepted/conditionally_accepted requires at least one scenario result");
      }
      const reportScenarioIds = acceptanceReport.scenario_results.map((result) => result.scenario_id);
      const uniqueReportScenarioIds = new Set(reportScenarioIds);
      if (uniqueReportScenarioIds.size !== reportScenarioIds.length) {
        errors.push("BUSINESS_ACCEPTANCE_REPORT_INVALID scenario_results must not contain duplicate scenario_id values");
      }
      if (reportScenarioIds.some((scenarioId) => !scenarioIds.has(scenarioId))) {
        errors.push("BUSINESS_ACCEPTANCE_REPORT_INVALID scenario_results references a missing scenario card");
      }
      if (scenarioIds.size !== uniqueReportScenarioIds.size
        || [...scenarioIds].some((scenarioId) => !uniqueReportScenarioIds.has(scenarioId))) {
        errors.push("BUSINESS_ACCEPTANCE_REPORT_INVALID accepted/conditionally_accepted must cover every scenario card exactly once");
      }
      if (acceptanceReport.rating.level !== verdict.verdict) {
        errors.push("business-acceptance-report rating.level must match business-verdict.verdict");
      }
    }
  }

  if (intent.closure_mode !== "dual_goal" || !hasGoalA || !hasGoalB) {
    return;
  }
  const goalAIdentities = lintGoalEvidence("goal_a", verdict.goal_a, evidenceIndex, scenarioIds, errors);
  const goalBIdentities = lintGoalEvidence("goal_b", verdict.goal_b, evidenceIndex, scenarioIds, errors);
  if ([...goalAIdentities].some((identity) => goalBIdentities.has(identity))) {
    errors.push("EVIDENCE_SUBSTITUTION goal_a and goal_b must not use the same canonical evidence identity");
  }
}

function lintBusinessAcceptance(artifactRoot, taskId, errors, warnings, strict) {
  const acceptanceDir = path.join(artifactRoot, "team", "acceptance");
  const intentFile = path.join(acceptanceDir, "business-intent.json");
  const scenariosDir = path.join(acceptanceDir, "scenarios");
  const evidenceMapFile = path.join(acceptanceDir, "business-evidence-map.json");
  const acceptanceReportFile = path.join(acceptanceDir, "business-acceptance-report.json");
  const verdictFile = path.join(acceptanceDir, "business-verdict.json");
  const deviationLogFile = path.join(acceptanceDir, "business-deviation-log.jsonl");
  let intent = null;

  if (!fs.existsSync(intentFile)) {
    errors.push("missing team/acceptance/business-intent.json");
  } else {
    intent = validateJsonFile(intentFile, validateBusinessIntent, errors);
  }

  const scenarioFiles = fs.existsSync(scenariosDir)
    ? fs.readdirSync(scenariosDir)
      .filter((entry) => /^business-scenario-card\..*\.json$/.test(entry))
      .map((entry) => path.join(scenariosDir, entry))
      .sort()
    : [];
  if (scenarioFiles.length === 0) {
    errors.push("missing team/acceptance/scenarios/business-scenario-card.*.json");
  }
  const scenarios = scenarioFiles
    .map((file) => validateJsonFile(file, validateBusinessScenarioCard, errors))
    .filter(Boolean);

  const evidenceMap = fs.existsSync(evidenceMapFile)
    ? validateJsonFile(evidenceMapFile, validateBusinessEvidenceMap, errors)
    : null;
  const acceptanceReport = fs.existsSync(acceptanceReportFile)
    ? validateJsonFile(acceptanceReportFile, validateBusinessAcceptanceReport, errors)
    : null;
  const verdict = fs.existsSync(verdictFile)
    ? validateJsonFile(verdictFile, validateBusinessVerdict, errors)
    : null;

  const v2Intent = intent && intent.schema_version === 2;
  const scenarioIdValues = scenarios.map((scenario) => scenario.scenario_id);
  const scenarioIds = new Set(scenarioIdValues);
  if (v2Intent && scenarioIds.size !== scenarioIdValues.length) {
    errors.push("BUSINESS_SCENARIO_DUPLICATE scenario cards must not contain duplicate scenario_id values");
  }
  lintDeviationLog(deviationLogFile, errors, v2Intent ? taskId : null);
  const evidenceIndex = lintEvidenceMap(artifactRoot, evidenceMap, errors, v2Intent);

  if (v2Intent) {
    lintBusinessTaskId(intent, "business-intent", taskId, errors);
    scenarios.forEach((scenario) => lintBusinessTaskId(
      scenario,
      `business-scenario-card.${scenario.scenario_id}`,
      taskId,
      errors,
    ));
    lintBusinessTaskId(evidenceMap, "business-evidence-map", taskId, errors);
    lintBusinessTaskId(acceptanceReport, "business-acceptance-report", taskId, errors);
    lintBusinessTaskId(verdict, "business-verdict", taskId, errors);
  }

  if (intent && intent.schema_version === 1 && (!verdict || verdict.schema_version === 1)) {
    warnings.push("LEGACY_BAF_V1 historical business acceptance artifact; migrate intent and verdict to schema_version 2");
  }
  if (strict && intent && intent.schema_version !== 2) {
    errors.push("BAF_V2_REQUIRED strict business acceptance requires business-intent schema_version 2");
  }
  if (strict && verdict && verdict.schema_version !== 2) {
    errors.push("BAF_V2_REQUIRED strict business acceptance requires business-verdict schema_version 2");
  }
  if (intent && verdict && intent.schema_version !== verdict.schema_version) {
    errors.push(`BAF_VERSION_MISMATCH intent v${intent.schema_version} cannot be combined with verdict v${verdict.schema_version}`);
  }

  if (!verdict) {
    return;
  }
  const acceptedVerdicts = ["accepted", "conditionally_accepted"];
  if (acceptedVerdicts.includes(verdict.verdict) && !fs.existsSync(evidenceMapFile)) {
    errors.push("business-verdict accepted/conditionally_accepted requires business-evidence-map.json");
  }
  if (acceptedVerdicts.includes(verdict.verdict) && !fs.existsSync(acceptanceReportFile)) {
    errors.push("business-verdict accepted/conditionally_accepted requires business-acceptance-report.json");
  }
  const v2Bundle = intent
    && intent.schema_version === 2
    && verdict.schema_version === 2;
  if (!v2Bundle
    && acceptedVerdicts.includes(verdict.verdict)
    && ["failed", "blocked"].includes(verdict.technical_gate_status)) {
    errors.push("business-verdict accepted/conditionally_accepted is forbidden when technical_gate_status is failed or blocked");
  }
  if (!v2Bundle
    && acceptedVerdicts.includes(verdict.verdict)
    && acceptanceReport
    && acceptanceReport.rating
    && acceptanceReport.rating.blocking_technical_gate_failed === true) {
    errors.push("business-verdict accepted/conditionally_accepted is forbidden when blocking_technical_gate_failed is true");
  }
  if (v2Bundle) {
    lintBusinessAcceptanceV2({
      intent,
      verdict,
      evidenceMap,
      evidenceIndex,
      acceptanceReport,
      scenarioIds,
    }, errors);
  }
}

function lint(options) {
  safeId("task", options.task);
  const artifactRoot = path.join(workflowRoot(), "artifacts", options.task);
  const teamDir = path.join(artifactRoot, "team");
  const sddDir = path.join(teamDir, "sdd");
  const slicesDir = path.join(sddDir, "slices");
  const errors = [];
  const warnings = [];
  if (!fs.existsSync(sddDir)) {
    errors.push("missing team/sdd artifact directory");
  }
  if (!fs.existsSync(slicesDir)) {
    errors.push("missing team/sdd/slices directory");
  }
  if (errors.length > 0) {
    return { errors, warnings };
  }
  const events = lintLedger(sddDir, errors);
  const sliceDirs = fs.readdirSync(slicesDir)
    .map((entry) => path.join(slicesDir, entry))
    .filter((item) => fs.statSync(item).isDirectory());
  if (sliceDirs.length === 0) {
    errors.push("no slice directories found");
  }
  lintSliceReferences(events, slicesDir, errors);
  lintBriefs(sliceDirs, errors);
  lintReviewVerdicts(sliceDirs, errors, options.strict, options.task);
  lintPathLeases(sddDir, errors);
  lintTeamMetadata(artifactRoot, teamDir, errors, options.strict);
  lintPlaceholderArtifacts(teamDir, errors, options.strict);
  lintForbiddenTerms(sddDir, errors);
  if (options.businessAcceptance) {
    lintBusinessAcceptance(artifactRoot, options.task, errors, warnings, options.strict);
  }
  return { errors, warnings };
}

function main() {
  try {
    const options = parseArgs(process.argv.slice(2));
    if (options.help) {
      usage();
      return;
    }
    if (!options.task) {
      throw new Error("--task is required");
    }
    const { errors, warnings } = lint(options);
    for (const warning of warnings) {
      console.error(`lint warning: ${warning}`);
    }
    if (errors.length > 0) {
      for (const error of errors) {
        console.error(`lint: ${error}`);
      }
      throw new Error(`artifact lint failed with ${errors.length} issue(s)`);
    }
    console.log("artifact_lint: true");
  } catch (error) {
    console.error(`codex-team-artifact-lint: ${error.message}`);
    process.exitCode = 1;
  }
}

main();
