  ...OPTIONAL_PRODUCT_UI_FIELDS,
]);
const RECOGNIZED_FIELDS = new Set([...ENVELOPE_FIELDS, ...DETAIL_FIELDS]);
const WORK_TYPES = new Set(["implementation", "planning", "review", "audit", "docs-only"]);
const GATE_VALUES = new Set(["required", "not_applicable"]);
const FIRST_CODE_KINDS = new Set([
  "product",
