#!/usr/bin/env node
"use strict";

const fs = require("fs");
const path = require("path");

const FINAL_STATUSES = new Set([
  "final",
  "ready-for-implementation",
  "in-implementation",
  "implemented",
]);

const STALE_MARKERS = [
  { label: "TODO", pattern: /\bTODO\b/i },
  { label: "TBD", pattern: /\bTBD\b/i },
  { label: "placeholder", pattern: /\bplaceholder\b/i },
  { label: "待定", pattern: /待定/ },
  { label: "占位", pattern: /占位/ },
  { label: "待确认", pattern: /待确认/ },
  { label: "待补充", pattern: /待补充/ },
  { label: "修订意见如下", pattern: /修订意见如下/ },
  { label: "评审意见如下", pattern: /评审意见如下/ },
  { label: "review 修订意见", pattern: /review\s*修订意见/i },
  { label: "旧合同正文", pattern: /旧合同正文/ },
  { label: "原合同正文", pattern: /原合同正文/ },
  { label: "追加修订", pattern: /追加修订/ },
  { label: "追加说明", pattern: /追加说明/ },
  { label: "append-only", pattern: /append-only/i },
  { label: "unrevised previous contract", pattern: /unrevised\s+previous\s+contract/i },
  { label: "old contract body", pattern: /old\s+contract\s+body/i },
  { label: "review notes heading", pattern: /^#{1,6}\s*(review notes|修订意见|评审原文|旧合同|旧版方案)\s*$/im },
];

function usage() {
  console.log(`usage: codex-contract-index-lint --root <workflow-docs-bundle>

Checks contract-index.md and, when implementation is ready, verifies that the
authoritative final contract exists and does not contain obvious stale markers.

Options:
  --root <dir>   Workflow docs bundle directory.
  --help         Show this help.`);
}

function parseArgs(argv) {
  const options = { root: null, help: false };

  for (let index = 0; index < argv.length; index += 1) {
    const arg = argv[index];
    if (arg === "--help" || arg === "-h") {
      options.help = true;
    } else if (arg === "--root") {
      options.root = argv[++index];
    } else if (arg.startsWith("--root=")) {
      options.root = arg.slice("--root=".length);
    } else {
      throw new Error(`unknown option: ${arg}`);
    }
  }

  return options;
}

function readIndex(root) {
  const indexPath = path.join(root, "contract-index.md");
  if (!fs.existsSync(indexPath)) {
    throw new Error(`missing contract-index.md: ${indexPath}`);
  }

  const content = fs.readFileSync(indexPath, "utf8");
  const fields = {};
  for (const line of content.split(/\r?\n/)) {
    const match = /^([A-Za-z][A-Za-z0-9_]*):\s*(.*)$/.exec(line);
    if (match) {
      fields[match[1]] = match[2].trim();
    }
  }

  return { indexPath, content, fields };
}

function resolveBundlePath(root, value, fieldName) {
  if (!value) {
    throw new Error(`missing ${fieldName} in contract-index.md`);
  }
  if (path.isAbsolute(value)) {
    throw new Error(`${fieldName} must be relative to the workflow docs bundle: ${value}`);
  }

  const resolved = path.resolve(root, value);
  const relative = path.relative(root, resolved);
  if (relative === "" || relative.startsWith("..") || path.isAbsolute(relative)) {
    throw new Error(`${fieldName} must stay inside the workflow docs bundle: ${value}`);
  }

  return resolved;
}

function assertAuthoritativeTarget(root, fields) {
  const status = fields.contract_status || "";
  const target = resolveBundlePath(root, fields.current_authoritative_contract, "current_authoritative_contract");
  const relativeTarget = path.relative(root, target).split(path.sep).join("/");

  if (relativeTarget.startsWith("reviews/") || relativeTarget.startsWith("decisions/")) {
    throw new Error(`current_authoritative_contract must not point to review history: ${fields.current_authoritative_contract}`);
  }

  if (!fs.existsSync(target)) {
    throw new Error(`authoritative contract does not exist: ${fields.current_authoritative_contract}`);
  }
  if (!fs.statSync(target).isFile()) {
    throw new Error(`authoritative contract is not a file: ${fields.current_authoritative_contract}`);
  }

  const mustBeFinal = FINAL_STATUSES.has(status);
  const isFinal = path.basename(target) === "implementation-contract.final.md";
  if (mustBeFinal && !isFinal) {
    throw new Error(`contract_status ${status} must point to ./implementation-contract.final.md`);
  }

  return { status, target, relativeTarget, isFinal, mustBeFinal };
}

function assertCleanFinalContract(target) {
  const content = fs.readFileSync(target, "utf8");
  if (content.trim().length === 0) {
    throw new Error(`final contract is empty: ${target}`);
  }

  for (const marker of STALE_MARKERS) {
    if (marker.pattern.test(content)) {
      throw new Error(`stale final contract marker found (${marker.label}): ${target}`);
    }
  }
}

function main() {
  const options = parseArgs(process.argv.slice(2));
  if (options.help) {
    usage();
    return;
  }
  if (!options.root) {
    throw new Error("--root is required");
  }

  const root = path.resolve(options.root);
  if (!fs.existsSync(root) || !fs.statSync(root).isDirectory()) {
    throw new Error(`workflow docs bundle root does not exist: ${root}`);
  }

  const { fields } = readIndex(root);
  const target = assertAuthoritativeTarget(root, fields);
  if (target.mustBeFinal || target.isFinal) {
    assertCleanFinalContract(target.target);
  }

  console.log(`contract_index_lint: true`);
  console.log(`root: ${root}`);
  console.log(`current_authoritative_contract: ${target.relativeTarget}`);
}

try {
  main();
} catch (error) {
  console.error(`contract_index_lint: false`);
  console.error(error.message);
  process.exit(1);
}
