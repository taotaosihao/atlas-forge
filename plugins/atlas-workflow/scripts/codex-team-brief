#!/usr/bin/env node
"use strict";

const fs = require("fs");
const os = require("os");
const path = require("path");
const crypto = require("crypto");
const childProcess = require("child_process");
const { validateBrief } = require("../contracts/team-sdd/validators/brief");
const {
  POLICY_ID,
  estimateOverBudget,
  extractExecutionPlan,
  repositoryBroadPath,
  sha256Value,
} = require("../contracts/team-sdd/validators/execution-plan");
const {
  extractReleaseIntent,
} = require("../contracts/release-certification/validators/release-intent");

const ID_PATTERN = /^[A-Za-z0-9][A-Za-z0-9._-]*$/;

function usage() {
  console.log(`usage:
  codex-team-brief --task <task-id> --slice <slice-id> --repo <absolute-path> --base <rev> \\
    --objective <text> --acceptance <ref> --owned <path> --check <command> [options]
  codex-team-brief --task <task-id> --slice <slice-id> --repo <absolute-path> --base <rev> \\
    --contract <semantics-v3-or-v4-contract>
  codex-team-brief --task <task-id> --all-slices --repo <absolute-path> --base <rev> \\
    --contract <semantics-v3-or-v4-contract>

options:
  --contract <file>           Sprint Contract markdown to compile into evidence-manifest.json
  --all-slices                Compile every slice in a semantics-v3/v4 execution plan
  --forbidden <path>           repeatable, comma-separated allowed
  --commit-policy <policy>     logical_outcome|changes_allowed_no_commit|no_change_allowed`);
}

function parseArgs(argv) {
  const options = {
    task: null,
    slice: null,
    allSlices: false,
    repo: null,
    base: null,
    objective: null,
    acceptance: [],
    owned: [],
    forbidden: [],
    checks: [],
    contract: null,
    commitPolicy: "logical_outcome",
    help: false,
  };
  for (let i = 0; i < argv.length; i += 1) {
    const arg = argv[i];
    if (arg === "--help" || arg === "-h") {
      options.help = true;
    } else if (arg === "--task") {
      options.task = argv[++i];
    } else if (arg.startsWith("--task=")) {
      options.task = arg.slice("--task=".length);
    } else if (arg === "--slice") {
      options.slice = argv[++i];
    } else if (arg.startsWith("--slice=")) {
      options.slice = arg.slice("--slice=".length);
    } else if (arg === "--all-slices") {
      options.allSlices = true;
    } else if (arg === "--repo") {
      options.repo = argv[++i];
    } else if (arg.startsWith("--repo=")) {
      options.repo = arg.slice("--repo=".length);
    } else if (arg === "--base") {
      options.base = argv[++i];
    } else if (arg.startsWith("--base=")) {
      options.base = arg.slice("--base=".length);
    } else if (arg === "--objective") {
      options.objective = argv[++i];
    } else if (arg.startsWith("--objective=")) {
      options.objective = arg.slice("--objective=".length);
    } else if (arg === "--acceptance") {
      addList(options.acceptance, argv[++i]);
    } else if (arg.startsWith("--acceptance=")) {
      addList(options.acceptance, arg.slice("--acceptance=".length));
    } else if (arg === "--owned") {
      addList(options.owned, argv[++i]);
    } else if (arg.startsWith("--owned=")) {
      addList(options.owned, arg.slice("--owned=".length));
    } else if (arg === "--forbidden") {
      addList(options.forbidden, argv[++i]);
    } else if (arg.startsWith("--forbidden=")) {
      addList(options.forbidden, arg.slice("--forbidden=".length));
    } else if (arg === "--check") {
      addList(options.checks, argv[++i]);
    } else if (arg.startsWith("--check=")) {
      addList(options.checks, arg.slice("--check=".length));
    } else if (arg === "--contract") {
      options.contract = argv[++i];
    } else if (arg.startsWith("--contract=")) {
      options.contract = arg.slice("--contract=".length);
    } else if (arg === "--commit-policy") {
      options.commitPolicy = argv[++i];
    } else if (arg.startsWith("--commit-policy=")) {
      options.commitPolicy = arg.slice("--commit-policy=".length);
    } else {
      throw new Error(`unknown option: ${arg}`);
    }
  }
  return options;
}

function addList(target, raw) {
  if (typeof raw !== "string") {
    throw new Error("missing option value");
  }
  for (const item of raw.split(",")) {
    const trimmed = item.trim();
    if (trimmed) {
      target.push(trimmed);
    }
  }
}

function workflowRoot() {
  return path.resolve(process.env.CODEX_WORKFLOW_ROOT || process.env.ATLAS_WORKFLOW_ROOT || path.join(os.homedir(), ".codex", "workflow"));
}

function safeId(label, value) {
  if (typeof value !== "string" || !ID_PATTERN.test(value)) {
    throw new Error(`${label} must be a safe identifier`);
  }
}

function ensureWithin(parent, child) {
  const relative = path.relative(parent, child);
  if (relative === "" || (!relative.startsWith("..") && !path.isAbsolute(relative))) {
    return;
  }
  throw new Error(`resolved path escapes artifact root: ${child}`);
}

function sliceDir(taskId, sliceId) {
  safeId("task", taskId);
  safeId("slice", sliceId);
  const artifactRoot = path.join(workflowRoot(), "artifacts", taskId);
  const dir = path.join(artifactRoot, "team", "sdd", "slices", sliceId);
  ensureWithin(artifactRoot, dir);
  fs.mkdirSync(dir, { recursive: true });
  return dir;
}

function resolveCommit(repo, revision) {
  return childProcess.execFileSync("git", ["-C", repo, "rev-parse", "--verify", `${revision}^{commit}`], {
    encoding: "utf8",
  }).trim();
}

function sha256(file) {
  return crypto.createHash("sha256").update(fs.readFileSync(file)).digest("hex");
}

function contractSemanticsVersion(text) {
  const match = /^contract_semantics_version:\s*([^\s]+)\s*$/m.exec(text);
  if (!match) return 1;
  const version = Number(match[1]);
  if (![1, 2, 3, 4].includes(version)) {
    throw new Error(`unsupported contract_semantics_version: ${match[1]}`);
  }
  return version;
}

function readContract(options) {
  if (!options.contract) return null;
  const contractPath = path.resolve(options.contract);
  if (!fs.existsSync(contractPath) || !fs.statSync(contractPath).isFile()) {
    throw new Error("--contract must exist and be a file");
  }
  const text = fs.readFileSync(contractPath, "utf8");
  return {
    path: contractPath,
    sha256: sha256(contractPath),
    semanticsVersion: contractSemanticsVersion(text),
    text,
  };
}

function parseMarkdownTableRows(text) {
  const rows = [];
  const lines = text.split(/\n/);
  for (let i = 0; i < lines.length; i += 1) {
    const line = lines[i].trim();
    const next = (lines[i + 1] || "").trim();
    if (!line.startsWith("|") || !next.startsWith("|") || !/^\|?\s*:?-{3,}:?\s*(\|\s*:?-{3,}:?\s*)+\|?$/.test(next)) {
      continue;
    }
    const headers = splitTableRow(line).map((item) => item.toLowerCase());
    for (i += 2; i < lines.length; i += 1) {
      const rowLine = lines[i].trim();
      if (!rowLine.startsWith("|")) {
        break;
      }
      const cells = splitTableRow(rowLine);
      const row = {};
      headers.forEach((header, index) => {
        row[header] = cells[index] || "";
      });
      rows.push(row);
    }
  }
  return rows;
}

function splitTableRow(line) {
  return line.replace(/^\|/, "").replace(/\|$/, "").split("|").map((cell) => cell.trim());
}

function acceptanceId(row) {
  return row.id || row.acceptance || row["acceptance id"] || row.ref || row.reference || "";
}

function compileContract(options) {
  if (!options.contract) {
    return null;
  }
  if (!fs.existsSync(options.contract) || !fs.statSync(options.contract).isFile()) {
    throw new Error("--contract must exist and be a file");
  }
  const contractPath = path.resolve(options.contract);
  const text = fs.readFileSync(contractPath, "utf8");
  const rows = parseMarkdownTableRows(text);
  const selectedRows = [];
  for (const ref of options.acceptance) {
    const match = rows.find((row) => acceptanceId(row) === ref);
    if (!match) {
      throw new Error(`acceptance ref not found in contract: ${ref}`);
    }
    selectedRows.push(match);
  }
  return {
    schema_version: 1,
    contract_path: contractPath,
    contract_sha256: sha256(contractPath),
    selected_acceptance_refs: [...options.acceptance],
    selected_acceptance_rows: selectedRows,
    owned_paths: [...options.owned],
    forbidden_paths: [...options.forbidden],
    required_checks: [...options.checks],
  };
}

function requireRepositoryOptions(options) {
  for (const key of ["task", "repo", "base"]) {
    if (!options[key]) throw new Error(`--${key} is required`);
  }
  if (!path.isAbsolute(options.repo)) {
    throw new Error("--repo must be an absolute path");
  }
  if (!fs.existsSync(options.repo) || !fs.statSync(options.repo).isDirectory()) {
    throw new Error("--repo must exist and be a directory");
  }
}

function requireLegacyOptions(options) {
  requireRepositoryOptions(options);
  for (const key of ["slice", "objective"]) {
    if (!options[key]) throw new Error(`--${key} is required`);
  }
  if (options.allSlices) throw new Error("--all-slices requires a semantics-v3 contract");
  if (options.acceptance.length === 0) {
    throw new Error("--acceptance is required");
  }
  if (options.owned.length === 0) {
    throw new Error("--owned is required");
  }
  if (options.checks.length === 0) {
    throw new Error("--check is required");
  }
}

function writeBriefFiles(brief, evidenceManifest = null) {
  const dir = sliceDir(brief.task_id, brief.slice_id);
  const sddDir = path.resolve(dir, "..", "..");
  const globalConstraints = path.join(sddDir, "global-constraints.md");
  if (!fs.existsSync(globalConstraints)) {
    fs.writeFileSync(globalConstraints, "# Global Constraints\n\n- Follow the task brief and repository instructions.\n", "utf8");
  }

  const briefMarkdown = [
    "# Brief",
    "",
    `task_id: ${brief.task_id}`,
    `slice_id: ${brief.slice_id}`,
    `repo: ${brief.repo}`,
    `base_sha: ${brief.base_sha}`,
    "",
    "## Objective",
    "",
    brief.objective,
    "",
    "## Acceptance",
    "",
    ...brief.acceptance_refs.map((item) => `- ${item}`),
    "",
    "## Owned Paths",
    "",
    ...brief.owned_paths.map((item) => `- ${item}`),
    "",
    "## Required Checks",
    "",
    ...(brief.schema_version === 3
      ? brief.checks.map((item) => `- ${item.check_id}: ${item.command}`)
      : brief.required_checks.map((item) => `- ${item}`)),
    "",
  ].join("\n");
  fs.writeFileSync(path.join(dir, "brief.md"), briefMarkdown, "utf8");

  const errors = validateBrief(brief);
  if (errors.length > 0) throw new Error(errors.join("; "));
  fs.writeFileSync(path.join(dir, "brief.json"), `${JSON.stringify(brief, null, 2)}\n`, "utf8");
  if (evidenceManifest) {
    fs.writeFileSync(path.join(dir, "evidence-manifest.json"), `${JSON.stringify(evidenceManifest, null, 2)}\n`, "utf8");
    console.log(`evidence_manifest: ${path.join(dir, "evidence-manifest.json")}`);
  }
  console.log(`brief_json: ${path.join(dir, "brief.json")}`);
  console.log(`brief_md: ${path.join(dir, "brief.md")}`);
}

function legacyBrief(options, baseSha) {
  return {
    schema_version: 2,
    task_id: options.task,
    slice_id: options.slice,
    repo: options.repo,
    base_sha: baseSha,
    objective: options.objective,
    requirements_path: "brief.md",
    global_constraints_path: "../../global-constraints.md",
    owned_paths: options.owned,
    forbidden_paths: options.forbidden,
    acceptance_refs: options.acceptance,
    required_checks: options.checks,
    commit_policy: options.commitPolicy,
    output_contract: "final_message_json_only",
  };
}

function sizeGate(slice) {
  const overBudget = estimateOverBudget(slice.estimate, slice.budget, slice.checks)
    || slice.owned_paths.some(repositoryBroadPath);
  if (!overBudget) {
    return { decision: "pass", policy_id: POLICY_ID, estimate: slice.estimate, exception: null };
  }
  if (!slice.size_exception) {
    throw new Error(`slice ${slice.slice_id} exceeds ${POLICY_ID} and requires a complete size_exception`);
  }
  return {
    decision: "exception",
    policy_id: POLICY_ID,
    estimate: slice.estimate,
    exception: slice.size_exception,
  };
}

function v3Brief(options, baseSha, contract, plan, slice) {
  const slices = new Map(plan.slices.map((item) => [item.slice_id, item]));
  return {
    schema_version: 3,
    task_id: options.task,
    slice_id: slice.slice_id,
    repo: fs.realpathSync(options.repo),
    base_sha: baseSha,
    objective: slice.objective,
    requirements_path: "brief.md",
    global_constraints_path: "../../global-constraints.md",
    contract: {
      path: contract.path,
      sha256: `sha256:${contract.sha256}`,
      semantics_version: contract.semanticsVersion,
      execution_plan_sha256: `sha256:${sha256Value(plan)}`,
      ...(plan.release ? { release: plan.release } : {}),
    },
    dependencies: slice.depends_on.map((sliceId) => ({
      slice_id: sliceId,
      required_outcome: "succeeded",
      keeper_outputs: slices.get(sliceId).keeper_outputs,
    })),
    keeper_outputs: slice.keeper_outputs,
    owned_paths: slice.owned_paths,
    forbidden_paths: slice.forbidden_paths || [],
    acceptance_refs: slice.acceptance_refs,
    risk_class: slice.risk_class,
    failure_domain: slice.failure_domain,
    rollback_boundary: slice.rollback_boundary,
    budget: slice.budget,
    checks: slice.checks,
    size_gate: sizeGate(slice),
    commit_policy: options.commitPolicy,
    output_contract: "final_message_json_only",
  };
}

function compatibilityPlan(options) {
  return {
    schema_version: 1,
    size_policy: { policy_id: POLICY_ID },
    slices: [{
      slice_id: options.slice,
      objective: options.objective,
      depends_on: [],
      keeper_outputs: [`event:${options.slice}:complete`],
      owned_paths: options.owned,
      forbidden_paths: options.forbidden,
      acceptance_refs: options.acceptance,
      risk_class: "medium",
      failure_domain: "legacy-single-slice",
      rollback_boundary: "one logical commit",
      estimate: {
        estimated_changed_files: Math.max(1, options.owned.length),
        estimated_net_loc: 1200,
        target_p90_minutes: 120,
        serial_dependency_depth: 0,
        independent_vertical_count: 1,
      },
      budget: {
        max_changed_files: Math.max(1, options.owned.length),
        max_loc: 1200,
        max_wall_clock_minutes: 120,
        max_required_checks: Math.max(1, options.checks.length),
      },
      checks: options.checks.map((command, index) => ({
        check_id: `legacy-check-${String(index + 1).padStart(3, "0")}`,
        gate_class: "contract",
        command,
        final_only: false,
        cache_policy: "identity-bound",
      })),
    }],
  };
}

function writeBrief(options) {
  const contract = readContract(options);
  if (!contract) {
    requireLegacyOptions(options);
    writeBriefFiles(
      legacyBrief(options, resolveCommit(options.repo, options.base)),
      null,
    );
    return;
  }
  if (![3, 4].includes(contract.semanticsVersion)) {
    requireLegacyOptions(options);
    const plan = compatibilityPlan(options);
    writeBriefFiles(
      v3Brief(options, resolveCommit(options.repo, options.base), contract, plan, plan.slices[0]),
      compileContract(options),
    );
    return;
  }
  requireRepositoryOptions(options);
  if (options.allSlices && options.slice) throw new Error("--all-slices and --slice are mutually exclusive");
  if (!options.allSlices && !options.slice) throw new Error("--slice or --all-slices is required");
  if (options.objective || options.acceptance.length || options.owned.length
    || options.forbidden.length || options.checks.length) {
    throw new Error("semantics-v3/v4 contracts derive objective, acceptance, owned paths, and checks from the execution plan");
  }
  if (contract.semanticsVersion === 4) extractReleaseIntent(contract.text);
  const plan = extractExecutionPlan(contract.text);
  const selected = options.allSlices
    ? plan.slices
    : plan.slices.filter((slice) => slice.slice_id === options.slice);
  if (selected.length !== (options.allSlices ? plan.slices.length : 1)) {
    throw new Error(`slice not found in execution plan: ${options.slice}`);
  }
  const baseSha = resolveCommit(options.repo, options.base);
  const briefs = selected.map((slice) => v3Brief(options, baseSha, contract, plan, slice));
  for (const brief of briefs) writeBriefFiles(brief);
}

function main() {
  try {
    const options = parseArgs(process.argv.slice(2));
    if (options.help) {
      usage();
      return;
    }
    writeBrief(options);
  } catch (error) {
    console.error(`codex-team-brief: ${error.message}`);
    process.exitCode = 1;
  }
}

main();
