{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.local/contracts/team-sdd/scope-vnext.schema.json",
  "title": "Atlas immutable canonical execution scope vNext",
  "type": "object",
  "required": [
    "schema_version", "grant_id", "task_id", "repo", "objective", "contract",
    "execution_plan", "owned_paths", "forbidden_paths", "required_slices",
    "size_exceptions", "scope_core_digest", "authorization_provenance", "release_binding",
    "parent", "supersedes_grant_id", "evidence_policy", "design_handoff", "first_code"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "grant_id": { "$ref": "#/$defs/safe_id" },
    "task_id": { "$ref": "#/$defs/safe_id" },
    "repo": {
      "type": "object",
      "required": ["realpath", "base_sha"],
      "properties": {
        "realpath": { "type": "string", "pattern": "^/[\\x20-\\x7e]+$" },
        "base_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      },
      "additionalProperties": false
    },
    "objective": { "$ref": "#/$defs/non_empty" },
    "contract": {
      "type": "object",
      "required": ["path", "sha256", "semantics_version", "authority_slices"],
      "properties": {
        "path": { "$ref": "#/$defs/relative_path" },
        "sha256": { "$ref": "#/$defs/digest" },
        "semantics_version": { "type": "integer", "enum": [5, 6] },
        "authority_slices": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/authority_slice_identity" }
        }
      },
      "additionalProperties": false
    },
    "execution_plan": {
      "type": "object",
      "required": ["schema_version", "sha256"],
      "properties": {
        "schema_version": { "type": "integer", "enum": [3, 4] },
        "sha256": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "owned_paths": { "$ref": "#/$defs/paths" },
    "forbidden_paths": { "$ref": "#/$defs/paths" },
    "required_slices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "slice_id", "objective", "brief_path", "brief_sha256", "depends_on",
          "keeper_outputs", "owned_paths", "forbidden_paths", "acceptance_refs",
          "estimate", "budget", "checks"
        ],
        "properties": {
          "slice_id": { "$ref": "#/$defs/safe_id" },
          "objective": { "$ref": "#/$defs/non_empty" },
          "brief_path": { "$ref": "#/$defs/relative_path" },
          "brief_sha256": { "$ref": "#/$defs/digest" },
          "depends_on": { "$ref": "#/$defs/strings" },
          "keeper_outputs": { "$ref": "#/$defs/strings" },
          "owned_paths": { "$ref": "#/$defs/paths" },
          "forbidden_paths": { "$ref": "#/$defs/paths" },
          "acceptance_refs": { "$ref": "#/$defs/strings" },
          "estimate": { "$ref": "#/$defs/estimate" },
          "budget": { "$ref": "#/$defs/budget" },
          "checks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/check" } }
        },
        "additionalProperties": false
      }
    },
    "size_exceptions": { "type": "array", "items": { "$ref": "#/$defs/size_exception" } },
    "scope_core_digest": { "$ref": "#/$defs/digest" },
    "authorization_provenance": { "$ref": "#/$defs/authority" },
    "release_binding": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/release_binding" }]
    },
    "parent": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["grant_id", "scope_digest"],
          "properties": {
            "grant_id": { "$ref": "#/$defs/safe_id" },
            "scope_digest": { "$ref": "#/$defs/digest" }
          },
          "additionalProperties": false
        }
      ]
    },
    "supersedes_grant_id": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "evidence_policy": {
      "type": "object",
      "required": ["mode", "retained_receipt_ids"],
      "properties": {
        "mode": { "type": "string", "enum": ["invalidate-incompatible", "retain-compatible"] },
        "retained_receipt_ids": { "$ref": "#/$defs/strings" }
      },
      "additionalProperties": false
    },
    "design_handoff": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/design_handoff_approved" },
        { "$ref": "#/$defs/not_applicable_binding" }
      ]
    },
    "first_code": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/first_code_required" },
        { "$ref": "#/$defs/not_applicable_binding" }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "contract": {
            "properties": { "semantics_version": { "const": 5 } },
            "required": ["semantics_version"]
          }
        },
        "required": ["contract"]
      },
      "then": {
        "properties": {
          "execution_plan": {
            "properties": { "schema_version": { "const": 3 } },
            "required": ["schema_version"]
          },
          "release_binding": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "contract": {
            "properties": { "semantics_version": { "const": 6 } },
            "required": ["semantics_version"]
          }
        },
        "required": ["contract"]
      },
      "then": {
        "properties": {
          "execution_plan": {
            "properties": { "schema_version": { "const": 4 } },
            "required": ["schema_version"]
          },
          "release_binding": { "$ref": "#/$defs/release_binding" }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "safe_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "non_empty": { "type": "string", "pattern": "^(?=.*\\S)[^\\r\\n\\t]+$" },
    "relative_path": {
      "type": "string",
      "pattern": "^(?!/)(?!\\./)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\/$)[\\x20-\\x7e]+$"
    },
    "strings": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/non_empty" } },
    "paths": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/relative_path" } },
    "estimate": {
      "type": "object",
      "required": [
        "estimated_changed_files", "estimated_net_loc", "target_p90_minutes",
        "serial_dependency_depth", "independent_vertical_count"
      ],
      "properties": {
        "estimated_changed_files": { "type": "integer", "minimum": 1 },
        "estimated_net_loc": { "type": "integer", "minimum": 1 },
        "target_p90_minutes": { "type": "integer", "minimum": 1 },
        "serial_dependency_depth": { "type": "integer", "minimum": 0 },
        "independent_vertical_count": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "required": ["max_changed_files", "max_loc", "max_wall_clock_minutes", "max_required_checks"],
      "properties": {
        "max_changed_files": { "type": "integer", "minimum": 1 },
        "max_loc": { "type": "integer", "minimum": 1 },
        "max_wall_clock_minutes": { "type": "integer", "minimum": 1 },
        "max_required_checks": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "authority_slice_identity": {
      "type": "object",
      "required": [
        "path", "task_id", "slice_id", "brief_json_sha256", "brief_md_sha256",
        "evidence_manifest_sha256", "review_verdict_sha256",
        "controller_resolution_sha256", "global_constraints_sha256"
      ],
      "properties": {
        "path": { "type": "string", "pattern": "^/[\\x20-\\x7e]+$" },
        "task_id": { "$ref": "#/$defs/safe_id" },
        "slice_id": { "$ref": "#/$defs/safe_id" },
        "brief_json_sha256": { "$ref": "#/$defs/digest" },
        "brief_md_sha256": { "$ref": "#/$defs/digest" },
        "evidence_manifest_sha256": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }] },
        "review_verdict_sha256": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }] },
        "controller_resolution_sha256": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }] },
        "global_constraints_sha256": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }] }
      },
      "additionalProperties": false
    },
    "authority": {
      "type": "object",
      "required": ["kind", "ref"],
      "properties": {
        "kind": { "type": "string", "enum": ["user-message", "operator-input"] },
        "ref": { "type": "string", "pattern": "^(user-message|operator-input):[A-Za-z0-9][A-Za-z0-9._:-]*$" }
      },
      "additionalProperties": false
    },
    "not_applicable_binding": {
      "type": "object",
      "required": ["status", "reason", "contract_sha256"],
      "properties": {
        "status": { "const": "not_applicable" },
        "reason": { "$ref": "#/$defs/non_empty" },
        "contract_sha256": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "design_handoff_approved": {
      "type": "object",
      "required": [
        "status", "task_id", "designed_feature_target", "context_path", "context_sha256",
        "context_identity", "scenario_path", "scenario_sha256", "scenario_identity",
        "scenario_approval_ref", "flow_path", "flow_sha256", "flow_identity",
        "flow_approval_ref", "handoff_path", "handoff_sha256"
      ],
      "properties": {
        "status": { "const": "approved" },
        "task_id": { "$ref": "#/$defs/safe_id" },
        "designed_feature_target": { "type": "string", "enum": ["product_increment", "product_release"] },
        "context_path": { "$ref": "#/$defs/relative_path" },
        "context_sha256": { "$ref": "#/$defs/digest" },
        "context_identity": { "$ref": "#/$defs/digest" },
        "scenario_path": { "$ref": "#/$defs/relative_path" },
        "scenario_sha256": { "$ref": "#/$defs/digest" },
        "scenario_identity": { "$ref": "#/$defs/digest" },
        "scenario_approval_ref": { "$ref": "#/$defs/authority_ref" },
        "flow_path": { "$ref": "#/$defs/relative_path" },
        "flow_sha256": { "$ref": "#/$defs/digest" },
        "flow_identity": { "$ref": "#/$defs/digest" },
        "flow_approval_ref": { "$ref": "#/$defs/authority_ref" },
        "handoff_path": { "$ref": "#/$defs/relative_path" },
        "handoff_sha256": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "first_code_required": {
      "type": "object",
      "required": [
        "status", "contract_sha256", "first_code_slice_id", "verification_check_id",
        "stop_before_slice_id"
      ],
      "properties": {
        "status": { "const": "required" },
        "contract_sha256": { "$ref": "#/$defs/digest" },
        "first_code_slice_id": { "$ref": "#/$defs/safe_id" },
        "verification_check_id": { "$ref": "#/$defs/safe_id" },
        "stop_before_slice_id": { "$ref": "#/$defs/safe_id" }
      },
      "additionalProperties": false
    },
    "authority_ref": {
      "type": "string",
      "pattern": "^(user-message|operator-input):[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "check": {
      "type": "object",
      "required": ["check_id", "gate_class", "command", "final_only", "cache_policy", "release_requirement"],
      "properties": {
        "check_id": { "$ref": "#/$defs/safe_id" },
        "gate_class": { "$ref": "#/$defs/non_empty" },
        "command": { "$ref": "#/$defs/non_empty" },
        "final_only": { "type": "boolean" },
        "cache_policy": { "$ref": "#/$defs/non_empty" },
        "release_requirement": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "execution-plan.schema.json#/definitions/release_requirement" }
          ]
        }
      },
      "additionalProperties": false
    },
    "size_exception": {
      "type": "object",
      "required": [
        "task_id", "slice_id", "grant_id", "scope_core_digest", "authority",
        "expires_at", "reason", "compensating_controls"
      ],
      "properties": {
        "task_id": { "$ref": "#/$defs/safe_id" },
        "slice_id": { "$ref": "#/$defs/safe_id" },
        "grant_id": { "$ref": "#/$defs/safe_id" },
        "scope_core_digest": { "$ref": "#/$defs/digest" },
        "authority": { "$ref": "#/$defs/authority" },
        "expires_at": {
          "type": "string",
          "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\dZ$"
        },
        "reason": { "$ref": "#/$defs/non_empty" },
        "compensating_controls": { "$ref": "#/$defs/strings" }
      },
      "additionalProperties": false
    },
    "release_binding": {
      "type": "object",
      "required": [
        "target_delivery_class", "intent_sha256", "profile_ref", "profile_sha256",
        "check_definition_set_sha256", "requirement_refs"
      ],
      "properties": {
        "target_delivery_class": { "const": "product_release" },
        "intent_sha256": { "$ref": "#/$defs/digest" },
        "profile_ref": { "$ref": "#/$defs/safe_id" },
        "profile_sha256": { "$ref": "#/$defs/digest" },
        "check_definition_set_sha256": { "$ref": "#/$defs/digest" },
        "requirement_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/non_empty" } }
      },
      "additionalProperties": false
    }
  }
}
