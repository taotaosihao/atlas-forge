{
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "slice_id",
    "base_sha",
    "head_sha",
    "spec_compliance",
    "task_quality",
    "issues",
    "cannot_verify_from_diff",
    "strengths",
    "reviewed_inputs"
  ],
  "properties": {
    "schema_version": { "type": "integer", "enum": [2] },
    "task_id": { "type": "string" },
    "slice_id": { "type": "string" },
    "base_sha": { "type": "string" },
    "head_sha": { "type": "string" },
    "spec_compliance": { "type": "string", "enum": ["pass", "fail", "cannot_verify"] },
    "task_quality": { "type": "string", "enum": ["pass", "fail"] },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_id", "severity", "category", "path", "evidence", "required_fix"],
        "properties": {
          "finding_id": { "type": "string" },
          "severity": { "type": "string", "enum": ["Critical", "Important", "Minor"] },
          "category": { "type": "string" },
          "path": { "type": "string" },
          "line": { "type": ["integer", "null"] },
          "evidence": { "type": "string" },
          "required_fix": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "cannot_verify_from_diff": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["gap_id", "description"],
        "properties": {
          "gap_id": { "type": "string" },
          "description": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "strengths": { "type": "array" },
    "reviewed_inputs": { "type": "object" }
  },
  "additionalProperties": false
}
