{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.local/contracts/team-sdd/grant-vnext.schema.json",
  "title": "Atlas execution grant vNext",
  "type": "object",
  "required": [
    "schema_version", "grant_id", "status", "scope_digest", "scope", "evidence_epoch",
    "authorization_provenance", "issued_at", "issued_revision", "terminal"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "grant_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "status": { "type": "string", "enum": ["issued", "active", "completed", "revoked", "superseded"] },
    "scope_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "scope": { "$ref": "scope-vnext.schema.json" },
    "evidence_epoch": { "type": "integer", "minimum": 1 },
    "authorization_provenance": {
      "type": "object",
      "required": ["kind", "ref"],
      "properties": {
        "kind": { "type": "string", "enum": ["user-message", "operator-input"] },
        "ref": { "type": "string", "pattern": "^(user-message|operator-input):[A-Za-z0-9][A-Za-z0-9._:-]*$" }
      },
      "additionalProperties": false
    },
    "issued_at": { "$ref": "#/$defs/canonical_utc" },
    "issued_revision": { "type": "integer", "minimum": 1 },
    "terminal": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["status", "occurred_at", "revision", "reason", "outcome", "superseded_by"],
          "properties": {
            "status": { "type": "string", "enum": ["completed", "revoked", "superseded"] },
            "occurred_at": { "$ref": "#/$defs/canonical_utc" },
            "revision": { "type": "integer", "minimum": 1 },
            "reason": { "type": "string" },
            "outcome": { "type": "string" },
            "superseded_by": { "type": "string" }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "enum": ["issued", "active"] } }, "required": ["status"] },
      "then": { "properties": { "terminal": { "type": "null" } } }
    },
    {
      "if": { "properties": { "status": { "enum": ["completed", "revoked", "superseded"] } }, "required": ["status"] },
      "then": { "properties": { "terminal": { "type": "object" } } }
    },
    {
      "if": { "properties": { "status": { "const": "completed" } }, "required": ["status"] },
      "then": {
        "properties": {
          "terminal": {
            "properties": {
              "status": { "const": "completed" },
              "superseded_by": { "const": "" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "revoked" } }, "required": ["status"] },
      "then": {
        "properties": {
          "terminal": {
            "properties": {
              "status": { "const": "revoked" },
              "superseded_by": { "const": "" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "superseded" } }, "required": ["status"] },
      "then": {
        "properties": {
          "terminal": {
            "properties": {
              "status": { "const": "superseded" },
              "superseded_by": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "canonical_utc": {
      "type": "string",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\dZ$"
    }
  }
}
