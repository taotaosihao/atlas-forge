{
  "type": "object",
  "required": ["schema_version", "task_id", "slice_id", "repo", "base_sha", "objective", "requirements_path", "global_constraints_path", "contract", "dependencies", "keeper_outputs", "owned_paths", "forbidden_paths", "acceptance_refs", "risk_class", "failure_domain", "rollback_boundary", "budget", "checks", "size_gate", "commit_policy", "output_contract"],
  "properties": {
    "schema_version": { "type": "integer", "enum": [3] },
    "task_id": { "type": "string" },
    "slice_id": { "type": "string" },
    "repo": { "type": "string" },
    "base_sha": { "type": "string" },
    "objective": { "type": "string" },
    "requirements_path": { "type": "string" },
    "global_constraints_path": { "type": "string" },
    "contract": {
      "type": "object",
      "required": ["path", "sha256", "semantics_version", "execution_plan_sha256"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string" },
        "semantics_version": { "type": "integer", "enum": [1, 2, 3] },
        "execution_plan_sha256": { "type": "string" }
      },
      "additionalProperties": false
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slice_id", "required_outcome", "keeper_outputs"],
        "properties": {
          "slice_id": { "type": "string" },
          "required_outcome": { "type": "string", "enum": ["succeeded"] },
          "keeper_outputs": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "keeper_outputs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "owned_paths": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "forbidden_paths": { "type": "array", "items": { "type": "string" } },
    "acceptance_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "risk_class": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "failure_domain": { "type": "string" },
    "rollback_boundary": { "type": "string" },
    "budget": {
      "type": "object",
      "required": ["max_changed_files", "max_loc", "max_wall_clock_minutes", "max_required_checks"],
      "properties": {
        "max_changed_files": { "type": "integer", "minimum": 1 },
        "max_loc": { "type": "integer", "minimum": 1 },
        "max_wall_clock_minutes": { "type": "integer", "minimum": 1 },
        "max_required_checks": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "checks": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "size_gate": {
      "type": "object",
      "required": ["decision", "policy_id", "estimate", "exception"],
      "properties": {
        "decision": { "type": "string", "enum": ["pass", "split_required", "exception"] },
        "policy_id": { "type": "string", "enum": ["atlas-slice-size-v2"] },
        "estimate": {
          "type": "object",
          "required": ["estimated_changed_files", "estimated_net_loc", "target_p90_minutes", "serial_dependency_depth", "independent_vertical_count"],
          "properties": {
            "estimated_changed_files": { "type": "integer", "minimum": 1 },
            "estimated_net_loc": { "type": "integer", "minimum": 1 },
            "target_p90_minutes": { "type": "integer", "minimum": 1 },
            "serial_dependency_depth": { "type": "integer", "minimum": 0 },
            "independent_vertical_count": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "exception": { "type": ["object", "null"] }
      },
      "additionalProperties": false
    },
    "commit_policy": { "type": "string", "enum": ["logical_outcome", "changes_allowed_no_commit", "no_change_allowed"] },
    "output_contract": { "type": "string", "enum": ["final_message_json_only"] }
  },
  "additionalProperties": false
}
