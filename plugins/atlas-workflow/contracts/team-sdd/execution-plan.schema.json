{
  "type": "object",
  "required": ["schema_version", "size_policy", "slices"],
  "properties": {
    "schema_version": { "type": "integer", "enum": [1] },
    "size_policy": {
      "type": "object",
      "required": ["policy_id"],
      "properties": { "policy_id": { "type": "string", "enum": ["atlas-slice-size-v1"] } },
      "additionalProperties": false
    },
    "slices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slice_id", "objective", "depends_on", "keeper_outputs", "owned_paths", "acceptance_refs", "risk_class", "failure_domain", "rollback_boundary", "budget", "checks"],
        "properties": {
          "slice_id": { "type": "string" },
          "objective": { "type": "string" },
          "depends_on": { "type": "array", "items": { "type": "string" } },
          "keeper_outputs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "owned_paths": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "forbidden_paths": { "type": "array", "items": { "type": "string" } },
          "acceptance_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "risk_class": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
          "failure_domain": { "type": "string" },
          "rollback_boundary": { "type": "string" },
          "budget": {
            "type": "object",
            "required": ["max_changed_files", "max_loc", "max_wall_clock_minutes", "max_required_checks"],
            "properties": {
              "max_changed_files": { "type": "integer", "minimum": 1 },
              "max_loc": { "type": "integer", "minimum": 1 },
              "max_wall_clock_minutes": { "type": "integer", "minimum": 1 },
              "max_required_checks": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          },
          "checks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["check_id", "gate_class", "command", "final_only", "cache_policy"],
              "properties": {
                "check_id": { "type": "string" },
                "gate_class": { "type": "string" },
                "command": { "type": "string" },
                "final_only": { "type": "boolean" },
                "cache_policy": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "size_exception": {
            "type": "object",
            "required": ["authority_ref", "expires_at", "reason", "compensating_controls"],
            "properties": {
              "authority_ref": { "type": "string" },
              "expires_at": { "type": "string" },
              "reason": { "type": "string" },
              "compensating_controls": { "type": "array", "minItems": 1, "items": { "type": "string" } }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
