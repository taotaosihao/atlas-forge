{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "oneOf": [
    {
      "type": "object",
      "required": ["schema_version", "size_policy", "slices"],
      "properties": {
        "schema_version": { "type": "integer", "enum": [1] },
        "size_policy": { "$ref": "#/definitions/size_policy" },
        "slices": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/slice_v1" }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["schema_version", "size_policy", "release", "slices"],
      "properties": {
        "schema_version": { "type": "integer", "enum": [2] },
        "size_policy": { "$ref": "#/definitions/size_policy" },
        "release": { "$ref": "#/definitions/release_binding" },
        "slices": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/slice_v2" }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["schema_version", "size_policy", "slices"],
      "properties": {
        "schema_version": { "type": "integer", "enum": [3] },
        "size_policy": { "$ref": "#/definitions/size_policy" },
        "slices": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/slice_v3" }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["schema_version", "size_policy", "release", "slices"],
      "properties": {
        "schema_version": { "type": "integer", "enum": [4] },
        "size_policy": { "$ref": "#/definitions/size_policy" },
        "release": { "$ref": "#/definitions/release_binding" },
        "slices": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/slice_v4" }
        }
      },
      "additionalProperties": false
    }
  ],
  "definitions": {
    "safe_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/non_empty_string" }
    },
    "string_array": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/non_empty_string" }
    },
    "size_policy": {
      "type": "object",
      "required": ["policy_id"],
      "properties": {
        "policy_id": { "type": "string", "enum": ["atlas-slice-size-v2"] }
      },
      "additionalProperties": false
    },
    "estimate": {
      "type": "object",
      "required": [
        "estimated_changed_files",
        "estimated_net_loc",
        "target_p90_minutes",
        "serial_dependency_depth",
        "independent_vertical_count"
      ],
      "properties": {
        "estimated_changed_files": { "type": "integer", "minimum": 1 },
        "estimated_net_loc": { "type": "integer", "minimum": 1 },
        "target_p90_minutes": { "type": "integer", "minimum": 1 },
        "serial_dependency_depth": { "type": "integer", "minimum": 0 },
        "independent_vertical_count": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "required": ["max_changed_files", "max_loc", "max_wall_clock_minutes", "max_required_checks"],
      "properties": {
        "max_changed_files": { "type": "integer", "minimum": 1 },
        "max_loc": { "type": "integer", "minimum": 1 },
        "max_wall_clock_minutes": { "type": "integer", "minimum": 1 },
        "max_required_checks": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "size_exception": {
      "type": "object",
      "required": ["authority_ref", "expires_at", "reason", "compensating_controls"],
      "properties": {
        "authority_ref": { "$ref": "#/definitions/non_empty_string" },
        "expires_at": { "type": "string", "format": "date-time" },
        "reason": { "$ref": "#/definitions/non_empty_string" },
        "compensating_controls": { "$ref": "#/definitions/non_empty_string_array" }
      },
      "additionalProperties": false
    },
    "canonical_relative_path": {
      "type": "string",
      "pattern": "^(?!/)(?!\\./)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\/$)[\\x20-\\x7e]+$"
    },
    "canonical_path_array": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/canonical_relative_path" }
    },
    "canonical_non_empty_path_array": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/canonical_relative_path" }
    },
    "canonical_size_exception": {
      "allOf": [
        { "$ref": "#/definitions/size_exception" },
        {
          "type": "object",
          "properties": {
            "authority_ref": {
              "type": "string",
              "pattern": "^(user-message|operator-input):[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            "expires_at": {
              "type": "string",
              "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\dZ$"
            }
          }
        }
      ]
    },
    "gate_class": {
      "type": "string",
      "enum": [
        "unit",
        "integration",
        "contract",
        "lint",
        "typecheck",
        "build",
        "e2e",
        "auth",
        "permission",
        "security",
        "data-consistency",
        "migration",
        "backup",
        "restore",
        "served-ui",
        "browser-flow",
        "install",
        "postflight",
        "release-identity",
        "collision",
        "downgrade",
        "symlink",
        "exact-layout"
      ]
    },
    "cache_policy": {
      "type": "string",
      "enum": ["identity-bound", "fresh-executed", "cached", "imported", "skipped"]
    },
    "check_v1": {
      "type": "object",
      "required": ["check_id", "gate_class", "command", "final_only", "cache_policy"],
      "properties": {
        "check_id": { "$ref": "#/definitions/safe_id" },
        "gate_class": { "$ref": "#/definitions/gate_class" },
        "command": { "$ref": "#/definitions/non_empty_string" },
        "final_only": { "type": "boolean" },
        "cache_policy": { "$ref": "#/definitions/cache_policy" }
      },
      "additionalProperties": false
    },
    "release_requirement": {
      "type": "object",
      "required": [
        "profile_ref",
        "profile_sha256",
        "requirement_ref",
        "requirement_sha256",
        "dimension",
        "required",
        "waiver_policy",
        "definition_ref",
        "definition_sha256",
        "collector_adapter_ref",
        "collector_adapter_sha256",
        "fact_schema_ref",
        "fact_schema_sha256",
        "evaluator_ref",
        "evaluator_sha256",
        "pass_rule_sha256",
        "required_candidate_components"
      ],
      "properties": {
        "profile_ref": { "$ref": "#/definitions/safe_id" },
        "profile_sha256": { "$ref": "#/definitions/digest" },
        "requirement_ref": { "$ref": "#/definitions/safe_id" },
        "requirement_sha256": { "$ref": "#/definitions/digest" },
        "dimension": { "$ref": "#/definitions/non_empty_string" },
        "required": { "type": "boolean", "enum": [true] },
        "waiver_policy": { "type": "string", "enum": ["never"] },
        "definition_ref": { "$ref": "#/definitions/non_empty_string" },
        "definition_sha256": { "$ref": "#/definitions/digest" },
        "collector_adapter_ref": { "$ref": "#/definitions/non_empty_string" },
        "collector_adapter_sha256": { "$ref": "#/definitions/digest" },
        "fact_schema_ref": { "$ref": "#/definitions/non_empty_string" },
        "fact_schema_sha256": { "$ref": "#/definitions/digest" },
        "evaluator_ref": { "$ref": "#/definitions/non_empty_string" },
        "evaluator_sha256": { "$ref": "#/definitions/digest" },
        "pass_rule_sha256": { "$ref": "#/definitions/digest" },
        "required_candidate_components": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["source", "artifact", "surface_inventory", "config", "runtime", "data"]
          }
        }
      },
      "additionalProperties": false
    },
    "check_v2": {
      "type": "object",
      "required": ["check_id", "gate_class", "command", "final_only", "cache_policy"],
      "properties": {
        "check_id": { "$ref": "#/definitions/safe_id" },
        "gate_class": { "$ref": "#/definitions/gate_class" },
        "command": { "$ref": "#/definitions/non_empty_string" },
        "final_only": { "type": "boolean" },
        "cache_policy": { "$ref": "#/definitions/cache_policy" },
        "release_requirement": { "$ref": "#/definitions/release_requirement" }
      },
      "additionalProperties": false
    },
    "slice_v1": {
      "type": "object",
      "required": [
        "slice_id",
        "objective",
        "depends_on",
        "keeper_outputs",
        "owned_paths",
        "acceptance_refs",
        "risk_class",
        "failure_domain",
        "rollback_boundary",
        "estimate",
        "budget",
        "checks"
      ],
      "properties": {
        "slice_id": { "$ref": "#/definitions/safe_id" },
        "objective": { "$ref": "#/definitions/non_empty_string" },
        "depends_on": { "$ref": "#/definitions/string_array" },
        "keeper_outputs": { "$ref": "#/definitions/non_empty_string_array" },
        "owned_paths": { "$ref": "#/definitions/non_empty_string_array" },
        "forbidden_paths": { "$ref": "#/definitions/string_array" },
        "acceptance_refs": { "$ref": "#/definitions/non_empty_string_array" },
        "risk_class": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "failure_domain": { "$ref": "#/definitions/non_empty_string" },
        "rollback_boundary": { "$ref": "#/definitions/non_empty_string" },
        "estimate": { "$ref": "#/definitions/estimate" },
        "budget": { "$ref": "#/definitions/budget" },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/check_v1" }
        },
        "size_exception": { "$ref": "#/definitions/size_exception" }
      },
      "additionalProperties": false
    },
    "slice_v2": {
      "type": "object",
      "required": [
        "slice_id",
        "objective",
        "depends_on",
        "keeper_outputs",
        "owned_paths",
        "acceptance_refs",
        "risk_class",
        "failure_domain",
        "rollback_boundary",
        "estimate",
        "budget",
        "checks"
      ],
      "properties": {
        "slice_id": { "$ref": "#/definitions/safe_id" },
        "objective": { "$ref": "#/definitions/non_empty_string" },
        "depends_on": { "$ref": "#/definitions/string_array" },
        "keeper_outputs": { "$ref": "#/definitions/non_empty_string_array" },
        "owned_paths": { "$ref": "#/definitions/non_empty_string_array" },
        "forbidden_paths": { "$ref": "#/definitions/string_array" },
        "acceptance_refs": { "$ref": "#/definitions/non_empty_string_array" },
        "risk_class": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "failure_domain": { "$ref": "#/definitions/non_empty_string" },
        "rollback_boundary": { "$ref": "#/definitions/non_empty_string" },
        "estimate": { "$ref": "#/definitions/estimate" },
        "budget": { "$ref": "#/definitions/budget" },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/check_v2" }
        },
        "size_exception": { "$ref": "#/definitions/size_exception" }
      },
      "additionalProperties": false
    },
    "slice_v3": {
      "allOf": [
        { "$ref": "#/definitions/slice_v1" },
        {
          "type": "object",
          "properties": {
            "owned_paths": { "$ref": "#/definitions/canonical_non_empty_path_array" },
            "forbidden_paths": { "$ref": "#/definitions/canonical_path_array" },
            "size_exception": { "$ref": "#/definitions/canonical_size_exception" }
          }
        }
      ]
    },
    "slice_v4": {
      "allOf": [
        { "$ref": "#/definitions/slice_v2" },
        {
          "type": "object",
          "properties": {
            "owned_paths": { "$ref": "#/definitions/canonical_non_empty_path_array" },
            "forbidden_paths": { "$ref": "#/definitions/canonical_path_array" },
            "size_exception": { "$ref": "#/definitions/canonical_size_exception" }
          }
        }
      ]
    },
    "release_binding": {
      "type": "object",
      "required": [
        "target_delivery_class",
        "intent_sha256",
        "profile_ref",
        "profile_sha256",
        "check_definition_set_sha256",
        "requirement_refs"
      ],
      "properties": {
        "target_delivery_class": { "type": "string", "enum": ["product_release"] },
        "intent_sha256": { "$ref": "#/definitions/digest" },
        "profile_ref": { "$ref": "#/definitions/safe_id" },
        "profile_sha256": { "$ref": "#/definitions/digest" },
        "check_definition_set_sha256": { "$ref": "#/definitions/digest" },
        "requirement_refs": { "$ref": "#/definitions/non_empty_string_array" }
      },
      "additionalProperties": false
    }
  }
}
