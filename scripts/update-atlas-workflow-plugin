#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PLUGIN_NAME="atlas-workflow"
PLUGIN_SOURCE="$REPO_ROOT/plugins/$PLUGIN_NAME"
CODEX_HOME_ROOT="${CODEX_HOME_ROOT:-${CODEX_HOME:-$HOME/.codex}}"
LOCAL_PLUGIN_SOURCE="$CODEX_HOME_ROOT/plugins/$PLUGIN_NAME"
LOCAL_MARKETPLACE_FILE="$CODEX_HOME_ROOT/.agents/plugins/marketplace.json"
LOCAL_CACHE_ROOT="$CODEX_HOME_ROOT/plugins/cache/local-atlas/$PLUGIN_NAME/local"
ATLAS_FORGE_SNAPSHOT="$CODEX_HOME_ROOT/.tmp/marketplaces/atlas-forge/plugins/$PLUGIN_NAME"
ATLAS_FORGE_CACHE_ROOT="$CODEX_HOME_ROOT/plugins/cache/atlas-forge/$PLUGIN_NAME"
CODEX_AGENT_SOURCE="$REPO_ROOT/.codex/agents"
CODEX_AGENT_TARGET="$CODEX_HOME_ROOT/agents"
PLUGIN_CREATOR_VALIDATE_SCRIPT="${PLUGIN_CREATOR_VALIDATE_SCRIPT:-${CODEX_HOME:-$HOME/.codex}/skills/.system/plugin-creator/scripts/validate_plugin.py}"

DRY_RUN=0
RUN_CONTRACT=0
SKIP_VALIDATE=0

usage() {
  cat <<'EOF'
Usage:
  scripts/update-atlas-workflow-plugin [options]

Options:
  --dry-run         Show the local update plan without writing runtime files.
  --contract        Run workflow/tests/contract.sh after the local update.
  --skip-validate   Skip plugin manifest validation.
  -h, --help        Show this help.

This is the one-command local development refresh for atlas-workflow. It syncs
the repo plugin source to the local Codex plugin source, refreshes installed
runtime cache copies, syncs workflow helpers and native Codex agents, then
verifies source/cache equality.
EOF
}

log() {
  printf '%s\n' "$*"
}

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    --contract)
      RUN_CONTRACT=1
      shift
      ;;
    --skip-validate)
      SKIP_VALIDATE=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      printf 'unknown option: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

[[ -d "$PLUGIN_SOURCE" ]] || die "missing plugin source: $PLUGIN_SOURCE"
command -v python3 >/dev/null || die "python3 not found in PATH"
command -v rsync >/dev/null || die "rsync not found in PATH"
command -v diff >/dev/null || die "diff not found in PATH"

manifest_version() {
  python3 - "$PLUGIN_SOURCE/.codex-plugin/plugin.json" <<'PY'
import json
import sys
from pathlib import Path

manifest = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
version = manifest.get("version")
if not isinstance(version, str) or not version:
    raise SystemExit("missing plugin version")
print(version)
PY
}

PLUGIN_VERSION="$(manifest_version)"

run_cmd() {
  if [[ "$DRY_RUN" -eq 1 ]]; then
    printf '+'
    printf ' %q' "$@"
    printf '\n'
  else
    "$@"
  fi
}

sync_tree() {
  local source="$1"
  local target="$2"
  local label="$3"

  if [[ "$DRY_RUN" -eq 1 ]]; then
    log "would sync $label:"
    log "  source: $source"
    log "  target: $target"
    return
  fi

  mkdir -p "$target"
  rsync -a --delete "$source/" "$target/"
  log "synced $label: $target"
}

verify_tree() {
  local source="$1"
  local target="$2"
  local label="$3"

  if [[ "$DRY_RUN" -eq 1 ]]; then
    log "would verify $label with diff -qr"
    return
  fi

  [[ -d "$target" ]] || die "missing $label target: $target"
  diff -qr "$source" "$target" >/dev/null
  log "verified $label"
}

validate_plugin() {
  python3 -m json.tool "$PLUGIN_SOURCE/.codex-plugin/plugin.json" >/dev/null

  if [[ "$SKIP_VALIDATE" -eq 1 ]]; then
    log "skipped plugin validation"
    return
  fi

  if [[ -f "$PLUGIN_CREATOR_VALIDATE_SCRIPT" ]]; then
    run_cmd python3 "$PLUGIN_CREATOR_VALIDATE_SCRIPT" "$PLUGIN_SOURCE"
  else
    log "warning: plugin validator not found, skipped: $PLUGIN_CREATOR_VALIDATE_SCRIPT"
  fi
}

refresh_local_cache() {
  if [[ "$DRY_RUN" -eq 1 ]]; then
    log "would refresh installed local plugin cache: $LOCAL_CACHE_ROOT"
    return
  fi

  if [[ ! -f "$LOCAL_MARKETPLACE_FILE" ]]; then
    log "warning: local marketplace file missing, skipped local-atlas cache refresh: $LOCAL_MARKETPLACE_FILE"
    return
  fi

  CODEX_HOME_ROOT="$CODEX_HOME_ROOT" "$REPO_ROOT/workflow/bin/codex-refresh-local-plugin" "$PLUGIN_NAME" >/dev/null
  log "refreshed local-atlas installed cache: $LOCAL_CACHE_ROOT"
}

atlas_forge_cache_target() {
  local version_target="$ATLAS_FORGE_CACHE_ROOT/$PLUGIN_VERSION"
  local latest_target=""

  if [[ -d "$version_target" ]]; then
    printf '%s\n' "$version_target"
    return
  fi

  latest_target="$(find "$ATLAS_FORGE_CACHE_ROOT" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | sort -V | tail -1 || true)"
  if [[ -n "$latest_target" ]]; then
    printf '%s\n' "$latest_target"
  fi
}

sync_atlas_forge_cache() {
  local target

  target="$(atlas_forge_cache_target)"
  if [[ -z "$target" ]]; then
    log "warning: atlas-forge installed cache not found, skipped: $ATLAS_FORGE_CACHE_ROOT"
    return
  fi

  if [[ "$target" != "$ATLAS_FORGE_CACHE_ROOT/$PLUGIN_VERSION" ]]; then
    log "warning: versioned atlas-forge cache missing for $PLUGIN_VERSION; using latest installed cache: $target"
  fi

  sync_tree "$PLUGIN_SOURCE" "$target" "atlas-forge installed plugin cache"
  verify_tree "$PLUGIN_SOURCE" "$target" "atlas-forge installed plugin cache"
}

sync_native_codex_agents() {
  local file
  local target

  if [[ ! -d "$CODEX_AGENT_SOURCE" ]]; then
    log "warning: native Codex agent source missing, skipped: $CODEX_AGENT_SOURCE"
    return
  fi

  if [[ "$DRY_RUN" -eq 1 ]]; then
    log "would sync native Codex agents:"
    log "  source: $CODEX_AGENT_SOURCE"
    log "  target: $CODEX_AGENT_TARGET"
    return
  fi

  mkdir -p "$CODEX_AGENT_TARGET"
  shopt -s nullglob
  for file in "$CODEX_AGENT_SOURCE"/*.toml; do
    cp -p "$file" "$CODEX_AGENT_TARGET/"
    target="$CODEX_AGENT_TARGET/$(basename "$file")"
    cmp -s "$file" "$target"
  done
  shopt -u nullglob
  log "synced native Codex agents: $CODEX_AGENT_TARGET"
}

sync_workflow_helpers() {
  if [[ "$DRY_RUN" -eq 1 ]]; then
    log "would sync workflow helpers and agent assets with scripts/sync-live-workflow.sh"
    return
  fi

  CODEX_HOME_ROOT="$CODEX_HOME_ROOT" "$REPO_ROOT/scripts/sync-live-workflow.sh" >/dev/null
  log "synced workflow helpers and command shims"
}

run_contract() {
  if [[ "$RUN_CONTRACT" -ne 1 ]]; then
    return
  fi

  if [[ "$DRY_RUN" -eq 1 ]]; then
    log "would run workflow/tests/contract.sh"
    return
  fi

  "$REPO_ROOT/workflow/tests/contract.sh"
}

log "Atlas workflow plugin local update"
log "repo:    $REPO_ROOT"
log "version: $PLUGIN_VERSION"
log "codex:   $CODEX_HOME_ROOT"

validate_plugin
sync_native_codex_agents
sync_tree "$PLUGIN_SOURCE" "$LOCAL_PLUGIN_SOURCE" "atlas-workflow source to local plugin source"
verify_tree "$PLUGIN_SOURCE" "$LOCAL_PLUGIN_SOURCE" "local plugin source"

if [[ -d "$ATLAS_FORGE_SNAPSHOT" || "$DRY_RUN" -eq 1 ]]; then
  sync_tree "$PLUGIN_SOURCE" "$ATLAS_FORGE_SNAPSHOT" "atlas-forge marketplace snapshot"
  verify_tree "$PLUGIN_SOURCE" "$ATLAS_FORGE_SNAPSHOT" "atlas-forge marketplace snapshot"
fi

refresh_local_cache
if [[ -d "$LOCAL_CACHE_ROOT" || "$DRY_RUN" -eq 1 ]]; then
  verify_tree "$PLUGIN_SOURCE" "$LOCAL_CACHE_ROOT" "local-atlas installed plugin cache"
fi

sync_atlas_forge_cache
sync_workflow_helpers
run_contract

log "atlas-workflow local plugin update complete"
log "Start a new Codex thread before relying on newly changed skills or agents."
