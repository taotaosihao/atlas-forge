{
  "name": "atlas-forge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "paseo-guard": "./plugins/paseo-agent-guard-plugin/scripts/paseo-guard.mjs",
    "paseo-guard-watch": "./plugins/paseo-agent-guard-plugin/scripts/paseo-guard-watch.mjs"
  },
  "scripts": {
    "check": "node --check plugins/paseo-agent-guard-plugin/scripts/paseo-guard.mjs && node --check plugins/paseo-agent-guard-plugin/scripts/paseo-guard-watch.mjs && node --check scripts/update-codex-plugin.mjs && npm test",
    "test": "node --test plugins/paseo-agent-guard-plugin/test/*.mjs test/*.mjs",
    "plugin:update": "node scripts/update-codex-plugin.mjs",
    "guard:init": "node plugins/paseo-agent-guard-plugin/scripts/paseo-guard.mjs init --workflow plugins/paseo-agent-guard-plugin/examples/single-project.WORKFLOW.md",
    "guard:status": "node plugins/paseo-agent-guard-plugin/scripts/paseo-guard.mjs status --workflow plugins/paseo-agent-guard-plugin/examples/single-project.WORKFLOW.md",
    "guard:dry-run": "node plugins/paseo-agent-guard-plugin/scripts/paseo-guard.mjs reconcile --workflow plugins/paseo-agent-guard-plugin/examples/single-project.WORKFLOW.md --dry-run",
    "guard:watch-status": "node plugins/paseo-agent-guard-plugin/scripts/paseo-guard.mjs watch-status --workflow plugins/paseo-agent-guard-plugin/examples/single-project.WORKFLOW.md",
    "guard:ensure-watch": "node plugins/paseo-agent-guard-plugin/scripts/paseo-guard.mjs ensure-watch --workflow plugins/paseo-agent-guard-plugin/examples/single-project.WORKFLOW.md",
    "guard:watch": "node plugins/paseo-agent-guard-plugin/scripts/paseo-guard-watch.mjs --workflow plugins/paseo-agent-guard-plugin/examples/single-project.WORKFLOW.md"
  }
}
