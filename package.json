{
  "name": "codex-plugins-marketplace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "paseo-guard": "./plugins/paseo-agent-guard-plugin/scripts/paseo-guard.mjs",
    "paseo-guard-watch": "./plugins/paseo-agent-guard-plugin/scripts/paseo-guard-watch.mjs"
  },
  "scripts": {
    "check": "node --check plugins/paseo-agent-guard-plugin/scripts/paseo-guard.mjs && node --check plugins/paseo-agent-guard-plugin/scripts/paseo-guard-watch.mjs && node --check scripts/update-codex-plugin.mjs && npm test",
    "test": "node --test plugins/paseo-agent-guard-plugin/test/*.mjs",
    "plugin:update": "node scripts/update-codex-plugin.mjs",
    "guard:init": "node plugins/paseo-agent-guard-plugin/scripts/paseo-guard.mjs init --config plugins/paseo-agent-guard-plugin/examples/gearjob-123-plm-next.config.json",
    "guard:status": "node plugins/paseo-agent-guard-plugin/scripts/paseo-guard.mjs status --config plugins/paseo-agent-guard-plugin/examples/gearjob-123-plm-next.config.json",
    "guard:dry-run": "node plugins/paseo-agent-guard-plugin/scripts/paseo-guard.mjs reconcile --config plugins/paseo-agent-guard-plugin/examples/gearjob-123-plm-next.config.json --dry-run",
    "guard:watch": "node plugins/paseo-agent-guard-plugin/scripts/paseo-guard-watch.mjs --config plugins/paseo-agent-guard-plugin/examples/gearjob-123-plm-next.config.json"
  }
}
